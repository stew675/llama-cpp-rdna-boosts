From 1c7ab0e89bf3c4a7ef540725d5a42adcc5a90c5e Mon Sep 17 00:00:00 2001
From: Stew Forster <stew675@gmail.com>
Date: Thu, 10 Sep 2026 19:09:06 -0500
Subject: [PATCH 00/14] rdna-boosts: block 00: structural and architecture
 fixes

Baseline-level fixes that every later block builds on.

1. flash-attention KV-split width invariance: launch_fattn's parallel_blocks
   heuristic keys off ntiles_dst (a function of Q->ne[1]), so single-token
   decode (n_q=1) and speculative verify batches (n_q=3, 5, ...) picked
   different KV splits, fed different partial sums into the online-softmax/PV
   combine and produced different logits.  Greedy near-ties then flipped, so
   MTP --spec-draft-n-max 2 and 4 streamed apart (issue #25).  Evaluate the
   non-stream-K heuristic as if n_q == 1 for every n_q <= 8; decode and all
   verify widths now group identically and the streams match.  n_q > 8
   (prefill) is unchanged.
---
 ggml/src/ggml-cuda/fattn-common.cuh           | 10 +++-
 .../vulkan-shaders/flash_attn.comp            | 29 +++++++++++-
 .../vulkan-shaders/flash_attn_cm1.comp        | 47 +++++++++++++++++--
 3 files changed, 79 insertions(+), 7 deletions(-)

diff --git a/ggml/src/ggml-cuda/fattn-common.cuh b/ggml/src/ggml-cuda/fattn-common.cuh
index 7442bc22a..22eec7d57 100644
--- a/ggml/src/ggml-cuda/fattn-common.cuh
+++ b/ggml/src/ggml-cuda/fattn-common.cuh
@@ -1167,13 +1167,21 @@ void launch_fattn(
         // parallel_blocks must not be larger than what the tensor size allows:
         parallel_blocks = std::min(parallel_blocks, ntiles_KV);
 
+        // Decode and speculative verify batches (n_q <= 8) must use a query-width-
+        // independent KV split: ntiles_dst is a function of Q->ne[1]
+        // (ntiles_x = ceil(Q->ne[1]/ncols1)), so n_q=3 and n_q=5 would otherwise
+        // feed different partial sums into the online-softmax/PV combine, drift the
+        // logits in the last bits and flip greedy near-ties (issue #25).  Evaluate
+        // the heuristic as if n_q == 1 so every small batch agrees.
+        const int ntiles_dst_eff = Q->ne[1] <= 8 ? (ntiles_z_gqa * K->ne[2] * Q->ne[3]) : ntiles_dst;
+
         // If ntiles_total % blocks_per_wave != 0 then some efficiency is lost due to tail effects.
         // Test whether parallel_blocks can be set to a higher value for better efficiency.
         const int blocks_per_wave = nsm * max_blocks_per_sm;
         int nwaves_best = 0;
         int efficiency_percent_best = 0;
         for (int parallel_blocks_test = parallel_blocks; parallel_blocks_test <= ntiles_KV; ++parallel_blocks_test) {
-            const int nblocks_total = ntiles_dst * parallel_blocks_test;
+            const int nblocks_total = ntiles_dst_eff * parallel_blocks_test;
             const int nwaves = (nblocks_total + blocks_per_wave - 1) / blocks_per_wave;
             const int efficiency_percent = 100 * nblocks_total / (nwaves*blocks_per_wave);
 
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/flash_attn.comp b/ggml/src/ggml-vulkan/vulkan-shaders/flash_attn.comp
index 0c1b6d067..3437c6e38 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/flash_attn.comp
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/flash_attn.comp
@@ -512,9 +512,26 @@ void main() {
             }
 
             FLOAT_TYPE Pf[rows_per_thread];
+            bool any_live = false;   // any row of this thread that attends to column c
+            bool any_mask = false;   // any row masked out at column c (P == +0.0)
             [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
                 Pf[r] = FLOAT_TYPE(exp(float(Sf[r][c]) - Mf[r]));
                 Lf[r] += Pf[r];
+                if (Pf[r] != FLOAT_TYPE(0.0)) {
+                    any_live = true;
+                } else {
+                    any_mask = true;
+                }
+            }
+
+            // Masked cells (P == +0.0) must not read V at all: on some targets
+            // (e.g. gfx1151 f16 WMMA / matrix units) accumulating +-0.0 products
+            // is inexact, so a fully masked column would leak the sign of whatever
+            // V the cell last held (e.g. a freed KV cell) into the output. A fully
+            // masked column contributes exactly +0.0, so it can be skipped outright;
+            // partially masked columns skip the masked rows below.
+            if (!any_live) {
+                continue;
             }
 
             [[unroll]] for (uint32_t d = 0; d < HSV_per_thread / 4; ++d) {
@@ -529,8 +546,16 @@ void main() {
                 } else {
                     Vf = FLOAT_TYPEV4(data_vv4[v_offset / 4 + (j * Bc + c * cols_per_iter + col_tid) * v_stride / 4 + d * D_split + d_tid]);
                 }
-                [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
-                    Of[r][d] += FLOAT_TYPEV4(Pf[r] * Vf);
+                if (any_mask) {
+                    [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
+                        if (Pf[r] != FLOAT_TYPE(0.0)) {
+                            Of[r][d] += FLOAT_TYPEV4(Pf[r] * Vf);
+                        }
+                    }
+                } else {
+                    [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
+                        Of[r][d] += FLOAT_TYPEV4(Pf[r] * Vf);
+                    }
                 }
             }
         }
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/flash_attn_cm1.comp b/ggml/src/ggml-vulkan/vulkan-shaders/flash_attn_cm1.comp
index 057ed739a..3100e61b9 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/flash_attn_cm1.comp
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/flash_attn_cm1.comp
@@ -62,6 +62,11 @@ shared O_TYPEV4 pvsh[MatBc * osh_stride];
 
 shared ACC_TYPE slope[Br];
 
+// Per-column liveness for the current KV tile: col_live[c] is set when at least one
+// real query row has a nonzero softmax weight (P) for KV column c of this tile. A
+// column with no live row is fully masked and must never read V (see below).
+shared uint32_t col_live[Bc];
+
 void main() {
 #ifdef NEEDS_INIT_IQ_SHMEM
     if (fa_type_needs_shmem(FaTypeK) || fa_type_needs_shmem(FaTypeV)) {
@@ -157,6 +162,10 @@ void main() {
             mask_cache[idx] = f16vec4(0);
         }
 
+        if (tid < Bc) {
+            col_live[tid] = 0;
+        }
+
         if (MASK_ENABLE) {
             if (USE_MASK_OPT && mask_opt_idx != j / 16) {
                 mask_opt_idx = j / 16;
@@ -389,6 +398,9 @@ void main() {
                     const FLOAT_TYPEV4 Pf = FLOAT_TYPEV4(exp(vec4(sfsh[row / 4 + col * sfshstride]) - mfvec));
                     [[unroll]] for (uint32_t vec_idx = 0; vec_idx < 4; ++vec_idx) {
                         Lf[r + vec_idx] += Pf[vec_idx];
+                        if (i * Br + row + vec_idx < N && float(Pf[vec_idx]) != 0.0f) {
+                            col_live[col] = 1;
+                        }
                     }
                     Psh[col * psh_stride + row / 4] = Pf;
                 }
@@ -396,12 +408,14 @@ void main() {
         }
 
         if (SHMEM_STAGING != 0) {
+            // col_live is written by the Pf loop above; make it visible before zeroing
+            barrier();
             [[unroll]] for (uint32_t idx = 0; idx < Bc * HSV_pad / 4; idx += gl_WorkGroupSize.x) {
                 uint32_t d = (idx + tid) % (HSV_pad / 4);
                 uint32_t c = (idx + tid) / (HSV_pad / 4);
                 if (idx + gl_WorkGroupSize.x <= Bc * HSV_pad / 4 || c < Bc) {
                     FLOAT_TYPEV4 V_Tf = FLOAT_TYPEV4(0);
-                    if ((!KV_bounds_check || j * Bc + c < KV) && (HSV == HSV_pad || d < HSV / 4)) {
+                    if (col_live[c] != 0 && (!KV_bounds_check || j * Bc + c < KV) && (HSV == HSV_pad || d < HSV / 4)) {
 #if !defined(BFLOAT16)
                         if (USE_DECODE_V) {
                             uint coord = (j * Bc + c) * v_stride * BLOCK_SIZE_V + 4 * d;
@@ -421,6 +435,27 @@ void main() {
         }
         barrier();
 
+        // A tile that applied a mask can contain fully masked columns (no live query
+        // row, col_live == 0). Those columns must not read V (see the stage_v comment).
+        // The test is workgroup-uniform and only runs for tiles that may have masked
+        // cells, so fully-live tiles keep the direct path untouched.
+        bool tile_has_dead = false;
+        if (MASK_ENABLE && (!USE_MASK_OPT || (mask_opt_bits != MASK_OPT_ALL_ZERO && mask_opt_bits != MASK_OPT_ALL_NEG_INF))) {
+            if (tid < Bc && col_live[tid] == 0) {
+                tile_has_dead = true;
+            }
+            tile_has_dead = subgroupOr(tile_has_dead);
+            barrier();
+            if (gl_SubgroupInvocationID == 0) {
+                tmpsh[gl_SubgroupID] = tile_has_dead ? 1.0f : 0.0f;
+            }
+            barrier();
+            tile_has_dead = false;
+            [[unroll]] for (uint s = 0; s < gl_NumSubgroups; ++s) {
+                tile_has_dead = tile_has_dead || (tmpsh[s] != 0.0f);
+            }
+        }
+
         const uint num_hsv_tiles = (HSV + MatBc * row_split - 1) / (MatBc * row_split); // round up
 
         // Each subgroup handles HSV/4 columns
@@ -441,7 +476,11 @@ void main() {
             if (SHMEM_STAGING == 0) {
             // For quants we always preload via kvsh. For f16/bf16 we only preload when
             // alignment / bounds force it (otherwise we coopMatLoad direct from data_vv4).
-            const bool stage_v = USE_DECODE_V || KV_bounds_check;
+            // A fully masked column (col_live[c] == 0) must never read V: masked cells
+            // would accumulate +-0.0 x V inexactly on gfx11 f16 WMMA and leak the sign
+            // of whatever V the cell last held. Such columns are staged through kvsh
+            // with their V zeroed instead of being loaded direct.
+            const bool stage_v = USE_DECODE_V || KV_bounds_check || tile_has_dead;
             if (stage_v) {
                 [[unroll]] for (uint32_t i = 0; i < v_loads_per_thread; ++i) {
                     const uint idx = i * gl_WorkGroupSize.x + tid;
@@ -455,7 +494,7 @@ void main() {
                     const uint ib = coord / BLOCK_SIZE_V;
                     const uint iqs = coord % BLOCK_SIZE_V;
 
-                    if (!KV_bounds_check || (v_row < KV && v_col < HSV)) {
+                    if (col_live[row] != 0 && (!KV_bounds_check || (v_row < KV && v_col < HSV))) {
 #if !defined(BFLOAT16)
                         if (USE_DECODE_V) {
                             kvsh[row * vsh_stride + col] = dequantize4(ib, iqs, v_offset, BINDING_IDX_V);
@@ -479,7 +518,7 @@ void main() {
                     coopMatLoad(KMat, Psh, bc_chunk * MatBc * psh_stride, psh_stride, gl_CooperativeMatrixLayoutColumnMajor);
 
                     if (SHMEM_STAGING == 0) {
-                    if (!USE_DECODE_V && !KV_bounds_check) {
+                    if (!USE_DECODE_V && !KV_bounds_check && !tile_has_dead) {
                         // F16/BF16 values can be loaded directly from global memory
                         const uint v_tile_row = j * Bc + bc_chunk * MatBc;
                         const uint v_tile_offset = v_offset / 4 + v_tile_row * v_stride / 4 + hsv_offset / 4;
