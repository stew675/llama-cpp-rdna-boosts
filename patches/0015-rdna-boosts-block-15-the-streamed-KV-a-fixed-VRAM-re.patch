+    }
+    if (offer_pool) {
+        common_log_add(common_log_main(), level, "%s:     --kv-attendance-pool     keep the whole KV in a pinned host mirror and cache only the\n", fn);
+        common_log_add(common_log_main(), level, "%s:                             pages the sparse reader selects in VRAM (a SECOND copy; qwen4exp/\n", fn);
+        common_log_add(common_log_main(), level, "%s:                             Flash-Next trunks only, sized by the system).  Costs prompt\n", fn);
