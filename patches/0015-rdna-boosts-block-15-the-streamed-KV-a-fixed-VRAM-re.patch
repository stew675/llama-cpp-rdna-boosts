+            if (t != nullptr) {
+                vram += ggml_nbytes(t);
+            }
+        }
+    }
+    for (const auto & pc : pool_ctrs) {
+        if (pc.second != nullptr) {
+            vram += ggml_nbytes(pc.second);
+        }
+    }
+    // the cell-indexed tensors ARE the mirror in this mode: the authoritative copy of the whole context
