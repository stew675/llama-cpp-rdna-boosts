+        const char * p = e;
+        while (*p != '\0') {
+            char * end = nullptr;
+            const long x = strtol(p, &end, 10);
+            if (end == p) {
+                break;
+            }
+            v.push_back((int) x);
+            p = end;
+            while (*p == ',' || *p == ' ') { ++p; }
