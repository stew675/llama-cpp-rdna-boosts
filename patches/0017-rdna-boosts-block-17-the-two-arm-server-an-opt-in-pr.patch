+            return false;
+        }
+        note_idx();
+        return true;
+    }
+
+    // SERIALISED FALLBACK (wip/prefill-decode-arms).  The batched device-to-device take needs a backend hook the
+    // buffer may not have -- the delivery's Meta split-state cache under `-sm tensor` has neither `cpy_tensor_n` nor
+    // `cpy_tensor`, and its host path cannot resolve a strided view of a split tensor (measured on Qwen3.8-Flash-Next,
+    // 3-device tensor split: SIGSEGV in ggml_backend_meta_get_tensor_impl).  A take must be CORRECT on every buffer
+    // type, so fall through to the state move the prompt cache already ships: write the sequence's recurrent rows to
+    // a host buffer and read them back on the destination (`LLAMA_STATE_SEQ_FLAGS_RECR_ONLY`, the campaign's measured
