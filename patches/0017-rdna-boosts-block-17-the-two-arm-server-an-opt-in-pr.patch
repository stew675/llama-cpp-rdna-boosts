+void llama_memory_recurrent::debug_cells_dump(const char * tag, uint32_t min, uint32_t max) const {
+    if (!rs_debug_cells()) {
+        return;
+    }
+
+    std::string ss;
+    for (uint32_t i = min; i <= max && i < size; ++i) {
+        const auto & cell = cells[i];
+        if (cell.is_empty()) {
+            continue;
+        }
+        if (!ss.empty()) { ss += ','; }
+        ss += std::to_string(i);
+        ss += ":p" + std::to_string(cell.pos);
+        ss += "/s" + std::to_string(cell.src);
+        ss += "/s0" + std::to_string(cell.src0);
+        ss += "/t" + std::to_string(cell.tail);
+        ss += "/";
+        for (llama_seq_id s : cell.seq_id) { ss += std::to_string(s); }
+    }
+
+    std::string tails;
+    for (uint32_t s = 0; s < size && s < (uint32_t) n_seq_max; ++s) {
+        if (cells[s].tail < 0 && cells[s].pos < 0) { continue; }
+        if (!tails.empty()) { tails += ','; }
+        tails += std::to_string(s) + ":tail" + std::to_string(cells[s].tail) + "/pos" + std::to_string(cells[s].pos);
+    }
+
+    LLAMA_LOG_DEBUG("[TAG_RS_CELLS] %s head=%u n=%u min=%u max=%u rs_z=%d used=%u size=%u cells=%s tails=%s\n",
+            tag, head, n, min, max, rs_z, used, size, ss.c_str(), tails.c_str());
+}
