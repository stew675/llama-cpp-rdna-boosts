+    }
+
+    // a child range as a 1-D view of the child's own simple tensor: `ggml_nbytes()` of the view is exactly the
+    // contiguous range the child backend copies, which is how the CUDA hook already serves the take's own views
+    auto child_view = [&](struct ggml_tensor * c, size_t off, size_t len) -> struct ggml_tensor * {
+        const size_t es   = ggml_type_size(c->type);
