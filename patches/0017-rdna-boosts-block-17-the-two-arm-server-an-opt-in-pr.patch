+    // batched device copy is available.  This bisects "the serialised move is wrong" against "the Meta buffer's
+    // per-device resolution is wrong": on a shape whose buffer HAS a device copy (1 GPU, `-sm layer`), a broken text
+    // with this set means the state move's logic is at fault, not the meta backend.
+    static const bool force_serialised = [] {
+        const char * e = getenv("LLAMA_RS_FORCE_SERIALISED");
+        return e != nullptr && atoi(e) != 0;
+    }();
+
+    // wip/prefill-decode-arms: a handover can move a sequence's CELLS (the reverse handover and a checkpoint
+    // restore the peer performed both re-place them), while qwen4exp's derived indexer pool is laid out FROM
+    // those cells (`kpool_by_order` pools consecutive cells).  The raw indexer keys are shared and authoritative,
+    // so the arm that receives the sequence must re-pool it instead of trusting a layout built for this seq id's
+    // previous cells -- without this the decode arm attends only over what it re-prefilled itself and the
+    // restored/restarted prefix reads as empty (measured on Qwen3.8-Flash-Next, `-sm tensor`, cache_prompt).
+    auto note_idx = [mem, seq_id]() {
+        if (auto * dst_idx = dynamic_cast<llama_memory_hybrid_idx *>(mem)) {
+            dst_idx->seq_state_take_note(seq_id);
+        }
+    };
+
+    if (!force_serialised && dst_recr->can_take_batched(*src_recr)) {
