+    // the destination may still hold cells of a previous request that used this seq id
+    dst_recr->seq_rm(seq_id, -1, -1);
+    {
+        llama_io_read_host rio(blob.data(), blob.size());
+        dst_recr->state_read(rio, seq_id, LLAMA_STATE_SEQ_FLAGS_RECR_ONLY);
+    }
+
+    src_recr->seq_rm(seq_id, -1, -1);
+
+    // wip/prefill-decode-arms (diagnostic, LLAMA_RS_VERIFY_TAKE=1): is the transfer FAITHFUL?  Re-read the
+    // destination's state into a second blob and diff it against the source's.  A difference inside the cell
+    // metadata (the first 4 + 8*cell_count bytes) is placement, not state; a difference in the rows means the
+    // destination is not the source's state and the decode arm is decoding from something else.
+    static const bool verify_take = [] {
+        const char * e = getenv("LLAMA_RS_VERIFY_TAKE");
+        return e != nullptr && atoi(e) != 0;
+    }();
+    if (verify_take) {
+        llama_io_write_dummy dummy2(/* skip_tensors = */ false);
+        dst_recr->state_write(dummy2, seq_id, LLAMA_STATE_SEQ_FLAGS_RECR_ONLY);
+        const size_t size2 = dummy2.n_bytes();
+
+        std::vector<uint8_t> blob2(size2);
+        {
+            llama_io_write_host wio2(blob2.data(), blob2.size());
+            dst_recr->state_write(wio2, seq_id, LLAMA_STATE_SEQ_FLAGS_RECR_ONLY);
+        }
+
+        // the metadata a RECR_ONLY write emits: u32 cell_count, then (i32 pos, u32 n_seq_id) per cell
+        uint32_t n_cells = 0;
+        if (size >= sizeof(n_cells)) {
+            memcpy(&n_cells, blob.data(), sizeof(n_cells));
+        }
+        const size_t meta_size = std::min(size, sizeof(uint32_t) + (size_t) n_cells * (sizeof(int32_t) + sizeof(uint32_t)));
+
+        size_t n_diff = 0, n_diff_meta = 0, first = (size_t) -1;
+        if (size2 != size) {
+            LLAMA_LOG_ERROR("%s: VERIFY size mismatch: source %zu, destination %zu\n", __func__, size, size2);
+        } else {
+            for (size_t i = 0; i < size; ++i) {
+                if (blob[i] != blob2[i]) {
+                    if (first == (size_t) -1) {
+                        first = i;
+                    }
+                    ++n_diff;
+                    if (i < meta_size) {
+                        ++n_diff_meta;
+                    }
+                }
+            }
+        }
+        LLAMA_LOG_INFO("%s: VERIFY seq %d: %zu of %zu byte(s) differ (%zu in the %zu-byte cell metadata), "
+                "first at %zd; the source rows are %s\n",
+                __func__, (int) seq_id, n_diff, size, n_diff_meta, meta_size, (ssize_t) first,
+                n_diff == 0 ? "FAITHFUL" : (n_diff == n_diff_meta ? "re-placed (metadata only)" : "NOT the source's state"));
+
+        if (n_diff > n_diff_meta) {
+            char lines[512];
+            size_t pos = 0;
+            int shown = 0;
+            for (size_t i = first; i < size && shown < 8; i += 4096) { // one sample per 4 KiB window
+                pos += snprintf(lines + pos, sizeof(lines) - pos, " %zu:%02x/%02x", i, blob[i], blob2[i]);
+                ++shown;
+            }
+            LLAMA_LOG_INFO("%s: VERIFY bytes (offset:src/dst):%s\n", __func__, lines);
+        }
+    }
+
+    LLAMA_LOG_INFO("%s: took seq %d as a serialised state move (%.2f MiB: %.2f ms out, %.2f ms in, %.2f ms total)\n",
+            __func__, (int) seq_id, (double) blob.size() / 1024.0 / 1024.0,
+            (t_h2d - t_d2h) / 1000.0, (ggml_time_us() - t_h2d) / 1000.0, (ggml_time_us() - t_d2h) / 1000.0);
+
+    note_idx();
+
+    return true;
+}
