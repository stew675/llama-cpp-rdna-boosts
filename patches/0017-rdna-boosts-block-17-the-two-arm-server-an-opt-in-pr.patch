+        // is a VERIFY: `n_max + 1` rows per active slot (the sampled token plus its draft), which is also what makes
+        // this context's declared reserve (common_arms_dec_reserve) the right one -- the graph grew with the width.
+        n_spec_max = common_speculative_n_max(&params_base.speculative);
+        const int32_t n_rows_per_slot = std::max(1, n_spec_max + 1);
+        cparams.n_batch    = params_base.n_parallel * n_rows_per_slot;
+        cparams.n_ubatch   = cparams.n_batch;
+        cparams.embeddings = false;
+
+        // Every row of a verify batch is an output (it is sampled or verified), so the output limits must cover the
+        // whole width -- the server's own limits were derived for the PREFILL arm's -b, which a narrow `-b` makes
+        // smaller than this context's batch.
+        cparams.n_outputs_max         = std::max<int32_t>(cparams.n_outputs_max, cparams.n_batch);
+        cparams.n_outputs_max_per_seq = std::max<int32_t>(cparams.n_outputs_max_per_seq, n_rows_per_slot);
+
+        cparams.ctx_other              = ctx_tgt;
+        cparams.ctx_other_share_memory = true;
+
+        ctx_dec = llama_init_from_model(model_tgt, cparams);
+        if (ctx_dec == nullptr) {
+            SRV_ERR("%s", "--prefill-decode-arms: failed to create the decode context -- the second arm's graph "
+                    "reserve does not fit next to the expert arena on this card (try a smaller -ub / -c)\n");
+            return false;
+        }
+
+        return true;
+    }
+
+    void start_decode_arm() {
+        if (ctx_dec == nullptr || th_dec.joinable()) {
+            return;
+        }
+        dec_quit = false;
+        th_dec   = std::thread([this] { decode_arm_loop(); });
+    }
+
+    void stop_decode_arm() {
+        if (!th_dec.joinable()) {
+            return;
+        }
+        {
+            std::lock_guard<std::mutex> lk(m_arms);
+            dec_quit = true;
+        }
+        cv_arms.notify_all();
+        th_dec.join();
+    }
+
+    // T0's allocation handshake at a REQUEST boundary.  A reservation is LEGAL while a ubatch is
+    // prepared-but-not-yet-applied, so the reading is only meaningful at a moment when neither arm is inside
+    // llama_process(): the decode arm's step is held out for the duration (`arms_quiet`), and this thread is the
+    // prefill arm, so it cannot race itself.  The second user of the same bracket is the REVERSE state take below.
+    //
+    // Both callers run on the MAIN thread OUTSIDE a prefill step, so `main_in_step` is false by construction and
+    // the wait cannot be on itself; the decode arm's guard waits for `arms_quiet` to clear before it marks itself
+    // in-step, which is what makes the two waits deadlock-free (both under m_arms).
+    void arms_quiesce() {
+        std::unique_lock<std::mutex> lk(m_arms);
+        arms_quiet = true;
+        cv_arms.wait(lk, [&] { return (!dec_in_step && !main_in_step) || dec_quit; });
+    }
+
+    void arms_resume() {
+        {
+            std::lock_guard<std::mutex> lk(m_arms);
+            arms_quiet = false;
+        }
+        cv_arms.notify_all();
+    }
+
+    bool arms_boundary_sync(const char * tag) {
+        if (ctx_dec == nullptr) {
+            return true;
+        }
+
+        arms_quiesce();
+
+        const bool ok_tgt = llama_memory_alloc_sync(llama_get_memory(ctx_tgt), tag);
+        const bool ok_dec = llama_memory_alloc_sync(llama_get_memory(ctx_dec), tag);
+        const bool ok     = ok_tgt && ok_dec;
+
+        n_boundary_sync++;
+        if (ok) {
+            SRV_INF("prefill-decode arms: allocation handshake clean at the '%s' boundary (#%" PRId64 ")\n",
+                    tag, n_boundary_sync);
+        } else {
+            n_boundary_leak++;
+            SRV_WRN("prefill-decode arms: allocation handshake NOT clean at the '%s' boundary "
+                    "(%" PRId64 " of %" PRId64 ") -- a reservation nothing applied\n",
+                    tag, n_boundary_leak, n_boundary_sync);
+        }
+
+        arms_resume();
+
+        return ok;
+    }
+
+    // The speculative round state of one slot (r350).  A slot crosses the request boundary with an EMPTY draft: the
+    // draft it carried belongs to the batch the other arm just ran, its checkpoint is a snapshot of the other arm's
+    // state, and `spec_is_replay` describes a replay that context will never see.  The draft context's own cache is
+    // NOT touched -- it is per sequence and `common_speculative_begin()` re-syncs it at the next prompt.
+    void spec_slot_reset(server_slot & slot) {
+        slot.spec_draft.clear();
+        slot.spec_draft_q.clear();
+        slot.spec_i_batch.clear();
+        slot.spec_ckpt.clear();
+        slot.spec_is_replay = false;
+    }
+
+    // The RETURN half of the state handover: one sequence's recurrent state moves back from the decode arm's
+    // memory to the prefill arm's, so the finished conversation can STAY RESIDENT (its attention cells are shared
+    // and are never freed here) and the next request on this slot reuses its prefix instead of re-prefilling it
+    // from scratch.  Without it every request on the arms path pays a full re-prefill -- measured 685 ms against
+    // 33 ms for a turn that appends ~9 tokens to 5200 (gate-ckpt-reuse, RESULTS-2026-11-22.md pass 6 §6).
+    //
+    // Runs on the MAIN thread, for two reasons: the DESTINATION is this arm's memory, so the take cannot race this
+    // arm's own prepares, and `arms_quiet` holds the decode arm out of llama_process() for the duration because the
+    // take READS that arm's cell map.  Returns false only when there is a recurrent state to move and the move
+    // failed; a dense model has nothing to move and reads true.
+    bool take_state_back(server_slot & slot) {
+        if (ctx_dec == nullptr) {
+            return true;
+        }
+
+        // nothing of the speculative round follows the slot across the boundary (see spec_slot_reset) -- not even
+        // when there is no recurrent state to move, which is why this comes before the `dec_state` check
+        spec_slot_reset(slot);
+
+        {
+            // the decode arm sets this in the same critical section that clears `dec_posted`, which is what the
+            // forward handover waits on -- so read it here under the same mutex, never on the racy fast path
+            std::lock_guard<std::mutex> lk(m_arms);
+            if (!slot.dec_state) {
+                return true;
+            }
+        }
+
+        arms_quiesce();
+        const bool moved = llama_memory_seq_state_take(
+                llama_get_memory(ctx_tgt), llama_get_memory(ctx_dec), slot.id);
+        arms_resume();
+
+        {
+            std::lock_guard<std::mutex> lk(m_arms);
+            slot.dec_state = false;
+        }
+
+        // a plain attention KV is already shared (the same cells), so there is nothing to move and `false` is the
+        // answer, not a failure -- only a hybrid memory carries a recurrent state that has to follow the slot
+        if (!moved && llama_model_is_hybrid(model_tgt)) {
+            SRV_WRN("prefill-decode arms: the reverse state take failed for slot %d (its cells are dropped: the next "
+                    "request re-prefills)\n", slot.id);
+            return false;
+        }
+
+        SLT_TRC(slot, "prefill-decode arms: recurrent state taken back (%s)\n",
+                moved ? "device to device" : "nothing to move: no recurrent state");
+
+        return true;
+    }
+
+    // Which arm owns a slot.  The flag itself is only ever written under m_arms; this is the reader for everything
+    // that is not already holding it (the per-step slot loops on the prefill arm).
+    int slot_arm_of(const server_slot & slot) {
+        std::lock_guard<std::mutex> lk(m_arms);
+        return slot.arm;
+    }
+
+    // The request boundary, prefill -> decode: post the slot to the decode arm, which runs the state take on its
+    // own thread, and then wait for that take -- the prefill arm must not start another prompt on this memory
+    // while the take is reading its recurrent cell metadata.
+    void hand_over_to_decode(server_slot & slot) {
+        arms_boundary_sync("handover");
+
+        spec_slot_reset(slot);
+
+        {
+            std::lock_guard<std::mutex> lk(m_arms);
+            slot.dec_posted  = true;
+            slot.dec_stopped = false;
+            slot.dec_failed  = false;
+            slot.dec_abort   = false;
+            n_handovers++;
+        }
+        cv_arms.notify_all();
+
+        SLT_INF(slot, "%s", "prompt done: posted to the decode arm (the recurrent state follows device to device)\n");
+
+        wait_handover_taken();
+    }
+
+    // wake the main loop from the decode arm (a slot was handed back, or the decode step failed)
+    void wake_main_loop() {
+        server_task task(SERVER_TASK_TYPE_NEXT_RESPONSE);
+        task.id = queue_tasks.get_new_id();
+        queue_tasks.post(std::move(task));
+    }
+
+    void wait_handover_taken() {
+        if (ctx_dec == nullptr) {
+            return;
+        }
+        std::unique_lock<std::mutex> lk(m_arms);
+        cv_arms.wait(lk, [&] {
+            if (dec_quit) {
+                return true;
+            }
+            for (const auto & s : slots) {
+                if (s.dec_posted) {
+                    return false;
+                }
+            }
+            return true;
+        });
+    }
+
+    bool decode_arm_busy() {
+        std::lock_guard<std::mutex> lk(m_arms);
+        for (const auto & s : slots) {
+            if (s.arm == SLOT_ARM_DECODE || s.dec_posted) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    // The decode arm stopped generating for this slot: the rest of the response's lifecycle belongs to the MAIN
+    // loop (release() touches the task queues, the metrics and the prompt cache).
+    void finish_returned_slots() {
+        for (auto & slot : slots) {
+            bool stopped = false;
+            bool failed  = false;
+            {
+                std::lock_guard<std::mutex> lk(m_arms);
+                if (slot.arm != SLOT_ARM_PREFILL) {   // already holding m_arms: read the flag directly
+                    continue;
+                }
+                if (slot.dec_stopped || slot.dec_failed) {
+                    stopped = slot.dec_stopped;
+                    failed  = slot.dec_failed;
+                    slot.dec_stopped = false;
+                    slot.dec_failed  = false;
+                }
+            }
+            if (!stopped && !failed) {
+                continue;
+            }
+
+            // the return half of the request boundary
+            arms_boundary_sync("return");
+
+            if (failed) {
+                spec_slot_reset(slot);
+                send_error(slot, "the decode arm's step failed", ERROR_TYPE_SERVER);
+                slot.prompt_clear();
+                slot.release();
+                continue;
+            }
+
+            // THE REVERSE HANDOVER.  The recurrent state comes back to the prefill arm and the shared attention
+            // cells are left in place, so the slot's sequence is resident and identical to what the single-context
+            // server holds after the same request -- which is what makes the next request's prefix reusable.  The
+            // prompt must therefore NOT be cleared: it is the carrier the reuse path reads (`get_common_prefix`,
+            // `prompt.get_reuse`/checkpoints).  A failed take drops the sequence instead: an attention half with no
+            // recurrent half is an inconsistent state, and a forced re-prefill is the safe failure.
+            if (!take_state_back(slot)) {
+                slot.prompt_clear();
+            }
+
+            slot.print_timings();
+            send_final_response(slot);
+
+            // release() keeps the prompt for a normal task (that is the reference server's idle-slot behaviour);
+            // children and stateless tasks clear it themselves
+            slot.release();
+        }
+    }
+
+    // Release a slot from the MAIN thread whatever arm owns it.  A slot on the decode arm is handed back first
+    // (the decode arm stops using the slot), so this waits at most one decode step.  The slot's state is TAKEN
+    // BACK rather than dropped, so a cancelled conversation keeps its prefix for the next request -- the same
+    // behaviour the single-context server has (its release() does not clear the prompt).
+    void arm_release(server_slot & slot) {
+        if (ctx_dec != nullptr) {
+            bool on_arm = false;
+            {
+                std::unique_lock<std::mutex> lk(m_arms);
+                if (slot.arm != SLOT_ARM_PREFILL || slot.dec_posted) {
+                    on_arm = true;
+                    slot.dec_abort = true;
+                    cv_arms.notify_all();
+                    cv_arms.wait(lk, [&] {
+                        return dec_quit || (slot.arm == SLOT_ARM_PREFILL && !slot.dec_posted);
+                    });
+                    slot.dec_abort   = false;
+                    slot.dec_stopped = false;
+                    slot.dec_failed  = false;
+                }
+            }
+            if (on_arm && !take_state_back(slot)) {
+                slot.prompt_clear();
+            }
+        }
+        slot.release();
+    }
+
+    // ONE decode step for ONE slot: sample row `i` on `ctx`, emit, evaluate the stop conditions.  Factored out of
+    // post_decode() so both arms share it -- the prefill arm runs it for the row that ENDS a prompt (on ctx_tgt),
+    // the decode arm for every generated token (on ctx_dec).  Returns false when the slot must stop; the CALLER
+    // owns that decision (the prefill arm finishes the response, the decode arm hands the slot back).
+    bool slot_step(llama_context * ctx, const server_batch & batch, server_slot & slot, int32_t i) {
+        GGML_ASSERT(i >= 0 && i < batch.size());
+
+        auto accept_special_token = [&](llama_token token) {
+            return params_base.special ||
+                slot.task->params.sampling.preserved_tokens.find(token) != slot.task->params.sampling.preserved_tokens.end();
+        };
+
+        llama_token id;
+        {
+            scoped_timer timer(t_sampl, n_sampl);
+            id = common_sampler_sample(slot.smpl.get(), ctx, i);
+        }
+
+        slot.i_batch = -1;
+
+        common_sampler_accept(slot.smpl.get(), id, true);
+
+        // here we have synchronized the llama_context (due to the sampling above), so we can do time measurement
+        const int64_t t_now = ggml_time_us();
+
+        slot.stats.n_gen += 1;
+
+        if (slot.stats.n_gen == 1) {
+            slot.stats.update_prompt_last();
+            slot.t_print_last = t_now;
+            slot.n_gen_last = 0;
+        }
+
+        slot.stats.update_gen_last();
+
+        completion_token_output result;
+        result.tok          = id;
+        result.text_to_send = common_token_to_piece(ctx, result.tok, accept_special_token(result.tok));
+        result.prob         = 1.0f; // TODO: set it here instead of doing inside populate_token_probs
+
+        if (slot.task->params.sampling.n_probs > 0) {
+            populate_token_probs(slot, result, slot.task->params.post_sampling_probs, params_base.special, i, ctx);
+        }
+
+        if (!process_token(result, slot)) {
+            return false;
+        }
+
+        slot.print_timings_tg();
+
+        return true;
+    }
+
+    // The DECODE ARM: one token per ACTIVE slot, per step, in ONE batch (that is what keeps ITL flat).
+    void decode_arm_loop() {
+        SRV_INF("decode arm: thread up (ctx_dec n_batch = %d)\n", llama_n_batch(ctx_dec));
+
+        while (true) {
+            std::vector<server_slot *> aborting;
+            std::vector<server_slot *> taking;
+            std::vector<server_slot *> active;
+
+            {
+                std::unique_lock<std::mutex> lk(m_arms);
+
+                if (dec_quit) {
+                    break;
+                }
+
+                for (auto & slot : slots) {
+                    if (slot.dec_abort) {
+                        aborting.push_back(&slot);
+                    } else if (slot.dec_posted) {
+                        taking.push_back(&slot);
+                    } else if (slot.arm == SLOT_ARM_DECODE) {
+                        active.push_back(&slot);
+                    }
+                }
+
+                if (aborting.empty() && taking.empty() && active.empty()) {
+                    cv_arms.wait(lk, [&] {
+                        if (dec_quit) {
+                            return true;
+                        }
+                        for (const auto & slot : slots) {
+                            if (slot.arm == SLOT_ARM_DECODE || slot.dec_posted || slot.dec_abort) {
+                                return true;
+                            }
+                        }
+                        return false;
+                    });
+                    continue;
+                }
+            }
+
+            // (1) a slot the main loop is taking back (a client cancel, an error, a shutdown): hand the slot over
+            //     and LEAVE its cells in the shared KV -- the main thread takes the recurrent state back next, so a
+            //     cancelled conversation still reuses its prefix (this is what the single-context server does too:
+            //     release() keeps the prompt unless the task is a child/stateless one)
+            if (!aborting.empty()) {
+                {
+                    std::lock_guard<std::mutex> lk(m_arms);
+                    for (auto * slot : aborting) {
+                        slot->dec_abort   = false;
+                        slot->dec_posted  = false;
+                        slot->dec_stopped = false;
+                        slot->dec_failed  = false;
+                        slot->arm         = SLOT_ARM_PREFILL;
+                    }
+                }
+                cv_arms.notify_all();
+                continue;
+            }
+
+            // (2) the handovers: the recurrent state moves device to device, under THIS thread (it mutates this
+            //     arm's memory module's cell metadata), never under a lock the prefill arm waits on
+            if (!taking.empty()) {
+                for (auto * slot : taking) {
+                    const bool taken = llama_memory_seq_state_take(
+                            llama_get_memory(ctx_dec), llama_get_memory(ctx_tgt), slot->id);
+                    {
+                        std::lock_guard<std::mutex> lk(m_arms);
+                        slot->dec_posted = false;
+                        slot->dec_state  = true;   // the state is on THIS arm until the reverse take
+                        slot->arm        = SLOT_ARM_DECODE;
+                    }
+                    // the take reports its own mechanism (a batched device copy, or the serialised state move a
+                    // buffer without a device copy falls back to): do not claim either of them here
+                    SLT_INF(*slot, "decode arm: sequence state %s\n",
+                            taken ? "taken" : "not moved: no recurrent state to move");
+                }
+                cv_arms.notify_all(); // the prefill arm's wait: it may start the next prompt now
+                continue;             // step the (now larger) active set on the next pass
+            }
+
+            if (active.empty()) {
+                continue;
+            }
+
+            // (3) one step: one token per active slot in one batch -- or, with a speculator, one VERIFY batch:
+            // `n_draft + 1` rows per active slot (r350, TODO #364).
+            const int32_t n_active = (int32_t) active.size();
+
+            // a request-boundary handshake must not land in the middle of a prepare
+            int ret = 0;
+            {
+                arm_step_guard guard(*this, /* main_arm = */ false);
+
+                // Draft for every active slot, exactly as update_slots() does on the main thread.  The drafter reads
+                // the target's hidden rows of the LAST batch -- for these slots that batch ran on ctx_dec, which is
+                // why the decode arm is registered as a target context (common_speculative_add_target_ctx).  Inside
+                // the arm guard: the draft context's own llama_process() is a second DECODE-band context, and the
+                // one-decode-band-context-at-a-time rule of this block applies to it as well.
+                if (spec) {
+                    std::lock_guard<std::mutex> lk(m_spec);
+
+                    for (auto * slot : active) {
+                        common_speculative_get_draft_params(spec.get(), slot->id).drafting = false;
+
+                        // the width this context was SIZED for is the speculator's own maximum, so a draft may never
+                        // exceed it (a batch that does not fit asserts in handle_last_sampled_token)
+                        const int n_draft_max = std::min(slot->get_n_draft_max(), n_spec_max);
+                        if (n_draft_max <= 0) {
+                            continue;
+                        }
+
+                        GGML_ASSERT(slot->can_speculate());
+
+                        // stale candidates: a replay never reads them, a new draft refills them
+                        slot->spec_draft_q.clear();
+
+                        if (!slot->spec_draft.empty()) {
+                            // a previous (partial) draft is replayed; it is verified before anything new is drafted
+                            if (ctx_dec_seq_rm_type == COMMON_CONTEXT_SEQ_RM_TYPE_FULL) {
+                                GGML_ASSERT(!slot->spec_ckpt.empty());
+                            }
+                            continue;
+                        }
+
+                        GGML_ASSERT(slot->spec_i_batch.empty());
+
+                        const bool use_ckpt_dft = ctx_dft_seq_rm_type == COMMON_CONTEXT_SEQ_RM_TYPE_FULL;
+
+                        slot->spec_ckpt.update_pos(
+                                slot->prompt.n_tokens(),
+                                llama_memory_seq_pos_min(llama_get_memory(ctx_dec), slot->id),
+                                llama_memory_seq_pos_max(llama_get_memory(ctx_dec), slot->id));
+
+                        if (use_ckpt_dft) {
+                            slot->spec_ckpt.update_dft(ctx_dft, slot->id, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY);
+                        }
+
+                        // the drafters read the prompt only inside common_speculative_draft() below, before this
+                        // batch changes it.  The pair refuses multimodal, so the slot's own token vector IS the
+                        // prompt and it is not copied (issue #273).
+                        const bool spec_reject = slot->use_spec_rejection();
+
+                        common_speculative_get_draft_params(spec.get(), slot->id) = {
+                            /* .drafting = */ true,
+                            /* .n_max    = */ n_draft_max,
+                            /* .pos0     = */ slot->prompt.tokens.pos_next(),
+                            /* .id_last  = */ slot->sampled,
+                            /* .prompt   = */ &slot->prompt.tokens.get_tokens(),
+                            /* .result   = */ &slot->spec_draft,
+                            /* .result_q = */ spec_reject ? &slot->spec_draft_q : nullptr,
+                            /* .temp     = */ slot->task->params.sampling.temp,
+                            /* .seed     = */ slot->task->params.sampling.seed,
+                        };
+                    }
+
+                    common_speculative_draft(spec.get());
+
+                    // the draft's checkpoints: saved from THIS context (the state the verify batch will extend),
+                    // and the draft context's own cache trimmed to the drafted prefix
+                    for (auto * slot : active) {
+                        auto & draft = slot->spec_draft;
+                        auto & ckpt  = slot->spec_ckpt;
+
+                        slot->stats.n_draft_tokens += draft.size();
+
+                        const bool use_ckpt_dft = ctx_dft_seq_rm_type == COMMON_CONTEXT_SEQ_RM_TYPE_FULL;
+
+                        if (ctx_dft) {
+                            if (use_ckpt_dft) {
+                                GGML_ASSERT(ckpt.load_dft(ctx_dft, slot->id, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY));
+                            }
+
+                            if (!llama_memory_seq_rm(llama_get_memory(ctx_dft), slot->id, ckpt.pos_max + 1, -1)) {
+                                GGML_ABORT("failed to remove sequence %d\n", (int) slot->id);
+                            }
+                        }
+
+                        if (!draft.empty()) {
+                            const bool use_ckpt_tgt =
+                                ctx_dec_seq_rm_type == COMMON_CONTEXT_SEQ_RM_TYPE_FULL ||
+                               (ctx_dec_seq_rm_type == COMMON_CONTEXT_SEQ_RM_TYPE_RS && draft.size() > llama_n_rs_seq(ctx_dec));
+
+                            const bool use_ckpt_dft_save =
+                               (ctx_dft_seq_rm_type == COMMON_CONTEXT_SEQ_RM_TYPE_RS && draft.size() > llama_n_rs_seq(ctx_dft));
+
+                            if (use_ckpt_tgt) {
+                                ckpt.update_tgt(ctx_dec, slot->id, spec_ckpt_save_flags_tgt(*slot));
+                            }
+
+                            if (use_ckpt_dft_save) {
+                                ckpt.update_dft(ctx_dft, slot->id, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY);
+                            }
+                        }
+                    }
+                }
+
+                batch_dec.clear();
+                for (auto * slot : active) {
+                    slot->handle_last_sampled_token(batch_dec);
+                }
+                batch_dec.render(0, batch_dec.size());
+
+                // note: no queue_tasks.yield_to_queue() here -- that is the main loop's worker handshake and this
+                // is another thread; metrics tasks are served by the main loop between steps.
+                ret = llama_process(ctx_dec, LLAMA_PROCESS_TYPE_DECODE, batch_dec.view.get());
