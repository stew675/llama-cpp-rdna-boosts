diff --git a/common/common.cpp b/common/common.cpp
index 3a08ee05c..4a21020e7 100644
--- a/common/common.cpp
+++ b/common/common.cpp
@@ -1320,15 +1320,98 @@ common_gguf_info common_get_gguf_info(const std::string & fname) {
 // `--fit` MEASURES the draft per device, but that measurement cannot work for an MTP draft (its context
 // requires `ctx_other`, which does not exist while fitting), so it silently fell back to zero and fit sized
 // the target as if the draft were free.  This value is what both `--fit` and the MoE preflight charge instead.
+// wip/prefill-decode-arms: the DECODE ARM is a second context created after the slab, exactly like an MTP
+// draft -- but with no KV of its own (it shares the prefill arm's, by design) and a narrow decode graph.  Left
+// undeclared it is an *unbudgeted* late allocation: the slab maps its whole VA at init (`va_spare=0`), the
+// expert arena commits the free VRAM, and the decode context's first `sched_reserve` asks ~1.4 GiB
+// (measured: 1430.16 MiB, Qwen3.8-Flash-Next, `-ncmoe 48`, `-ub 2048`, 3 rows) that has nowhere to come from
+// -- `the movable-boundary slab holds the VRAM` -> `the decode arm's step failed`.  A draft does not hit this
+// because `aux_reserve` is declared BEFORE the slab, so the slab maps less VA and keeps that much spare
+// (`mapped 20.31 < size 23.81`, `va_spare=3.50` on the same shape).  Declaring the decode arm the same way is
+// what makes the pair work on a host tier with the default arena and no user knob.
+//
+// The size is the flat decode-context reserve: no KV term (shared) and a graph that grows with the decode
+// width, measured at 1.4-1.5 GiB at `-ub 2048` on the largest model here.  2048 MiB covers that with the
+// margin this file's other reserves take.  `MOE_EXPERT_CACHE_AUX_RESERVE_MIB` overrides it for both cases.
+#define LLAMA_ARMS_DEC_RESERVE_MIB_DEFAULT 3584  // the same flat second-context reserve an embedded MTP head gets
+
+// TODO #366: the pair creates a SECOND late narrow (decode/verify-width) compute view as well -- the prefill arm
+// re-reserves one after every wide prefill (`process_ubatch`'s post-prefill drop), and it lands after the arena has
+// been re-armed.  That view is the same tier as the decode context's own (`-ub 2048` on the largest model here:
+// 1430.16 and 1430.63 MiB, i.e. the same layout), so the flat reserve is charged ONE MORE of it.  The tier is a
+// measured FLOOR, rounded up to the reserve granularity this file uses, and the direction of the rounding is
+// deliberately upward: over-estimating costs little (the surplus is reclaimed into the arena by `slab_extend` when
+// the late views leave more than `headroom` outside), while under-estimating aborts a request
+// (`graph_reserve: failed to allocate compute buffers` -> `failed to allocate graph`).
+//
+// Measured on the host tier (`-ncmoe 48`, `-c 131072`, arena 13.3 GiB, 3 x R9700, 3 slots, 71k + 23k + an 800-token
+// generation, two rounds):
+//     aux  3584 (flat)  -> fails, ~88 s in, on the post-prefill narrow re-reserve
+//     aux  4096 (+512)  -> fails, same place
+//     aux  5120 (+1536) -> CLEAN, `SLAB_INIT ... aux=5.00 GiB`
+//     6144              -> CLEAN (the manual workaround `WORKLOG.md` 261122.034 recorded)
+// so the derived total is the flat floor plus this tier, which is 5120 on that shape.
+static size_t common_arms_late_narrow_bytes(uint32_t n_ubatch) {
+    // KEYED ON THE WIDTH (TODO #366): a graph at a narrow width is small enough that the flat reserve already covers
+    // both of the pair's late views -- that is the pre-#366 behaviour and it is kept, so a small model or a narrow
+    // ubatch is not charged for VRAM it does not use (a flat charge would take 1.5 GiB of arena from a 4B run).
+    // From `-ub 2048` up the two views together exceed the flat reserve and the extra tier is charged; above 2048 the
+    // ubatch term adds the same +256 MiB per doubling the draft path measured for a wider graph.
+    if (n_ubatch <= 1024) {
+        return 0;
+    }
+    size_t bytes = (size_t) 1536 << 20;
+    for (uint32_t ub = 2048; ub < n_ubatch; ub = ub * 2) {
+        bytes += (size_t) 256 << 20;
+    }
+    return bytes;
+}
+
+static common_draft_reserve common_arms_dec_reserve(const common_params & params) {
+    common_draft_reserve r;
+    if (params.prefill_decode_arms == 0) {
+        return r;
+    }
+    const char * e = getenv("MOE_EXPERT_CACHE_AUX_RESERVE_MIB");
+    if (e != nullptr) {
+        r.total = (size_t) atoll(e) * 1024 * 1024;
+        r.ok    = true;
+        r.note  = "prefill-decode arms: MOE_EXPERT_CACHE_AUX_RESERVE_MIB (the decode context's graph reserve plus "
+                  "the prefill arm's post-prefill narrow re-reserve; no KV -- it shares the prefill arm's)";
+        return r;
+    }
+    const size_t late = common_arms_late_narrow_bytes(params.n_ubatch);
+    r.total = ((size_t) LLAMA_ARMS_DEC_RESERVE_MIB_DEFAULT << 20) + late;
+    r.ok    = true;
+    r.note  = "prefill-decode arms: the decode context's graph reserve (" +
+              std::to_string(LLAMA_ARMS_DEC_RESERVE_MIB_DEFAULT) + " MiB, no KV: it shares the prefill arm's)" +
+              (late != 0 ? " plus " + std::to_string(late >> 20) +
+                           " MiB for the prefill arm's post-prefill narrow re-reserve (#366, derived from the "
+                           "ubatch width)" : "");
+    return r;
+}
+
 static common_draft_reserve common_draft_reserve_derive(const common_params & params) {
     common_draft_reserve draft_reserve;
+
+    // The decode arm is charged even when no drafter exists, and since block 17 amendment r350 the two can be
+    // configured TOGETHER (a speculator on the pair): they are two SEPARATE late contexts, so the reserve is the
+    // SUM, not the larger of the two.  (Before r350 the pair refused a speculator, which is why the old code
+    // kept the max -- that shortcut would under-charge a shape that carries both by a whole draft context.)
+    const common_draft_reserve arms_reserve = common_arms_dec_reserve(params);
+
     if (!params.speculative.has_aux()) {
-        return draft_reserve;
+        if (arms_reserve.ok) {
+            COM_TRC("%s: charging %.0f MiB for the decode arm (%s)\n", __func__,
+                    (double) arms_reserve.total / 1048576.0, arms_reserve.note.c_str());
+        }
+        return arms_reserve;
     }
     const char * e = getenv("MOE_EXPERT_CACHE_AUX_RESERVE_MIB");
     if (e != nullptr) {
         draft_reserve.total = (size_t) atoll(e) * 1024 * 1024;
         draft_reserve.ok    = true;
+        // the override is the TOTAL the slab holds back, for the draft context AND the decode arm together
         return draft_reserve;
     }
     // `n_ctx == 0` ("from the model") is resolved inside the estimator from the draft GGUF's own
@@ -1361,7 +1444,7 @@ static common_draft_reserve common_draft_reserve_derive(const common_params & pa
                                                       (uint32_t) params.n_parallel, params.kv_unified,
                                                       params.speculative.draft.kv_window,
                                                       &mtp_win) != 0;
-    return common_draft_reserve_estimate(
+    common_draft_reserve res = common_draft_reserve_estimate(
             mtp_shared ? params.model.path : params.speculative.draft.mparams.path,
             params.n_ctx,
             mtp_shared ? n_ubatch_dft : params.n_ubatch,
@@ -1369,6 +1452,15 @@ static common_draft_reserve common_draft_reserve_derive(const common_params & pa
             mtp_shared,
             (uint32_t) params.n_parallel, params.kv_unified,
             params.speculative.draft.kv_window);
+
+    // a speculator ON the pair: the draft context and the decode arm are two separate late allocations, so the
+    // slab must hold back both (before r350 the pair refused a speculator, and the max below was the whole story)
