+    }
+    if (size == 0) {
+        return false;
+    }
+
+    std::vector<uint8_t> blob(size);
+    const int64_t t_d2h = ggml_time_us();
+    {
+        llama_io_write_host wio(blob.data(), blob.size());
+        src_recr->state_write(wio, seq_id, LLAMA_STATE_SEQ_FLAGS_RECR_ONLY);
+    }
+    const int64_t t_h2d = ggml_time_us();
