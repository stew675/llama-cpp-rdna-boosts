+// TODO #365: the Meta buffer's per-child, split-aware device copy (`cpy_tensor_n`).
+//
+// The recurrent handover of the two-arm server (block 17) moves one sequence's state from one context's memory to
+// the other's with ONE `ggml_backend_tensor_copy_n()` over 2-D row views that `llama_memory_recurrent::
+// seq_state_take()` builds OUT OF GRAPH.  Those views carry `buffer`/`data` by hand and are registered in NO
+// simple-tensor container, so the host paths here (`set_tensor`/`get_tensor`) cannot resolve them at all -- and
+// because this buffer exposed no copy hook, `llama_memory_recurrent::can_take_batched()` refused the batched take
+// and every handover on a `-sm tensor` hybrid was a host round trip of the whole state (112.57 MiB, ~74 ms, in
+// TTFT; the fallback is still the A/B control `LLAMA_RS_FORCE_SERIALISED=1`).
+//
+// A Meta copy has to be per CHILD: the split state of the view's ROOT -- the tensor the memory allocated, which IS
+// registered -- says which byte range of a row belongs to which child, and each child's own buffer then takes a
+// plain copy of its rows.  (Both sides of a copy are children of the SAME layout, so a child's covered rows are one
+// contiguous range even when the split state is segmented/repeated: the interleaving is INSIDE that range,
+// identically on both sides.)  A shape the planner cannot express that way -- a per-device/partial split, a padded
+// child row, a non-contiguous view -- is staged through the host via the ROOT, i.e. what the serialised arm does for
+// those bytes.  It is NEVER partially copied: a half-moved recurrent state is fluent-but-wrong text, the worst
+// outcome this repo allows.
+//
+// `cpy_tensor` (the single-tensor hook) stays null deliberately.  `ggml_backend_buffer_can_copy_tensor()` is
+// satisfied by either hook and the take only ever uses the batched one; adding the single-tensor hook would
+// silently reroute the KV-park and state-staging copies that take the host path today (they have their own gates and
+// are not part of this change), so this buffer advertises exactly the capability it implements.
+static bool ggml_backend_meta_copy_root_range(const struct ggml_tensor * tensor,
+        struct ggml_tensor ** root, size_t * off, size_t * len) {
+    if (tensor == nullptr || tensor->data == nullptr) {
+        return false;
+    }
+    // the chain root: the take's views are `ggml_view_2d()` over the memory's own tensor, with `buffer`/`data`
+    // assigned by hand, so the root -- not the view -- is what every container knows about
+    struct ggml_tensor * r = const_cast<struct ggml_tensor *>(tensor);
+    for (int guard = 0; guard < 64 && r->view_src != nullptr; ++guard) {
+        r = r->view_src;
+    }
+    if (r->data == nullptr || r->buffer == nullptr) {
+        return false;
+    }
+    const size_t base = (size_t) r->data;
+    const size_t addr = (size_t) tensor->data;
+    if (addr < base) {
+        return false;
+    }
+    const size_t o = addr - base;
+    const size_t n = ggml_nbytes(tensor);
+    if (n > ggml_nbytes(r) || o > ggml_nbytes(r) - n) {
+        return false;
+    }
+    // the copied bytes have to be ONE range of the root: a view of packed whole rows is, a permuted view is not
+    if (n > 0 && !ggml_is_contiguous(tensor)) {
+        return false;
+    }
+    *root = r;
+    *off  = o;
+    *len  = n;
+    return true;
+}
+
+struct ggml_backend_meta_copy_chunk {
+    size_t child; // index of the child buffer the bytes live in
+    size_t off;   // byte offset inside that child's simple tensor
+    size_t len;   // contiguous bytes
+};
+
+struct ggml_backend_meta_copy_side {
+    struct ggml_tensor * root = nullptr; // the allocated tensor the copied range lives in (nullptr: unresolved)
+    size_t off = 0;                      // where the range starts inside `root`
+    size_t len = 0;
+    bool   device = false;               // `chunk` is usable: one contiguous range per child
+    // diagnostics only (GGML_META_DEBUG_CPY), so a staged copy says WHY it was not per child
+    int      axis = GGML_BACKEND_SPLIT_AXIS_NONE;
+    uint32_t n_segments = 0;
+    uint32_t nr0 = 0;
+    size_t   n_bufs = 0;
+    const char * why = "ok";
+    std::vector<ggml_backend_meta_copy_chunk> chunk;
+};
+
+// TODO #365: the per-child plan for ONE side of a copy.  `false` means the range is not resolvable at all (the
+// caller declines); `true` with `device == false` means "staged through the host", never "partly copied".
+static bool ggml_backend_meta_copy_plan(struct ggml_tensor * tensor, ggml_backend_meta_copy_side & side) {
+    side = ggml_backend_meta_copy_side();
+
+    struct ggml_tensor * root = nullptr;
+    if (!ggml_backend_meta_copy_root_range(tensor, &root, &side.off, &side.len)) {
+        return false;
+    }
+    side.root = root;
+
+    if (!ggml_backend_buffer_is_meta(root->buffer) || side.len == 0) {
+        side.why = "a host/other root, or nothing to copy";
+        return true;
+    }
+
+    // whole rows of a contiguous root only: the row is the smallest unit the split state describes
+    const size_t row_stride = root->nb[1];
+    if (!ggml_is_contiguous(root) || row_stride == 0 ||
+            tensor->ne[0] != root->ne[0] || tensor->nb[1] != row_stride ||
+            side.off % row_stride != 0 || side.len % row_stride != 0) {
+        side.why = "not whole packed rows of a contiguous root";
+        return true;
+    }
+    const size_t r0    = side.off / row_stride;
+    const size_t nrows = side.len / row_stride;
+
+    const size_t n_bufs = ggml_backend_meta_buffer_n_bufs(root->buffer);
+    const ggml_backend_meta_split_state ss = ggml_backend_meta_get_split_state(root, /*assume_sync =*/ false);
+    side.axis = (int) ss.axis;
+    side.n_segments = ss.n_segments;
+    side.nr0 = ss.nr[0];
+    side.n_bufs = n_bufs;
+
+    auto child = [&](size_t j) { return ggml_backend_meta_buffer_simple_tensor(root, j); };
+
+    if (ss.axis == GGML_BACKEND_SPLIT_AXIS_MIRRORED) {
+        // every child holds the whole tensor: the same byte range in each
+        for (size_t j = 0; j < n_bufs; ++j) {
+            struct ggml_tensor * c = child(j);
+            if (c == nullptr || c->nb[1] != row_stride) {
+                side.why = "mirrored, but a child is missing or has a different row stride";
+                side.chunk.clear();
+                return true;
+            }
+            side.chunk.push_back({j, side.off, side.len});
+        }
+        side.device = true;
+        return true;
+    }
+
+    if (ss.axis != GGML_BACKEND_SPLIT_AXIS_0 && ss.axis != GGML_BACKEND_SPLIT_AXIS_1) {
+        // a per-device / partial / unknown split: stage it (the host paths serve a registered root)
+        side.why = "a per-device, partial or non-row split";
+        return true;
+    }
+
+    if (ss.axis == GGML_BACKEND_SPLIT_AXIS_0) {
+        // A row is dealt to the children in chunks -- for the recurrent state of a `-sm tensor` hybrid, one segment
+        // repeated `nr[0]` times (3 and 5 on Qwen3.8-Flash-Next) -- and each child PACKS its own chunks in its own
+        // row.  Both sides of this copy are children of the SAME layout, so a child's covered rows are ONE
+        // contiguous range on each side: the interleaving lives inside that range, identically on both, and does
+        // not have to be walked (walking it costs `nr[0]` copies per row per child, which is what made the first
+        // cut of this hook 3.5 ms instead of ~1 ms).  What must hold is that the children's rows tile the root's
+        // row exactly, and that no child row is padded.
+        size_t row_total = 0;
+        for (size_t j = 0; j < n_bufs; ++j) {
+            struct ggml_tensor * c = child(j);
+            if (c == nullptr || c->nb[1] != ggml_row_size(c->type, c->ne[0]) ||
+                    (int64_t) (r0 + nrows) > c->ne[1]) {
+                side.why = "axis 0, but a child row is padded or the row range leaves the child";
+                side.chunk.clear();
+                return true;
+            }
+            row_total += (size_t) c->nb[1];
+            side.chunk.push_back({j, r0*(size_t) c->nb[1], nrows*(size_t) c->nb[1]});
+        }
+        if (row_total != row_stride) {
+            side.why = "axis 0, but the children's rows do not tile the root's row";
+            side.chunk.clear();
+            return true;
+        }
+        side.device = true;
+        return true;
+    }
+
+    // axis 1: whole rows are dealt to the children in bands, so each child takes its overlap with the row range
+    if (ss.n_segments != 1 || ss.nr[0] != 1) {
+        side.why = "axis 1 with segments/repeats";
+        return true;
+    }
+    int64_t row_base = 0;
+    for (size_t j = 0; j < n_bufs; ++j) {
+        struct ggml_tensor * c = child(j);
+        if (c == nullptr || c->nb[1] != row_stride) {
+            side.why = "axis 1, but a child is missing or has a different row stride";
+            side.chunk.clear();
+            return true;
+        }
+        const int64_t rows_j = ss.ne[j];
+        const int64_t lo = std::max<int64_t>((int64_t) r0, row_base);
+        const int64_t hi = std::min<int64_t>((int64_t) (r0 + nrows), row_base + rows_j);
+        if (hi > lo) {
+            side.chunk.push_back({j, (size_t) (lo - row_base)*(size_t) c->nb[1], (size_t) (hi - lo)*(size_t) c->nb[1]});
+        }
+        row_base += rows_j;
+    }
+    if (row_base != root->ne[1]) {
+        side.why = "axis 1, but the child bands do not add up to the root";
+        side.chunk.clear();
+        return true;
+    }
+    side.device = true;
+    return true;
+}
