+static bool ggml_backend_meta_buffer_cpy_tensor_n(ggml_backend_buffer_t buffer,
+        const struct ggml_tensor * const * srcs, struct ggml_tensor * const * dsts, size_t n_tensors) {
+    GGML_ASSERT(ggml_backend_buffer_is_meta(buffer));
+    if (n_tensors == 0) {
+        return true;
+    }
+
+    static const bool dbg = ggml_backend_meta_copy_debug() != nullptr;
+
+    std::vector<ggml_backend_meta_copy_side> sside(n_tensors);
+    std::vector<ggml_backend_meta_copy_side> dside(n_tensors);
+    std::vector<bool> per_child(n_tensors, false);
+
+    size_t n_device = 0, n_staged = 0, bytes_device = 0, bytes_staged = 0;
+
+    for (size_t i = 0; i < n_tensors; ++i) {
+        if (!ggml_backend_meta_copy_plan(const_cast<struct ggml_tensor *>(srcs[i]), sside[i]) ||
+            !ggml_backend_meta_copy_plan(dsts[i], dside[i])) {
+            // not resolvable: decline and let the caller's own fallback own this shape (nothing copied here)
+            if (dbg) {
+                GGML_LOG_INFO("%s: decline '%s' -> '%s' (no resolvable root range)\n", __func__,
+                        srcs[i] != nullptr ? srcs[i]->name : "null", dsts[i] != nullptr ? dsts[i]->name : "null");
+            }
+            return false;
+        }
+
+        // the two sides only pair up when they resolve to the SAME children with the same extents (one model, two
+        // contexts: they should, and a mismatch is staged rather than guessed)
+        bool device = sside[i].device && dside[i].device &&
+                      sside[i].len == dside[i].len &&
+                      sside[i].chunk.size() == dside[i].chunk.size();
+        for (size_t c = 0; device && c < sside[i].chunk.size(); ++c) {
+            device = sside[i].chunk[c].child == dside[i].chunk[c].child &&
+                     sside[i].chunk[c].len   == dside[i].chunk[c].len;
+        }
+        per_child[i] = device;
+
+        if (device) {
+            ++n_device;
+            bytes_device += sside[i].len;
+        } else {
+            ++n_staged;
+            bytes_staged += sside[i].len;
+        }
+        if (dbg) {
+            GGML_LOG_INFO("%s: %s '%s' -> '%s': %zu B, %zu child chunk(s); src axis %d/%u seg/%zu bufs (%s), "
+                    "dst axis %d/%u seg (%s); src nr0 %u\n", __func__,
+                    device ? "device" : "staged(host)", srcs[i]->name, dsts[i]->name, sside[i].len,
+                    device ? sside[i].chunk.size() : 0,
+                    sside[i].axis, sside[i].n_segments, sside[i].n_bufs, sside[i].why,
+                    dside[i].axis, dside[i].n_segments, dside[i].why, sside[i].nr0);
+        }
+    }
+
+    if (dbg || n_staged > 0) {
+        GGML_LOG_INFO("%s: %zu tensor(s) copied per child (%.2f MiB), %zu staged through the host (%.2f MiB)\n",
+                __func__, n_device, (double) bytes_device/1024.0/1024.0, n_staged,
+                (double) bytes_staged/1024.0/1024.0);
+    }
+
+    // the staged pairs first: a host round trip of the pair's whole range through the ROOT (the registered tensor)
+    if (n_staged > 0) {
+        static bool warned = false;
+        if (!warned) {
+            warned = true;
+            GGML_LOG_WARN("%s: %zu tensor(s) (%.2f MiB) of this Meta copy have no contiguous per-child plan, so they are "
+                    "staged through the host (correct, but a round trip).  GGML_META_DEBUG_CPY=1 names the shapes\n",
+                    __func__, n_staged, (double) bytes_staged/1024.0/1024.0);
+        }
+        std::vector<uint8_t> blob;
+        for (size_t i = 0; i < n_tensors; ++i) {
+            if (per_child[i] || sside[i].len == 0) {
+                continue;
+            }
+            if (blob.size() < sside[i].len) {
+                blob.resize(sside[i].len);
+            }
+            ggml_backend_tensor_get(sside[i].root, blob.data(), sside[i].off, sside[i].len);
+            ggml_backend_tensor_set(dside[i].root, blob.data(), dside[i].off, dside[i].len);
+        }
+    }
