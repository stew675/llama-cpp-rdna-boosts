+    uint4 bst[B_ITEMS];
+    int brow[B_ITEMS];
+#pragma unroll
+    for (int i = 0; i < B_ITEMS; ++i) { const int c = tid + i * MMB_NT; brow[i] = xrow(c >> 3); }
+
+    auto load_regs = [&](const int ks) {
+#pragma unroll
+        for (int i = 0; i < A_ITEMS; ++i) {
