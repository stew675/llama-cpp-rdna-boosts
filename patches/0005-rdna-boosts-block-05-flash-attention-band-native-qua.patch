+    GGML_ASSERT(cell_pos->ne[0] == a->src[1]->ne[1]);
+    GGML_ASSERT(tok_lo->ne[0]   == a->src[0]->ne[1]);
+    GGML_ASSERT(tok_hi->ne[0]   == a->src[0]->ne[1]);
+
+    a->src[5] = cell_pos;
+    a->src[6] = tok_lo;
+    a->src[7] = tok_hi;
