+#include "common.cuh"
+#include "fattn-qsa.cuh"
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+// qsa3: packed-block WMMA prefill for the qwen4exp QSA (sparse) attention.
+//
+// The VEC kernel (fattn-qsa.cu) walks the top-k list cell by cell with v_dot2 and one query
+// column per block; this one shares a block of work across G = 4 queries and 12 query heads
+// (48 output rows) and runs the score and PV passes on the F16 WMMA tensor cores over a
+// package of 4 key blocks (16 keys) at a time.
+//
+// It consumes the packed F16 layouts built by the launcher's fused pack kernels below from the natural
+// contiguous F16 cache view (op src[7]/src[8], `ggml_flash_attn_qsa_set_packed`):
+//   pk  [16, 4, 16, n_kv/4*n_kvh]   F16   keys, 4-key blocks, (a, k, b, n) at a+16k+64b+1024n
+//   pv  [ 4, 256, n_kv/4*n_kvh, 1]  F16   values, (k, d, n) at k+4d+1024n
+// and derives the per-group block union here (rows/merge kernels), so the attention kernel
+// reads each needed key/value block exactly once for the 48 rows that share it.
+//
+// Ported from the Strix Halo branch's qsa-attn (qsa3); the op plumbing here is the delivery's
+// GGML_OP_FLASH_ATTN_QSA (src[3] = idx, src[4] = mask or NULL, src[5] = cell_vis, src[6] = q_vis).
+// Prefill-only: the launcher's support check requires q->ne[1] >= 128, so the W = 1..8
+// decode/verify band always takes the VEC kernel and width purity holds by construction.
+
+typedef float v8f  __attribute__((ext_vector_type(8)));
+
+#define QSA3_L2E 1.4426950408889634f
+#define QSA3_G 4
+
+// Fragment-layout shim.  Both gens compute a 16x16x16 F16 tile with fp32 accumulation; only the
+// lane bookkeeping differs (see gated_delta_net_chunked_bf16.cu vs ..._gfx11.cu):
+//   gfx11: 16 halfs/lane (the whole K row, lanes 16-31 mirror 0-15), accumulator m = 2*e + hi
+//   gfx12:  8 halfs/lane ("two runs of four": k = 4*hi + {0..3} and 4*hi + 8 + {0..3}), m = 8*hi + e
+#if defined(RDNA4)
+typedef _Float16 qsa3_frag_t __attribute__((ext_vector_type(8)));
+#define QSA3_ACC_M(e, hi) (8*(hi) + (e))
+#else
+typedef short qsa3_frag_t __attribute__((ext_vector_type(16)));
+#define QSA3_ACC_M(e, hi) (2*(e) + (hi))
+#endif
+
+// K-contiguous fragment from a 16-wide F16 row (gfx12 reads the lane's two 8-byte runs).
+static __device__ __forceinline__ qsa3_frag_t qsa3_frag_row(const uint16_t * row, const int hi) {
+#if defined(RDNA4)
+    const uint16_t * p = row + 4 * hi;
+    return __builtin_bit_cast(qsa3_frag_t, (uint2[2]){*reinterpret_cast<const uint2 *>(p), *reinterpret_cast<const uint2 *>(p + 8)});
+#else
+    (void) hi;
+    return __builtin_bit_cast(qsa3_frag_t, (uint4[2]){*reinterpret_cast<const uint4 *>(row), *reinterpret_cast<const uint4 *>(row + 8)});
+#endif
+}
+
+// the kernel's row map is 48 rows = QSA3_G queries x QSA3_HQ heads; the model's gqa is 12
+#define QSA3_HQ 12
+
+static __device__ __forceinline__ uint16_t qsa3_f2h(const float f) { return __builtin_bit_cast(uint16_t, (_Float16) f); }
+static __device__ __forceinline__ float qsa3_h2f(const uint16_t h) { return (float) __builtin_bit_cast(_Float16, h); }
+
+// Portable WMMA dispatch: gfx12 renamed the builtin and uses the 8-half fragment above; gfx11 keeps
+// the first-gen builtin and its 16-half fragment.  The kernels are runtime-gated to
+// RDNA3_0/RDNA3_5/RDNA4 (ggml_cuda_flash_attn_qsa3_supported), so only the matching arm is ever
+// launched.
+static __device__ __forceinline__ v8f qsa3_wmma_f16(const qsa3_frag_t a, const qsa3_frag_t b, const v8f c) {
+#if defined(RDNA4)
+    return __builtin_amdgcn_wmma_f32_16x16x16_f16_w32_gfx12(a, b, c);
+#else
+    return __builtin_amdgcn_wmma_f32_16x16x16_f16_w32(a, b, c);
+#endif
+}
+
+// ------------------------------------------------------------------------------------------------------------
+// union builder, kernel A: per query row, check that the (validity-transformed) row is non-decreasing; if not,
+// rank-sort it into srow[q] and set sflag[q]. Sentinel 0x7FFFFFFF for invalid (-1 / >= nk) entries.
+#define QSA3_SENT 0x7FFFFFFF
+__global__ __launch_bounds__(256) void qsa3_rows_kernel(
+        const int * __restrict__ ids, const size_t i1, const int ns, const int nk, const int bitmap_words,
+        int * __restrict__ srow, int * __restrict__ sflag) {
+    extern __shared__ int ent[];   // [ns] normalized keys (the sortedness check and the fallback sort)
+    // Bitmap path (only when bitmap_words > 0, see the launcher): a nk-bit cell presence map plus the
+    // 256 per-lane scan offsets, carved out of the same dynamic smem right after ent.
+    uint32_t * bitmap = reinterpret_cast<uint32_t *>(ent + ns);
+    int      * ssum   = reinterpret_cast<int *>(bitmap + bitmap_words);
+    __shared__ int unsorted;
+    __shared__ int nvalid;
+    const int q = blockIdx.x, tid = threadIdx.x;
+    const int * row = reinterpret_cast<const int *>(reinterpret_cast<const char *>(ids) + (size_t) q * i1);
+    for (int j = tid; j < ns; j += 256) { const int key = row[j]; ent[j] = (key >= 0 && key < nk) ? key : QSA3_SENT; }
+    if (tid == 0) { unsorted = 0; }
+    __syncthreads();
+    for (int j = tid; j + 1 < ns; j += 256) { if (ent[j] > ent[j+1]) { unsorted = 1; } }
+    __syncthreads();
+    if (unsorted) {
+        int * dst = srow + (size_t) q * ns;
+        if (bitmap_words > 0) {
+            // The row is the indexer's top-k selection, i.e. a SET of cell ids, so a presence bitmap
+            // enumerates it in ascending order - exactly the order the rank sort produces - for
+            // O(ns + nk/32) per row instead of O(ns^2).  The rows are long contiguous runs of a few
+            // ranges, so the bitmap is also dense and the popcount scan is cheap.
+            for (int i = tid; i < bitmap_words; i += 256) { bitmap[i] = 0u; }
+            __syncthreads();
+            for (int j = tid; j < ns; j += 256) {
+                const int v = ent[j];
+                if (v >= 0 && v < nk) { atomicOr(&bitmap[v >> 5], 1u << (v & 31)); }
+            }
+            __syncthreads();
+            const int per = (bitmap_words + 255) / 256;
+            const int w0  = tid * per, w1 = min(w0 + per, bitmap_words);
+            int cnt = 0;
+            for (int w = w0; w < w1; ++w) { cnt += __popc(bitmap[w]); }
+            ssum[tid] = cnt;
+            __syncthreads();
+            if (tid == 0) {
+                int run = 0;
+                for (int i = 0; i < 256; ++i) { const int v = ssum[i]; ssum[i] = run; run += v; }
+                nvalid = run;
+            }
+            __syncthreads();
+            int o = ssum[tid];
+            for (int w = w0; w < w1; ++w) {
+                uint32_t m = bitmap[w];
+                while (m) { const int b = __ffs(m) - 1; m &= m - 1; dst[o++] = (w << 5) + b; }
+            }
+            __syncthreads();
+            // sentinels sort after every valid key (the merge kernel binary-searches for the first
+            // entry >= QSA3_SENT to get a row's valid count)
+            if (tid == 0) { for (int i = nvalid; i < ns; ++i) { dst[i] = QSA3_SENT; } }
+        } else {
+            // nk is too large for the bitmap budget: the plain cell-level rank sort
+            for (int j = tid; j < ns; j += 256) {
+                const int e = ent[j];
+                int rank = 0;
+                for (int k = 0; k < ns; ++k) { const int f = ent[k]; rank += (f < e) || (f == e && k < j); }
+                dst[rank] = e;
+            }
+        }
+    }
+    if (tid == 0) { sflag[q] = unsorted; }
+}
+
+// kernel B: one workgroup (128 lanes) per group of 4 queries. Lane = key sub-range; the range boundaries are the
+// quantiles of the first non-empty row (block aligned), so the work per lane is balanced for the real (sorted,
+// similar) rows. Each lane merges the 4 sorted rows inside its range: pass 1 counts, block-wide prefix sum,
+// pass 2 writes.
+#define QSA3_MERGE_LANES 128
+static __device__ __forceinline__ int qsa3_get(const int * __restrict__ p, const int j, const int nk, const bool raw) {
+    const int key = p[j];
+    return raw ? ((key >= 0 && key < nk) ? key : QSA3_SENT) : key;
+}
+
+// Per-cell visibility (the derived-visibility predicate the VEC kernel applies): a cell is visible
+// for a query iff 0 <= cell_vis[c] <= q_vis[q].  It is folded into the per-(query,cell) `umask` bit
+// here, at merge time, so the attention kernel needs no per-cell load/branch in its hot loop: the
+// block-level `kv` test it already does then carries the same -inf.  Bit-identical to applying the
+// predicate in the attention kernel (the umask bit indexes the same cell: 4*block + cc).
+static __device__ __forceinline__ bool qsa3_cell_visible(const int * cell_vis, const int qv, const int c) {
+    if (cell_vis == nullptr) { return true; }
+    const int cv = cell_vis[c];
+    return cv >= 0 && cv <= qv;
+}
+__global__ __launch_bounds__(QSA3_MERGE_LANES) void qsa3_merge_kernel(
+        const int * __restrict__ ids, const size_t i1, const int n_q, const int ns, const int nk,
+        const int * __restrict__ srow, const int * __restrict__ sflag,
+        const int * __restrict__ cell_vis, const int * __restrict__ q_vis,
+        uint16_t * __restrict__ ublk, uint16_t * __restrict__ umask, int * __restrict__ ucount, const int cap) {
+    extern __shared__ int rows_s[];
+    __shared__ int scan_s[QSA3_MERGE_LANES];
+    const int lane = threadIdx.x;
+    const int g = blockIdx.x;
+    // per-query visibility key (only when the derived-visibility predicate is in force; the mask path
+    // passes cell_vis == nullptr and is applied by the attention kernel)
+    const int * cvis = cell_vis;
+    int qvv[QSA3_G];
+#pragma unroll
+    for (int qi = 0; qi < QSA3_G; ++qi) { qvv[qi] = (cvis != nullptr && q_vis != nullptr) ? q_vis[QSA3_G*g + qi] : 0; }
+#pragma unroll
+    for (int qi = 0; qi < QSA3_G; ++qi) {
+        const int q = QSA3_G * g + qi;
+        int * dst = rows_s + qi * ns;
+        if (q < n_q) {
+            const bool rw = sflag[q] == 0;
+            const int * src = rw ? reinterpret_cast<const int *>(reinterpret_cast<const char *>(ids) + (size_t) q * i1) : srow + (size_t) q * ns;
+            for (int j = lane; j < ns; j += QSA3_MERGE_LANES) { dst[j] = qsa3_get(src, j, nk, rw); }
+        } else {
+            for (int j = lane; j < ns; j += QSA3_MERGE_LANES) { dst[j] = QSA3_SENT; }
+        }
+    }
+    __syncthreads();
+    const int * rp[QSA3_G]; bool raw[QSA3_G]; int cnt[QSA3_G];
+#pragma unroll
+    for (int qi = 0; qi < QSA3_G; ++qi) {
+        raw[qi] = false; rp[qi] = rows_s + qi * ns;
+        int a = 0, b = ns;
+        while (a < b) { const int mid = (a + b) >> 1; if (rp[qi][mid] < QSA3_SENT) { a = mid + 1; } else { b = mid; } }
+        cnt[qi] = a;
+    }
+    int kmax = -1, ref = -1;
+#pragma unroll
+    for (int qi = 0; qi < QSA3_G; ++qi) {
+        if (cnt[qi] > 0) { kmax = max(kmax, qsa3_get(rp[qi], cnt[qi] - 1, nk, raw[qi])); if (ref < 0) { ref = qi; } }
+    }
+    uint16_t * ob = ublk + (size_t) g * cap, * om = umask + (size_t) g * cap;
+    if (kmax < 0) { if (lane == 0) { ucount[g] = 0; } return; }
+    // lane range [lo, hi) in key space, block aligned, from the reference row's quantiles
+    const int rc = cnt[ref];
+    const int lo = lane == 0 ? 0 : (qsa3_get(rp[ref], (int) (((long long) rc * lane) / QSA3_MERGE_LANES), nk, raw[ref]) & ~3);
+    const int hi = lane == QSA3_MERGE_LANES - 1 ? ((kmax + 4) & ~3)
+                 : (qsa3_get(rp[ref], (int) (((long long) rc * (lane + 1)) / QSA3_MERGE_LANES), nk, raw[ref]) & ~3);
+    int p[QSA3_G], pe[QSA3_G];
+#pragma unroll
+    for (int qi = 0; qi < QSA3_G; ++qi) {
+        int a = 0, b = cnt[qi];
+        while (a < b) { const int mid = (a + b) >> 1; if (qsa3_get(rp[qi], mid, nk, raw[qi]) < lo) { a = mid + 1; } else { b = mid; } }
+        p[qi] = a; b = cnt[qi];
+        while (a < b) { const int mid = (a + b) >> 1; if (qsa3_get(rp[qi], mid, nk, raw[qi]) < hi) { a = mid + 1; } else { b = mid; } }
+        pe[qi] = a;
+    }
+    // pass 1: count union blocks in range
+    int n = 0;
+    {
+        int pp[QSA3_G]; int head[QSA3_G];
+#pragma unroll
+        for (int qi = 0; qi < QSA3_G; ++qi) { pp[qi] = p[qi]; head[qi] = pp[qi] < pe[qi] ? qsa3_get(rp[qi], pp[qi], nk, raw[qi]) : QSA3_SENT; }
+        while (true) {
+            int b = QSA3_SENT;
+#pragma unroll
+            for (int qi = 0; qi < QSA3_G; ++qi) { b = min(b, head[qi]); }
+            if (b == QSA3_SENT) { break; }
+            b >>= 2;
+#pragma unroll
+            for (int qi = 0; qi < QSA3_G; ++qi) {
+                if (head[qi] != QSA3_SENT && (head[qi] >> 2) == b) {
+                    const int * rr = rp[qi];
+                    int pn = pp[qi];
+                    if ((head[qi] & 3) == 0 && pn + 3 < pe[qi] && rr[pn+3] == head[qi] + 3 && rr[pn+1] == head[qi] + 1 && rr[pn+2] == head[qi] + 2) { pn += 4; }
+                    else { do { ++pn; } while (pn < pe[qi] && (rr[pn] >> 2) == b); }
+                    pp[qi] = pn; head[qi] = pn < pe[qi] ? rr[pn] : QSA3_SENT;
+                }
+            }
+            ++n;
+        }
+    }
+    scan_s[lane] = n;
+    __syncthreads();
+    for (int off = 1; off < QSA3_MERGE_LANES; off <<= 1) {
+        const int v = lane >= off ? scan_s[lane - off] : 0;
+        __syncthreads();
+        scan_s[lane] += v;
+        __syncthreads();
+    }
+    const int total = scan_s[QSA3_MERGE_LANES - 1];
+    int o = scan_s[lane] - n;
+    {
+        int head[QSA3_G];
+#pragma unroll
+        for (int qi = 0; qi < QSA3_G; ++qi) { head[qi] = p[qi] < pe[qi] ? qsa3_get(rp[qi], p[qi], nk, raw[qi]) : QSA3_SENT; }
+        while (true) {
+            int b = QSA3_SENT;
+#pragma unroll
+            for (int qi = 0; qi < QSA3_G; ++qi) { b = min(b, head[qi]); }
+            if (b == QSA3_SENT) { break; }
+            b >>= 2;
+            uint32_t mk = 0;
+#pragma unroll
+            for (int qi = 0; qi < QSA3_G; ++qi) {
+                if (head[qi] != QSA3_SENT && (head[qi] >> 2) == b) {
+                    const int * rr = rp[qi];
+                    int pn = p[qi];
+                    if ((head[qi] & 3) == 0 && pn + 3 < pe[qi] && rr[pn+3] == head[qi] + 3 && rr[pn+1] == head[qi] + 1 && rr[pn+2] == head[qi] + 2) {
+                        for (int k2 = 0; k2 < 4; ++k2) { if (qsa3_cell_visible(cvis, qvv[qi], head[qi] + k2)) { mk |= 1u << (4*qi + k2); } }
+                        pn += 4;
+                    }
+                    else { do { const int c2 = rr[pn]; if (qsa3_cell_visible(cvis, qvv[qi], c2)) { mk |= 1u << (4*qi + (c2 & 3)); } ++pn; } while (pn < pe[qi] && (rr[pn] >> 2) == b); }
+                    p[qi] = pn; head[qi] = pn < pe[qi] ? rr[pn] : QSA3_SENT;
+                }
+            }
+            ob[o] = (uint16_t) b; om[o] = (uint16_t) mk; ++o;
+        }
+    }
+    if (lane == QSA3_MERGE_LANES - 1) {
+        int t = total;
+        while (t & 3) { ob[t] = 0xFFFFu; om[t] = 0; ++t; }
+        ucount[g] = t;
+    }
+}
+
+// ------------------------------------------------------------------------------------------------------------
+// Fused qsa3 pack (session 7).  The graph used to build pk/pv as cast + permute + cont + reshape + permute +
+// cont - three passes over the cache, the two `cont`s element-scalar (`cpy_scalar<half,half>`).  These two
+// kernels do the whole re-layout in ONE pass from the natural contiguous F16 view `nat [D=256, H=n_head_kv,
+// N=n_kv]`, so the packs are bit-identical to the graph form (a pure permutation of the same F16 values):
+//   pk[a + 16*k + 64*b + 1024*m] = nat[(a + 16*b) + 256*h + 256*H*n],  m = n/4 + (N/4)*h, k = n&3
+//   pv[k + 4*d + 1024*m]         = nat[ d            + 256*h + 256*H*n]
+// (D = 16*16 fixes the two 16-wide dims `a` and `b`; both kernels write 32 B / 8 B per thread.)
+__global__ __launch_bounds__(256) void qsa3_pack_keys_kernel(
+        const uint16_t * __restrict__ nat, uint16_t * __restrict__ pk, const int H, const int N) {
+    const int q = N >> 2;                     // 4-key groups per head
+    const int total = H * q * 64;             // H * (N/4) * 16 (b) * 4 (k)
+    const int t = blockIdx.x * blockDim.x + threadIdx.x;
+    if (t >= total) return;
+    const int n0 = t & 3;                     // k = n & 3
+    const int j  = (t >> 2) & 15;             // b = d >> 4
+    const int r  = t >> 6;
+    const int qq = r % q;                     // n >> 2
+    const int h  = r / q;
+    const uint16_t * s = nat + (size_t) 16 * j + (size_t) 256 * h + (size_t) 256 * H * (4 * qq + n0);
+    uint16_t * d = pk + (size_t) 16 * n0 + (size_t) 64 * j + (size_t) 1024 * ((size_t) qq + (size_t) q * h);
+    *reinterpret_cast<uint4 *>(d)     = *reinterpret_cast<const uint4 *>(s);
+    *reinterpret_cast<uint4 *>(d + 8) = *reinterpret_cast<const uint4 *>(s + 8);
+}
+
+__global__ __launch_bounds__(256) void qsa3_pack_values_kernel(
+        const uint16_t * __restrict__ nat, uint16_t * __restrict__ pv, const int H, const int N) {
+    const int q = N >> 2;
+    const int total = 256 * q * H;
+    const int t = blockIdx.x * blockDim.x + threadIdx.x;
+    if (t >= total) return;
+    const int d  = t & 255;
+    const int r  = t >> 8;
+    const int qq = r % q;
+    const int h  = r / q;
+    const uint16_t * s = nat + d + (size_t) 256 * h + (size_t) 256 * H * (4 * qq);
+    uint16_t * o = pv + (size_t) 4 * d + (size_t) 1024 * ((size_t) qq + (size_t) q * h);
+    const size_t ks = (size_t) 256 * H;
+    uint16_t v[4];
+#pragma unroll
+    for (int k = 0; k < 4; ++k) { v[k] = s[(size_t) k * ks]; }
+    *reinterpret_cast<uint2 *>(o) = make_uint2((uint32_t) v[0] | ((uint32_t) v[1] << 16), (uint32_t) v[2] | ((uint32_t) v[3] << 16));
+}
+
+struct qsa3_layout {
+    size_t q1, q2, o1, o2, m1;
+    int nk, n_q, gqa, cap;
+    float scale;
+};
+
+__global__ __launch_bounds__(256) void qsa3_attn_kernel(
+        const float * __restrict__ q, const uint16_t * __restrict__ pk, const uint16_t * __restrict__ pv,
+        const uint16_t * __restrict__ mask,
+        const uint16_t * __restrict__ ublk, const uint16_t * __restrict__ umask,
+        const int * __restrict__ ucount, float * __restrict__ out, const qsa3_layout s) {
+    const int tid = threadIdx.x, lane = tid & 31, w = tid >> 5, r = lane & 15, hi = lane >> 4;
+    const int g = blockIdx.x, kvh = blockIdx.y;
+    __shared__ float4 part[3][8][64];
+    __shared__ uint4  ptile[3][32];
+    __shared__ float  alpha_s[48];
+    __shared__ float  l_s[48];
+
+    const size_t nblk = (size_t) s.nk / 4;
+    const uint16_t * pkg = pk + (size_t) kvh * nblk * 1024;
+    const uint16_t * pvg = pv + (size_t) kvh * nblk * 1024;
+    const uint16_t * gblk = ublk + (size_t) g * s.cap;
+    const uint16_t * gmsk = umask + (size_t) g * s.cap;
+    const int nchunks = ucount[g] >> 2;
+
+    qsa3_frag_t qf[3][2];
+    {
+        uint16_t * stage = reinterpret_cast<uint16_t *>(&part[0][0][0]) + w * (48 * 32);   // 3 KB per wave, row stride 64 B
+        const _Float16 hs = (_Float16) s.scale;
+#pragma unroll
+        for (int c = 0; c < QSA3_HQ; ++c) {
+            const int row = 4*c + (lane >> 3), dq = 4 * (lane & 7);
+            const int qi = row / QSA3_HQ, h = row - QSA3_HQ*qi;
+            const int query = QSA3_G * g + qi;
+            float4 v = make_float4(0.f, 0.f, 0.f, 0.f);
+            if (query < s.n_q) {
+                v = *reinterpret_cast<const float4 *>(reinterpret_cast<const char *>(q) + (size_t) query * s.q1 + (size_t) (kvh * s.gqa + h) * s.q2 + (size_t) (32*w + dq) * 4);
+            }
+            const uint16_t h0 = __builtin_bit_cast(uint16_t, (_Float16) v.x * hs), h1 = __builtin_bit_cast(uint16_t, (_Float16) v.y * hs);
+            const uint16_t h2 = __builtin_bit_cast(uint16_t, (_Float16) v.z * hs), h3 = __builtin_bit_cast(uint16_t, (_Float16) v.w * hs);
+            *reinterpret_cast<uint2 *>(stage + row * 32 + dq) = make_uint2((uint32_t) h0 | ((uint32_t) h1 << 16), (uint32_t) h2 | ((uint32_t) h3 << 16));
+        }
+        __syncthreads();
+#pragma unroll
+        for (int i = 0; i < 3; ++i)
+#pragma unroll
+            for (int t = 0; t < 2; ++t) {
+                qf[i][t] = qsa3_frag_row(stage + (16*i + r) * 32 + 16*t, hi);
+            }
+        __syncthreads();
+    }
+    v8f O[3][2];
+#pragma unroll
+    for (int i = 0; i < 3; ++i)
+#pragma unroll
+        for (int t = 0; t < 2; ++t)
+#pragma unroll
+            for (int e = 0; e < 8; ++e) { O[i][t][e] = 0.f; }
+    float m = -INFINITY, l = 0.f;                       // owner state (waves 0..2): row 16w + r
+    const int own_row = 16*w + r, own_qi = own_row / QSA3_HQ;
+
+    auto load_desc = [&](const int c, uint32_t & b01, uint32_t & b23, uint32_t & m01, uint32_t & m23) {
+        const uint2 bb = *reinterpret_cast<const uint2 *>(gblk + 4*c);
+        const uint2 mm = *reinterpret_cast<const uint2 *>(gmsk + 4*c);
+        b01 = bb.x; b23 = bb.y; m01 = mm.x; m23 = mm.y;
+    };
+    auto blk_of = [&](const uint32_t b01, const uint32_t b23, const int j) -> int {
+        const uint32_t v = (j < 2 ? b01 : b23) >> (16 * (j & 1)) & 0xFFFFu;
+        return v == 0xFFFFu ? 0 : (int) v;
+    };
+    auto load_k = [&](const uint32_t b01, const uint32_t b23, qsa3_frag_t * kf) {
+        const int kb = blk_of(b01, b23, r >> 2);
+        const uint16_t * krow = pkg + (size_t) kb * 1024 + (r & 3) * 16 + w * 128;
+#pragma unroll
+        for (int t = 0; t < 2; ++t) { kf[t] = qsa3_frag_row(krow + t*64, hi); }
+    };
+
+    uint32_t b01 = 0, b23 = 0, m01 = 0, m23 = 0;
+    qsa3_frag_t kf[2];
+    if (nchunks > 0) { load_desc(0, b01, b23, m01, m23); load_k(b01, b23, kf); }
+
+    for (int c = 0; c < nchunks; ++c) {
+        v8f sc[3];
+#pragma unroll
+        for (int i = 0; i < 3; ++i) {
+#pragma unroll
+            for (int e = 0; e < 8; ++e) { sc[i][e] = 0.f; }
+#pragma unroll
+            for (int t = 0; t < 2; ++t) { sc[i] = qsa3_wmma_f16(kf[t], qf[i][t], sc[i]); }
+        }
+        qsa3_frag_t vf[2];
+        {
+            const int kb0 = blk_of(b01, b23, 0), kb1 = blk_of(b01, b23, 1), kb2 = blk_of(b01, b23, 2), kb3 = blk_of(b01, b23, 3);
+#pragma unroll
+            for (int t = 0; t < 2; ++t) {
+                const int d = 32*w + 16*t + r;
+#if defined(RDNA4)
+                // the lane's two runs are keys 4*hi..4*hi+3 (block kb_hi) and 4*hi+8..4*hi+11 (kb_{hi+2})
+                const uint2 v0 = *reinterpret_cast<const uint2 *>(pvg + (size_t) (hi ? kb1 : kb0) * 1024 + d * 4);
+                const uint2 v1 = *reinterpret_cast<const uint2 *>(pvg + (size_t) (hi ? kb3 : kb2) * 1024 + d * 4);
+                vf[t] = __builtin_bit_cast(qsa3_frag_t, (uint2[2]){v0, v1});
+#else
+                const uint2 v0 = *reinterpret_cast<const uint2 *>(pvg + (size_t) kb0 * 1024 + d * 4);
+                const uint2 v1 = *reinterpret_cast<const uint2 *>(pvg + (size_t) kb1 * 1024 + d * 4);
+                const uint2 v2 = *reinterpret_cast<const uint2 *>(pvg + (size_t) kb2 * 1024 + d * 4);
+                const uint2 v3 = *reinterpret_cast<const uint2 *>(pvg + (size_t) kb3 * 1024 + d * 4);
+                vf[t] = __builtin_bit_cast(qsa3_frag_t, (uint2[4]){v0, v1, v2, v3});
+#endif
+            }
+        }
+        // --- prefetch next chunk's descriptor and K fragments ---
+        uint32_t nb01 = 0, nb23 = 0, nm01 = 0, nm23 = 0;
+        qsa3_frag_t kfn[2];
+        if (c + 1 < nchunks) { load_desc(c + 1, nb01, nb23, nm01, nm23); load_k(nb01, nb23, kfn); }
+        else { kfn[0] = kf[0]; kfn[1] = kf[1]; }
+#pragma unroll
+        for (int i = 0; i < 3; ++i) {
+            if (i != w) {
+                part[i][w][lane*2+0] = make_float4(sc[i][0], sc[i][1], sc[i][2], sc[i][3]);
+                part[i][w][lane*2+1] = make_float4(sc[i][4], sc[i][5], sc[i][6], sc[i][7]);
+            }
+        }
+        __syncthreads();
+        if (w < 3) {
+            float scf[8];
+#pragma unroll
+            for (int e = 0; e < 8; ++e) { scf[e] = 0.f; }
+#pragma unroll
+            for (int w2 = 0; w2 < 8; ++w2) {
+                if (w2 == w) {
+#pragma unroll
+                    for (int e = 0; e < 8; ++e) { scf[e] += sc[w][e]; }
+                } else {
+                    const float4 a = part[w][w2][lane*2+0], b = part[w][w2][lane*2+1];
+                    scf[0] += a.x; scf[1] += a.y; scf[2] += a.z; scf[3] += a.w; scf[4] += b.x; scf[5] += b.y; scf[6] += b.z; scf[7] += b.w;
+                }
+            }
+#pragma unroll
+            for (int e = 0; e < 8; ++e) {
+                const int mrow = QSA3_ACC_M(e, hi);
+                const int j = mrow >> 2, cc = mrow & 3;
+                const uint32_t mk = ((j < 2 ? m01 : m23) >> (16 * (j & 1))) & 0xFFFFu;
+                const bool kv = (mk >> (own_qi * 4 + cc)) & 1u;
+                if (!kv) {
+                    scf[e] = -INFINITY;
+                } else if (mask) {
+                    scf[e] += qsa3_h2f(mask[4 * blk_of(b01, b23, j) + cc]);
+                }
+            }
+            float mloc = scf[0];
+#pragma unroll
+            for (int e = 1; e < 8; ++e) { mloc = fmaxf(mloc, scf[e]); }
+            mloc = fmaxf(mloc, __shfl_xor(mloc, 16));
+            const float mnew  = fmaxf(m, mloc);
+            const float alpha = mnew == -INFINITY ? 1.f : exp2f((m - mnew) * QSA3_L2E);
+            float p[8], ls = 0.f;
+#pragma unroll
+            for (int e = 0; e < 8; ++e) { p[e] = mnew == -INFINITY ? 0.f : exp2f((scf[e] - mnew) * QSA3_L2E); ls += p[e]; }
+            ls += __shfl_xor(ls, 16);
+            l = l * alpha + ls;
+            m = mnew;
+            uint16_t ph[16];
+#if defined(RDNA4)
+            // the lane's p[e] is the probability of key 8*hi + e; ph must hold keys 0..15 in order
+            float po[8];
+#pragma unroll
+            for (int e = 0; e < 8; ++e) { po[e] = __shfl_xor(p[e], 16); }
+#pragma unroll
+            for (int e = 0; e < 8; ++e) {
+                ph[e]   = qsa3_f2h(hi ? po[e] : p[e]);
+                ph[8+e] = qsa3_f2h(hi ? p[e] : po[e]);
+            }
+#else
+            uint32_t pp[4], po[4];
+#pragma unroll
+            for (int e2 = 0; e2 < 4; ++e2) {
+                pp[e2] = (uint32_t) qsa3_f2h(p[2*e2]) | ((uint32_t) qsa3_f2h(p[2*e2+1]) << 16);
+                po[e2] = (uint32_t) __shfl_xor((int) pp[e2], 16);
+            }
+#pragma unroll
+            for (int e = 0; e < 8; ++e) {
+                const uint16_t mine  = (e & 1) ? (uint16_t) (pp[e>>1] >> 16) : (uint16_t) (pp[e>>1] & 0xffffu);
+                const uint16_t other = (e & 1) ? (uint16_t) (po[e>>1] >> 16) : (uint16_t) (po[e>>1] & 0xffffu);
+                ph[2*e]   = hi ? other : mine;
+                ph[2*e+1] = hi ? mine  : other;
+            }
+#endif
+            if (hi == 0) {
+                ptile[w][r*2+0] = make_uint4((uint32_t) ph[0] | ((uint32_t) ph[1] << 16), (uint32_t) ph[2] | ((uint32_t) ph[3] << 16),
+                                             (uint32_t) ph[4] | ((uint32_t) ph[5] << 16), (uint32_t) ph[6] | ((uint32_t) ph[7] << 16));
+                ptile[w][r*2+1] = make_uint4((uint32_t) ph[8] | ((uint32_t) ph[9] << 16), (uint32_t) ph[10] | ((uint32_t) ph[11] << 16),
+                                             (uint32_t) ph[12] | ((uint32_t) ph[13] << 16), (uint32_t) ph[14] | ((uint32_t) ph[15] << 16));
+                alpha_s[own_row] = alpha;
+            }
+        }
+        __syncthreads();
+        float al[3];
+#pragma unroll
+        for (int i = 0; i < 3; ++i) { al[i] = alpha_s[16*i + r]; }
+        if (__ballot(al[0] != 1.f || al[1] != 1.f || al[2] != 1.f)) {
+#pragma unroll
+            for (int i = 0; i < 3; ++i)
+#pragma unroll
+                for (int t = 0; t < 2; ++t)
+#pragma unroll
+                    for (int e = 0; e < 8; ++e) { O[i][t][e] *= al[i]; }
+        }
+#pragma unroll
+        for (int i = 0; i < 3; ++i) {
+#if defined(RDNA4)
+            const uint2 * prow = reinterpret_cast<const uint2 *>(&ptile[i][r*2]);
+            const qsa3_frag_t pf = __builtin_bit_cast(qsa3_frag_t, (uint2[2]){prow[hi], prow[hi+2]});
+#else
+            const qsa3_frag_t pf = __builtin_bit_cast(qsa3_frag_t, (uint4[2]){ptile[i][r*2+0], ptile[i][r*2+1]});
+#endif
+#pragma unroll
+            for (int t = 0; t < 2; ++t) { O[i][t] = qsa3_wmma_f16(vf[t], pf, O[i][t]); }
+        }
+        kf[0] = kfn[0]; kf[1] = kfn[1];
+        b01 = nb01; b23 = nb23; m01 = nm01; m23 = nm23;
+    }
+
+    if (w < 3 && hi == 0) { l_s[own_row] = l; }
+    __syncthreads();
+    // output: per tile, stage [16 rows x 32 dims] F32 per wave in LDS (2 KB), then coalesced 16-byte row stores
+    float * ostage = reinterpret_cast<float *>(&part[0][0][0]) + w * (16 * 32);
+#pragma unroll
+    for (int i = 0; i < 3; ++i) {
+        const float li = l_s[16*i + r];
+#pragma unroll
+        for (int t = 0; t < 2; ++t)
+#pragma unroll
+            for (int e = 0; e < 8; ++e) { ostage[r * 32 + 16*t + QSA3_ACC_M(e, hi)] = li > 0.f ? O[i][t][e] / li : 0.f; }
+        __syncthreads();
+#pragma unroll
+        for (int c = 0; c < 4; ++c) {
+            const int rr = 4*c + (lane >> 3), dq = 4 * (lane & 7);
+            const int row = 16*i + rr, qi = row / QSA3_HQ, h = row - QSA3_HQ*qi;
+            const int query = QSA3_G * g + qi;
+            if (query < s.n_q) {
+                float * dst = reinterpret_cast<float *>(reinterpret_cast<char *>(out) + (size_t) query * s.o2 + (size_t) (kvh * s.gqa + h) * s.o1) + 32*w + dq;
+                *reinterpret_cast<float4 *>(dst) = *reinterpret_cast<const float4 *>(ostage + rr * 32 + dq);
+            }
+        }
+        __syncthreads();
+    }
+}
+
+// ------------------------------------------------------------------------------------------------------------
+// host side
+
+// Prefill-only packed-block path.  All preconditions the kernels rely on are checked here; returning
+// false simply leaves the VEC kernel (fattn-qsa.cu) in charge of the same op for the decode/verify
+// band and for anything the packs do not cover.
+bool ggml_cuda_flash_attn_qsa3_supported(int device, const ggml_tensor * dst) {
+    const ggml_tensor * q    = dst->src[0];
+    const ggml_tensor * k    = dst->src[1];
+    const ggml_tensor * v    = dst->src[2];
+    const ggml_tensor * ids  = dst->src[3];
+    const ggml_tensor * mask = dst->src[4];
+    const ggml_tensor * pk   = dst->src[7];
+    const ggml_tensor * pv   = dst->src[8];
+
+    if (!pk || !pv) {                                     // the graph did not build the packs
+        return false;
+    }
+    const int cc = ggml_cuda_info().devices[device].cc;
+    if (!(GGML_CUDA_CC_IS_RDNA3_0(cc) || GGML_CUDA_CC_IS_RDNA3_5(cc) || GGML_CUDA_CC_IS_RDNA4(cc))) {
+        return false;                                     // F16 WMMA: first-gen (gfx11) or _gfx12 builtin
+    }
+    if (q->ne[1] < 128) {                                 // prefill-only: the W=1..8 band keeps the VEC kernel
+        return false;
+    }
+    if (q->ne[3] != 1 || k->ne[3] != 1 || v->ne[3] != 1) {
+        return false;
+    }
+    if (q->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32 || ids->type != GGML_TYPE_I32 || !ggml_is_contiguous(dst)) {
+        return false;
+    }
+    if (q->ne[0] != 256 || k->ne[0] != 256 || v->ne[0] != 256 || q->ne[2] != QSA3_HQ * k->ne[2] || v->ne[2] != k->ne[2]) {
+        return false;                                     // the WMMA tiles and the row map are D=256 / gqa=12
+    }
+    if (k->ne[1] < 4 || k->ne[1] % 4 || v->ne[1] != k->ne[1]) {
+        return false;
+    }
+    if (ids->ne[0] < 1 || ids->ne[0] > 2560 || ids->ne[1] < q->ne[1] || ids->nb[1] % 4 || uintptr_t(ids->data) % 4) {
+        return false;
+    }
+    // src[7]/src[8] are the NATURAL contiguous F16 views [D=256, n_head_kv, n_kv] the launcher packs
+    // into the block layouts itself (session 7 fused pack).  k (src[1]) is the permuted
+    // [D, n_kv, n_head_kv] view, so the natural one swaps its dims 1 and 2.
+    if (pk->type != GGML_TYPE_F16 || !ggml_is_contiguous(pk) || pk->ne[0] != k->ne[0] ||
+        pk->ne[1] != k->ne[2] || pk->ne[2] != k->ne[1] || pk->ne[3] != 1 || uintptr_t(pk->data) % 16) {
+        return false;
+    }
+    if (pv->type != GGML_TYPE_F16 || !ggml_is_contiguous(pv) || pv->ne[0] != k->ne[0] ||
+        pv->ne[1] != k->ne[2] || pv->ne[2] != k->ne[1] || pv->ne[3] != 1 || uintptr_t(pv->data) % 16) {
+        return false;
+    }
+    if (mask) {
+        if (mask->type != GGML_TYPE_F16 || mask->nb[0] != 2 || mask->ne[0] < k->ne[1] || mask->ne[1] < q->ne[1] ||
+            mask->ne[2] != 1 || mask->ne[3] != 1) {
+            return false;
+        }
+    } else if (!dst->src[5] || !dst->src[6]) {
+        return false;                                     // no mask and no derived visibility: the op is malformed
+    }
+    return true;
+}
+
+void ggml_cuda_flash_attn_qsa3(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * q    = dst->src[0];
+    const ggml_tensor * k    = dst->src[1];
+    const ggml_tensor * ids  = dst->src[3];
+    const ggml_tensor * mask = dst->src[4];
+    const ggml_tensor * cell_vis = dst->src[5];
+    const ggml_tensor * q_vis    = dst->src[6];
+    const ggml_tensor * pk   = dst->src[7];   // natural F16 [D, n_head_kv, n_kv]; packed below
+    const ggml_tensor * pv   = dst->src[8];
+
+    float scale;
+    memcpy(&scale, dst->op_params, sizeof(float));
+
+    const int n_q    = (int) q->ne[1];
+    const int ns     = (int) ids->ne[0];
+    const int nk     = (int) k->ne[1];
+    const int nh_kv  = (int) k->ne[2];
+    const int ngroups = (n_q + QSA3_G - 1) / QSA3_G;
+    const int cap     = (QSA3_G * ns + 3) & ~3;
+
+
+    // Fused pack (session 7): one pass per tensor from the natural [D, n_head_kv, n_kv] F16 view into the
+    // block layouts the attention kernel reads.  Replaces cast+permute+cont+reshape+permute+cont.
+    ggml_cuda_pool_alloc<uint16_t> pk16(ctx.pool(), (size_t) 256 * nk * nh_kv);
+    ggml_cuda_pool_alloc<uint16_t> pv16(ctx.pool(), (size_t) 256 * nk * nh_kv);
+    {
+        const int q4 = nk >> 2;
+        const int tk = nh_kv * q4 * 64;
+        const int tv = 256 * q4 * nh_kv;
+        if (tk > 0) qsa3_pack_keys_kernel  <<<(tk + 255) / 256, 256, 0, ctx.stream()>>>((const uint16_t *) pk->data, pk16.get(), nh_kv, nk);
+        if (tv > 0) qsa3_pack_values_kernel<<<(tv + 255) / 256, 256, 0, ctx.stream()>>>((const uint16_t *) pv->data, pv16.get(), nh_kv, nk);
+        CUDA_CHECK(cudaGetLastError());
+    }
+
+    ggml_cuda_pool_alloc<uint16_t> ublk(ctx.pool(), (size_t) ngroups * cap);
+    ggml_cuda_pool_alloc<uint16_t> umask(ctx.pool(), (size_t) ngroups * cap);
+    ggml_cuda_pool_alloc<int>      ucount(ctx.pool(), (size_t) ngroups);
+    ggml_cuda_pool_alloc<int>      srow(ctx.pool(), (size_t) n_q * ns);
+    ggml_cuda_pool_alloc<int>      sflag(ctx.pool(), (size_t) n_q);
+    {
+        // rows-kernel dynamic smem: [ns] keys + the nk-bit presence bitmap + 256 scan offsets.
+        // When that does not fit the 48 KiB budget (a very long cache) the kernel falls back to the
+        // rank sort and only the key array is allocated.
+        const int    bitmap_words = (nk + 31) / 32;
+        const size_t rows_smem_bm = (size_t) ns * sizeof(int) + (size_t) bitmap_words * sizeof(uint32_t) + 256 * sizeof(int);
+        const bool   rows_bitmap  = rows_smem_bm <= 48 * 1024;
+        const size_t rows_smem    = rows_bitmap ? rows_smem_bm : (size_t) ns * sizeof(int);
+        const ggml_cuda_kernel_launch_params launch(dim3(n_q), dim3(256), rows_smem, ctx.stream());
+        ggml_cuda_kernel_launch(qsa3_rows_kernel, launch, (const int *) ids->data, ids->nb[1], ns, nk,
+                                rows_bitmap ? bitmap_words : 0, srow.get(), sflag.get());
+        CUDA_CHECK(cudaGetLastError());
+        const ggml_cuda_kernel_launch_params launch2(dim3(ngroups), dim3(QSA3_MERGE_LANES), (size_t) QSA3_G * ns * sizeof(int), ctx.stream());
+        ggml_cuda_kernel_launch(qsa3_merge_kernel, launch2, (const int *) ids->data, ids->nb[1], n_q, ns, nk,
+                                (const int *) srow.get(), (const int *) sflag.get(),
+                                (mask == nullptr && cell_vis != nullptr) ? (const int *) cell_vis->data : nullptr,
+                                (mask == nullptr && q_vis    != nullptr) ? (const int *) q_vis->data    : nullptr,
+                                ublk.get(), umask.get(), ucount.get(), cap);
+        CUDA_CHECK(cudaGetLastError());
+    }
+
+    qsa3_layout layout{q->nb[1], q->nb[2], dst->nb[1], dst->nb[2], mask ? mask->nb[1] : 0, nk, n_q, QSA3_HQ, cap, scale};
+    const ggml_cuda_kernel_launch_params launch(dim3(ngroups, k->ne[2]), dim3(256), 0, ctx.stream());
+    ggml_cuda_kernel_launch(qsa3_attn_kernel, launch,
+            (const float    *) q->data,
+            (const uint16_t *) pk16.get(),
+            (const uint16_t *) pv16.get(),
+            mask     ? (const uint16_t *) mask->data     : nullptr,
+            (const uint16_t *) ublk.get(),
+            (const uint16_t *) umask.get(),
+            (const int      *) ucount.get(),
+            (float          *) dst->data, layout);
+    CUDA_CHECK(cudaGetLastError());
+}
