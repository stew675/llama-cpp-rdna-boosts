+        return false;
+    }
+    args.inject       = nullptr;
+    args.residual     = res;
+    args.block_out    = base_root;
+    args.block_out_hc = false;
+    args.gamma        = nullptr;
+    args.out_res      = const_cast<ggml_tensor *>(add);
+    args.out_xn       = const_cast<ggml_tensor *>(mulg);
+    return true;
+}
