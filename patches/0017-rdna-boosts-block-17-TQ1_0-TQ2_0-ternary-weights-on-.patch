+    // TQ1_0 / TQ2_0 decode (tq.cu): gate + up + SWIGLU, or two or three matmuls over the same src1, in one launch
+    if (const int n_tq = ggml_cuda_tq_try_fuse(cuda_ctx, cgraph, i)) {
+        return n_tq;
+    }
