-    std::lock_guard<std::mutex> lock(g_slab_mutex);
-    const ggml_cuda_slab & s = g_slabs[device];
-    if (!s.inited || !s.ring_armed || s.ring_region == 0 || s.ring_slots <= 0) {
-        return 0;
-    }
-    return (s.ring_region / (size_t) s.ring_slots) / s.unit * s.unit;
-}
