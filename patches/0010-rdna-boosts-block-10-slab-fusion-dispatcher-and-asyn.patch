+        if (slab) {
+            ggml_cuda_slab_wide_aux_free(device, ptr, n * sizeof(T));
+        }
+    }
+    ggml_cuda_wide_scratch(const ggml_cuda_wide_scratch &) = delete;
+    ggml_cuda_wide_scratch & operator=(const ggml_cuda_wide_scratch &) = delete;
+
+    T * get() const { return ptr; }
+};
