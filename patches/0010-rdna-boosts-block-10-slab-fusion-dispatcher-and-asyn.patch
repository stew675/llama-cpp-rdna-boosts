+    if (const int n_kv = ggml_cuda_rms_norm_mul_rope_fwht_set_rows_count(cgraph, i, kv_allow_v, ggml_cuda_info().devices[cuda_ctx->device].warp_size)) {
+        ggml_cuda_op_rms_norm_mul_rope_fused(*cuda_ctx, node, cgraph->nodes[i + 1], cgraph->nodes[i + 2], nullptr, cgraph->nodes[i + 4],
+                                             cgraph->nodes[i + 7], n_kv == 10 ? cgraph->nodes[i + 9] : nullptr);
+        return n_kv - 1;
+    }
+
+    if (ggml_cuda_should_fuse_rms_norm_mul_rope_fwht(cgraph, i)) {
+        // Quantized KV cache, QK rotate order: Q chain (RMS_NORM, MUL, ROPE, RESHAPE, Hadamard) at i, its RESHAPE and V's
+        // 2-D view (no kernels), then V's rotation + the K chain + K / V cache writes at j = i + 7 (ggml_cuda_v_fwht_fold_at).
+        // Defer Q to j and run both in one launch (rms_norm_mul_rope_f32_qk_pair<.., fwht_n, true>): each block runs the
+        // single launch's body, so the results are the same.  Nothing runs in between; the pair kernel's writes (Q's
+        // rotation, the K / V cache rows) must not touch what the other half reads.  GGML_CUDA_QK_PAIR_FWHT=0: off.
+        static const bool pair_fwht_on = getenv("GGML_CUDA_QK_PAIR_FWHT") == nullptr || atoi(getenv("GGML_CUDA_QK_PAIR_FWHT")) != 0;
+        const int j = i + 7;
+        if (pair_fwht_on && kv_allow_v && cuda_ctx->qk_pend_graph == nullptr && j + 12 <= cgraph->n_nodes &&
+                ggml_cuda_is_view_or_noop(cgraph->nodes[i + 5]) && ggml_cuda_is_view_or_noop(cgraph->nodes[i + 6]) &&
+                ggml_cuda_v_fwht_fold_at(*cuda_ctx, cgraph, j)) {
+            const ggml_tensor * q_norm = node;
+            const ggml_tensor * q_mul  = cgraph->nodes[i + 1];
+            const ggml_tensor * q_rope = cgraph->nodes[i + 2];
+            const ggml_tensor * q_had  = cgraph->nodes[i + 4];
+            const ggml_tensor * v_had  = cgraph->nodes[j];
+            const ggml_tensor * k_norm = cgraph->nodes[j + 2];
+            const ggml_tensor * k_mul  = cgraph->nodes[j + 3];
+            const ggml_tensor * k_rope = cgraph->nodes[j + 4];
+            const ggml_tensor * k_had  = cgraph->nodes[j + 6];
+            const ggml_tensor * k_sr   = cgraph->nodes[j + 9];
+            const ggml_tensor * v_sr   = cgraph->nodes[j + 11];
+            const ggml_tensor * q_mul_src = q_mul->src[0] == q_norm ? q_mul->src[1] : q_mul->src[0];
+            const ggml_tensor * k_mul_src = k_mul->src[0] == k_norm ? k_mul->src[1] : k_mul->src[0];
+            const auto overlap = [](const ggml_tensor * a, const ggml_tensor * b) {
+                if (a == nullptr || b == nullptr || a->data == nullptr || b->data == nullptr) {
+                    return false;
+                }
+                const int64_t a0 = (int64_t) a->data, a1 = a0 + ggml_nbytes(a);
+                const int64_t b0 = (int64_t) b->data, b1 = b0 + ggml_nbytes(b);
+                return a0 < b1 && b0 < a1;
+            };
+            const ggml_tensor * k_reads[] = { k_norm->src[0], k_mul_src, k_rope->src[1], k_rope->src[2], k_sr->src[1], v_had->src[1], v_sr->src[1] };
+            const ggml_tensor * q_reads[] = { q_norm->src[0], q_mul_src, q_rope->src[1], q_rope->src[2] };
+            // (no op_params comparison as in ggml_cuda_qk_pair_k_at: each half of the pair carries its own rope arguments)
+            bool ok = q_rope->src[1] == k_rope->src[1] && q_rope->src[2] == k_rope->src[2] &&
+                      q_norm->src[0]->ne[2] == k_norm->src[0]->ne[2] && q_norm->src[0]->ne[3] == k_norm->src[0]->ne[3] &&
+                      q_had->src[0]->ne[0] == k_had->src[0]->ne[0];
+            for (const ggml_tensor * r : k_reads) {
+                ok = ok && !overlap(q_had, r);
+            }
+            for (const ggml_tensor * r : q_reads) {
+                ok = ok && !overlap(k_sr, r) && !overlap(v_sr, r);
+            }
+            if (ok) {
+                cuda_ctx->qk_pend_graph = cgraph;
+                cuda_ctx->qk_pend_i     = i;
+                cuda_ctx->qk_pend_j     = j;
+                return 4;
+            }
+        }
+        ggml_cuda_op_rms_norm_mul_rope_fused(*cuda_ctx, node, cgraph->nodes[i + 1], cgraph->nodes[i + 2], nullptr, cgraph->nodes[i + 4]);
+        return 4;
+    }
+
+    if (ggml_cuda_can_fuse(cgraph, i, { GGML_OP_RMS_NORM, GGML_OP_MUL, GGML_OP_ROPE, GGML_OP_VIEW, GGML_OP_SET_ROWS }, {})) {
+        if (cuda_ctx->qk_pend_graph == cgraph && cuda_ctx->qk_pend_j == i) {
+            const int qi = cuda_ctx->qk_pend_i;
+            const bool with_v = kv_allow_v && ggml_cuda_rope_set_rows_v_ok(cgraph, i);
+            cuda_ctx->qk_pend_graph = nullptr;
+            ggml_cuda_op_rms_norm_mul_rope_qk_pair(*cuda_ctx, cgraph->nodes[qi], cgraph->nodes[qi + 1], cgraph->nodes[qi + 2],
+                                                   node, cgraph->nodes[i + 1], cgraph->nodes[i + 2], cgraph->nodes[i + 4],
+                                                   with_v ? cgraph->nodes[i + 6] : nullptr);
+            return with_v ? 6 : 4;
+        }
+        if (kv_allow_v && ggml_cuda_rope_set_rows_v_ok(cgraph, i)) {
+            ggml_cuda_op_rms_norm_mul_rope_fused(*cuda_ctx, node, cgraph->nodes[i + 1], cgraph->nodes[i + 2], cgraph->nodes[i + 4],
+                                                 nullptr, nullptr, cgraph->nodes[i + 6]);
+            return 6;
+        }
+        ggml_cuda_op_rms_norm_mul_rope_fused(*cuda_ctx, node, cgraph->nodes[i + 1], cgraph->nodes[i + 2], cgraph->nodes[i + 4]);
+        return 4;
+    }
+
+    // GDN gate chain for the verify band: ADD(dt) -> SOFTPLUS -> MUL(a) with per-head broadcasts in one
+    // kernel (decode fuses it into ssm_gate_beta).  GGML_CUDA_FUSE_GDN_GATE=0 turns it off.
+    // GDN gate chain (owned by unary.cu). GGML_CUDA_FUSE_GDN_GATE=0 turns it off.
+    if (const int n_gdn_gate = ggml_cuda_add_softplus_mul_try_fuse(*cuda_ctx, cgraph, i)) {
+        return n_gdn_gate;
+    }
+
+    // NOTE: RMS_NORM + SCALE is fused upstream now (ggml_cuda_op_rms_norm_scale_fused,
+    // handled by the ggml_cuda_can_fuse matcher below); block 08's older separate
+    // kernel (GGML_CUDA_FUSE_RMS_SCALE) was retired in the r38 re-base.
+
+    if (ggml_cuda_can_fuse(cgraph, i, { GGML_OP_RMS_NORM, GGML_OP_MUL, GGML_OP_ROPE }, {})) {
+        if (const int j = ggml_cuda_qk_pair_k_at(cgraph, i, kv_allow_v); j > 0 && cuda_ctx->qk_pend_graph == nullptr) {
+            cuda_ctx->qk_pend_graph = cgraph;
+            cuda_ctx->qk_pend_i     = i;
+            cuda_ctx->qk_pend_j     = j;
+            return 2;
+        }
+        ggml_cuda_op_rms_norm_mul_rope_fused(*cuda_ctx, node, cgraph->nodes[i + 1], cgraph->nodes[i + 2], nullptr);
+        return 2;
+    }
+
+    if (ggml_cuda_can_fuse(cgraph, i, { GGML_OP_RMS_NORM, GGML_OP_MUL, GGML_OP_ADD }, {})) {
+        ggml_cuda_op_rms_norm_fused_add(*cuda_ctx, node, cgraph->nodes[i + 1], cgraph->nodes[i + 2]);
+        return 2;
+    }
+
+    if (ggml_cuda_can_fuse(cgraph, i, { GGML_OP_RMS_NORM, GGML_OP_MUL }, {})) {
+        ggml_cuda_op_rms_norm_fused(*cuda_ctx, node, cgraph->nodes[i + 1]);
+        return 1;
+    }
+
+    if (ggml_cuda_can_fuse(cgraph, i, { GGML_OP_RMS_NORM, GGML_OP_SCALE }, {})) {
+        // a second RMS_NORM + SCALE over a view of the same tensor with the same shape, strides, eps and scale (the GDN
+        // q / k l2 norm), separated only by no-op nodes: both in one launch.  GGML_CUDA_DISABLE_NORM_PAIR=1: off.
+        static const bool norm_pair_off = getenv("GGML_CUDA_DISABLE_NORM_PAIR") != nullptr && atoi(getenv("GGML_CUDA_DISABLE_NORM_PAIR")) != 0;
+        const ggml_tensor * x0 = node->src[0];
+        int j = i + 2;
+        while (!norm_pair_off && j < cgraph->n_nodes && (cgraph->nodes[j]->op == GGML_OP_VIEW || cgraph->nodes[j]->op == GGML_OP_RESHAPE ||
+                cgraph->nodes[j]->op == GGML_OP_PERMUTE || cgraph->nodes[j]->op == GGML_OP_TRANSPOSE || cgraph->nodes[j]->op == GGML_OP_NONE)) {
+            ++j;
+        }
+        if (!norm_pair_off && j + 1 < cgraph->n_nodes && ggml_cuda_can_fuse(cgraph, j, { GGML_OP_RMS_NORM, GGML_OP_SCALE }, {})) {
+            const ggml_tensor * n1 = cgraph->nodes[j];
+            const ggml_tensor * x1 = n1->src[0];
+            bool same = x0->type == GGML_TYPE_F32 && x1->type == GGML_TYPE_F32 && x0->view_src && x0->view_src == x1->view_src &&
+                        x0->ne[0] < 1024 && memcmp(node->op_params, n1->op_params, sizeof(float)) == 0 &&
+                        memcmp(cgraph->nodes[i + 1]->op_params, cgraph->nodes[j + 1]->op_params, 2 * sizeof(float)) == 0;
+            for (int k = 0; same && k < 4; ++k) {
+                same = x0->ne[k] == x1->ne[k] && x0->nb[k] == x1->nb[k];
+            }
+            // the second pair must not read the first one's output (it reads a view of the shared parent)
+            same = same && x1 != cgraph->nodes[i + 1] && x1->view_src != cgraph->nodes[i + 1];
+            if (same) {
+                ggml_cuda_op_rms_norm_scale_pair_fused(*cuda_ctx, node, cgraph->nodes[i + 1], cgraph->nodes[j], cgraph->nodes[j + 1]);
+                return j + 1 - i;
+            }
+        }
+        ggml_cuda_op_rms_norm_scale_fused(*cuda_ctx, node, cgraph->nodes[i + 1]);
+        return 1;
+    }
+
+    // Fuse the SSM pre-scan chain (owned by mmvq.cu). GGML_CUDA_DISABLE_SSM_PRESCAN=1 turns it off.
+    if (const int n_ssm_prescan = ggml_cuda_ssm_prescan_try_fuse(*cuda_ctx, cgraph, i)) {
+        return n_ssm_prescan;
+    }
+
+    if (ggml_cuda_can_fuse(cgraph, i, { GGML_OP_SSM_CONV, GGML_OP_ADD, GGML_OP_UNARY }, { GGML_UNARY_OP_SILU })) {
+        ggml_cuda_op_ssm_conv(*cuda_ctx, node, cgraph->nodes[i + 1], cgraph->nodes[i + 2]);
+        return 2;
+    }
+
+    if (ggml_cuda_can_fuse(cgraph, i, { GGML_OP_SSM_CONV, GGML_OP_UNARY }, { GGML_UNARY_OP_SILU })) {
+        ggml_cuda_op_ssm_conv(*cuda_ctx, node, /*bias_add_node=*/ nullptr, cgraph->nodes[i + 1]);
+        return 1;
+    }
+
+    // prefill hyper-connection fusions (DEFAULT ON). Bit-exact vs the unfused chain, verified on the
+    // deterministic substrate with a llama_decode harness (pp + 40 greedy steps, logits hashed per
+    // step: fused == unfused bit for bit at 6..1400-token prompts). FIXED 2026-09-06: the comb
+    // matcher unwrapped the block_out REPEAT to its input, whose buffer the allocator had reused
+    // (e.g. for hc_inject) because the standalone REPEAT ran before the fused window - the kernel
+    // then read inject's data as block_out. It now reads the live REPEAT output (mul operand).
+    // Opt-outs: GGML_CUDA_DISABLE_HC_FUSION=1 (all), GGML_CUDA_DISABLE_HC_MIX=1 / GGML_CUDA_DISABLE_HC_COMB=1.
+
+
+    // UNARY(sigmoid) -> MUL -> ADD with a per-row gate (GGML_CUDA_FUSE_SIGMOID_MUL_ADD=0: off): one kernel
+    if (const int n_sig_mul_add = ggml_cuda_sigmoid_mul_add_try_fuse(*cuda_ctx, cgraph, i)) {
+        return n_sig_mul_add;
+    }
+
+    if (ggml_cuda_can_fuse(cgraph, i, { GGML_OP_UNARY, GGML_OP_MUL }, { GGML_UNARY_OP_SILU }) ||
+        ggml_cuda_can_fuse(cgraph, i, { GGML_OP_UNARY, GGML_OP_MUL }, { GGML_UNARY_OP_SIGMOID }) ||
+        ggml_cuda_can_fuse(cgraph, i, { GGML_OP_UNARY, GGML_OP_MUL }, { GGML_UNARY_OP_SOFTPLUS })) {
+        ggml_tensor * mul_node = cgraph->nodes[i + 1];
+
+        // If the product feeds a single decode matmul (directly or via a
+        // no-op reshape), write its Q8_1 quantized value instead of the F32
+        // output; the matmul launcher finds it via the quantize cache.
+        const ggml_tensor * mm = ggml_cuda_find_mul_q8_1_matmul(cgraph, i + 1, mul_node);
+        if (mm != nullptr) {
+            ggml_cuda_op_unary_mul_q8_1(*cuda_ctx, node, mul_node, mm);
+            return cgraph->nodes[i + 2] == mm ? 1 : 2;
+        }
+
+        ggml_cuda_op_unary_mul(*cuda_ctx, node, mul_node);
+        return 1;
+    }
+
+    if (ggml_cuda_can_fuse(cgraph, i, { GGML_OP_UNARY, GGML_OP_SQR }, { GGML_UNARY_OP_RELU })) {
+        ggml_cuda_op_relu_sqr(*cuda_ctx, node, cgraph->nodes[i + 1]);
+        return 1;
+    }
+
+    // DSV4 hyper-connection post: the two scales and the sigmoid in front of the op are folded into it
+    // (upstream's arm; the op itself is `ggml_cuda_op_dsv4_hc_post`, dispatched standalone otherwise).
+    if (ggml_cuda_can_fuse(cgraph, i, { GGML_OP_SCALE, GGML_OP_UNARY, GGML_OP_SCALE, GGML_OP_DSV4_HC_POST }, { GGML_UNARY_OP_SIGMOID })) {
+        ggml_cuda_op_dsv4_hc_post(*cuda_ctx, cgraph->nodes[i + 3], node, cgraph->nodes[i + 2]);
+        return 3;
+    }
+
+    if (ggml_cuda_can_fuse(cgraph, i, { GGML_OP_SCALE, GGML_OP_UNARY, GGML_OP_SCALE }, { GGML_UNARY_OP_TANH })) {
+        ggml_cuda_op_softcap(*cuda_ctx, cgraph->nodes[i + 2], node);
+        return 2;
+    }
+
+    // scale -> silu/sigmoid unary (owned by unary.cu). Opt-out: GGML_CUDA_SCALE_UNARY=0.
+    if (const int n_scale_unary = ggml_cuda_scale_unary_try_fuse(*cuda_ctx, cgraph, i)) {
+        return n_scale_unary;
+    }
+
+    return 0;
+}
diff --git a/ggml/src/ggml-cuda/ggml-cuda-try-fuse.cuh b/ggml/src/ggml-cuda/ggml-cuda-try-fuse.cuh
new file mode 100644
index 000000000..b3f874c08
--- /dev/null
+++ b/ggml/src/ggml-cuda/ggml-cuda-try-fuse.cuh
@@ -0,0 +1,43 @@
+// The delivery's CUDA graph fusion dispatcher (matchers + per-concern try-fuse arms).
+// Split out of ggml-cuda.cu (an upstream hub); declared here, defined in ggml-cuda-try-fuse.cu.
+#pragma once
+
+#include "common.cuh"
+
+int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph * cgraph, int i);
+
+// Upstream #29948's dense fused gate/up/GLU MMQ predicate (defined in ggml-cuda.cu, next to the matcher the
+// graph optimizer uses); the arm itself lives here with the rest of the dispatcher.
+bool ggml_cuda_should_fuse_mul_mat_q(const ggml_tensor * up, const ggml_tensor * gate, const ggml_tensor * glu,
+        const ggml_tensor * up_scale = nullptr, const ggml_tensor * gate_scale = nullptr);
+
+// Also used by the graph optimizer in ggml-cuda.cu.
+bool ggml_cuda_gdn_state_gather_deferrable(const ggml_cgraph * cgraph, int node_idx);
+
+// Cheap prefilter: non-null (the gather's cache root) when the node is a GDN-state-gather candidate.
+// The graph loop uses it so the index below is built only on a graph that actually has candidates.
+const ggml_tensor * ggml_cuda_gdn_gather_candidate(const ggml_cgraph * cgraph, int node_idx);
+
+// One pass over the graph answers ggml_cuda_gdn_state_gather_deferrable for every gather, replacing the
+// per-gather forward walk (O(gathers x nodes): ~48 gathers x ~1900 nodes on a 64-layer GDN decode graph).
+// Conservative relative to the walk -- any disagreement can only drop a deferral, never add one, so the
+// kernel path is unchanged either way.  GGML_CUDA_GDN_GATHER_INDEX=0 selects the walk; =2 runs both and
+// aborts on a different answer.
+struct ggml_cuda_gdn_gather_index {
+    struct gather_info {
+        int  gdn          = -1;    // index of the GATED_DELTA_NET whose state (src[5]) roots at the gather
+        int  n_gdn        = 0;
+        bool other_reader = false; // a non-view node other than that GDN reads the gathered rows
+        int  concat       = -1;    // index of the GDN conv CONCAT whose state (src[0]) roots at the gather
+        int  n_concat     = 0;
+    };
+    std::unordered_map<const ggml_tensor *, gather_info>      gathers; // keyed by the candidate GET_ROWS
+    std::unordered_map<const ggml_tensor *, std::vector<int>> writers; // cache root -> non-view nodes rooted at it
+    bool built = false;
+};
+void ggml_cuda_gdn_gather_index_build(const ggml_cgraph * cgraph, ggml_cuda_gdn_gather_index & idx);
+bool ggml_cuda_gdn_state_gather_deferrable(const ggml_cgraph * cgraph, int node_idx, const ggml_cuda_gdn_gather_index & idx);
+// the conv-state gather of a GDN layer whose direct conv reads the cache row itself (ggml_cuda_gdn_conv_direct)
+bool ggml_cuda_gdn_conv_gather_deferrable(const ggml_cgraph * cgraph, int node_idx, const ggml_cuda_gdn_gather_index & idx);
+struct ggml_cuda_topk_moe_args;
+bool ggml_cuda_topk_moe_fusion(const struct ggml_cgraph * cgraph, int node_idx, struct ggml_cuda_topk_moe_args & args);
diff --git a/ggml/src/ggml-cuda/ggml-cuda-vmm.h b/ggml/src/ggml-cuda/ggml-cuda-vmm.h
index 8005b57b4..7570a3b06 100644
--- a/ggml/src/ggml-cuda/ggml-cuda-vmm.h
+++ b/ggml/src/ggml-cuda/ggml-cuda-vmm.h
@@ -26,6 +26,13 @@ bool   ggml_cuda_slab_configured();
 // Is the slab live on THIS device?  (The gate can be on while a device failed to create one.)  Used to
 // keep the generic OOM path from churning the arena, which cannot help under the slab.
 bool   ggml_cuda_slab_active    (int device);
+// May `[dst, dst+nbytes)` be the destination of a raw cross-device peer copy?  A peer copy into a slab range
+// the driver's grants do not cover FAULTS the GPU instead of returning an error (the grant is best effort:
+// three ~29 GiB slabs leave the peers no free VRAM to build it), and the slab check is process-wide because
+// a copy fails while ANY live slab's grants are incomplete -- even between two fully granted devices.  A
+// destination outside every slab is always fine (plain memory peer copies stage inside the driver).
+// false => stage the copy through pinned host memory.
+bool   ggml_cuda_slab_peer_copy_ok(const void * dst, size_t nbytes);
 // The slab declined because `work estimate + cache floor` does not fit.  The expert cache must then stream
 // the experts from the host instead of building an arena a wide prefill would have to evict wholesale.
 bool   ggml_cuda_slab_cache_unusable(int device);
@@ -77,6 +84,47 @@ void * ggml_cuda_slab_arena_alloc_transient(int device, size_t size);
 // Per-slot capacity of the slab's ring hole (0 when there is none).  The op-offload H2D ring allocates one
 // full-capacity slot so every slot gets a stable VA and the ring never reallocs a slot.
 size_t ggml_cuda_slab_ring_slot_capacity(int device);
+// The ring hole's reserved size (0 when the slab carved none): `llama_context` uses it to skip the
+// narrow -> wide compute-buffer drop when there is no ring to arm.  wip/slab-ring-region (issue #164).
+size_t ggml_cuda_slab_ring_region(int device);
+// wip/slab-transient-absorption (F5, step 0): was the ring hole REQUESTED for this model?  The ring
+// fallback is refused only when it was (an operator can still leave the ring outside the slab with
+// GGML_CUDA_SLAB_RING_MIB=0, which is the pre-slab behaviour).
+bool   ggml_cuda_slab_ring_requested();
+// wip/slab-transient-absorption: the WIDE-PHASE auxiliary region (the FA prefill staging arena's home).
+// Bump-allocates above the live work boundary while the wide view is armed; released with the ring on the
+// prefill -> decode transition.  Returns nullptr when there is no wide view or no room (the caller falls
+// back).  `gen_out` receives the region generation, which the caller must compare against
+// `ggml_cuda_slab_wide_aux_gen` before reusing a cached pointer.
+void * ggml_cuda_slab_wide_aux_alloc(int device, size_t size, size_t * gen_out);
+void   ggml_cuda_slab_wide_aux_free(int device, void * ptr, size_t size);
+
+bool   ggml_cuda_slab_wide_available(int device);
+size_t ggml_cuda_slab_wide_aux_gen(int device);
+// One-line steady-state layout + transient accounting, gated on GGML_CUDA_SLAB_STATS (diagnostic only).
+void   ggml_cuda_slab_log_stats(int device, const char * tag);
+// wip/slab-transient-absorption: physical retained by the VMM workspace pool on this device (diagnostic).
+size_t ggml_cuda_pool_mapped_bytes(int device);
+// Largest single allocation made through `ggml_cuda_device_malloc` AFTER the slab became active, per
+// device: everything it reports is OUTSIDE the slab by construction (scheduler buffers, the Meta
+// all-reduce temp, the q8_1 arena, the pool).  Diagnostic only (GGML_CUDA_SLAB_STATS).
+size_t ggml_cuda_outside_alloc_max_bytes(int device);
+// Largest allocation the same choke point REFUSED after the slab became active (the outside-reserve
+// shortfall signal).  Diagnostic only (GGML_CUDA_SLAB_STATS).
+size_t ggml_cuda_outside_fail_max_bytes(int device);
+// Low-water mark of the free VRAM outside the slab, per device (diagnostic only).
+size_t ggml_cuda_free_min_bytes(int device);
+void   ggml_cuda_free_min_sample(int device, size_t free_b);
+// wip/slab-transient-absorption (step 2b): bytes and block count the workspace pools have currently handed
+// out from the slab's wide band on this device.  The block count is the LEAK TRIPWIRE: it must be 0 at the
+// prefill -> decode drop (a non-zero value means a pool allocation outlived the band, i.e. a retained site
