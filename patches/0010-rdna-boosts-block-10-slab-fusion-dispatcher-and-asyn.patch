+    ggml_backend_dev_t dev = ggml_backend_buft_get_device(ggml_backend_buffer_get_type(tgt->lf_layer_buf.get()));
+    ggml_backend_t reader = lf_backend_for(dev);
+    if (reader == nullptr) {
+        synchronize();
+        return;
+    }
+    tgt->lf_set_consumed_event(reader);
