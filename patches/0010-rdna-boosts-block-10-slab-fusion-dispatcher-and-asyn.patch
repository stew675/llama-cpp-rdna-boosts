+        launch(k);
+    } else {
+        rmr_args<float> k;
+        ggml_cuda_op_rms_norm_mul_rope_fused(ctx, k_norm, k_mul, k_rope, k_set_rows, nullptr, nullptr, v_set_rows, &k);
+        launch(k);
+    }
+}
