+                                       : off + nf2 <= mapped_before ? "taken from the arena (tables evicted)"
+                                                                   : "taken from the arena (tables evicted) "
+                                                                     "plus the VA above the mapped extent mapped",
+                  (double) (ggml_cuda_slab_arena_top(s) - s.boundary) / (1ull << 30));
