+                          (double) host_total / (1024.0 * 1024.0));
+        }
+        return;
+    }
+    const int64_t avail = pool_available_ram_bytes();
+    if (avail <= 0 || host_total <= 0) {
+        g_pool_dio = pool_dio_effective(true);   // no MemAvailable to reason with: keep the memory-tight default (r112)
