+// Commit a pin decided above: map whatever part of [off, off + nf2) has no physical behind it, and cap
+// the arena at `off`.
+//
+// TWO ranges can need a mapping, and only the first used to be handled:
+//   * the whole region lying above `mapped` (the ordinary short-nothing case), and
+//   * the TAIL above `mapped` when the region straddles it -- the shortfall case, where the region is
+//     wider than the spare.  The pre-fix code took the "arena gave it up" branch for a straddle and
+//     mapped nothing at all, so the top of the draft's compute buffer was reserved-but-absent VA and the
+//     first device access past `mapped` was an unrecoverable page fault (TODO #143).
+static void ggml_cuda_slab_narrow2_commit_locked(int device, ggml_cuda_slab & s, size_t bytes) {
+    if (!s.inited || s.narrow2_floor != 0 || bytes == 0) {
+        return;
+    }
+    const size_t nf2 = ggml_cuda_slab_up(bytes, s.chunk);
+    if (nf2 == 0 || nf2 >= s.size) {
+        return;
+    }
+    const size_t off  = s.size - nf2;
+    const size_t want = off + nf2;              // == s.size; the top of the region, always
+    const size_t mapped_before = s.mapped;
+    if (off < mapped_before) {
+        // The arena gave the range up: drop every free run at or above the new top, so a later
+        // `arena_alloc` cannot hand out memory that now belongs to the draft's compute view.
+        for (auto it = s.arena_free.begin(); it != s.arena_free.end(); ) {
+            const size_t lo = it->first;
+            const size_t hi = lo + it->second;
+            if (lo >= off) {
+                it = s.arena_free.erase(it);
+                continue;
+            }
+            if (hi > off) {
+                it->second = off - lo;
+            }
+            ++it;
+        }
+    }
+    if (mapped_before < want) {
+        // [mapped_before, want) is reserved VA with no physical behind it -- either the whole region (the
+        // arena never mapped up there) or its tail above the arena's mapped extent.  Map it, so the VA
+        // the draft's compute buffer occupies is ACTUALLY PRESENT for the whole region.
+        const size_t map_off = mapped_before > off ? mapped_before : off;
+        const size_t map_len = want - map_off;
