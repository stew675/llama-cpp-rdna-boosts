+    GGML_ASSERT(layer.nextn.hnorm       && "MTP block missing nextn.hnorm");
+    GGML_ASSERT(layer.nextn.hc_head_norm && "MTP block missing nextn.hc_head_norm");
+    GGML_ASSERT(layer.hc_attn_norm      && "MTP block missing hc_attn_norm");
