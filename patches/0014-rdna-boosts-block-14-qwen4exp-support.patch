+    const char * env_cache = getenv("GGML_CUDA_QSA_INDEXER_CACHE");
+    derived_enabled = env_cache != nullptr && std::atoi(env_cache) != 0;
+
+    if (mem_idx) {
+        pool_create(model, filter_idx);
