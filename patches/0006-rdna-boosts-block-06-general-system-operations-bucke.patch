+static bool ggml_backend_cpu_weight_is_offloaded(const struct ggml_tensor * w) {
+    if (w == nullptr || w->buffer == nullptr) {
+        return false;
+    }
+    const ggml_backend_buffer_type_t buft = w->buffer->buft;
+    if (buft == nullptr) {
