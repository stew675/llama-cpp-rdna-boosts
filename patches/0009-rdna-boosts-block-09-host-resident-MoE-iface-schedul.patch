+    std::vector<cudaEvent_t>             slot_ev;
+    std::vector<int64_t>                 last;          // per expert, last use
+    int64_t     clock       = 0;
+    int64_t     hits        = 0;
+    int64_t     misses      = 0;
+    int64_t     fills       = 0;
+    int64_t     evictions   = 0;
+    bool        failed      = false;
