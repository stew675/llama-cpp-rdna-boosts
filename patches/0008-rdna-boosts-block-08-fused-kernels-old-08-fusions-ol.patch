+    // MUL_MAT_ID pair (sparse-MoE gate+up): one mm_ids_helper + one dedup-scatter quantize
+    GGML_ASSERT(ne13 == 1);
+    GGML_ASSERT(src1->nb[2] % src1->nb[1] == 0);
