+static __device__ __forceinline__ float ggml_cuda_lf_butterfly_rest(float x) {
+    if constexpr (offset > 0) {
+        x += __shfl_xor_sync(0xffffffff, x, offset, width);
+        return ggml_cuda_lf_butterfly_rest<offset/2, width>(x);
+    } else {
+        return x;
+    }
