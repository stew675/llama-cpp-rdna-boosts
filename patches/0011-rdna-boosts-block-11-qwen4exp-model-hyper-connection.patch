+    GGML_ASSERT(idx->type == GGML_TYPE_I32);
+    GGML_ASSERT(idx->ne[1] == q->ne[1]);   // n_tps
+    GGML_ASSERT(idx->ne[3] == q->ne[3]);   // n_stream
