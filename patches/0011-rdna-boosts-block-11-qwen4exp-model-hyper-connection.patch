+    qsa3_frag_t qf[3][2];
+    {
+        uint16_t * stage = reinterpret_cast<uint16_t *>(&part[0][0][0]) + w * (48 * 32);   // 3 KB per wave, row stride 64 B
+        const _Float16 hs = (_Float16) s.scale;
+#pragma unroll
+        for (int c = 0; c < QSA3_HQ; ++c) {
