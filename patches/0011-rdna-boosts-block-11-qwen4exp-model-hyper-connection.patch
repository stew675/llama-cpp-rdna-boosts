+                    scf[e] += qsa3_h2f(mask[4 * blk_of(b01, b23, j) + cc]);
+                }
+            }
+            float mloc = scf[0];
+#pragma unroll
+            for (int e = 1; e < 8; ++e) { mloc = fmaxf(mloc, scf[e]); }
+            mloc = fmaxf(mloc, __shfl_xor(mloc, 16));
+            const float mnew  = fmaxf(m, mloc);
+            const float alpha = mnew == -INFINITY ? 1.f : exp2f((m - mnew) * QSA3_L2E);
+            float p[8], ls = 0.f;
+#pragma unroll
+            for (int e = 0; e < 8; ++e) { p[e] = mnew == -INFINITY ? 0.f : exp2f((scf[e] - mnew) * QSA3_L2E); ls += p[e]; }
+            ls += __shfl_xor(ls, 16);
+            l = l * alpha + ls;
+            m = mnew;
+            uint16_t ph[16];
+#if defined(RDNA4)
+            // the lane's p[e] is the probability of key 8*hi + e; ph must hold keys 0..15 in order
+            float po[8];
+#pragma unroll
+            for (int e = 0; e < 8; ++e) { po[e] = __shfl_xor(p[e], 16); }
+#pragma unroll
+            for (int e = 0; e < 8; ++e) {
+                ph[e]   = qsa3_f2h(hi ? po[e] : p[e]);
+                ph[8+e] = qsa3_f2h(hi ? p[e] : po[e]);
+            }
+#else
+            uint32_t pp[4], po[4];
+#pragma unroll
+            for (int e2 = 0; e2 < 4; ++e2) {
+                pp[e2] = (uint32_t) qsa3_f2h(p[2*e2]) | ((uint32_t) qsa3_f2h(p[2*e2+1]) << 16);
+                po[e2] = (uint32_t) __shfl_xor((int) pp[e2], 16);
+            }
+#pragma unroll
+            for (int e = 0; e < 8; ++e) {
+                const uint16_t mine  = (e & 1) ? (uint16_t) (pp[e>>1] >> 16) : (uint16_t) (pp[e>>1] & 0xffffu);
+                const uint16_t other = (e & 1) ? (uint16_t) (po[e>>1] >> 16) : (uint16_t) (po[e>>1] & 0xffffu);
+                ph[2*e]   = hi ? other : mine;
+                ph[2*e+1] = hi ? mine  : other;
+            }
+#endif
+            if (hi == 0) {
+                ptile[w][r*2+0] = make_uint4((uint32_t) ph[0] | ((uint32_t) ph[1] << 16), (uint32_t) ph[2] | ((uint32_t) ph[3] << 16),
+                                             (uint32_t) ph[4] | ((uint32_t) ph[5] << 16), (uint32_t) ph[6] | ((uint32_t) ph[7] << 16));
+                ptile[w][r*2+1] = make_uint4((uint32_t) ph[8] | ((uint32_t) ph[9] << 16), (uint32_t) ph[10] | ((uint32_t) ph[11] << 16),
+                                             (uint32_t) ph[12] | ((uint32_t) ph[13] << 16), (uint32_t) ph[14] | ((uint32_t) ph[15] << 16));
+                alpha_s[own_row] = alpha;
+            }
+        }
+        __syncthreads();
+        float al[3];
+#pragma unroll
+        for (int i = 0; i < 3; ++i) { al[i] = alpha_s[16*i + r]; }
+        if (__ballot(al[0] != 1.f || al[1] != 1.f || al[2] != 1.f)) {
+#pragma unroll
+            for (int i = 0; i < 3; ++i)
+#pragma unroll
+                for (int t = 0; t < 2; ++t)
+#pragma unroll
+                    for (int e = 0; e < 8; ++e) { O[i][t][e] *= al[i]; }
+        }
+#pragma unroll
+        for (int i = 0; i < 3; ++i) {
+#if defined(RDNA4)
+            const uint2 * prow = reinterpret_cast<const uint2 *>(&ptile[i][r*2]);
+            const qsa3_frag_t pf = __builtin_bit_cast(qsa3_frag_t, (uint2[2]){prow[hi], prow[hi+2]});
+#else
+            const qsa3_frag_t pf = __builtin_bit_cast(qsa3_frag_t, (uint4[2]){ptile[i][r*2+0], ptile[i][r*2+1]});
+#endif
+#pragma unroll
+            for (int t = 0; t < 2; ++t) { O[i][t] = qsa3_wmma_f16(vf[t], pf, O[i][t]); }
+        }
+        kf[0] = kfn[0]; kf[1] = kfn[1];
+        b01 = nb01; b23 = nb23; m01 = nm01; m23 = nm23;
+    }
+
+    if (w < 3 && hi == 0) { l_s[own_row] = l; }
+    __syncthreads();
+    // output: per tile, stage [16 rows x 32 dims] F32 per wave in LDS (2 KB), then coalesced 16-byte row stores
+    float * ostage = reinterpret_cast<float *>(&part[0][0][0]) + w * (16 * 32);
+#pragma unroll
+    for (int i = 0; i < 3; ++i) {
+        const float li = l_s[16*i + r];
+#pragma unroll
+        for (int t = 0; t < 2; ++t)
+#pragma unroll
+            for (int e = 0; e < 8; ++e) { ostage[r * 32 + 16*t + QSA3_ACC_M(e, hi)] = li > 0.f ? O[i][t][e] / li : 0.f; }
+        __syncthreads();
+#pragma unroll
+        for (int c = 0; c < 4; ++c) {
+            const int rr = 4*c + (lane >> 3), dq = 4 * (lane & 7);
+            const int row = 16*i + rr, qi = row / QSA3_HQ, h = row - QSA3_HQ*qi;
+            const int query = QSA3_G * g + qi;
+            if (query < s.n_q) {
+                float * dst = reinterpret_cast<float *>(reinterpret_cast<char *>(out) + (size_t) query * s.o2 + (size_t) (kvh * s.gqa + h) * s.o1) + 32*w + dq;
+                *reinterpret_cast<float4 *>(dst) = *reinterpret_cast<const float4 *>(ostage + rr * 32 + dq);
+            }
+        }
+        __syncthreads();
+    }
+}
+
+// ------------------------------------------------------------------------------------------------------------
+// host side
+
+// Prefill-only packed-block path.  All preconditions the kernels rely on are checked here; returning
+// false simply leaves the VEC kernel (fattn-qsa.cu) in charge of the same op for the decode/verify
+// band and for anything the packs do not cover.
+bool ggml_cuda_flash_attn_qsa3_supported(int device, const ggml_tensor * dst) {
+    const ggml_tensor * q    = dst->src[0];
+    const ggml_tensor * k    = dst->src[1];
+    const ggml_tensor * v    = dst->src[2];
+    const ggml_tensor * ids  = dst->src[3];
+    const ggml_tensor * mask = dst->src[4];
+    const ggml_tensor * pk   = dst->src[7];
+    const ggml_tensor * pv   = dst->src[8];
+
+    if (!pk || !pv) {                                     // the graph did not build the packs
+        return false;
+    }
+    const int cc = ggml_cuda_info().devices[device].cc;
+    if (!(GGML_CUDA_CC_IS_RDNA3_0(cc) || GGML_CUDA_CC_IS_RDNA3_5(cc) || GGML_CUDA_CC_IS_RDNA4(cc))) {
+        return false;                                     // F16 WMMA: first-gen (gfx11) or _gfx12 builtin
+    }
+    // Policy (issue #59): the packed-block path was tuned on RDNA3_5 (gfx1151) and RDNA4
+    // (gfx1201).  RDNA3_0 (gfx1100) shares the gfx11 WMMA builtin but its qwen4exp prefill was
+    // never measured end-to-end (the campaign's gfx1100 record left it "trust-RDNA3_5"), and on a
+    // 2x RX 7900 XTX box it measured ~13% slower than the VEC path at d64K, so it is OFF there
+    // until it is re-tuned.  GGML_CUDA_QSA3=1 opts back in, =0 disables the path everywhere for
+    // A/B.  The same policy is what makes it safe to skip building the natural F16 K/V packs on
+    // RDNA3_0 (they are two full F16 copies of the cache when this returns false): the model probes
+    // this predicate through qsa3_op_supported() in src/models/qwen4exp.cpp.
+    static const int qsa3_env = []() {
+        const char * e = getenv("GGML_CUDA_QSA3");
+        return e ? atoi(e) : -1;
+    }();
+    if (qsa3_env == 0) {
+        return false;
+    }
+    if (GGML_CUDA_CC_IS_RDNA3_0(cc) && qsa3_env != 1) {
+        return false;
+    }
+    if (q->ne[1] < 128) {                                 // prefill-only: the W=1..8 band keeps the VEC kernel
+        return false;
+    }
+    if (q->ne[3] != 1 || k->ne[3] != 1 || v->ne[3] != 1) {
+        return false;
+    }
+    if (q->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32 || ids->type != GGML_TYPE_I32 || !ggml_is_contiguous(dst)) {
+        return false;
+    }
+    if (q->ne[0] != 256 || k->ne[0] != 256 || v->ne[0] != 256 || q->ne[2] != QSA3_HQ * k->ne[2] || v->ne[2] != k->ne[2]) {
+        return false;                                     // the WMMA tiles and the row map are D=256 / gqa=12
+    }
+    if (k->ne[1] < 4 || k->ne[1] % 4 || v->ne[1] != k->ne[1]) {
+        return false;
+    }
+    if (ids->ne[0] < 1 || ids->ne[0] > 2560 || ids->ne[1] < q->ne[1] || ids->nb[1] % 4 || uintptr_t(ids->data) % 4) {
+        return false;
+    }
+    // src[7]/src[8] are the NATURAL contiguous F16 views [D=256, n_head_kv, n_kv] the launcher packs
+    // into the block layouts itself (session 7 fused pack).  k (src[1]) is the permuted
+    // [D, n_kv, n_head_kv] view, so the natural one swaps its dims 1 and 2.
+    if (pk->type != GGML_TYPE_F16 || !ggml_is_contiguous(pk) || pk->ne[0] != k->ne[0] ||
+        pk->ne[1] != k->ne[2] || pk->ne[2] != k->ne[1] || pk->ne[3] != 1 || uintptr_t(pk->data) % 16) {
+        return false;
+    }
+    if (pv->type != GGML_TYPE_F16 || !ggml_is_contiguous(pv) || pv->ne[0] != k->ne[0] ||
+        pv->ne[1] != k->ne[2] || pv->ne[2] != k->ne[1] || pv->ne[3] != 1 || uintptr_t(pv->data) % 16) {
+        return false;
+    }
+    if (mask) {
+        if (mask->type != GGML_TYPE_F16 || mask->nb[0] != 2 || mask->ne[0] < k->ne[1] || mask->ne[1] < q->ne[1] ||
+            mask->ne[2] != 1 || mask->ne[3] != 1) {
+            return false;
+        }
+    } else if (!dst->src[5] || !dst->src[6]) {
+        return false;                                     // no mask and no derived visibility: the op is malformed
+    }
+    return true;
+}
+
+// wip/slab-transient-absorption: the QSA3 prefill workspace (a few hundred MiB on a deep prefill, and a
+// fixed high-water mark in the workspace pool for the rest of the run) is a WIDE-PHASE transient: the
+// launcher's support check requires q->ne[1] >= 128, so this never runs in a captured decode or verify
+// graph.  Serve it from the slab's wide band so its bytes leave the headroom budget and return to the
+// arena on the prefill -> decode transition; the LIFO stack mirrors the workspace pool's discipline (the
+// seven blocks below are destroyed in reverse declaration order).  Falls back to the pool -- the
+// pre-change behaviour -- when the slab is inactive, the region is full, or a block is larger than the
+// band.
+template <typename T>
+struct qsa3_scratch {
+    ggml_cuda_pool_alloc<T> pool;
+    T *    ptr    = nullptr;
+    size_t n      = 0;
+    int    device = -1;
+    bool   slab   = false;
+
+    qsa3_scratch(ggml_backend_cuda_context & c, size_t n_) : pool(c.pool()), n(n_), device(c.device) {
+        if (n > 0 && ggml_cuda_slab_active(device)) {
+            size_t gen = 0;
+            void * p = ggml_cuda_slab_wide_aux_alloc(device, n * sizeof(T), &gen);
+            if (p != nullptr) {
+                ptr  = (T *) p;
+                slab = true;
+                return;
+            }
+        }
+        if (n > 0) {
+            pool.alloc(n);
+            ptr = pool.get();
+        }
+    }
+    ~qsa3_scratch() {
+        if (slab) {
+            ggml_cuda_slab_wide_aux_free(device, ptr, n * sizeof(T));
+        }
+    }
+    qsa3_scratch(const qsa3_scratch &) = delete;
+    qsa3_scratch & operator=(const qsa3_scratch &) = delete;
+
+    T * get() const { return ptr; }
+};
+
+void ggml_cuda_flash_attn_qsa3(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * q    = dst->src[0];
+    const ggml_tensor * k    = dst->src[1];
+    const ggml_tensor * ids  = dst->src[3];
+    const ggml_tensor * mask = dst->src[4];
+    const ggml_tensor * cell_vis = dst->src[5];
+    const ggml_tensor * q_vis    = dst->src[6];
+    const ggml_tensor * pk   = dst->src[7];   // natural F16 [D, n_head_kv, n_kv]; packed below
+    const ggml_tensor * pv   = dst->src[8];
+
+    float scale;
+    memcpy(&scale, dst->op_params, sizeof(float));
+
+    const int n_q    = (int) q->ne[1];
+    const int ns     = (int) ids->ne[0];
+    const int nk     = (int) k->ne[1];
+    const int nh_kv  = (int) k->ne[2];
+    const int ngroups = (n_q + QSA3_G - 1) / QSA3_G;
+    const int cap     = (QSA3_G * ns + 3) & ~3;
+
+    // Fused pack (session 7): one pass per tensor from the natural [D, n_head_kv, n_kv] F16 view into the
+    // block layouts the attention kernel reads.  Replaces cast+permute+cont+reshape+permute+cont.
+    qsa3_scratch<uint16_t> pk16(ctx, (size_t) 256 * nk * nh_kv);
+    qsa3_scratch<uint16_t> pv16(ctx, (size_t) 256 * nk * nh_kv);
+    {
+        const int q4 = nk >> 2;
+        const int tk = nh_kv * q4 * 64;
+        const int tv = 256 * q4 * nh_kv;
+        if (tk > 0) qsa3_pack_keys_kernel  <<<(tk + 255) / 256, 256, 0, ctx.stream()>>>((const uint16_t *) pk->data, pk16.get(), nh_kv, nk);
+        if (tv > 0) qsa3_pack_values_kernel<<<(tv + 255) / 256, 256, 0, ctx.stream()>>>((const uint16_t *) pv->data, pv16.get(), nh_kv, nk);
+        CUDA_CHECK(cudaGetLastError());
+    }
+
+    qsa3_scratch<uint16_t> ublk(ctx, (size_t) ngroups * cap);
+    qsa3_scratch<uint16_t> umask(ctx, (size_t) ngroups * cap);
+    qsa3_scratch<int>      ucount(ctx, (size_t) ngroups);
+    qsa3_scratch<int>      srow(ctx, (size_t) n_q * ns);
+    qsa3_scratch<int>      sflag(ctx, (size_t) n_q);
+    {
+        // rows-kernel dynamic smem: [ns] keys + the nk-bit presence bitmap + 256 scan offsets.
+        // When that does not fit the 48 KiB budget (a very long cache) the kernel falls back to the
+        // rank sort and only the key array is allocated.
+        const int    bitmap_words = (nk + 31) / 32;
+        const size_t rows_smem_bm = (size_t) ns * sizeof(int) + (size_t) bitmap_words * sizeof(uint32_t) + 256 * sizeof(int);
+        const bool   rows_bitmap  = rows_smem_bm <= 48 * 1024;
+        const size_t rows_smem    = rows_bitmap ? rows_smem_bm : (size_t) ns * sizeof(int);
+        const ggml_cuda_kernel_launch_params launch(dim3(n_q), dim3(256), rows_smem, ctx.stream());
+        ggml_cuda_kernel_launch(qsa3_rows_kernel, launch, (const int *) ids->data, ids->nb[1], ns, nk,
+                                rows_bitmap ? bitmap_words : 0, srow.get(), sflag.get());
+        CUDA_CHECK(cudaGetLastError());
+        const ggml_cuda_kernel_launch_params launch2(dim3(ngroups), dim3(QSA3_MERGE_LANES), (size_t) QSA3_G * ns * sizeof(int), ctx.stream());
+        ggml_cuda_kernel_launch(qsa3_merge_kernel, launch2, (const int *) ids->data, ids->nb[1], n_q, ns, nk,
+                                (const int *) srow.get(), (const int *) sflag.get(),
+                                (mask == nullptr && cell_vis != nullptr) ? (const int *) cell_vis->data : nullptr,
+                                (mask == nullptr && q_vis    != nullptr) ? (const int *) q_vis->data    : nullptr,
+                                ublk.get(), umask.get(), ucount.get(), cap);
+        CUDA_CHECK(cudaGetLastError());
+    }
+
+    qsa3_layout layout{q->nb[1], q->nb[2], dst->nb[1], dst->nb[2], mask ? mask->nb[1] : 0, nk, n_q, QSA3_HQ, cap, scale};
+    const ggml_cuda_kernel_launch_params launch(dim3(ngroups, k->ne[2]), dim3(256), 0, ctx.stream());
+    ggml_cuda_kernel_launch(qsa3_attn_kernel, launch,
+            (const float    *) q->data,
+            (const uint16_t *) pk16.get(),
+            (const uint16_t *) pv16.get(),
+            mask     ? (const uint16_t *) mask->data     : nullptr,
+            (const uint16_t *) ublk.get(),
+            (const uint16_t *) umask.get(),
+            (const int      *) ucount.get(),
+            (float          *) dst->data, layout);
+    CUDA_CHECK(cudaGetLastError());
+}
