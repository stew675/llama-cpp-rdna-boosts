+uint32_t llama_kv_cache::graph_extra_entries() const {
+    // per rotated tensor: two `llama_mul_mat_hadamard` chains (the rows going into the cache and the
+    // attention result coming out; 3 nodes each - cont/reshape + mul_mat + reshape) plus its rotation
+    // constant as a graph leaf, see build_attn() and init_rotation().
+    if (n_rot_k == 0 && n_rot_v == 0) {
+        return 0;
+    }
+
+    uint32_t res = 0;
+    for (const auto & layer : layers) {
+        res += layer.k_rot ? 7 : 0;
+        res += layer.v_rot ? 7 : 0;
+    }
+
+    return res;
+}
