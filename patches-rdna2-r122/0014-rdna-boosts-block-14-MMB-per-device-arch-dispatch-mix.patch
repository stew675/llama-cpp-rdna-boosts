 ggml/src/ggml-cuda/mmb.cu |   52 +++++++++++++++++++++++++++++----------------
 1 file changed, 34 insertions(+), 18 deletions(-)

diff --git a/ggml/src/ggml-cuda/mmb.cu b/ggml/src/ggml-cuda/mmb.cu
index d788cbb71..ab96c8158 100644
--- a/ggml/src/ggml-cuda/mmb.cu
+++ b/ggml/src/ggml-cuda/mmb.cu
@@ -1,3 +1,4 @@
+#include "common.cuh"
 #include "mmb.cuh"
 #include "unary.cuh"
 #include <unordered_map>
@@ -1570,7 +1571,20 @@ static mmb_arch_cfg mmb_arch_defaults(const int cc) {
 }
 
 static const mmb_arch_cfg & mmb_cfg() {
-    static const mmb_arch_cfg c = mmb_arch_defaults(ggml_cuda_info().devices[0].cc);
+    /* r121: key the per-arch config to the cc of the device the kernel runs on, not the
+       primary: a mixed-arch setup froze the devices[0] config for every device, so a gfx1030
+       secondary behind a gfx1100 primary ran RDNA3-tuned MMB kernels on RDNA2 (no WMMA) and
+       zeroed its output projection logits (PPL = vocab). */
+    const int cc = ggml_cuda_info().devices[ggml_cuda_get_device()].cc;
+    if (GGML_CUDA_CC_IS_RDNA4(cc)) {
+        static const mmb_arch_cfg c = mmb_arch_defaults(cc);
+        return c;
+    }
+    if (GGML_CUDA_CC_IS_RDNA3_0(cc)) {
+        static const mmb_arch_cfg c = mmb_arch_defaults(cc);
+        return c;
+    }
+    static const mmb_arch_cfg c = mmb_arch_defaults(cc);
     return c;
 }
 
