@@ -2454,11 +2464,13 @@ void ggml_cuda_op_ssm_conv_l2_gatebeta(
     const size_t ts_src1 = ggml_type_size(src1->type);
 
     // Quantize src1 to Q8_1 once per graph; reuse the same buffer as the other
-    // matmuls over this input.
+    // matmuls over this input.  The cache identity is the root's data pointer, but the
+    // buffer is filled from this tensor's pointer, so only offset-free views may take
