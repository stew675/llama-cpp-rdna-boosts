@@ -2619,10 +2634,12 @@ void ggml_cuda_op_shexp_down_gate(
     cudaStream_t stream = ctx.stream();
     const size_t ts_src1 = ggml_type_size(swiglu->type);
 
-    // Quantize the swiglu to Q8_1 once per graph.
+    // Quantize the swiglu to Q8_1 once per graph.  The cache identity is the root's data
+    // pointer, but the buffer is filled from this tensor's pointer, so only offset-free
