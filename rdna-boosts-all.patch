+            alpha_w->type != GGML_TYPE_F32 || beta_w->type != GGML_TYPE_F32 || bias->type != GGML_TYPE_F32 ||
+            softplus->type != GGML_TYPE_F32 || gate_mul->type != GGML_TYPE_F32 ||
