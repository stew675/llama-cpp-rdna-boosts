+    } else if (gw->type == GGML_TYPE_MXFP4) {
+        mmb_routed_glu_kernel<64, 128, 32, 32, 14><<<gbig,   MMB_NT, 0, stream>>>(Wg, Wu, eb, xhp, D, Dh, store_f32, ids_src, ids_dst, bounds, desc_big,   M, K);
