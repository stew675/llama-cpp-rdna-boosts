+    for (const auto * o = tensor_buft_overrides; o->pattern != nullptr; ++o) {
+        if (o->buft != ggml_backend_cpu_buffer_type()) {
+            continue;
+        }
+        std::regex pattern(o->pattern);
+        if (std::regex_search(tensor_name, pattern)) {
+            return true;
+        }
+    }
+    return false;
