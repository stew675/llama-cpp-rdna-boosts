+    const float    bv  = __shfl_sync(0xffffffff, v, src, QK4_NL);
+    const float vmax = at ? bv : 0.0f;
+    const float d0 = vmax / kvalues_iq4nl[0];
+    const float id = d0 ? 1.0f/d0 : 0.0f;
