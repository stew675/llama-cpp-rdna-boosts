+
+    const int row  = (sequence*int(ne01.z) + col)*ne02 + head;
+    const int k0   = slice*n_slice_cells;
+    const int k1   = min(ne40, k0 + n_slice_cells);
+
+    // Per-warp tile exp weights, staged in shared.  Indexed by the local
