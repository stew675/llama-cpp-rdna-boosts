+    const int warp_size = ggml_cuda_info().devices[ctx.device].warp_size;
+    const int64_t nr    = wa->ne[1];
+    if (!dt || !ssm_a || wa->type != GGML_TYPE_BF16 || wb->type != GGML_TYPE_BF16 || y->type != GGML_TYPE_F32 ||
