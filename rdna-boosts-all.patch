+        if (qsa3) {
+            ggml_tensor * k16 = ggml_cont(ctx, ggml_permute(ctx, ggml_cast(ctx, ggml_cast(ctx, k, GGML_TYPE_F32), GGML_TYPE_F16), 0, 2, 1, 3));
