+    int64_t tail_from = T + H; int first_tap = -1, ntaps = 0; const ggml_tensor * wroot = nullptr; const ggml_tensor * chain = nullptr; int silu = -1;
+    const ggml_tensor * tap_out[4] = {nullptr,nullptr,nullptr,nullptr};
