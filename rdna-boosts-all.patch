+// Multi-sequence regression test for the GDN gate/beta decode fusions (issue #204).
+//
+// The GPU gate/beta fusions (GGML_CUDA_FUSE_GATE_BETA_BF16, mmvf.cu, and its Q8_0 sibling
+// GGML_CUDA_FUSE_GATE_BETA_VERIFY, mmvq.cu) replace the unfused chain
+//
+//     alpha = MUL_MAT(alpha_w, y);  a3 = RESHAPE3D(alpha, nr, T, S);  bias = a3 + dt;
+//     sp = SOFTPLUS(bias);  gate = sp * ssm_a;  gate4 = RESHAPE4D(gate, 1, nr, T, S)
+//     beta = MUL_MAT(beta_w, y);    beta4 = RESHAPE4D(beta, 1, nr, T, S)
+//
+// with one mmvf/mmvq launch that writes the alpha rows (through the gate chain) and the beta rows.
+// The launch derives its geometry from the dst tensor, so it is only correct if the shapes it is
+// given describe the *flat* projection: y is [k, n_tokens] with n_tokens = T*S (one channel), the
+// gate MUL is [nr, T, S].  Passing the gate MUL as dst (as the r102..r107 code did) gave the launch
+// n_seq_tokens columns and n_seqs channels, so every channel past the first was computed from y's
+// first n_seq_tokens columns - i.e. every sequence but the first silently took sequence 0's
+// alpha/beta gates.  Single-sequence decode/verify was unaffected, which is why the same-seed text
+// and MTP gates never saw it.
+//
+// What this test checks, per (T, S) shape, with no model and no ubatch scheduler involved:
+//
+//   1. the fused chain and the unfused chain produce bit-identical gate and beta values
+//      (the unfused arm is the same graph plus one extra consumer of the ADD output, which makes
+//      ggml_can_fuse_subgraph reject the window - the intermediate is used outside it - so the two
+//      arms differ *only* in whether the fusion fires);
+//   2. the fusion really did fire in the fused arm: the fused launch skips the ADD/UNARY/MUL
+//      nodes, so the softplus output is never written.  It is pre-filled with NaN and must still
+//      be NaN afterwards.  Without this check a regression that made the fusion silently stop
+//      matching would make the test pass vacuously.
+//
+// At least one shape in the matrix must fire on the running device, otherwise the test fails
+// ("nothing exercised the fusion"): the fusions are band-limited (BF16: n_tokens <= 3 on a device
+// with bf16 MMA where MMF is applicable, <= 8 otherwise), so on some devices only the small shapes
+// fire.  (T, S) = (1, 2) and (1, 3) are the multi-sequence shapes that regressed in #204.
+//
+// usage: test-fusion-gate-beta-multiseq [device-index]
+// exit:  0 all cases bit-identical and at least one fused; 2 otherwise; 0 with a SKIP line when
+//        the build has no CUDA/ROCm/MUSA backend device (the fusions do not exist elsewhere).
+//
+// The sibling Q8_0 fusion (GGML_CUDA_FUSE_GATE_BETA_VERIFY) is covered through its own switch; the
+// gate/beta arms in gdn-conv.* / unary.* are unaffected by the dst-shape rule (they write their own
+// outputs) and are covered by the same-seed text gates.
+
+#include "ggml.h"
+#include "ggml-alloc.h"
+#include "ggml-backend.h"
+
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+#include <string>
+#include <vector>
+
+static bool is_cuda_family(const char * name) {
+    return strncmp(name, "CUDA", 4) == 0 || strncmp(name, "ROCm", 4) == 0 || strncmp(name, "MUSA", 4) == 0;
+}
+
+struct case_t {
+    int64_t T;   // n_seq_tokens
+    int64_t S;   // n_seqs
+};
+
+struct graph_t {
+    ggml_context * ctx = nullptr;
+    ggml_cgraph  * gf  = nullptr;
+    ggml_tensor  * gate    = nullptr;   // [nr, T, S]  -- what the fused launch writes
+    ggml_tensor  * beta    = nullptr;   // [nr, T*S]   -- what the fused launch's beta rows write
+    ggml_tensor  * bias    = nullptr;
+    ggml_tensor  * softplus= nullptr;   // fused arm: never written
+    ggml_tensor  * alpha_w = nullptr;
+    ggml_tensor  * beta_w  = nullptr;
+    ggml_tensor  * y       = nullptr;
+    ggml_tensor  * dt = nullptr;
+    ggml_tensor  * ssm_a   = nullptr;
+};
+
+// build the chain; `unfused` adds one extra consumer of the ADD output, which makes the fusion
+// window ineligible (the intermediate would be read outside the window) while leaving the
+// arithmetic identical.
+static graph_t build_graph(int64_t nr, int64_t k, int64_t T, int64_t S, bool unfused, ggml_type wtype) {
+    graph_t g;
+    // no_alloc: the tensors are allocated below, into one backend buffer
+ggml_init_params ip = { /*.mem_size =*/ 16 * 1024 * 1024, /*.mem_buffer =*/ nullptr, /*.no_alloc =*/ true };
+    g.ctx = ggml_init(ip);
+    if (!g.ctx) { fprintf(stderr, "ggml_init failed\n"); exit(1); }
+
+    g.alpha_w = ggml_new_tensor_2d(g.ctx, wtype, k, nr);
+    g.beta_w  = ggml_new_tensor_2d(g.ctx, wtype, k, nr);
+    g.y       = ggml_new_tensor_2d(g.ctx, GGML_TYPE_F32,  k, T * S);
+    g.ssm_a   = ggml_new_tensor_1d(g.ctx, GGML_TYPE_F32,  nr);
+
+    g.dt = ggml_new_tensor_1d(g.ctx, GGML_TYPE_F32, nr);
+
+    ggml_tensor * alpha   = ggml_mul_mat(g.ctx, g.alpha_w, g.y);        // [nr, T*S]
+    ggml_tensor * alpha3  = ggml_reshape_3d(g.ctx, alpha, nr, T, S);
+    ggml_tensor * bias    = ggml_add(g.ctx, alpha3, g.dt);
+    g.bias = bias;
+    g.softplus            = ggml_softplus(g.ctx, bias);
+    g.gate                = ggml_mul(g.ctx, g.softplus, g.ssm_a);       // [nr, T, S]
+    ggml_tensor * gate4   = ggml_reshape_4d(g.ctx, g.gate, 1, nr, T, S);
+    g.beta                = ggml_mul_mat(g.ctx, g.beta_w, g.y);         // [nr, T*S]
+    ggml_tensor * beta4   = ggml_reshape_4d(g.ctx, g.beta, 1, nr, T, S);
+
+    g.gf = ggml_new_graph(g.ctx);
+    // this order is what the matcher sees: alpha chain, then the beta projection (the real graphs
+    // create beta first but the executed order is the dependency order below)
+    ggml_build_forward_expand(g.gf, gate4);
+    ggml_build_forward_expand(g.gf, beta4);
+    if (unfused) {
+        // one extra consumer of the ADD output, outside the fusion window: subgraph_uses (1) no
+        // longer matches the graph-wide use count (2), so the matcher declines and the plain
+        // chain runs
+        ggml_build_forward_expand(g.gf, ggml_sum(g.ctx, bias));
+    }
+
+    return g;
+}
+
+struct result_t {
+    bool            fused = false;
+    std::vector<float> gate;
+    std::vector<float> beta;
+};
+
+static result_t run_graph(graph_t & g, ggml_backend_t backend,
+                          const void * wa, size_t wa_bytes,
+                          const void * wb, size_t wb_bytes,
+                          const std::vector<float> & y,
+                          const std::vector<float> & dt,
+                          const std::vector<float> & ssm_a) {
+    ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors(g.ctx, backend);
+    if (!buf) { fprintf(stderr, "alloc_ctx_tensors failed\n"); exit(1); }
+
+    ggml_backend_tensor_set(g.alpha_w, wa, 0, wa_bytes);
+    ggml_backend_tensor_set(g.beta_w,  wb, 0, wb_bytes);
+    ggml_backend_tensor_set(g.y,       y.data(),  0, y.size()  * sizeof(float));
+    ggml_backend_tensor_set(g.ssm_a, ssm_a.data(), 0, ssm_a.size() * sizeof(float));
+    ggml_backend_tensor_set(g.dt, dt.data(), 0, dt.size() * sizeof(float));
+
+    // NaN sentinel: the fused launch skips ADD/UNARY/MUL, so softplus stays untouched
+    {
+        std::vector<float> nan(ggml_nelements(g.softplus), NAN);
+        ggml_backend_tensor_set(g.bias,     nan.data(), 0, nan.size() * sizeof(float));
+        ggml_backend_tensor_set(g.softplus, nan.data(), 0, nan.size() * sizeof(float));
+    }
+
+    if (ggml_backend_graph_compute(backend, g.gf) != GGML_STATUS_SUCCESS) {
+        fprintf(stderr, "graph compute failed\n");
+        exit(1);
+    }
+
+    result_t r;
+    std::vector<float> sp(ggml_nelements(g.softplus));
+    std::vector<float> bi(ggml_nelements(g.bias));
+    ggml_backend_tensor_get(g.softplus, sp.data(), 0, sp.size() * sizeof(float));
+    ggml_backend_tensor_get(g.bias,     bi.data(), 0, bi.size() * sizeof(float));
+    r.fused = true;
+    for (float v : sp) {
+        if (!std::isnan(v)) { r.fused = false; break; }
+    }
+
+    r.gate.resize(ggml_nelements(g.gate));
+    r.beta.resize(ggml_nelements(g.beta));
+    ggml_backend_tensor_get(g.gate, r.gate.data(), 0, r.gate.size() * sizeof(float));
+    ggml_backend_tensor_get(g.beta, r.beta.data(), 0, r.beta.size() * sizeof(float));
+
+    ggml_backend_buffer_free(buf);
+    return r;
+}
+
+int main(int argc, char ** argv) {
+    const int want_dev = argc > 1 ? atoi(argv[1]) : -1;
+
+    ggml_backend_load_all();
+
+    ggml_backend_dev_t dev = nullptr;
+    for (size_t i = 0; i < ggml_backend_dev_count(); ++i) {
+        ggml_backend_dev_t d = ggml_backend_dev_get(i);
+        if (ggml_backend_dev_type(d) != GGML_BACKEND_DEVICE_TYPE_GPU) { continue; }
+        if (!is_cuda_family(ggml_backend_dev_name(d))) { continue; }
+        if (want_dev >= 0 && (int) i != want_dev)      { continue; }
+        dev = d;
+        break;
+    }
+    if (!dev) {
+        printf("SKIP: no CUDA/ROCm/MUSA backend device (the gate/beta fusions only exist there)\n");
+        return 0;
+    }
+    const char * dev_name = ggml_backend_dev_name(dev);
+    printf("device: %s\n", dev_name);
+
+    ggml_backend_t backend = ggml_backend_dev_init(dev, nullptr);
+    if (!backend) { fprintf(stderr, "backend init failed\n"); return 1; }
+
+    const int64_t nr = 48;      // n_v_heads, as in the GDN models the fusion fires on
+    const case_t cases[] = {
+        { 1, 1 }, { 2, 1 }, { 3, 1 }, { 4, 1 },
+        { 1, 2 }, { 1, 3 }, { 1, 4 },            // the multi-sequence shapes (#204)
+        { 2, 2 }, { 3, 2 }, { 2, 3 }, { 2, 4 },
+    };
+
+    std::mt19937 gen(42);
+    std::normal_distribution<float> dis(0.0f, 0.1f);
+
+    std::vector<float> ssm_a(nr);
+    for (int64_t i = 0; i < nr; ++i) {
+        ssm_a[i] = -fabsf(dis(gen));   // -A_log.exp(), negative as in the models
+    }
+
+    int n_fired = 0;
+    int n_failed = 0;
+    int n_shapes = 0;
+
+    // both siblings: GGML_TYPE_BF16 is the mmvf (GGML_CUDA_FUSE_GATE_BETA_BF16) epilogue and GGML_TYPE_Q8_0
+    // the mmvq one (GGML_CUDA_FUSE_GATE_BETA_VERIFY).  The quantized one is what every delivered GDN model
+    // actually runs (blk.N.ssm_alpha/beta.weight are Q8_0 in the qwen3.5/3.6/3.8 GGUFs), and k = 5120 is
+    // that model's contraction length.
+    const struct { ggml_type type; int64_t k; } wt[] = {
+        { GGML_TYPE_BF16, 1024 },
+        { GGML_TYPE_Q8_0, 1024 },
+        { GGML_TYPE_Q8_0, 5120 },
+    };
+
+    for (const auto & w : wt) {
+        const int64_t k = w.k;
+        std::vector<float> wa_f32(nr * k), wb_f32(nr * k);
+        for (int64_t i = 0; i < nr * k; ++i) {
+            wa_f32[i] = dis(gen);
+            wb_f32[i] = dis(gen);
+        }
+        // the weight blob the backend is given: BF16 rows, or the quantized block layout for Q8_0
+        std::vector<char> wa_buf(ggml_row_size(w.type, k) * nr);
+        std::vector<char> wb_buf(wa_buf.size());
+        if (w.type == GGML_TYPE_BF16) {
+            for (int64_t i = 0; i < nr * k; ++i) {
+                ((ggml_bf16_t *) wa_buf.data())[i] = ggml_fp32_to_bf16(wa_f32[i]);
+                ((ggml_bf16_t *) wb_buf.data())[i] = ggml_fp32_to_bf16(wb_f32[i]);
+            }
+        } else {
+            ggml_quantize_chunk(w.type, wa_f32.data(), wa_buf.data(), 0, nr, k, nullptr);
+            ggml_quantize_chunk(w.type, wb_f32.data(), wb_buf.data(), 0, nr, k, nullptr);
+        }
+
+        for (const case_t & c : cases) {
+            std::vector<float> y(k * c.T * c.S);
+            std::vector<float> dt(nr);
+            for (auto & v : y)  { v = dis(gen); }
+            for (auto & v : dt) { v = dis(gen); }
+
+            graph_t ga = build_graph(nr, k, c.T, c.S, /*unfused =*/ false, w.type);
+            graph_t gb = build_graph(nr, k, c.T, c.S, /*unfused =*/ true,  w.type);
+
+            const result_t a = run_graph(ga, backend, wa_buf.data(), wa_buf.size(), wb_buf.data(), wb_buf.size(), y, dt, ssm_a);
+            const result_t b = run_graph(gb, backend, wa_buf.data(), wa_buf.size(), wb_buf.data(), wb_buf.size(), y, dt, ssm_a);
+
+            double max_diff = 0.0;
+            size_t n_bad = 0;
+            auto compare = [&](const std::vector<float> & x, const std::vector<float> & z) {
+                for (size_t i = 0; i < x.size(); ++i) {
+                    if (memcmp(&x[i], &z[i], sizeof(float)) != 0) {
+                        ++n_bad;
+                        max_diff = std::max(max_diff, (double) fabsf(x[i] - z[i]));
+                    }
+                }
+            };
+            compare(a.gate, b.gate);
+            compare(a.beta, b.beta);
+
+            // at n_tokens == 1 the ADD->SOFTPLUS->MUL chain also has its own fold (GGML_CUDA_FUSE_GDN_GATE,
+            // unary.cu), which skips the softplus node as well, so the sentinel cannot tell the two apart
+            // there and the reference arm is not guaranteed to be unfused.  From n_tokens >= 2 that fold is
+            // out of band and "softplus untouched" is specific to the gate/beta fusion.
+            const bool strict_ref = c.T * c.S > 1;
+            const bool ok = (n_bad == 0) && (!strict_ref || !b.fused);
+            if (!ok) { ++n_failed; }
+            if (a.fused) { ++n_fired; }
+            ++n_shapes;
+
+            printf("type=%s nr=%2lld k=%4lld T=%lld S=%lld  fused=%s  reference_fused=%s  "
+                   "maxdiff=%.9g  mismatches=%zu  %s\n",
+                   ggml_type_name(w.type), (long long) nr, (long long) k, (long long) c.T, (long long) c.S,
+                   a.fused ? "yes" : "no ", b.fused ? "YES" : "no ", max_diff, n_bad,
+                   ok ? "OK" : "FAIL");
+
+            ggml_free(ga.ctx);
+            ggml_free(gb.ctx);
+        }
+    }
+
+    ggml_backend_free(backend);
+
+    printf("\n%d/%d shapes fused; %d failed\n", n_fired, n_shapes, n_failed);
+    if (n_fired == 0) {
+        printf("FAIL: no shape exercised the fusion - the test verified nothing on %s\n", dev_name);
+        return 2;
+    }
+    if (n_failed != 0) {
+        printf("FAIL: the fused chain does not match the unfused chain (issue #204 class)\n");
+        return 2;
+    }
+    printf("PASS\n");
+    return 0;
+}
diff --git a/tests/test-lazy-reader.cpp b/tests/test-lazy-reader.cpp
new file mode 100644
index 000000000..f4fd3f599
--- /dev/null
+++ b/tests/test-lazy-reader.cpp
@@ -0,0 +1,264 @@
+#include "../src/llama-lazy-reader.h"
+
+#include "ggml.h"
+
+#include <cinttypes>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <stdexcept>
+#include <string>
+#include <thread>
+#include <vector>
+
+#if defined(__unix__) || defined(__APPLE__) || defined(__FreeBSD__) || defined(__OpenBSD__) || defined(__NetBSD__) || defined(__HAIKU__)
+#define TEST_HAS_POSIX 1
+#include <fcntl.h>
+#include <unistd.h>
+#else
+#define TEST_HAS_POSIX 0
+#endif
+
+// ---------------------------------------------------------------------------
+// tiny Q8_0 implementation (block = fp16 scale + 32 x int8), matching
+// ggml's quantize_row_q8_0_ref / dequantize_row_q8_0 byte for byte
+// ---------------------------------------------------------------------------
+
+struct block_q8_0_t {
+    ggml_fp16_t d;
+    int8_t      qs[32];
+};
+
+static void test_quantize_row_q8_0(const float * x, block_q8_0_t * y, int64_t k) {
+    GGML_ASSERT(k % 32 == 0);
+    for (int64_t i = 0; i < k / 32; i++) {
+        float amax = 0.0f;
+        for (int j = 0; j < 32; j++) {
+            amax = std::max(amax, std::fabs(x[i*32 + j]));
+        }
+        const float d = amax / 127.0f;
+        const float id = d ? 1.0f/d : 0.0f;
+        y[i].d = ggml_fp32_to_fp16(d);
+        for (int j = 0; j < 32; j++) {
+            y[i].qs[j] = (int8_t) std::round(x[i*32 + j] * id);
+        }
+    }
+}
+
+static void test_dequantize_row_q8_0(const block_q8_0_t * x, float * y, int64_t k) {
+    GGML_ASSERT(k % 32 == 0);
+    for (int64_t i = 0; i < k / 32; i++) {
+        const float d = ggml_fp16_to_fp32(x[i].d);
+        for (int j = 0; j < 32; j++) {
+            y[i*32 + j] = x[i].qs[j] * d;
+        }
+    }
+}
+
+static void test_assert(bool cond, const char * msg) {
+    if (!cond) {
+        throw std::runtime_error(std::string("assertion failed: ") + msg);
+    }
+}
+
+// row i element d: deterministic function of both, keeps Q8_0 lossy but stable
+static float test_row_value(uint64_t row, int64_t d) {
+    return 1.0f + 0.5f * std::sin(double(row) * 0.37 + double(d) * 0.11) +
+                 0.2f * std::cos(double(row) * 0.13 - double(d) * 0.07);
+}
+
+#if TEST_HAS_POSIX
+
+static int test_make_file(uint64_t n_rows, int64_t row_nelems, std::vector<uint8_t> & data) {
+    const size_t row_bytes = (size_t) row_nelems * ggml_type_size(GGML_TYPE_Q8_0) / ggml_blck_size(GGML_TYPE_Q8_0);
+    data.resize((size_t) n_rows * row_bytes);
+    std::vector<float> row(row_nelems);
+    std::vector<block_q8_0_t> blocks(row_nelems / 32);
+    for (uint64_t i = 0; i < n_rows; i++) {
+        for (int64_t d = 0; d < row_nelems; d++) {
+            row[d] = test_row_value(i, d);
+        }
+        test_quantize_row_q8_0(row.data(), blocks.data(), row_nelems);
+        std::memcpy(data.data() + (size_t) i * row_bytes, blocks.data(), row_bytes);
+    }
+
+    char path[] = "/tmp/test-lazy-reader-XXXXXX";
+    const int fd = mkstemp(path);
+    test_assert(fd >= 0, "mkstemp failed");
+    unlink(path); // removed on close
+    size_t off = 0;
+    while (off < data.size()) {
+        const ssize_t w = write(fd, data.data() + off, data.size() - off);
+        test_assert(w > 0, "write failed");
+        off += (size_t) w;
+    }
+    return fd;
+}
+
+static void test_check_gather(llama_lazy_reader & reader, const std::vector<uint8_t> & data,
+        const std::vector<int32_t> & rows, int64_t row_nelems) {
+    const size_t row_bytes = (size_t) row_nelems * ggml_type_size(GGML_TYPE_Q8_0) / ggml_blck_size(GGML_TYPE_Q8_0);
+    std::vector<float> got(rows.size() * (size_t) row_nelems);
+    std::vector<float> ref(rows.size() * (size_t) row_nelems);
+    reader.gather(rows.data(), rows.size(), got.data());
+    for (size_t j = 0; j < rows.size(); j++) {
+        test_dequantize_row_q8_0((const block_q8_0_t *) (data.data() + (size_t) rows[j] * row_bytes),
+                ref.data() + j * row_nelems, row_nelems);
+    }
+    test_assert(std::memcmp(got.data(), ref.data(), got.size() * sizeof(float)) == 0, "gather != reference decode");
+}
+
+int main() {
+    try {
+        const uint64_t n_rows = 10000;
+        const int64_t  row_nelems = 160; // Q8_0: 170 B/row, 24 rows/page
+        const size_t   row_bytes = (size_t) row_nelems * ggml_type_size(GGML_TYPE_Q8_0) / ggml_blck_size(GGML_TYPE_Q8_0);
+        const size_t   rows_per_page = 4096 / row_bytes;
+        const size_t   n_pages = (size_t) ((n_rows + rows_per_page - 1) / rows_per_page);
+        test_assert(row_bytes == 170, "row size");
+        test_assert(rows_per_page == 24, "rows per page");
+        test_assert(n_pages == 417, "page count");
+
+        std::vector<uint8_t> data;
+        int fd = test_make_file(n_rows, row_nelems, data);
+
+        // case 1: correctness -- page interior, page boundaries, final partial
+        // page, repeated rows in one call. Budget covers the whole table.
+        {
+            llama_lazy_reader reader(llama_lazy_reader::config{
+                dup(fd), 0, row_bytes, n_rows, GGML_TYPE_Q8_0, row_nelems,
+                /*budget*/ (n_pages + 1) * 4096});
+            test_assert(reader.n_pages_total() == n_pages, "n_pages_total");
+
+            const std::vector<int32_t> rows = {
+                0, 1, 23, 24, 25, 47, 48, /* page interiors */ 5,
+                9999,                      // last row (partial page)
+                9984,                      // first row of the last page
+                23, 24, 5,                 // repeats
+            };
+            test_check_gather(reader, data, rows, row_nelems);
+
+            // one pass over the whole table, then a second that must hit
+            std::vector<int32_t> all(n_rows);
+            for (uint64_t i = 0; i < n_rows; i++) {
+                all[i] = (int32_t) i;
+            }
+            test_check_gather(reader, data, all, row_nelems);
+            test_check_gather(reader, data, all, row_nelems);
+
+            test_assert(reader.misses() == n_pages, "one miss per page on cold table");
+            // gather 1 faulted pages {0,1,2,416} (4 hits on the first sweep), the
+            // second sweep hit all 417
+            test_assert(reader.hits() == n_pages + 4, "all hits on warm table");
+            test_assert(reader.bytes_read() == (size_t) n_rows * row_bytes,
+                    "bytes read == table size (partial page clamped)");
+        }
+
+        // case 2: eviction -- budget below the working set; sweep a sliding
+        // window repeatedly and verify every row still decodes correctly
+        {
+            llama_lazy_reader reader(llama_lazy_reader::config{
+                dup(fd), 0, row_bytes, n_rows, GGML_TYPE_Q8_0, row_nelems,
+                /*budget*/ 8 * 4096});
+            std::vector<int32_t> win(rows_per_page * 4); // 4 pages per sweep
+            for (uint64_t page0 = 0; page0 + 4 <= n_pages; page0 += 3) {
+                for (size_t k = 0; k < win.size(); k++) {
+                    win[k] = (int32_t) ((page0 + k / rows_per_page) * rows_per_page + k % rows_per_page);
+                }
+                test_check_gather(reader, data, win, row_nelems);
+            }
+            // verify a spread of rows again after the sweeps (re-faults)
+            std::vector<int32_t> spread;
+            for (uint64_t i = 0; i < n_rows; i += 97) {
+                spread.push_back((int32_t) i);
+            }
+            spread.push_back((int32_t) (n_rows - 1));
+            test_check_gather(reader, data, spread, row_nelems);
+            test_assert(reader.misses() > 0 && reader.hits() > 0, "eviction exercised both paths");
+        }
+
+        // case 3: budget below one page clamps to a single slot
+        {
+            llama_lazy_reader reader(llama_lazy_reader::config{
+                dup(fd), 0, row_bytes, n_rows, GGML_TYPE_Q8_0, row_nelems,
+                /*budget*/ 1000});
+            test_assert(reader.budget() == 4096, "budget clamps to one page");
+            test_check_gather(reader, data, {0, 23, 24, 9999}, row_nelems);
+            test_check_gather(reader, data, {0, 23, 24, 9999}, row_nelems); // thrash
+            test_check_gather(reader, data, {5, 9984, 1}, row_nelems);
+            test_assert(reader.misses() > 0, "single slot must miss");
+        }
+
+        // case 4: row_bytes > page_size bumps the page size
+        {
+            llama_lazy_reader reader(llama_lazy_reader::config{
+                dup(fd), 0, row_bytes, n_rows, GGML_TYPE_Q8_0, row_nelems,
+                /*budget*/ (n_pages + 1) * 4096,
+                /*page_size*/ 64});
+            test_assert(reader.n_pages_total() == n_pages, "page size bump keeps row mapping");
+            test_check_gather(reader, data, {0, 23, 24, 9999}, row_nelems);
+        }
+
+        // case 5: threaded -- results identical to serial under contention
+        {
+            llama_lazy_reader reader(llama_lazy_reader::config{
+                dup(fd), 0, row_bytes, n_rows, GGML_TYPE_Q8_0, row_nelems,
+                /*budget*/ 16 * 4096});
+            const int n_threads = 4;
+            const int per_thread = 500;
+            std::vector<std::vector<int32_t>> row_sets(n_threads);
+            for (int t = 0; t < n_threads; t++) {
+                row_sets[t].reserve(per_thread);
+                for (int k = 0; k < per_thread; k++) {
+                    row_sets[t].push_back((int32_t) ((t * 997 + k * 101) % n_rows));
+                }
+            }
+            std::vector<std::vector<float>> got(n_threads);
+            std::vector<std::thread> threads;
+            for (int t = 0; t < n_threads; t++) {
+                got[t].resize(per_thread * (size_t) row_nelems);
+                threads.emplace_back([&reader, &row_sets, &got, t]() {
+                    reader.gather(row_sets[t].data(), row_sets[t].size(), got[t].data());
+                });
+            }
+            for (auto & th : threads) {
+                th.join();
+            }
+            for (int t = 0; t < n_threads; t++) {
+                // serial reference on the same (warm) reader; must match
+                std::vector<float> ref(per_thread * (size_t) row_nelems);
+                reader.gather(row_sets[t].data(), row_sets[t].size(), ref.data());
+                test_assert(std::memcmp(got[t].data(), ref.data(), ref.size() * sizeof(float)) == 0,
+                        "threaded gather != serial gather");
+            }
+        }
+
+        // case 6: fd is owned -- closed on destruction
+        {
+            int dup_fd = dup(fd);
+            test_assert(dup_fd >= 0, "dup failed");
+            {
+                llama_lazy_reader reader(llama_lazy_reader::config{
+                    dup_fd, 0, row_bytes, n_rows, GGML_TYPE_Q8_0, row_nelems, 4096});
+            }
+            test_assert(fcntl(dup_fd, F_GETFD) == -1, "fd closed by destructor");
+        }
+
+        close(fd);
+        printf("test-lazy-reader: all tests passed\n");
+        return 0;
+    } catch (const std::exception & e) {
+        fprintf(stderr, "test-lazy-reader: %s\n", e.what());
+        return 1;
+    }
+}
+
+#else // !TEST_HAS_POSIX
+
+int main() {
+    printf("test-lazy-reader: skipped (POSIX only)\n");
+    return 0;
+}
+
+#endif
