+    // The delivery's grouped_norm emits a 3-D [n_embd, hc, T] MUL whose root is the transpose's
+    // view_src (the reference's emits a 2-D [hc_dim, T]); the flat F32 buffer is the same [hc_dim, T]
+    // row-major layout either way.  Derive C/T from the transpose and only require the root to be a
+    // contiguous F32 buffer big enough for C*T elements.
+    const int64_t C0 = tr->ne[1], T0 = tr->ne[0];
+    if (x->type != GGML_TYPE_F32 || !ggml_is_contiguous(x) || ggml_nelements(x) != C0 * T0) return false;
