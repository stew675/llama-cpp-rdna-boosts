+    __shared__ float sh_beta[nwarps > 1 ? nwarps-1 : 1][warp_size];
+    if (threadIdx.y > 0) {
+        sh_alpha[threadIdx.y-1][threadIdx.x] = sum_alpha;
+        sh_beta[threadIdx.y-1][threadIdx.x] = sum_beta;
+    }
+    __syncthreads();
+    if (threadIdx.y > 0) {
