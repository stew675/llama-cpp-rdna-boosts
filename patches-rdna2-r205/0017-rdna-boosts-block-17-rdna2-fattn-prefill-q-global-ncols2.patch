     // through the LDS, which the K reads already saturate (RDNA2: removing them measured +30% on the
     // 512-column kernel). Narrow kernels keep the original loop over Q_tmp: they are bound by
     // streaming K/V and the extra cached reads cost them more than the LDS reads did.
-    constexpr bool q_global = GGML_CUDA_FATTN_TILE_Q_GLOBAL && DKQ <= 256 && ncols1*ncols2 >= 16;
+    constexpr bool q_global = GGML_CUDA_FATTN_TILE_Q_GLOBAL && DKQ <= 256 && ncols1*ncols2 >= 64;
     if constexpr (q_global) {
         constexpr int nsteps = (nbatch_K/2) / cpy_ne;
         constexpr int nrows  = nbatch_fa/(np*warp_size);
@@ -1403,7 +1403,7 @@ static __global__ void flash_attn_tile(
     constexpr bool use_bf16 = ggml_cuda_fattn_tile_use_bf16<T_KV>();
     // Wide kernels with Q from global (q_global) leave Q_tmp unused: keep a 2-element stub so the
     // LDS that K/V/KQ need is not taken by Q (RDNA2 has 64 KB LDS per WGP).
-    constexpr int Q_tmp_count   = (GGML_CUDA_FATTN_TILE_Q_GLOBAL && DKQ <= 256 && ncols >= 16) ? 2 : ncols*DKQ/2;
+    constexpr int Q_tmp_count   = (GGML_CUDA_FATTN_TILE_Q_GLOBAL && DKQ <= 256 && ncols >= 64) ? 2 : ncols*DKQ/2;
     constexpr int KV_tmp_stride = nbatch_K/2 + cpy_ne;
     constexpr int KV_tmp_count  = nbatch_fa*KV_tmp_stride + DVp-DV;
     constexpr int KQ_count      = ncols*nbatch_fa;
@@ -1443,7 +1443,7 @@ static __global__ void flash_attn_tile(
     // Q comes pre-converted from Q_h2 (see launch_fattn) for the wide kernels, where the reads amortize
     // over many columns and the LDS traffic they replace is the limiter. The narrow decode kernels are
     // bound by streaming K/V and the extra cached reads cost them more than the LDS reads did.
-    constexpr bool q_global = GGML_CUDA_FATTN_TILE_Q_GLOBAL && DKQ <= 256 && ncols >= 16;
+    constexpr bool q_global = GGML_CUDA_FATTN_TILE_Q_GLOBAL && DKQ <= 256 && ncols >= 64;
 #else
     constexpr bool q_global = false;
 #endif // FAST_FP16_AVAILABLE
@@ -1792,13 +1792,13 @@ static void launch_fattn_tile_switch_ncols1(ggml_backend_cuda_context & ctx, ggm
         const int nbatch_fa = ggml_cuda_fattn_tile_get_nbatch_fa(DKQ, DV, cols_per_block, cc);
         fattn_kernel_t fattn_kernel = flash_attn_tile<DKQ, DV, cols_per_block/ncols2, ncols2, use_logit_softcap, type_KV>;
         // The q_h2 argument must mirror the kernel-side q_global condition
-        // (GGML_CUDA_FATTN_TILE_Q_GLOBAL && DKQ <= 256 && ncols >= 16): the wide RDNA2 kernels
+        // (GGML_CUDA_FATTN_TILE_Q_GLOBAL && DKQ <= 256 && ncols >= 64): the wide RDNA2 kernels
         // read Q from the Q_h2 global half2 buffer, and omitting the argument here (default
         // false) passed a null pointer to the kernel -> illegal memory access (decode band).
         launch_fattn<DV, cols_per_block/ncols2, ncols2>
             (ctx, dst, fattn_kernel, nwarps, nbytes_shared, nbatch_fa,
             need_f16_K, need_f16_V, false, false, kv_native_tile, warp_size, false,
-            /*q_h2*/ GGML_CUDA_CC_IS_RDNA2(cc) && fast_fp16_available(cc) && DKQ <= 256 && cols_per_block >= 16);
+            /*q_h2*/ GGML_CUDA_CC_IS_RDNA2(cc) && fast_fp16_available(cc) && DKQ <= 256 && cols_per_block >= 64);
         return;
     }
 
@@ -1827,7 +1827,7 @@ static void launch_fattn_tile_switch_ncols1(ggml_backend_cuda_context & ctx, ggm
             launch_fattn<DV, cols_per_block/ncols2, ncols2>
                 (ctx, dst, fattn_kernel, nwarps, nbytes_shared, nbatch_fa,
                 need_f16_K, need_f16_V, false, false, kv_native_tile, warp_size, false,
-                /*q_h2*/ rdna2 && fast_fp16_available(cc) && DKQ <= 256 && cols_per_block >= 16);
+                /*q_h2*/ rdna2 && fast_fp16_available(cc) && DKQ <= 256 && cols_per_block >= 64);
             return;
         }
     }
@@ -1845,7 +1845,7 @@ static void launch_fattn_tile_switch_ncols1(ggml_backend_cuda_context & ctx, ggm
             launch_fattn<DV, cols_per_block/ncols2, ncols2>
                 (ctx, dst, fattn_kernel, nwarps, nbytes_shared, nbatch_fa,
                 need_f16_K, need_f16_V, false, false, kv_native_tile, warp_size, false,
-                /*q_h2*/ rdna2 && fast_fp16_available(cc) && DKQ <= 256 && cols_per_block >= 16);
+                /*q_h2*/ rdna2 && fast_fp16_available(cc) && DKQ <= 256 && cols_per_block >= 64);
             return;
         }
     }
@@ -1859,7 +1859,7 @@ static void launch_fattn_tile_switch_ncols1(ggml_backend_cuda_context & ctx, ggm
             launch_fattn<DV, cols_per_block/ncols2, ncols2>
                 (ctx, dst, fattn_kernel, nwarps, nbytes_shared, nbatch_fa,
                 need_f16_K, need_f16_V, false, false, kv_native_tile, warp_size, false,
-                /*q_h2*/ rdna2 && fast_fp16_available(cc) && DKQ <= 256 && cols_per_block >= 16);
+                /*q_h2*/ rdna2 && fast_fp16_available(cc) && DKQ <= 256 && cols_per_block >= 64);
             return;
         }
     }
@@ -1873,7 +1873,7 @@ static void launch_fattn_tile_switch_ncols1(ggml_backend_cuda_context & ctx, ggm
             launch_fattn<DV, cols_per_block/ncols2, ncols2>
                 (ctx, dst, fattn_kernel, nwarps, nbytes_shared, nbatch_fa,
                 need_f16_K, need_f16_V, false, false, kv_native_tile, warp_size, false,
-                /*q_h2*/ rdna2 && fast_fp16_available(cc) && DKQ <= 256 && cols_per_block >= 16);
+                /*q_h2*/ rdna2 && fast_fp16_available(cc) && DKQ <= 256 && cols_per_block >= 64);
             return;
         }
