# Transient run logs (regenerated every run). The measured data itself
# (benchmarks/results/benchy/*.json|md, benchmarks/results/ppl/*.txt) IS
# committed - the README and v2-results.md link to it.
benchmarks/results/*.log
benchmarks/results/*.stdout.log

# Python bytecode from the tooling scripts.
__pycache__/
*.pyc

# The 56 GiB rig's per-arm logs (5-10 MiB per session, regenerated by parity-arm.sh).
wip/bench-56gb/runs/
wip/bench-56gb/matrix-*.log
wip/bench-56gb/ballast
wip/bench-56gb/prompt_*.txt
# The host-read-transport campaign's per-arm logs (regenerated by text-ab.sh / parity-arm.sh).
wip/host-read-transport/runs/

# The transport gate writes its per-arm logs to ./runs/gate (regenerated every run).
runs/
archive/work/host-read-transport/runs/

# wip/session-scheduling: gate.py --keep output (large, machine-specific)
archive/work/session-scheduling/gate-logs/

# a run wrote its MoE heat map into the repo root (r358 CI caught the untracked artifact)
*.moe-heatmap

# flash-next-prefill: the 89k prompt is generated by arm.sh/visit.sh (prompts/prose-rdna-boosts.txt x17)
wip/flash-next-prefill/l1-90k.txt
