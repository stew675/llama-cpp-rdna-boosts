# Transient run logs (regenerated every run). The measured data itself
# (benchmarks/results/benchy/*.json|md, benchmarks/results/ppl/*.txt) IS
# committed - the README and v2-results.md link to it.
benchmarks/results/*.log
benchmarks/results/*.stdout.log

# Python bytecode from the tooling scripts.
__pycache__/
*.pyc

# The 56 GiB rig's per-arm logs (5-10 MiB per session, regenerated by parity-arm.sh).
wip/bench-56gb/runs/
wip/bench-56gb/matrix-*.log
wip/bench-56gb/ballast
wip/bench-56gb/prompt_*.txt
