+// a pair that is hazard-free in lockstep must show hazards when a is delayed one split).
+static int ggml_backend_sched_pair_hazards(ggml_backend_sched_t sa, ggml_backend_sched_t sb, int n_log, int * n_cross, int a_shift) {
+    struct acc { int split; int backend; bool write; };
