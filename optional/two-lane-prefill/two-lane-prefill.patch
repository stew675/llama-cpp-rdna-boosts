+        ggml_backend_event_t ref = nullptr;
+        for (int i = 0; i < sched_a->n_backends && ref == nullptr; i++) {
+            ref = ev_start[0][i];
+        }
+        auto off = [&](ggml_backend_event_t e) -> double {
+            if (ref == nullptr || e == nullptr) {
+                return -1.0;
+            }
+            double ms = -1.0;
+            if (ggml_backend_event_elapsed_time(ref, e, &ms)) {
+                return ms;
+            }
+            return -1.0;
+        };
+        const char * names[PAIR_TS_MAX_B] = { "CPU", "GPU0", "GPU1", "GPU2", "GPU3", "GPU4", "GPU5", "GPU6" };
+        for (int i = 0; i < sched_a->n_backends; i++) {
+            names[i] = ggml_backend_name(sched_a->backends[i]);
+        }
+        for (int l = 0; l < 2; l++) {
+            GGML_LOG_WARN("pair-ev lane=%c:", l == 0 ? 'a' : 'b');
+            for (int b = 0; b < sched_a->n_backends; b++) {
+                GGML_LOG_WARN("  %-8s start=%8.1f end=%8.1f", names[b],
+                    off(ev_start[l][b]), off(ev_end[l][b]));
+            }
+            GGML_LOG_WARN("\n");
+        }
+        for (int l = 0; l < 2; l++) {
+            for (int b = 0; b < sched_a->n_backends; b++) {
+                if (ev_start[l][b] != nullptr && ev_end[l][b] != nullptr) {
+                    double ms = 0;
+                    if (ggml_backend_event_elapsed_time(ev_start[l][b], ev_end[l][b], &ms)) {
+                        GGML_LOG_WARN("pair-ev span lane=%c %-8s = %8.1f ms\n", l == 0 ? 'a' : 'b', names[b], ms);
+                    }
+                }
+            }
+        }
+    }
+    return GGML_STATUS_SUCCESS;
+}
