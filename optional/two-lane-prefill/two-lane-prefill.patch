+// halo-hybrid: data hazards on the persistent state two lanes share (KV / recurrent caches: buffers that are
+// neither weights nor compute - compute tensors carry GGML_BACKEND_BUFFER_USAGE_COMPUTE and never match).
+// The alternating submission a0 b0 a1 b1 ... orders a's split j before b's split i only when both run on the
+// same backend stream and j <= i, so every write of a to a cache tensor must reach b's reads and writes of it
+// that way, and every read of a must precede b's writes the same way. Per whole cache tensor (conservative).
+// Returns the number of violations, logging the first n_log. a_shift delays lane a's split indices (self-test:
+// a pair that is hazard-free in lockstep must show hazards when a is delayed one split).
+static int ggml_backend_sched_pair_hazards(ggml_backend_sched_t sa, ggml_backend_sched_t sb, int n_log, int * n_cross, int a_shift) {
+    struct acc { int split; int backend; bool write; };
+    std::unordered_map<const ggml_tensor *, std::vector<acc>> use[2];
+    auto root = [](const ggml_tensor * t) {
+        while (t->view_src) {
+            t = t->view_src;
+        }
+        return t;
+    };
+    auto cache = [](const ggml_tensor * r) {
+        return r->buffer != nullptr && ggml_backend_buffer_get_usage(r->buffer) == GGML_BACKEND_BUFFER_USAGE_ANY;
+    };
+    ggml_backend_sched_t lanes[2] = { sa, sb };
+    for (int l = 0; l < 2; l++) {
+        ggml_backend_sched_t s = lanes[l];
+        for (int i = 0; i < s->n_splits; i++) {
+            const struct ggml_backend_sched_split & sp = s->splits[i];
+            for (int k = 0; k < sp.n_inputs; k++) {   // an input copied in from another backend: read at this split
+                const ggml_tensor * r = root(sp.inputs[k]);
+                if (cache(r)) {
+                    use[l][r].push_back({ i + (l == 0 ? a_shift : 0), sp.backend_id, false });
+                }
+            }
+            for (int n = 0; n < sp.graph.n_nodes; n++) {
+                const ggml_tensor * t = sp.graph.nodes[n];
+                if (ggml_op_is_empty(t->op) || ggml_is_empty(t)) {
+                    continue;
+                }
+                const ggml_tensor * r = root(t);
+                if (cache(r)) {
+                    use[l][r].push_back({ i + (l == 0 ? a_shift : 0), sp.backend_id, true });
+                }
