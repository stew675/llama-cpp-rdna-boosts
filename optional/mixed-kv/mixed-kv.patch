From 5d25f70db3756fe9ec660ea21bd8fc3456cf1454 Mon Sep 17 00:00:00 2001
From: Marvin Johanning <email@marvinjohanning.de>
Date: Fri, 13 Nov 2026 21:32:17 +0100
Subject: [PATCH] ggml-cuda, llama: native mixed K/V cache types (q8_0 K with
 q4_0 / q5_0 / q5_1 V)

The tile flash-attention kernel takes a separate V type, with instances for head 256.
The RDNA4 decode/verify band and the context gate accept the three pairs on models whose
attention heads are all 256 wide. GGML_CUDA_FA_KV_MIXED=0 keeps the staged path.
test-logits-width-probe takes KVV=<type> for the V cache.
---
 ggml/src/ggml-cuda/fattn-rdna.cuh             | 34 +++++++-
 ggml/src/ggml-cuda/fattn-tile.cu              | 21 +++++
 ggml/src/ggml-cuda/fattn-tile.cuh             | 83 +++++++++++--------
 ggml/src/ggml-cuda/fattn.cu                   |  2 +-
 ...tn-tile-instance-dkq256-dv256-q8_0-q4_0.cu |  5 ++
 ...tn-tile-instance-dkq256-dv256-q8_0-q5_0.cu |  5 ++
 ...tn-tile-instance-dkq256-dv256-q8_0-q5_1.cu |  5 ++
 .../template-instances/generate_cu_files.py   | 12 +++
 src/llama-context.cpp                         | 17 +++-
 tests/test-backend-ops.cpp                    |  9 ++
 tests/test-logits-width-probe.cpp             | 11 +--
 11 files changed, 162 insertions(+), 42 deletions(-)
 create mode 100644 ggml/src/ggml-cuda/template-instances/fattn-tile-instance-dkq256-dv256-q8_0-q4_0.cu
 create mode 100644 ggml/src/ggml-cuda/template-instances/fattn-tile-instance-dkq256-dv256-q8_0-q5_0.cu
 create mode 100644 ggml/src/ggml-cuda/template-instances/fattn-tile-instance-dkq256-dv256-q8_0-q5_1.cu

diff --git a/ggml/src/ggml-cuda/fattn-rdna.cuh b/ggml/src/ggml-cuda/fattn-rdna.cuh
index 1c2626477..4c86ee4b4 100644
--- a/ggml/src/ggml-cuda/fattn-rdna.cuh
+++ b/ggml/src/ggml-cuda/fattn-rdna.cuh
@@ -265,6 +265,29 @@ static inline int ggml_cuda_fattn_tile_kv_native_type(const ggml_tensor * K, con
     return tk != FATTN_KV_NATIVE_NONE && tk == ggml_cuda_fattn_kv_native_type(V) ? tk : FATTN_KV_NATIVE_NONE;
 }
 
+// Mixed K/V: a q8_0 K with a smaller quantized V (q4_0 / q5_0 / q5_1), each operand read through its own
+// dequant arm.  The MMA kernel takes a native type per operand; the tile kernel has one instance per pair,
+// for head 256 only (ggml_cuda_fattn_tile_kv_mixed_ok).  GGML_CUDA_FA_KV_MIXED=0: off, a mixed pair is then
+// staged through F16 as before.
+static inline bool ggml_cuda_fattn_kv_mixed_native(const ggml_tensor * K, const ggml_tensor * V) {
+    static const bool on = []() {
+        const char * env = getenv("GGML_CUDA_FA_KV_MIXED");
+        return env == nullptr || atoi(env) != 0;
+    }();
+    if (!on || K == nullptr || V == nullptr) {
+        return false;
+    }
+    if (ggml_cuda_fattn_kv_native_type(K) != FATTN_KV_NATIVE_Q8_0) {
+        return false;
+    }
+    const int tv = ggml_cuda_fattn_kv_native_type(V);
+    return tv == FATTN_KV_NATIVE_Q4_0 || tv == FATTN_KV_NATIVE_Q5_0 || tv == FATTN_KV_NATIVE_Q5_1;
+}
+
+static inline bool ggml_cuda_fattn_tile_kv_mixed_ok(const ggml_tensor * K, const ggml_tensor * V) {
+    return ggml_cuda_fattn_kv_mixed_native(K, V) && K->ne[0] == 256 && V->ne[0] == 256;
+}
+
 // The native K/V type a kernel instantiated with `type_KV` reads through the *dequant loaders*
 // (constexpr, because the tile and vec kernels fix their K/V type at compile time).  BF16 and F16 are
 // read through the kernel's own T_KV, so they map to NONE here.
@@ -306,11 +329,19 @@ static inline ggml_type ggml_cuda_fattn_tile_type(const ggml_tensor * K, const g
     if (K->type == GGML_TYPE_BF16 && V->type == GGML_TYPE_BF16 && bf16_mma_hardware_available(cc)) {
         return GGML_TYPE_BF16;
     }
+    if (ggml_cuda_fattn_tile_kv_mixed_ok(K, V)) {
+        return K->type;
+    }
     const int tile_native = ggml_cuda_fattn_tile_kv_native_type(K, V);
     return (tile_native == FATTN_KV_NATIVE_BF16) ? GGML_TYPE_F16
                                                  : ggml_cuda_fattn_native_ggml_type(tile_native);
 }
 
+// The tile instantiation's V type: its K/V type, except for a mixed pair the tile kernel has an instance for.
+static inline ggml_type ggml_cuda_fattn_tile_type_V(const ggml_tensor * K, const ggml_tensor * V, const int cc) {
+    return ggml_cuda_fattn_tile_kv_mixed_ok(K, V) ? V->type : ggml_cuda_fattn_tile_type(K, V, cc);
+}
+
 // Decode/verify band (n_q <= 8) on RDNA4: the whole GQA group is folded into one block
 // (ncols2 = 8) via the WMMA kernel instead of the tile kernel's ncols2 = 2, which fetches and
 // dequantizes every K/V element once per head pair (3x for GQA 6).  This is the default; the env var
@@ -456,7 +487,8 @@ static inline bool ggml_cuda_fattn_band_wmma_applies(const int cc, const ggml_te
     // is the default since the r6 flip; it is deliberately NOT banded while it is staged, where the
     // whole-cache conversion dominates (that staged case only appears under GGML_CUDA_FA_KV_NATIVE=0).
     const int  kv_native = ggml_cuda_fattn_kv_native_type(K);
-    const bool kv_quant  = kv_native != FATTN_KV_NATIVE_NONE && kv_native == ggml_cuda_fattn_kv_native_type(V);
+    const bool kv_quant  = (kv_native != FATTN_KV_NATIVE_NONE && kv_native == ggml_cuda_fattn_kv_native_type(V)) ||
+        ggml_cuda_fattn_kv_mixed_native(K, V);
     const bool kv_f16    = K->type == GGML_TYPE_F16 && V->type == GGML_TYPE_F16;
     const bool kv_ok     = kv_quant || kv_f16;
 
diff --git a/ggml/src/ggml-cuda/fattn-tile.cu b/ggml/src/ggml-cuda/fattn-tile.cu
index 54a08ded6..194782c58 100644
