     // scratch the launcher may stage into cannot disagree.
     const ggml_type tile_type = ggml_cuda_fattn_tile_type(K, V, ggml_cuda_info().devices[ggml_cuda_get_device()].cc);
 
+#ifdef FAST_FP16_AVAILABLE
+    // mixed K/V pairs: instantiated for head 256 only, the same predicate as the allocator's
+    if constexpr (DKQ == 256 && DV == 256) {
+        if (ggml_cuda_fattn_tile_kv_mixed_ok(K, V)) {
+            switch (V->type) {
+                case GGML_TYPE_Q4_0:
+                    ggml_cuda_flash_attn_ext_tile_case<DKQ, DV, GGML_TYPE_Q8_0, GGML_TYPE_Q4_0>(ctx, dst);
+                    return;
+                case GGML_TYPE_Q5_0:
+                    ggml_cuda_flash_attn_ext_tile_case<DKQ, DV, GGML_TYPE_Q8_0, GGML_TYPE_Q5_0>(ctx, dst);
+                    return;
+                case GGML_TYPE_Q5_1:
+                    ggml_cuda_flash_attn_ext_tile_case<DKQ, DV, GGML_TYPE_Q8_0, GGML_TYPE_Q5_1>(ctx, dst);
+                    return;
+                default:
+                    GGML_ABORT("fatal error");
+            }
+        }
+    }
+#endif // FAST_FP16_AVAILABLE
+
     switch (tile_type) {
         case GGML_TYPE_BF16:
             // BF16 K/V is read natively and accumulated in FP32 (native-BF16 hardware only).
