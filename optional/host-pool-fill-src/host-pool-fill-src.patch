From 1b7131026147548ee5090765e872684644bea646 Mon Sep 17 00:00:00 2001
From: Stewart Gebbie <stew675@users.noreply.github.com>
Date: Mon, 9 Nov 2026 12:43:04 -0600
Subject: [PATCH] rdna-boosts [optional]: the host pool's buffered fill reads
 the FILE, not the model mapping

Issue #281, second half.  The coalesced prefill read (r232, the span) made the buffered
arm read the file for the experts in neither tier; this makes the pool FILL read the same
file instead of one mapping memcpy per expert.  Transport, not policy: a mapped fill on
Windows is a demand fault per 4 KiB page (measured 715 MiB/s on the reporter's box) where
a buffered pread gets the OS readahead.  Both read the same page-cache pages, so the
bytes and the pool contents are identical.

  MOE_HOST_POOL_FILL_SRC   unset = the pool's own file handle (buffered pread)
                           map   = the pre-r232 mapping memcpy

Measured (56 GiB rig, Flash-Next GSQ-RCO-IQ3_S + MTP, -c 204800 -ub 6144, -lme 12 =
26 % coverage, cold page cache, 50k prefill x2): +38 % on top of the coalesced span
(821-875 -> 1138-1146 t/s) and 95 -> 23.8 GiB of storage reads; but -41 % on its own
(313.7 t/s), because a 0.7 MiB pread per fill is latency-bound at depth 1, and exactly
neutral once the pages are cacheable (8893 vs 8984 MiB/s fill, pp4765 vs 4745 t/s).

It is therefore a page-cache-headroom bet, not a warming trick: keep the span on
(MOE_HOST_POOL_STAGE_SPAN=0 drops the arm this pays on).
---
 ggml/src/ggml-cuda/moe-expert-cache.cu | 33 +++++++++++++++++++-------
 1 file changed, 25 insertions(+), 8 deletions(-)

diff --git a/ggml/src/ggml-cuda/moe-expert-cache.cu b/ggml/src/ggml-cuda/moe-expert-cache.cu
index e2ecc287e..c3d1f4b07 100644
--- a/ggml/src/ggml-cuda/moe-expert-cache.cu
+++ b/ggml/src/ggml-cuda/moe-expert-cache.cu
@@ -395,6 +395,12 @@ int64_t g_pool_ram_used    = 0;      // bytes pinned by the pools built so far
 double  g_pool_ram_scale   = -1.0;
 int64_t g_preflight_host_bytes = 0;  // Σ host expert bytes over host-expert devices (the AUTO basis)
 bool    g_pool_prewarm     = true;   // MOE_HOST_POOL_PREWARM: fill every pool slot when it is built
+// issue #281: WHICH SOURCE a buffered fill reads -- the model mapping (pre-r232) or the file, through the OS
+// page cache.  The bytes and the cache are the same either way (a mapped GGUF and the file share the page
+// cache's pages), but the TRANSPORT is not: a mapped fill is a demand fault per 4 KiB page, measured at
+// 715 MiB/s on the reporter's Windows box against 2.4 GiB/s for the same bytes read through the file here,
+// and it is what made buffering lose 3x to O_DIRECT there.  `MOE_HOST_POOL_FILL_SRC=map` is the kill switch.
+bool    g_pool_fill_src_file = true; // MOE_HOST_POOL_FILL_SRC=map: fills read the model mapping again
 // TODO #87 (1): `MOE_HOST_POOL_DIO` is AUTO by default -- decided once, at the first pool build, from
 // MemAvailable vs the host expert set (the same measurement `MOE_HOST_POOL_RAM_PCT` takes).  Buffered fills
 // (DIO=0) let the page cache act as an L3, which is worth +90 % decode / +155 % prefill when the set fits;
@@ -1130,6 +1136,12 @@ void parse_env() {
         g_pool_ram_pct = 100;
     }
     g_pool_prewarm     = env_int("MOE_HOST_POOL_PREWARM", 1) != 0;
+    {
+        // issue #281: `file` (default) reads a buffered fill through the pool's own buffered file handle;
+        // `map` restores the pre-r232 mapping memcpy for an A/B.  A DIRECT-mode fill always reads the file.
+        const char * fs = getenv("MOE_HOST_POOL_FILL_SRC");
+        g_pool_fill_src_file = !(fs != nullptr && strcmp(fs, "map") == 0);
+    }
     // TODO #87 (1): AUTO by default (see `g_pool_dio_req`).  An explicit `MOE_HOST_POOL_DIO=0|1` wins and is
     // decided here, so an A/B never depends on the machine.
     g_pool_dio_req     = env_int("MOE_HOST_POOL_DIO", -1);
@@ -2363,13 +2375,14 @@ static void pool_reap_locked(host_pool_t & p) {
 }
 
 // wip/host-expert-master-drop (TODO #55): fill one pool slot with expert `expert`'s whole host blob.
-// When the host tensor is backed by the read-only model mapping (the pool-backed master) that is a plain
-// memcpy out of the page cache: no syscall, no second copy, and the pages stay reclaimable (the kernel drops
-// them under pressure and re-faults from the GGUF -- the disk tier).  `MOE_HOST_POOL_DIO=1` keeps the file
-// read with O_DIRECT, which is the only mode that bypasses the page cache.  The disk tier is an OPTIMISATION:
-// when it is unavailable (a platform whose pool file I/O is a stub, a file that cannot be opened) the fill
-// falls back to the mapping instead of failing, because failing here marks the whole pool dead (issue #274).
-// Caller holds `g_mutex`.
+// The source is the pool's own FILE handle by default (`pool_pread`, buffered through the OS page cache), or
+// the read-only model MAPPING when `MOE_HOST_POOL_FILL_SRC=map`.  Both read the same page-cache pages and
+// both are reclaimable, so the choice is transport, not policy -- and issue #281 is why the file is the
+// default: a mapping memcpy is a demand fault per page on Windows (715 MiB/s measured) where a buffered
+// read gets the OS readahead.  `MOE_HOST_POOL_DIO=1` still reads the file with O_DIRECT, the only mode that
+// bypasses the page cache.  The file tier is an OPTIMISATION: when it is unavailable (a platform whose pool
+// file I/O is a stub, a file that cannot be opened) the fill falls back to the mapping instead of failing,
+// because failing here marks the whole pool dead (issue #274).  Caller holds `g_mutex`.
 static bool pool_fill_slot_locked(host_pool_t & p, int expert, char * dst) {
     // wip/host-pool-speed: the fill's WALL TIME, by source.  A demand fill is synchronous (the host thread
     // blocks on it), so this is the number that decides whether an overlapped/coalesced fill is worth
@@ -2377,7 +2390,11 @@ static bool pool_fill_slot_locked(host_pool_t & p, int expert, char * dst) {
     const int64_t t0 = ggml_time_us();
     const size_t rel = (size_t) expert * p.host_bytes;
     const bool   use_disk = g_pool_dio && pool_file_io_available();
-    if (!use_disk && p.src_host != nullptr) {
+    // issue #281: a buffered fill reads the FILE by default (`MOE_HOST_POOL_FILL_SRC=map` restores the
+    // mapping memcpy).  Both arms read the same page-cache pages; the file arm is the one that does not pay a
+    // demand fault per page, and it is the only arm the coalesced prefill span can share a read size with.
+    const bool   use_file = use_disk || g_pool_fill_src_file;
+    if (!use_file && p.src_host != nullptr) {
         memcpy(dst, (const char *) p.src_host + rel, p.host_bytes);
         g_fill_memcpy_calls++;
         g_fill_memcpy_us += ggml_time_us() - t0;
-- 
2.56.0

