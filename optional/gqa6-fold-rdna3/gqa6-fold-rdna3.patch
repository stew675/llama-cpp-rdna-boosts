+// Fold launcher: one padded eight-column block per six-head GQA group (n_q <= 8). Forces the unfolded
+// ncols2=2 reference kernel's split-KV parallel_blocks so the fold keeps the existing per-head reduction
+// geometry (raw OFF/ON bit-identity). The unfolded reference is the ordinary baseline kernel.
+template <bool use_logit_softcap>
+static void launch_fattn_tile_gqa6_fold(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * Q = dst->src[0];
+    const ggml_tensor * K = dst->src[1];
+    const ggml_tensor * V = dst->src[2];
+
+    constexpr int DKQ = 256;
+    constexpr int DV = 256;
+    constexpr int ncols2 = 8;
+    constexpr ggml_type type_KV = GGML_TYPE_Q8_0;
+
+    const bool need_f16_K = K->type != type_KV;
+    const bool need_f16_V = V->type != type_KV;
+
+    constexpr int kv_native_tile = type_KV == GGML_TYPE_BF16 ? FATTN_KV_NATIVE_BF16 :
+                                   ggml_cuda_fattn_native_type_from_kernel<type_KV>();
+
+    const int id        = ggml_cuda_get_device();
+    const int cc        = ggml_cuda_info().devices[id].cc;
+    const int warp_size = 32;
+
+    constexpr size_t nbytes_shared = 0;
+
+    constexpr int cols_per_block = ncols2; // 8: six real heads + two padding columns, one warp each
+    const int nwarps    = 256 / warp_size;
+    const int nbatch_fa = ggml_cuda_fattn_tile_get_nbatch_fa(DKQ, DV, cols_per_block, cc);
+    fattn_kernel_t fattn_kernel = flash_attn_tile_gqa6_fold<DKQ, DV, cols_per_block/ncols2, ncols2, use_logit_softcap, type_KV, true>;
+
+    constexpr int unfolded_ncols2 = 2;
+    fattn_kernel_t unfolded_kernel =
+        flash_attn_tile<DKQ, DV, 1, unfolded_ncols2, use_logit_softcap, type_KV>;
+    const int unfolded_nwarps =
+        ggml_cuda_fattn_tile_get_nthreads(DKQ, DV, unfolded_ncols2, cc) / warp_size;
+    const int unfolded_nbatch_fa =
+        ggml_cuda_fattn_tile_get_nbatch_fa(DKQ, DV, unfolded_ncols2, cc);
+
+    int unfolded_max_blocks_per_sm = 1;
+    CUDA_CHECK(cudaOccupancyMaxActiveBlocksPerMultiprocessor(
+        &unfolded_max_blocks_per_sm, unfolded_kernel, unfolded_nwarps*warp_size, nbytes_shared));
+    GGML_ASSERT(unfolded_max_blocks_per_sm > 0);
+
+    const int nsm = ggml_cuda_info().devices[id].nsm;
+    const int gqa_ratio = Q->ne[2] / K->ne[2];
+    const int unfolded_ntiles_z_gqa = (gqa_ratio + unfolded_ncols2 - 1) / unfolded_ncols2;
+    const int unfolded_ntiles_dst_eff = unfolded_ntiles_z_gqa * K->ne[2] * Q->ne[3];
+    // Pre-existing: K->ne[1] here, not the kv_rows-aware n_kv_cols launch_fattn uses for ntiles_KV.
+    // Masked at the default GGML_CUDA_FA_SPLIT_CONST=1 (search limit = blocks_per_wave, then clamped to
+    // the real kv_rows-aware ntiles_KV); only SPLIT_CONST=0 with kv_rows->ne[0] != K->ne[1] could diverge
+    // from the unfolded reference. The fold's bit-identity was validated for the standard GQA-6 path.
+    const int unfolded_ntiles_KV = (K->ne[1] + unfolded_nbatch_fa - 1) / unfolded_nbatch_fa;
+    const int force_parallel_blocks = ggml_cuda_fattn_tile_gqa6_pick_parallel_blocks(
+        unfolded_max_blocks_per_sm, nsm, unfolded_ntiles_dst_eff, unfolded_ntiles_KV);
+
+    launch_fattn<DV, cols_per_block/ncols2, ncols2, true>
+        (ctx, dst, fattn_kernel, nwarps, nbytes_shared, nbatch_fa,
+        need_f16_K, need_f16_V, false, false, kv_native_tile, warp_size, false,
+        /*q_h2*/ GGML_CUDA_CC_IS_RDNA2(cc) && fast_fp16_available(cc) && DKQ <= 256 && cols_per_block >= 64,
+        /*can_chunk*/ false, force_parallel_blocks);
+}
