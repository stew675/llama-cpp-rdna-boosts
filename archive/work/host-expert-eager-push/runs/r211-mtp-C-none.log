def dijkstra(graph: Dict[str, List[Tuple[str, float]]], start: str) -> Dict[str, float]:
    """Compute single-source shortest paths using Dijkstra's algorithm.

    Args:
        graph: Adjacency list where keys are node names and values are lists of
               (neighbor, weight) tuples.
        start: The starting node.

    Returns:
        A dictionary mapping each reachable node to its shortest distance from start.
        Unreachable nodes are omitted.
    """
    import heapq

    distances0.28.104.617 I slot print_timing: id  0 | task 0 | n_gen =   1341, tg =  63.62 t/s, tg_3s =  64.46 t/s
: Dict[str, float] = {}
    # Priority queue: (distance, node)
    pq: List[Tuple[float, str]] = [(0.0, start)]
    distances[start] = 0.0

    while pq:
        current_dist, current_node = heapq.heappop(pq)

        # If we've already found a shorter path to this node, skip
        if current_dist > distances.get(current_node, float('inf')):
            continue

        # Explore neighbors
        for neighbor, weight in graph.get(current_node, []):
            distance = current_dist + weight
            # Only consider this new path if it's shorter than any previously found path
            if distance < distances.get(neighbor, float('inf')):
                distances[neighbor] = distance
                heapq.heappush(pq, (distance, neighbor))

    return distances


