    Uses an OrderedDict to maintain insertion order and an RLock for thread safety.
    """

    def __init__(self, maxsize: int) -> None:
        """Initialize the LRU cache.

        Args:
            maxsize: Maximum number of items the cache can hold.
        """
        if maxsize <= 0:
