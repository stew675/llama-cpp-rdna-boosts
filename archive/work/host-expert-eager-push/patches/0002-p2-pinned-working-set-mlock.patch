+// wip/host-expert-eager-push P2: the PINNED WORKING SET.  `mlock` the bytes of the model mapping the policy is
+// warming, so the hot set cannot be reclaimed and a push does not become a disk read.  This is NOT a transport
+// (the driver is not told, and the copy is still pageable): it is how the host tiers' residency policy is
+// enforced on a mapping we do not own.
+//
+//   MOE_HOST_PUSH_MLOCK_MIB=N    pin up to N MiB of the host expert set (0/unset = off)
+//
+// REFUSAL IS NOT FATAL.  The budget may exceed RLIMIT_MEMLOCK (8 MiB by default on this box), so the kernel
+// simply refuses at the limit: log ONCE with what the user can do, keep what was pinned, and carry on with the
+// unpinned remainder served from the page cache exactly as before.  A partly-pinned working set is the normal
+// state on a box without CAP_IPC_LOCK, not an error.
+static size_t  g_push_mlock_budget = 0;   // bytes; 0 = disabled
+static size_t  g_push_mlock_bytes  = 0;   // bytes actually pinned
+static bool    g_push_mlock_stop   = false;   // the kernel refused: stop trying (once-message)
+static long    g_push_mlock_experts = 0;
+static long    g_push_mlock_fail    = 0;
+static bool    g_push_mlock_parsed  = false;
+
+static void push_mlock_parse() {
+    if (g_push_mlock_parsed) {
+        return;
+    }
+    g_push_mlock_parsed = true;
+    const char * e = getenv("MOE_HOST_PUSH_MLOCK_MIB");
+    if (e == nullptr) {
+        return;
+    }
+    g_push_mlock_budget = (size_t) atoll(e) << 20;
+    fprintf(stderr, "P1-PUSH: MOE_HOST_PUSH_MLOCK_MIB=%zu -- pinning up to %zu MiB of the host expert set\n",
+            (size_t) atoll(e), g_push_mlock_budget >> 20);
+}
+
+static long vmlck_limit_kb() {
+    struct rlimit rl;
+    if (getrlimit(RLIMIT_MEMLOCK, &rl) != 0) {
+        return -1;
+    }
+    return (rl.rlim_cur == RLIM_INFINITY) ? -1 : (long) (rl.rlim_cur / 1024);
+}
+
+// Pin one expert's bytes in the mapping.  Called from the fill path, once per (table, expert).
+static void push_mlock_expert(table_t & t, int32_t expert) {
+    if (g_push_mlock_budget == 0 || g_push_mlock_stop || expert < 0 || expert >= t.n_experts) {
+        return;
+    }
+    if (t.push_locked.empty()) {
+        t.push_locked.assign((size_t) t.n_experts, 0);
+    }
+    if (t.push_locked[(size_t) expert]) {
+        return;
+    }
+    if (g_push_mlock_bytes + t.expert_bytes > g_push_mlock_budget) {
+        g_push_mlock_stop = true;
+        fprintf(stderr, "P1-PUSH: pinned working set full: %zu MiB pinned in %ld experts (budget %zu MiB); "
+                        "the remainder stays reclaimable page cache\n",
+                g_push_mlock_bytes >> 20, g_push_mlock_experts, g_push_mlock_budget >> 20);
+        return;
+    }
+    void * addr = (void *) ((const char *) t.host + (size_t) expert * t.host_bytes + t.src_off);
+    if (mlock(addr, t.expert_bytes) != 0) {
+        g_push_mlock_fail++;
+        g_push_mlock_stop = true;
+        const int err = errno;
+        // ONE message, with the remedy.  Everything already pinned stays pinned, and the rest is served from
+        // the page cache exactly as it would be without this feature.
+        fprintf(stderr,
+                "P1-PUSH: mlock refused (%s) after %zu MiB pinned in %ld experts (requested %zu MiB).  "
+                "The pinned working set stops here and the remainder stays reclaimable page cache -- correct, "
+                "just less warm.  To pin more, raise the limit for this process: "
+                "`LimitMEMLOCK=<MiB>` in the unit, or grant CAP_IPC_LOCK (RLIMIT_MEMLOCK is %ld KiB here).  "
+                "See wip/host-expert-eager-push/PUSH-MLOCK-TIER.md\n",
+                strerror(err), g_push_mlock_bytes >> 20, g_push_mlock_experts, g_push_mlock_budget >> 20,
+                (long) vmlck_limit_kb());
+        return;
+    }
+    t.push_locked[(size_t) expert] = 1;
+    g_push_mlock_bytes  += t.expert_bytes;
+    g_push_mlock_experts++;
+}
