+    push_src_parse();
+    if (g_push_src_mapping && t.host_pitch == 0 && t.n_slices == 0 && t.src_off + t.expert_bytes <= t.host_bytes) {
+        // The candidate: the mapping itself is the CE source.  No pool slot, no bounce, no host memcpy.
+        out->base = (const char *) t.host + (size_t) expert * t.host_bytes;
+        out->kind = cudaMemcpyHostToDevice;
+        g_push_src_copies++;
+        return true;
+    }
     if (pool != nullptr && t.src_off + t.expert_bytes <= t.host_bytes) {
