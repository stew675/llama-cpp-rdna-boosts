+// wip/host-expert-eager-push P1: `MOE_HOST_PUSH_SRC=mapping` makes a POOL-BACKED master (the read-only model
+// mapping) the copy engine's source directly, instead of memcpy'ing the expert into a pinned pool slot / bounce
+// ring first.  That deletes the per-miss host memcpy, which is the entire cost gap (measured: a 1-D CE push
+// from the mapping is 66-93 us hot / 1.32 ms cold per 1.66 MiB against the pool's 137 us / ~3.5 ms).
+//
+// It is an ENV SWITCH, not a mode: `pinned` (the default) is the delivered, measured-safe path, and this
+// campaign's P1 is a reproduce-or-refute of the claim that a pageable source tears under back-to-back use
+// (the comment above `expert_host_src`).  1-D only: a strided/sliced table (or a 2-D copy) keeps the pool,
+// because the 2-D pageable path is documented to fault as well as to be 4-5x slower.
+//   MOE_HOST_PUSH_SRC=mapping    direct pageable H2D from the mapping (the candidate)
+//   MOE_HOST_PUSH_SRC=pinned     the delivered path (default, and the control arm)
+static bool g_push_src_mapping = false;
+static bool g_push_src_parsed  = false;
+static long g_push_src_copies  = 0;   // diagnostic: how many fills took the mapping source
+
+static void push_src_parse() {
+    if (g_push_src_parsed) {
+        return;
+    }
+    g_push_src_parsed = true;
+    const char * e = getenv("MOE_HOST_PUSH_SRC");
+    g_push_src_mapping = e != nullptr && strcmp(e, "mapping") == 0;
+    if (g_push_src_mapping) {
+        // stderr as well: ggml's INFO/WARN can be filtered below llama.cpp's default threshold, and an
+        // engagement check that cannot be seen is worthless.
+        fprintf(stderr, "P1-PUSH: MOE_HOST_PUSH_SRC=mapping -- host-expert fills DMA straight from the model "
+                        "mapping (no pinned staging)\n");
+        GGML_LOG_WARN("%s: MOE_HOST_PUSH_SRC=mapping -- host-expert fills DMA straight from the model "
+                      "mapping (no pinned staging).  EXPERIMENTAL (wip/host-expert-eager-push P1)\n", __func__);
+    }
+}
+
