+bool ggml_cuda_vmm_region_grow_span(ggml_cuda_vmm_region * r, size_t off, size_t bytes) {
+    if (r == nullptr) {
+        return false;
+    }
+    if (bytes == 0) {
+        return true;
+    }
+    if (off > r->size || bytes > r->size - off) {
+        return false;
+    }
