+int32_t ggml_flash_attn_ext_get_kv_split_n_tail(const struct ggml_tensor * a) {
+    if (a->op != GGML_OP_FLASH_ATTN_EXT || a->src[8] == NULL) {
+        return 0;
+    }
+    return ggml_get_op_params_i32(a, 5);
