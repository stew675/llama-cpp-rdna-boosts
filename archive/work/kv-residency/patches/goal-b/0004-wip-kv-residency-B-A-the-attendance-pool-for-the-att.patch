+void ggml_kv_pool_set_page(
+        struct ggml_tensor * a,
+        int                   page_cells) {
+    GGML_ASSERT(a->op == GGML_OP_KV_POOL);
+    GGML_ASSERT(page_cells > 0);
+    ggml_set_op_params_i32(a, 0, page_cells);
+}
