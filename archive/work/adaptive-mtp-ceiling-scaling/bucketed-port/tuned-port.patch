+            n_m += ((double) delta - n_m) / (double) knobs("SPC_ALPHA", 8);
+
+            if (n_cool > 0) {
+                n_cool--;
+                return;
+            }
+
+            const double up = knobs("SPC_UP", 8)  / 10.0;
+            const double dn = knobs("SPC_DN", 20) / 10.0;
+
+            if (n_m >= up && n_cur < cap) {
                 n_cur++;
