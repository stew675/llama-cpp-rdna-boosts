+            delta = std::max(1, n_accepted - 1);
+        } else {
+            delta = n_accepted - n_cur;
+        }
+
+        if (knobs("SPC_MODE", 0) != 0) {
+            // proportional mode: track the drift as an EWMA of delta and move the
+            // depth whenever its magnitude says the depth is wrong. The drift
+            // carries the strength signal a threshold cannot: code sits at a
+            // weak negative drift just above its optimum (no drop), while a
