+                n_bucket -= bucket_cap();
+                n_cur++;
+                n_bucket += drop_pressure();
+            } else {
+                n_cur = cap;
+                n_bucket = bucket_cap();
+            }
+        } else if (n_bucket <= 0) {
+            // At or below low water mark
             if (n_cur > floor) {
