-        block_q8_1 * y_v, const int blocks_up, const float inv_hc, unsigned int * done) {
-    const int row = blockIdx.x;
+        block_q8_1 * y_v, const int blocks_up, const float inv_hc, unsigned int * done,
+        const float * xn, const float * w_inject_f32, const int nrows_inject_f32, const int ncols2, const int64_t xn_stride_t) {
+    // the F32 inject rows are the FIRST nrows_inject_f32 blocks: each reads a whole hc_dim row, ~10x a down row, so
+    // at the end of the grid they ran last and stretched its tail
+    const int row = (int) blockIdx.x - nrows_inject_f32;
     const int t   = blockIdx.y;
+    if (row < 0) {
+        // F32 inject rows (GGML_CUDA_HC_INJECT_DOWN, with the fused up+collapse): hc_mix_collapse_inject's inject
+        // block verbatim (256 threads, tid = 32*y + x is its threadIdx.x), the 1/hc-scaled logit into the inject tail
+        const int r   = (int) blockIdx.x;
+        const int tid = 32*threadIdx.y + threadIdx.x;
+        const float2 * x2 = (const float2 *) (xn + (int64_t) t*xn_stride_t);
+        const float2 * w2 = (const float2 *) (w_inject_f32 + (int64_t) r*2*ncols2);
+        float sumf = 0.0f;
+        for (int col2 = tid; col2 < ncols2; col2 += 256) {
