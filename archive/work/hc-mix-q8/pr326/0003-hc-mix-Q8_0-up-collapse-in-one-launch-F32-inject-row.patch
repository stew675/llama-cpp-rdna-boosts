+// hc_mix_up_silu_dot_band<8, 16, NT, 3, 10, true, true> (the up rows of 8 reference blocks) and the collapse of
+// their columns in one launch (GGML_CUDA_HC_UP_FUSE 1/2/3 = S 4/2/1 sub-blocks of 256 threads, I = 8/S slots each;
+// 0 = the two launches).  A fused block owns 32 consecutive columns j (2 units of 16) of all hc = 4 streams, i.e. the
+// reference blocks b = c*(n_embd/16) + u, c = 0..3, u = 2*blockIdx.x + {0, 1}: slot k = it*S + s runs reference
+// block (c = k/2, u = 2*blockIdx.x + k%2) with sub-block s, every thread with the reference block's thread index
+// (tid = 32*warp + lane within the sub-block) and the reference block's item math, so each warp's butterfly result
+// for row i is the reference's.  The per-warp results go to tmp[k][warp][t][i] (pre-zeroed like the reference's
+// partials) and the gate of row i is summed in the reference's order (warp 0, then warps 1..7); the gate never
+// leaves the block.  The collapse and its Q8_1 epilogue are hc_mix_collapse_inject's (warp t = token t, lane =
+// column), so the mixed row and its Q8_1 are bit-identical; the F32 inject rows run on the down-dots grid.
+template <int NT, int S>
+static __global__ void __launch_bounds__(S*256, 1) hc_mix_up_collapse_q8(
+        const block_q8_1 * y_pre, const block_q8_0 * w, const float * xn, float * dst,
+        const int n_embd, const int nrows, const int hc, const float inv_hc,
+        const int64_t xn_stride_t, const int64_t dst_stride_t, block_q8_1 * q8, const int64_t q8_stride_t) {
+    constexpr int nwarps = 8;
+    constexpr int RPB    = 16;
+    constexpr int BPR    = 10;
+    constexpr int MAXI   = 3;
+    constexpr int HC     = 4;
+    constexpr int C      = 2;            // 16-column units per fused block (32 columns: one whole Q8_1 group)
+    constexpr int K      = HC*C;         // reference blocks per fused block
+    constexpr int I      = K / S;        // slots per sub-block
+    static_assert(K % S == 0, "S must divide 8");
+    extern __shared__ block_q8_1 y_s[]; // [NT][BPR]
+    __shared__ float tmp[K][nwarps][NT][RPB];
+    const int lane = threadIdx.x;
+    const int s    = threadIdx.y / nwarps;
+    const int wy   = threadIdx.y % nwarps;   // the reference block's threadIdx.y
+    for (int k0 = 32*threadIdx.y + lane; k0 < K*nwarps*NT*RPB; k0 += 32*nwarps*S) {
+        (&tmp[0][0][0][0])[k0] = 0.0f;
+    }
+    constexpr int qi       = QI8_0;
+    constexpr int vdr      = VDR_Q8_0_Q8_1_MMVQ;
+    constexpr int n_groups = nwarps*32 / (qi/vdr);
+    constexpr int n_items  = RPB * BPR;
+    const int tid     = 32*wy + lane;
+    const int kqs     = vdr * (tid % (qi/vdr));
+    const int it0     = tid / (qi/vdr);
+    const int n_units = n_embd / RPB;
+    int  row0[I];
+    int  wq[I][MAXI][vdr];
+    half wdq[I][MAXI];
+#pragma unroll
+    for (int ii = 0; ii < I; ++ii) {
+        const int k = ii*S + s;
+        row0[ii] = RPB*((k / C)*n_units + C*blockIdx.x + k % C);
+#pragma unroll
+        for (int m = 0; m < MAXI; ++m) {
+            const int it = it0 + m*n_groups;
+            if (it < n_items && row0[ii] + it / BPR < nrows) {
+                const block_q8_0 * b = w + (int64_t) (row0[ii] + it / BPR) * BPR + it % BPR;
+#pragma unroll
+                for (int j = 0; j < vdr; ++j) {
+                    wq[ii][m][j] = get_int_b2(b->qs, kqs + j);
+                }
+                wdq[ii][m] = b->d;
+            }
+        }
+    }
+    {
+        const int * src = (const int *) y_pre;
+        int * dstw = (int *) y_s;
+        constexpr int nw = NT*BPR*sizeof(block_q8_1)/sizeof(int);
+        for (int k = 32*threadIdx.y + lane; k < nw; k += 32*nwarps*S) {
+            dstw[k] = src[k];
+        }
+    }
+    __syncthreads();
+
+    // rows touched by this warp (the same for every slot): its items are it = 8*warp + [0, 8) + m*n_groups
+    const int wit0 = (qi/vdr) == 4 ? 8*wy : (32/(qi/vdr))*wy;
+    uint32_t warp_rows = 0;
+#pragma unroll
+    for (int m = 0; m < MAXI; ++m) {
+        const int a = wit0 + m*n_groups;
+        const int b = min(a + 32/(qi/vdr) - 1, n_items - 1);
+        if (a < n_items) {
+            for (int i = a/BPR; i <= b/BPR; ++i) {
+                warp_rows |= 1u << i;
+            }
+        }
+    }
+#pragma unroll
+    for (int ii = 0; ii < I; ++ii) {
+        const int k = ii*S + s;
+        float val[MAXI][NT];
+        int   row_of[MAXI];
+#pragma unroll
+        for (int m = 0; m < MAXI; ++m) {
+            const int it = it0 + m*n_groups;
+            row_of[m] = -1;
+#pragma unroll
+            for (int t = 0; t < NT; ++t) {
+                val[m][t] = 0.0f;
+            }
+            if (it < n_items) {
+                const int i   = it / BPR;
+                const int kbx = it % BPR;
+                if (row0[ii] + i < nrows) {
+                    row_of[m] = i;
+#pragma unroll
+                    for (int t = 0; t < NT; ++t) {
+                        const block_q8_1 * yb = &y_s[t*BPR + kbx];
+                        int u[vdr];
+#pragma unroll
+                        for (int j = 0; j < vdr; ++j) {
+                            u[j] = get_int_b4(yb->qs, kqs + j);
+                        }
+                        val[m][t] = vec_dot_q8_0_q8_1_impl<float, vdr>(wq[ii][m], u, wdq[ii][m], __low2half(yb->ds));
+                    }
+                }
+            }
+        }
+#pragma unroll
+        for (int t = 0; t < NT; ++t) {
+            for (uint32_t mk = warp_rows; mk != 0; mk &= mk - 1) {
+                const int i = __builtin_ctz(mk);
+                float acc = 0.0f;
+#pragma unroll
+                for (int m = 0; m < MAXI; ++m) {
+                    if (row_of[m] == i) {
+                        acc += val[m][t];
+                    }
+                }
+                acc = warp_reduce_sum<32>(acc);
+                if (lane == 0) {
+                    tmp[k][wy][t][i] = acc;
+                }
+            }
+        }
+    }
+    __syncthreads();
+    if (threadIdx.y >= NT) {
+        return;
+    }
+    const int t  = threadIdx.y;
+    const int j  = 32*blockIdx.x + lane;
+    const int kk = lane / RPB;
+    const int i  = lane % RPB;
+    const float * xn_t = xn + (int64_t) t*xn_stride_t;
+    float * dst_t = dst + (int64_t) t*dst_stride_t;
+    float gate[HC];
+#pragma unroll
+    for (int c = 0; c < HC; ++c) {
+        const int k = c*C + kk;
+        float acc = tmp[k][0][t][i];
+#pragma unroll
+        for (int l = 1; l < nwarps; ++l) {
+            acc += tmp[k][l][t][i];
+        }
+        gate[c] = acc;
+    }
+    // hc_mix_collapse_inject's collapse (the reference's separate MUL and ADD roundings; contraction off here only,
+    // the dots above keep the band kernel's flags)
+    float xi;
+    {
+#pragma clang fp contract(off)
+        float pp[8];
+        for (int c = 0; c < hc; ++c) {
+            const float g = 1.0f / (1.0f + expf(-gate[c]));
+            pp[c] = xn_t[c*n_embd + j] * g;
+        }
+        float sum = pp[0];
+        for (int c = 1; c < hc; ++c) {
+            sum = sum + pp[c];
+        }
+        xi = sum * inv_hc;
+    }
+    dst_t[j] = xi;
+    if (q8 == nullptr) {
+        return;
+    }
+    float amax = fabsf(xi);
+    amax = warp_reduce_max<QK8_1>(amax);
+    const float  d = amax / 127.0f;
+    const int8_t q = amax == 0.0f ? 0 : roundf(xi / d);
+    const int  isum = warp_reduce_sum<QK8_1>((int) q);
+    block_q8_1 * y = q8 + (int64_t) t*q8_stride_t + j/QK8_1;
+    y->qs[lane] = q;
+    if (lane == 0) {
+        y->ds = make_half2(d, d * isum);
+    }
+}
