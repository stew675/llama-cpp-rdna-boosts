     const bool pre        = preq && (band || rpb_up == 16);
+    // up + collapse in one launch (hc_mix_up_collapse_q8; GGML_CUDA_HC_UP_FUSE 1/2/3 = S 4/2/1 sub-blocks, default 1,
+    // 0 = the two launches) and the F32 inject rows on the down-dots grid (GGML_CUDA_HC_INJECT_DOWN=0: their own small
+    // launch instead).  gfx1201, UD-IQ4_XS 4-token sites: up 17.6 + collapse_inject 5.6 + down 12.9 -> 18.5 + 13.4 us
+    // (S 2: 19.9 fused), bit-identical
