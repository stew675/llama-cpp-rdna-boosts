     }
-    dst_t[j] = sum * inv_hc;
+    const float xi = sum * inv_hc;
+    dst_t[j] = xi;
+    if (q8 == nullptr) {
+        return;
+    }
+    // warp-uniform: the j >= n_embd return above takes whole warps (n_embd % 32 == 0).  Exactly quantize_q8_1's
+    // arithmetic, including its correction term d * (integer sum of the quants) (upstream #31247)
+    const int lane = threadIdx.x % QK8_1;
+    float amax = fabsf(xi);
+    amax = warp_reduce_max<QK8_1>(amax);
+    const float  d = amax / 127.0f;
+    const int8_t q = amax == 0.0f ? 0 : roundf(xi / d);
+    const int  isum = warp_reduce_sum<QK8_1>((int) q);
+    block_q8_1 * y = q8 + (int64_t) t*q8_stride_t + j/QK8_1;
+    y->qs[lane] = q;
+    if (lane == 0) {
+        y->ds = make_half2(d, d * isum);
+    }
 }
 
