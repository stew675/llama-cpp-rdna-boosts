-    float * inject_t = inject + (int64_t) t*dst_stride_t;
+    float * inject_t = inject + (int64_t) t*inject_stride_t;
     if (blockIdx.x >= n_collapse_blocks) {
         // inject rows: one 256-thread block per inject row (mmvf numerics)
