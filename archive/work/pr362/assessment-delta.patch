-        return env == nullptr || atoi(env) != 0;
+        return env != nullptr && atoi(env) != 0;
     }();
     return enabled;
 }
 
+// One line at -lv 4 that proves the opt-in arm really launched (a numerics-changing opt-in whose arm
+// cannot be observed is not reviewable).
+static inline void ggml_cuda_fattn_tile_gqa6_fold_census(const int cc, const int gqa_ratio, const int n_q) {
+    static bool logged = false;
+    if (!logged) {
+        logged = true;
+        GGML_LOG_INFO("%s: padded GQA-6 tile fold ON (cc 0x%x, gqa_ratio %d, n_q %d, ncols1 1 / ncols2 8)\n",
+            __func__, cc, gqa_ratio, n_q);
+    }
+}
