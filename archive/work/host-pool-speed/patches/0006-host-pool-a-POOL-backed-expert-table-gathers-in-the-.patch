     /* .moe_cache_remap         = */ ggml_backend_cuda_moe_cache_remap,
+    /* .moe_cache_pool_backed   = */ ggml_backend_cuda_moe_cache_pool_backed,
 };
 
 static ggml_guid_t ggml_backend_cuda_guid() {
@@ -9519,6 +9522,12 @@ static int ggml_backend_cuda_device_moe_cache_band(ggml_backend_dev_t dev) {
     return moe_cache_enabled() ? moe_cache_max_tok_dev(ctx->device) : 0;
 }
 
+static bool ggml_backend_cuda_moe_cache_pool_backed(ggml_backend_t backend, const struct ggml_tensor * weight) {
+    // wip/host-pool-speed (#131): see the iface comment.  `backend->context` is the CUDA backend context.
+    ggml_backend_cuda_context * ctx = (ggml_backend_cuda_context *) backend->context;
+    return moe_cache_table_is_pool(weight, ctx->device);
+}
+
 static void ggml_backend_cuda_device_moe_cache_forget(ggml_backend_dev_t dev) {
     // r143: the model that registered this device's host-expert tables is being freed (`llama_model_free`).
     // Drop them before its host masters go: the deferred arena sizing fills EVERY registered table, so a
diff --git a/ggml/src/ggml-cuda/moe-expert-cache.cu b/ggml/src/ggml-cuda/moe-expert-cache.cu
index ff37dcfe9..e6fd7d397 100644
--- a/ggml/src/ggml-cuda/moe-expert-cache.cu
+++ b/ggml/src/ggml-cuda/moe-expert-cache.cu
@@ -5389,6 +5389,23 @@ void moe_cache_validate(const char * where) {
 // is fully device-resident -- `-ncmoe 0`, or a `-ncmoe` that did not offload, e.g. on unified memory --
 // can never take an input over, so the cache-band fusion guard must not stand anything down: a cache-on
 // run has to stay byte-identical to the cache-less one.  Returns false before sizing.
+bool moe_cache_table_is_pool(const struct ggml_tensor * weight, int device) {
+    // wip/host-pool-speed (#131): a routed expert table whose master is the read-only model MAPPING
+    // (`--host-experts pool`) is a "pool" table; one with a pinned, device-readable master is not.  Called
+    // from the scheduler's split, once per routed expert op, so keep it cheap: a linear scan over the
+    // registered tables (a few hundred) guarded by the same lock the registration uses.
+    if (weight == nullptr || device < 0) {
+        return false;
+    }
+    std::lock_guard<std::mutex> lock(g_mutex);
+    for (const table_t & t : g_tables) {
+        if (t.device == device && t.host == (const void *) weight->data) {
+            return !t.host_pinned && t.src_known;
+        }
+    }
+    return false;
+}
+
 bool moe_cache_has_tables() {
     if (!g_enabled) {
         return false;
diff --git a/ggml/src/ggml-cuda/moe-expert-cache.h b/ggml/src/ggml-cuda/moe-expert-cache.h
index 86e3f6c53..ee357ecbb 100644
--- a/ggml/src/ggml-cuda/moe-expert-cache.h
+++ b/ggml/src/ggml-cuda/moe-expert-cache.h
@@ -175,6 +175,12 @@ bool moe_cache_ready();
 // an input over, so its fusions must behave exactly as if it were disabled.
 bool moe_cache_has_tables();
 
+// wip/host-pool-speed (#131): true when the routed expert table backing `weight` on `device` is served by
+// the bounded pinned host POOL (`--host-experts pool`) instead of a pinned master.  The scheduler uses this
+// to send a pool-backed table to the device gather unconditionally: its whole-table staging is the slow
+// path at every width, while the gather reads the two pinned tiers on the device.
+bool moe_cache_table_is_pool(const struct ggml_tensor * weight, int device);
+
 // True only when EVERY table has a usable arena.  The cache-band fusion guard is global (one answer
 // for the whole graph) and the gate+up fused kernel indexes the gate lane with the up table's remap, so
 // a partially-failed cache (any allocation failed, or a budget below one expert) must stand its fusions
