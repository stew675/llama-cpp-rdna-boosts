diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index c9bd54590..93e8b423f 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -12177,8 +12177,33 @@ static ggml_backend_buffer_type_t ggml_backend_cuda_kv_region_buft_split_for_dev
     return nullptr;
 }
 
+// wip/prefill-transfer-overlap: a context may WANT to lose a fight for SM time (a decode co-scheduled with a
+// prefill), so its streams take a priority.  Streams are created lazily, so this must be called before the
+// context's first compute for it to take effect.
+static bool ggml_backend_cuda_set_stream_priority(ggml_backend_t backend, int priority) {
+    auto * ctx = static_cast<ggml_backend_cuda_context *>(backend->context);
+    if (ctx->stream_priority == priority) {
+        return true;
+    }
+    // the streams exist as soon as the context is built, so re-create them with the new priority.  This is
+    // only valid BEFORE the first compute (nothing is in flight, no cuBLAS handle is bound): the caller
+    // (llama_set_stream_priority) is documented that way.
+    for (int s = 0; s < GGML_CUDA_MAX_STREAMS; ++s) {
+        if (ctx->streams[ctx->device][s] != nullptr) {
+            (void) cudaStreamDestroy(ctx->streams[ctx->device][s]);
+            ctx->streams[ctx->device][s] = nullptr;
+        }
+    }
+    ctx->stream_priority = priority;
+    (void) ctx->stream();   // create the compute stream now, with the priority
+    return true;
+}
+
 static void * ggml_backend_cuda_reg_get_proc_address(ggml_backend_reg_t reg, const char * name) {
     GGML_UNUSED(reg);
+    if (strcmp(name, "ggml_backend_set_stream_priority") == 0) {
+        return (void *) ggml_backend_cuda_set_stream_priority;
+    }
     if (strcmp(name, "ggml_backend_cuda_kv_pool_mirror_buft") == 0) {
         return (void *) ggml_backend_cuda_kv_pool_mirror_buft_for_dev;
     }
