+    // wip/prefill-transfer-overlap [EXPERIMENTAL]: set the priority of this context's backend compute
+    // streams.  -1 = low, 0 = default, +1 = high.  A co-scheduled decode context wants LOW so that the
+    // prefill's kernels are scheduled first and the decode only fills the SMs the gather leaves idle; this
+    // is the hardware form of "spend the window, not the compute".  Must be called before the context's first
+    // compute (the streams are created lazily).  Returns false if no backend of this context implements it.
+    LLAMA_API bool llama_set_stream_priority(struct llama_context * ctx, int priority);
+
+    // wip/prefill-transfer-overlap [EXPERIMENTAL]: install a per-split yield hook.  It is called once for every
+    // graph split that issued a MoE device gather, AFTER the gather is enqueued on the backend's stream and
+    // immediately BEFORE that split's compute is launched -- the one host-visible window per layer.  The
+    // callee may enqueue work of its own, but from ITS OWN thread: the backend's stream is the per-thread
+    // default stream, so work submitted on the yielding thread would serialize behind the split.
+    LLAMA_API void llama_set_split_yield_callback(
+            struct llama_context * ctx,
+                          void (*callback)(void *),
+                                    void * user_data);
+
     // Set the number of threads used for decoding
     // n_threads is the number of threads used for generation (single token)
     // n_threads_batch is the number of threads used for prompt and batch processing (multiple tokens)
