         ggml_backend_sched_reset(sched.get());
         ggml_backend_sched_set_eval_callback(sched.get(), cparams.cb_eval, cparams.cb_eval_user_data);
+        // wip/prefill-transfer-overlap: re-installed per graph because the reset above drops the sched state
+        ggml_backend_sched_set_yield_callback(sched.get(), split_yield_cb, split_yield_data);
 
         //const auto t_start_us = ggml_time_us();
 
@@ -6832,6 +6834,30 @@ int32_t llama_n_threads_batch(llama_context * ctx) {
     return ctx->n_threads_batch();
 }
 
+bool llama_context::stream_priority_set(int priority) {
+    bool any = false;
+    for (auto & backend : backends) {
+        ggml_backend_dev_t dev = ggml_backend_get_device(backend.get());
+        ggml_backend_reg_t reg = dev ? ggml_backend_dev_backend_reg(dev) : nullptr;
+        if (reg == nullptr) {
+            continue;
+        }
+        auto fn = (ggml_backend_set_stream_priority_t) ggml_backend_reg_get_proc_address(reg, "ggml_backend_set_stream_priority");
+        if (fn != nullptr && fn(backend.get(), priority)) {
+            any = true;
+        }
+    }
+    return any;
+}
+
+bool llama_set_stream_priority(llama_context * ctx, int priority) {
+    return ctx->stream_priority_set(priority);
+}
+
+void llama_set_split_yield_callback(llama_context * ctx, void (*callback)(void *), void * user_data) {
+    ctx->split_yield_set(callback, user_data);
+}
+
 void llama_set_abort_callback(llama_context * ctx, bool (*abort_callback)(void * data), void * abort_callback_data) {
     ctx->set_abort_callback(abort_callback, abort_callback_data);
 }
