--- a/ggml/src/ggml-cuda/ggml-cuda-moe-cache-hooks.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda-moe-cache-hooks.cu
@@ -283,9 +283,137 @@ int64_t ggml_backend_cuda_moe_cache_band(ggml_backend_t backend) {
     return moe_cache_max_tok_dev(cuda_ctx->device);
 }
 
+
+// ---------------------------------------------------------------------------------------------------
+// WIP PROBE -- prefill-transfer-overlap campaign (wip/prefill-transfer-overlap/ in the delivery repo).
+// NEVER SHIPPED.  `MOE_PROBE_PF_OVERLAP=1` times the DEVICE GATHER on the compute stream, which is what
+// moves a pool-backed host-expert table's bytes during a prefill since `GGML_SCHED_DEVGATHER` (measured
+// 2.12x over the staging path).  It exists to answer one question the cache's census cannot: how much of
+// a partial-residency prefill's wall is the gather kernel -- i.e. how much a co-scheduled decode step
+// could attack.  Event pairs are folded with one stream synchronize per 64 calls, so the total is
+// accurate to within 64 gathers and the perturbation is one sync per 64.
+
+// The headroom test (`MOE_PROBE_PF_OVERLAP=2`): a compute-bound kernel launched on a SECOND stream right
+// after the gather.  It touches no global memory traffic beyond one store per block, so it models the
+// property a decode step needs -- SM work with no link use.  If the gather's own wall does not grow while
+// this runs, the gather's warps are waiting on the link and there is capacity to co-schedule into; if it
+// grows by ~the burn's duration, the device serialises and mechanism (D) has no window.
+static __global__ void pf_burn_kernel(float * out, int iters, float seed) {
+    float a = seed + (float) threadIdx.x;
+    float b = 1.000001f;
+    for (int i = 0; i < iters; ++i) {
+        a = __fmaf_rn(a, b, 0.5f);
+        b = __fmaf_rn(b, a, 1e-7f);
+    }
+    if (threadIdx.x == 0) {
+        out[blockIdx.x] = a + b;
+    }
+}
+
+static const bool g_pf_probe = [] {
+    const char * e = getenv("MOE_PROBE_PF_OVERLAP");
+    return e != nullptr && e[0] != '\0' && atoi(e) != 0;
+}();
+
+struct pf_probe_ring {
+    static const int CAP = 64;
+    hipEvent_t ev0[CAP] = {};
+    hipEvent_t ev1[CAP] = {};
+    hipEvent_t bv0[CAP] = {};
+    hipEvent_t bv1[CAP] = {};
+    hipStream_t burn_stream = nullptr;
+    float *     burn_out    = nullptr;
+    int        n     = 0;
+    long long  calls = 0;
+    long long  burn_launches = 0;
+    double     host_ms = 0.0;   // HOST wall inside moe_cache_gather_host (bookkeeping + launches)
+    double     ms    = 0.0;
+    double     burn_ms = 0.0;
+
+    void add_host(double ms_in) { host_ms += ms_in; }
+    void begin(hipStream_t st) {
+        if (n >= CAP) {
+            drain(st);
+        }
+        if (ev0[0] == nullptr) {
+            for (int i = 0; i < CAP; ++i) {
+                (void) hipEventCreate(&ev0[i]);
+                (void) hipEventCreate(&ev1[i]);
+                (void) hipEventCreate(&bv0[i]);
+                (void) hipEventCreate(&bv1[i]);
+            }
+            const char * mode = getenv("MOE_PROBE_PF_OVERLAP");
+            if (mode != nullptr && atoi(mode) >= 2) {
+                (void) hipStreamCreateWithFlags(&burn_stream, hipStreamNonBlocking);
+                (void) hipMalloc((void **) &burn_out, 64 * sizeof(float));
+            }
+        }
+        if (burn_stream != nullptr) {
+            // mode 3 (the BUDGET sweep): launch the decode-shaped workload only once every `every` gathers and
+            // with a tunable size, so the prefill's own cost curve against the co-scheduled work can be read.
+            // mode 2 launches one per gather at the default size (the headroom proof of pass 4).
+            static const int burn_iters = [] {
+                const char * e = getenv("MOE_PROBE_BURN_ITERS");
+                return e != nullptr && e[0] != '\0' ? atoi(e) : 2000000;
+            }();
+            static const int burn_every = [] {
+                const char * e = getenv("MOE_PROBE_BURN_EVERY");
+                return e != nullptr && e[0] != '\0' && atoi(e) > 0 ? atoi(e) : 1;
+            }();
+            if ((calls + n) % burn_every == 0) {
+                (void) hipEventRecord(bv0[n], burn_stream);
+                pf_burn_kernel<<<64, 256, 0, burn_stream>>>(burn_out, burn_iters, 0.25f);
+                (void) hipEventRecord(bv1[n], burn_stream);
+                burn_launches++;
+            }
+        }
+        (void) hipEventRecord(ev0[n], st);
+    }
+    void end(hipStream_t st) {
+        (void) hipEventRecord(ev1[n], st);
+        n++;
+    }
+    void drain(hipStream_t st) {
+        if (n == 0) {
+            return;
+        }
+        (void) hipStreamSynchronize(st);
+        for (int i = 0; i < n; ++i) {
+            float v = 0.0f;
+            (void) hipEventElapsedTime(&v, ev0[i], ev1[i]);
+            ms += v;
+            if (burn_stream != nullptr) {
+                float b = 0.0f;
+                (void) hipEventElapsedTime(&b, bv0[i], bv1[i]);
+                burn_ms += b;
+            }
+        }
+        calls += n;
+        n = 0;
+        fprintf(stderr, "MOE_PROBE_PF_OVERLAP: gather calls=%lld wall=%.1f ms (%.3f ms/call)"
+                        " burn=%.1f ms (%.3f ms/call) launches=%lld overlap=%.2f\n",
+                calls, ms, calls > 0 ? ms / (double) calls : 0.0,
+                burn_ms, calls > 0 ? burn_ms / (double) calls : 0.0, burn_launches,
+                host_ms, calls > 0 ? host_ms / (double) calls : 0.0,
+                (burn_ms > 0.0 && ms > 0.0) ? (burn_ms + ms) / fmax(ms, burn_ms) : 0.0);
+        fprintf(stderr, "MOE_PROBE_PF_HOST: calls=%lld host=%.1f ms (%.3f ms/call)\n",
+                calls, host_ms, calls > 0 ? host_ms / (double) calls : 0.0);
+    }
+};
+static pf_probe_ring g_pf_ring;
+// ---------------------------------------------------------------------------------------------------
+
 bool ggml_backend_cuda_moe_cache_gather(ggml_backend_t backend, const ggml_tensor * weight, const ggml_tensor * weight_cpy, const ggml_tensor * ids, size_t slice_off, int split_axis) {
     ggml_backend_cuda_context * ctx = (ggml_backend_cuda_context *) backend->context;
     ggml_cuda_set_device(ctx->device);   // issue #294: the scheduler leaves another split's device current
+    if (g_pf_probe) {
+        g_pf_ring.begin((hipStream_t) ctx->stream());
+        const int64_t t0 = ggml_time_us();
+        const bool ok = moe_cache_gather_host(weight, weight_cpy, ids, ctx->stream(), ctx->device, slice_off, split_axis);
+        g_pf_ring.add_host((ggml_time_us() - t0) / 1000.0);
+        g_pf_ring.end((hipStream_t) ctx->stream());
+        return ok;
+    }
     return moe_cache_gather_host(weight, weight_cpy, ids, ctx->stream(), ctx->device, slice_off, split_axis);
 }
 
