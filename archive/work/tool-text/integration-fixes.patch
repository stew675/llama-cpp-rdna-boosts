+// whether the tokens give the prompt back as text.  tool_text_tokenize() re-derives llama_vocab::tokenize's BOS/EOS and
+// per-fragment behaviour, so a vocab whose pre-tokenizer adds a prefix, normalizes a fragment or strips one (a
+// metaspace_prepend_scheme "first", a SOPRANO / NEMOTRON_3_5_EMBD / MMBERT pre-type, a <mask> LSTRIP) can move the text
+// the model reads.  This is the check common_chat_input_tokenize() makes: on a mismatch the request keeps its strings
+// BROKEN (the space fallback) instead of taking a token array that does not decode to the prompt.
+static bool tool_text_tokenize_ok(const llama_vocab * vocab, const std::string & prompt, const llama_tokens & toks) {
+    size_t b = 0;
+    size_t e = toks.size();
+    if (llama_vocab_get_add_bos(vocab) && b < e && toks[b] == llama_vocab_bos(vocab)) {
+        ++b;
+    }
+    if (llama_vocab_get_add_eos(vocab) && b < e && toks[e - 1] == llama_vocab_eos(vocab)) {
+        --e;
+    }
+    const llama_tokens body(toks.begin() + b, toks.begin() + e);
+    return common_detokenize(vocab, body, true) == tool_text_unmark(prompt);
+}
