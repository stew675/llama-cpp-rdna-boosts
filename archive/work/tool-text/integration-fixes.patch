+// the marked prompt with the marks taken out: the text the piecewise tokenization below has to give back
+static std::string tool_text_unmark(const std::string & prompt) {
+    std::string out;
+    for (size_t i = 0; i < prompt.size();) {
+        if (prompt.compare(i, TOOL_TEXT_OPEN.size(), TOOL_TEXT_OPEN) == 0) {
+            const size_t b = i + TOOL_TEXT_OPEN.size();
+            const size_t e = prompt.find(TOOL_TEXT_CLOSE, b);
+            out.append(prompt, b, e - b);
+            i = e + TOOL_TEXT_CLOSE.size();
+            continue;
+        }
+        out += prompt[i++];
+    }
+    return out;
+}
