From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bsp2020 <bsp2020@gmail.com>
Date: Sun, 15 Nov 2026 03:26:08 +0000
Subject: [PATCH 1/3] mmvf: GDN gate/beta fusion also for F32 projections
 (GGML_CUDA_FUSE_GATE_BETA_F32=0: off)

unsloth UD-IQ4_XS stores ssm_alpha / ssm_beta as F32, so the BF16-only gate/beta fusion did
not apply and each GDN layer ran the alpha GEMV, the beta GEMV and add_softplus_mul_bcast_f32.
The same fused launch with T = float: each row the plain F32 mul_mat_vec_f instantiation, the
epilogue add_softplus_mul_bcast_f32's arithmetic.  Bit-identical.  Each type keeps its own
switch (GGML_CUDA_FUSE_GATE_BETA_BF16 / _F32).  gfx1201 decode: -22 launches per draft step.
---
 ggml/src/ggml-cuda/mmvf.cu | 17 +++++++++++------
 1 file changed, 11 insertions(+), 6 deletions(-)

diff --git a/ggml/src/ggml-cuda/mmvf.cu b/ggml/src/ggml-cuda/mmvf.cu
index 350f0a998..f6a44d6da 100644
--- a/ggml/src/ggml-cuda/mmvf.cu
+++ b/ggml/src/ggml-cuda/mmvf.cu
@@ -611,7 +611,7 @@ static void mul_mat_vec_f_switch_fusion(
     }
 
     if (fusion.gb_x2 != nullptr) {
-        if constexpr (!is_multi_token_id && std::is_same_v<T, nv_bfloat16> && std::is_same_v<type_acc, float>) {
+        if constexpr (!is_multi_token_id && (std::is_same_v<T, nv_bfloat16> || std::is_same_v<T, float>) && std::is_same_v<type_acc, float>) {
             ggml_cuda_kernel_launch(mul_mat_vec_f<T, type_acc, ncols_dst, block_size, false, false, true>, launch_params,
                 x, y, ids, fusion, dst, ncols, nchannels_y, stride_row, stride_col_y, stride_col_dst,
                 channel_ratio, stride_channel_x, stride_channel_y, stride_channel_dst,
@@ -1152,7 +1152,7 @@ void ggml_cuda_mul_mat_vec_f(ggml_backend_cuda_context & ctx, const ggml_tensor
         fusion_local.sma_y_s1   = gb->sma_y_s1;
         fusion_local.sma_dst_s1 = gb->sma_dst_s1;
     } else if (gb) {
-        GGML_ASSERT(!fusion && !ids && src0->type == GGML_TYPE_BF16 && gb->gb_nrows == ne01);
+        GGML_ASSERT(!fusion && !ids && (src0->type == GGML_TYPE_BF16 || src0->type == GGML_TYPE_F32) && gb->gb_nrows == ne01);
         fusion_local.gb_x2    = gb->gb_x2;
         fusion_local.gb_dst2  = gb->gb_dst2;
         fusion_local.gb_dt    = gb->gb_dt;
@@ -1184,7 +1184,7 @@ void ggml_cuda_mul_mat_vec_f(ggml_backend_cuda_context & ctx, const ggml_tensor
     switch (src0->type) {
         case GGML_TYPE_F32: {
             const float * src0_d = (const float *) src0->data;
-            mul_mat_vec_f_cuda(src0_d, src1_d, ids_d, fusion_local, dst_d, ne00, ne01, ncols_dst, s01, stride_col_y, stride_col_dst,
+            mul_mat_vec_f_cuda(src0_d, src1_d, ids_d, fusion_local, dst_d, ne00, gb && gb->gb_x2 ? 2*ne01 : ne01, ncols_dst, s01, stride_col_y, stride_col_dst,
                 ne02, nchannels_y, nchannels_dst, s02, stride_channel_y, stride_channel_dst,
                 ne03,              ne3,           s03, s13,              s3,                 ids_stride, prec, ctx.stream());
         } break;
@@ -1386,14 +1386,17 @@ bool ggml_cuda_should_use_mmvf(const ggml_tensor * src0, int cc, int warp_size,
     }
 }
 
-// GDN gate/beta with BF16 projections (qwen4exp), decode and verify band (GGML_CUDA_FUSE_GATE_BETA_BF16=0: off):
+// GDN gate/beta with BF16 projections (qwen4exp), decode and verify band (GGML_CUDA_FUSE_GATE_BETA_BF16=0: off); also F32
+// projections (e.g. unsloth UD-IQ4_XS stores ssm_alpha/ssm_beta F32; GGML_CUDA_FUSE_GATE_BETA_F32=0: off) -- the same kernel
+// with T = float, each row the plain F32 mul_mat_vec_f instantiation, the epilogue add_softplus_mul_bcast_f32's arithmetic:
 //   gate = softplus(alpha_w x + dt) * a, beta = beta_w x (the sigmoid stays for the GATED_DELTA_NET fusion).
 // One mul_mat_vec_f launch computes both projections (alpha rows, then beta rows) and applies the gate chain to the
 // alpha rows before the store.  Each row runs the instantiation the unfused MUL_MAT would take, so both outputs are
 // bit-identical.  The Q8_0 pair is ggml_cuda_gate_beta_verify_try_fuse (mmvq.cu).  Returns 7 when fused, 0 otherwise.
 int ggml_cuda_gate_beta_bf16_try_fuse(ggml_backend_cuda_context & ctx, const ggml_cgraph * cgraph, int i) {
     static const bool fuse = [] { const char * e = getenv("GGML_CUDA_FUSE_GATE_BETA_BF16"); return e == nullptr || atoi(e) != 0; }();
-    if (!fuse || i + 7 >= cgraph->n_nodes || cgraph->nodes[i]->op != GGML_OP_MUL_MAT) {
+    static const bool fuse_f32 = [] { const char * e = getenv("GGML_CUDA_FUSE_GATE_BETA_F32"); return e == nullptr || atoi(e) != 0; }();
+    if (!(fuse || fuse_f32) || i + 7 >= cgraph->n_nodes || cgraph->nodes[i]->op != GGML_OP_MUL_MAT) {
         return 0;
     }
     const ggml_op ops[8] = {
@@ -1424,7 +1427,9 @@ int ggml_cuda_gate_beta_bf16_try_fuse(ggml_backend_cuda_context & ctx, const ggm
     const int cc        = ggml_cuda_info().devices[ctx.device].cc;
     const int warp_size = ggml_cuda_info().devices[ctx.device].warp_size;
     const int64_t nr    = wa->ne[1];
-    if (!dt || !ssm_a || wa->type != GGML_TYPE_BF16 || wb->type != GGML_TYPE_BF16 || y->type != GGML_TYPE_F32 ||
+    const bool pair_ok = (fuse && wa->type == GGML_TYPE_BF16 && wb->type == GGML_TYPE_BF16) ||
+                         (fuse_f32 && wa->type == GGML_TYPE_F32 && wb->type == GGML_TYPE_F32);
+    if (!dt || !ssm_a || !pair_ok || y->type != GGML_TYPE_F32 ||
             wa->view_src || wb->view_src || wa->ne[0] != wb->ne[0] || nr != wb->ne[1] || !ggml_are_same_stride(wa, wb) ||
             wa->ne[2] != 1 || wa->ne[3] != 1 || y->ne[2] != 1 || y->ne[3] != 1 ||
             y->ne[1] < 1 || y->ne[1] > MMVF_MAX_BATCH_SIZE || nr >= 3072 ||
-- 
