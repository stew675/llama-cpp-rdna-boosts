+// GDN gate / beta epilogue (Qwen3.5 / 3.6 / 3.8 ssm_alpha and ssm_beta of a type mmvq_gdn_epi_type takes; Q8_0 has the
+// prescan and gate/beta kernels): the chains after the two matmuls,
+//   alpha: RESHAPE -> ADD(dt) -> SOFTPLUS -> MUL(ssm_a),   beta: RESHAPE -> SIGMOID,
+// as the nodes directly after node `last` (any interleaving, nothing else in between) run as the epilogue of their
+// launch, which writes the MUL and SIGMOID outputs.  Returns the index of the last chain node, 0 when there is no match.
+// The ADD / MUL operand order does not matter (one IEEE add / multiply).  GGML_CUDA_FUSE_GDN_EPI=0: off.
+bool ggml_cuda_gdn_epi_enabled() {
+    static const bool on = [] { const char * e = getenv("GGML_CUDA_FUSE_GDN_EPI"); return e == nullptr || atoi(e) != 0; }();
+    return on;
+}
+
+struct mmvq_gdn_epi_m {
+    int ia = -1;                    // alpha / beta: indices into mm
+    int ib = -1;
+    ggml_tensor * gate = nullptr;   // MUL(softplus, ssm_a)
+    ggml_tensor * beta = nullptr;   // SIGMOID
+    const ggml_tensor * dt = nullptr;
+    const ggml_tensor * a  = nullptr;
+};
+
+static int mmvq_gdn_epi_find(const ggml_cgraph * cgraph, const int first, const int last, ggml_tensor * const * mm,
+                             const int n_mm, const int * mm_idx, mmvq_gdn_epi_m & m) {
+    if (!ggml_cuda_gdn_epi_enabled()) {
+        return 0;
+    }
+    const ggml_tensor * view[3] = { nullptr, nullptr, nullptr };   // the RESHAPE of mm[k]
+    int view_idx[3] = { -1, -1, -1 };
+    const ggml_tensor * add = nullptr;
+    const ggml_tensor * sp  = nullptr;
+    int add_idx = -1, sp_idx = -1, gate_idx = -1, beta_idx = -1;
+    const auto view_of = [&](const ggml_tensor * t) {
+        for (int k = 0; k < n_mm; ++k) {
+            if (view[k] != nullptr && t == view[k]) {
+                return k;
+            }
+        }
+        return -1;
+    };
+    int end = 0;
+    for (int k = last + 1; k < std::min(cgraph->n_nodes, last + 12) && end == 0; ++k) {
+        ggml_tensor * t = cgraph->nodes[k];
+        int v = -1;
+        if (t->op == GGML_OP_RESHAPE && m.gate != nullptr && t->src[0] == m.gate) {
+            // the gate's own RESHAPE (a view, nothing to run)
+        } else if (t->op == GGML_OP_RESHAPE) {
+            for (int q = 0; q < n_mm; ++q) {
+                if (t->src[0] == mm[q] && view[q] == nullptr) {
+                    v = q;
+                }
+            }
+            if (v < 0) {
+                return 0;
+            }
+            view[v] = t;
+            view_idx[v] = k;
+        } else if (t->op == GGML_OP_ADD && add == nullptr && (view_of(t->src[0]) >= 0 || view_of(t->src[1]) >= 0)) {
+            const bool s0 = view_of(t->src[0]) >= 0;
+            m.ia = view_of(s0 ? t->src[0] : t->src[1]);
+            m.dt = s0 ? t->src[1] : t->src[0];
+            add = t;
+            add_idx = k;
+        } else if (t->op == GGML_OP_UNARY && ggml_get_unary_op(t) == GGML_UNARY_OP_SOFTPLUS && add != nullptr && t->src[0] == add) {
+            sp = t;
+            sp_idx = k;
+        } else if (t->op == GGML_OP_MUL && sp != nullptr && (t->src[0] == sp || t->src[1] == sp) && m.gate == nullptr) {
+            m.gate = t;
+            m.a = t->src[0] == sp ? t->src[1] : t->src[0];
+            gate_idx = k;
+        } else if (t->op == GGML_OP_UNARY && ggml_get_unary_op(t) == GGML_UNARY_OP_SIGMOID && m.beta == nullptr && view_of(t->src[0]) >= 0) {
+            m.ib = view_of(t->src[0]);
+            m.beta = t;
+            beta_idx = k;
+        } else {
+            return 0;
+        }
+        if (m.gate != nullptr && m.beta != nullptr) {
+            end = k;
+        }
+    }
+    if (end == 0 || m.ia < 0 || m.ib < 0 || m.ia == m.ib) {
+        return 0;
+    }
+    const ggml_tensor * x_a = mm[m.ia];
+    const ggml_tensor * x_b = mm[m.ib];
+    const int64_t nvh = x_a->ne[0];
+    const auto f32c = [](const ggml_tensor * t) { return t->type == GGML_TYPE_F32 && ggml_is_contiguous(t); };
+    if (x_a->src[0]->type != x_b->src[0]->type || !mmvq_gdn_epi_type(x_a->src[0]->type) || x_b->ne[0] != nvh ||
+            !ggml_are_same_shape(x_a, x_b) || !f32c(x_a) || !f32c(x_b) || !f32c(add) || !f32c(sp) || !f32c(m.gate) || !f32c(m.beta) ||
+            !f32c(m.dt) || !f32c(m.a) || m.dt->ne[0] != nvh || ggml_nelements(m.dt) != nvh || m.a->ne[0] != nvh || ggml_nelements(m.a) != nvh ||
+            ggml_nelements(add) != ggml_nelements(x_a) || ggml_nelements(m.gate) != ggml_nelements(x_a) ||
+            ggml_nelements(m.beta) != ggml_nelements(x_b) || view_idx[m.ia] < 0 || view_idx[m.ib] < 0) {
+        return 0;
+    }
+    // the intermediates have no consumer outside the chain
+    const int idxs[8] = { mm_idx[m.ia], mm_idx[m.ib], view_idx[m.ia], add_idx, sp_idx, gate_idx, view_idx[m.ib], beta_idx };
+    const ggml_op ops[8] = { GGML_OP_MUL_MAT, GGML_OP_MUL_MAT, GGML_OP_RESHAPE, GGML_OP_ADD, GGML_OP_UNARY, GGML_OP_MUL,
+                             GGML_OP_RESHAPE, GGML_OP_UNARY };
+    const int outs[2] = { gate_idx, beta_idx };
+    if (!ggml_can_fuse_subgraph_ext(cgraph, idxs, 8, ops, outs, 2)) {
+        return 0;
+    }
+    // every node of the window that the launch writes (the chain outputs and any other matmul of the group)
+    int wr[4];
+    int n_wr = 0;
+    wr[n_wr++] = gate_idx;
+    wr[n_wr++] = beta_idx;
+    for (int k = 0; k < n_mm; ++k) {
+        if (k != m.ia && k != m.ib) {
+            wr[n_wr++] = mm_idx[k];
+        }
+    }
+    if (!ggml_cuda_check_fusion_memory_ranges(cgraph, first, end - first + 1, wr, n_wr)) {
+        return 0;
+    }
+    return end;
+}
+
+// GGML_CUDA_GDN_EPI_LOG=1: one line the first time each epilogue launch runs (proves the fusion fires).
+static void mmvq_gdn_epi_log(const char * what, const ggml_tensor * x, const int ncols) {
+    static const bool on = getenv("GGML_CUDA_GDN_EPI_LOG") != nullptr;
+    static bool seen[2] = { false, false };
+    const int w = ncols > 1;
