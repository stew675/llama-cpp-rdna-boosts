+// GDN gate / beta epilogue of a row concat (ggml_cuda_mm_fusion_args_host::gdn_*, mmvq_gdn_epi_find): the ADD(dt) ->
+// SOFTPLUS -> MUL(ssm_a) and SIGMOID nodes after ssm_alpha / ssm_beta, computed as unary.cu's op_softplus / op_sigmoid and
+// the binbcast add / mul compute them, with rounded add / mul so nothing contracts into an FMA: bit-identical.
+static constexpr __host__ __device__ bool mmvq_gdn_epi_type(ggml_type type) {
+    return type == GGML_TYPE_Q4_K || type == GGML_TYPE_Q5_K || type == GGML_TYPE_Q6_K || type == GGML_TYPE_IQ4_XS ||
+           type == GGML_TYPE_MXFP4;
+}
+
+static __device__ __forceinline__ float mmvq_gdn_epi(const float v, const int seg, const int row,
+                                                     const ggml_cuda_mm_fusion_args_device & fusion) {
+    if (seg == fusion.gdn_gate_seg) {
+        const float x = __fadd_rn(v, fusion.gb_dt[row]);
+        return __fmul_rn((x > 20.0f) ? x : log1pf(expf(x)), fusion.gb_a[row]);
+    }
+    if (seg == fusion.gdn_beta_seg) {
+        return 1.0f / (1.0f + expf(-v));
+    }
+    return v;
+}
+
