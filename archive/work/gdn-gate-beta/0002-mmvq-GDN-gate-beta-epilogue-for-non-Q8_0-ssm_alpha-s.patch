 ggml/src/ggml-cuda/common.cuh            |   9 +
 ggml/src/ggml-cuda/ggml-cuda-try-fuse.cu |   3 +
 ggml/src/ggml-cuda/ggml-cuda.cu          |   9 +-
 ggml/src/ggml-cuda/mmvq-ksplit-body.inc  |  15 +-
 ggml/src/ggml-cuda/mmvq.cu               | 269 ++++++++++++++++++++++-
 ggml/src/ggml-cuda/mmvq.cuh              |   3 +
 6 files changed, 299 insertions(+), 9 deletions(-)

