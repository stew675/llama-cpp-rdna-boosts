+// WIP (wip/mmq-pipeline): software-pipeline the MMQ k-loop. Runtime gate so the default path is
+// untouched; the host and the kernel must agree on the shared-memory layout (see the tile_y/tile_y2
+// /tile_x/tile_x2 pointer arithmetic in mul_mat_q_process_tile).
+static bool mmq_pipeline_enabled() {
+    static const bool enabled = getenv("GGML_CUDA_MMQ_PIPELINE") != nullptr;
+    return enabled;
+}
+
+// The pipelined path needs the MMA sram layout (the dp4a tile_x has no sram_stride) and is left off
+// for the fallback (non-128-row) kernel, the fused gate path and stream-k.
+static bool mmq_pipeline_eligible(const ggml_type type, const bool fallback, const bool has_gate, const int cc) {
+    if (!mmq_pipeline_enabled() || fallback || has_gate) {
+        return false;
+    }
+    return amd_wmma_available(cc) || amd_mfma_available(cc) || turing_mma_available(cc);
+}
+
+static size_t mmq_get_nbytes_shared(const ggml_cuda_mmq_config & config, const int cc, const bool pipeline = false) {
+    const size_t nbs_ids  = config.J*sizeof(int);
+    const size_t nbs_x    = ggml_cuda_mmq_get_nbytes_shared_x(config, cc);
+    const size_t nbs_y    = GGML_PAD(config.J * (sizeof(block_q8_1_mmq)), config.nthreads*sizeof(int));
+    if (pipeline) {
+        // [ids][tile_y][tile_y2][tile_x][tile_x2]
+        return nbs_ids + 2*nbs_y + 2*nbs_x;
+    }
+    return nbs_ids + nbs_x + nbs_y;
 }
 
