+// wip/host-expert-pinned-window: forward the gather's capability query to every simple backend.  The
+// scheduler asks this BEFORE it skips whole-table staging for a gatherable table; a NULL predicate means
+// "the historical behaviour" (skip and hope), and on a `-sm tensor` split a single declining device makes
+// the meta gather return false, which drops the whole split onto the slow host path (measured on a simple
+// backend with `--host-experts pool`: 49.6 t/s prefill on the first request).  So answer honestly: true only
+// if EVERY device says it will serve its slice.
+static bool ggml_backend_meta_moe_cache_gather_ok(ggml_backend_t backend, const struct ggml_tensor * weight,
+        const struct ggml_tensor * weight_cpy) {
+    if (weight == nullptr || weight_cpy == nullptr || weight->ne[2] < 2) {
+        return false;
+    }
+    if (!ggml_backend_buffer_is_meta(weight_cpy->buffer)) {
+        return false;
+    }
+    const size_t              n_backends = ggml_backend_meta_n_backends(backend);
+    const ggml_backend_meta_split_state ss = ggml_backend_meta_get_split_state(weight_cpy, /*assume_sync =*/ false);
+    if (ss.n_segments != 1 || ss.nr[0] != 1 || ss.axis < 0 || ss.axis >= GGML_MAX_DIMS) {
+        return false;
+    }
+    for (size_t j = 0; j < n_backends; j++) {
+        ggml_backend_t simple_backend = ggml_backend_meta_simple_backend(backend, j);
+        ggml_tensor *  simple_tensor  = ggml_backend_meta_buffer_simple_tensor(weight_cpy, j);
+        if (simple_tensor == nullptr || simple_backend->iface.moe_cache_gather_ok == nullptr ||
+                !simple_backend->iface.moe_cache_gather_ok(simple_backend, weight, simple_tensor)) {
+            return false;
+        }
+    }
+    return true;
+}
