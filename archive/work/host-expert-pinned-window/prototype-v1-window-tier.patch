+// Promote the page-rounded range covering `expert`'s whole host blob (which covers `src_off` and every
+// fused slice of a `-sm tensor` child).  Caller holds `g_mutex`; returns the entry index.
+static bool win_promote_locked(const table_t & t, int32_t expert, size_t * out_off, void ** out_dev) {
+    if (!g_win_on || t.host == nullptr || t.host_bytes == 0 || expert < 0 || expert >= t.n_experts) {
+        return false;
+    }
+    const size_t page = win_page();
+    const size_t off0 = (size_t) expert * t.host_bytes;
+    const size_t aoff = off0 & ~(page - 1);
+    const size_t aend = (off0 + t.host_bytes + page - 1) & ~(page - 1);
+    const size_t len  = aend - aoff;
+    if (len == 0 || aend > t.host_bytes * (size_t) t.n_experts) {
+        return false;
+    }
+    for (size_t i = 0; i < g_win.size(); i++) {
+        win_entry & e = g_win[i];
+        if (e.host == t.host && e.off == aoff && e.len == len) {
+            e.last = ++g_win_clock;
+            e.call = g_win_call;
+            g_win_hits++;
+            *out_off = aoff;
+            *out_dev = e.dev;
+            return true;
+        }
+    }
+    if (len > g_win_budget) {
+        g_win_denied++;
+        return false;   // a single expert blob cannot fit the window
+    }
+    if (g_win_bytes + len > g_win_budget + win_slack() && !win_trim_locked(len)) {
+        g_win_denied++;
+        return false;
+    }
+    device_guard dg(t.device >= 0 ? t.device : 0);
+    void * base = (void *) ((const char *) t.host + aoff);
+    if (cudaHostRegister(base, len, hipHostRegisterDefault) != cudaSuccess) {
+        const cudaError_t err = cudaGetLastError();
+        g_win_reg_fail++;
+        static bool warned = false;
+        if (!warned) {
+            warned = true;
+            GGML_LOG_WARN("%s: window register FAILED (off=%zu len=%zu): %s\n", __func__, aoff, len,
+                          cudaGetErrorString(err));
+        }
+        return false;
+    }
+    if (g_win_trace && (g_win_promotes & 255) == 0) {
+        fprintf(stderr, "WINDOW promotes=%lld hits=%lld demotes=%lld d2d=%lld h2d=%lld reg_fail=%lld "
+                "denied=%lld bytes=%zu/%zu\n", (long long) g_win_promotes, (long long) g_win_hits,
+                (long long) g_win_demotes, (long long) g_win_d2d, (long long) g_win_h2d,
+                (long long) g_win_reg_fail, (long long) g_win_denied, g_win_bytes, g_win_budget);
+    }
+    bool locked = false;
+#if !defined(_WIN32)
+    if (g_win_mlock) {
+        if (mlock(base, len) == 0) {
+            locked = true;
+            g_win_mlocked++;
+        } else {
+            g_win_mlock_fail++;
+            static bool warned = false;
+            if (!warned) {
+                warned = true;
+                GGML_LOG_WARN("%s: the host-expert window cannot mlock (RLIMIT_MEMLOCK?); residency is "
+                              "page-cache best-effort from here\n", __func__);
+            }
+        }
+    }
+#endif
+    // The copy kind is what decides the transport.  `cudaMemcpyHostToDevice` from a registered range is
+    // treated as a PAGEABLE upload by ROCm (staged through an internal bounce, ~1/4 the rate and known to
+    // tear under back-to-back use, see `expert_host_src`'s comment) even though the range is registered.
+    // Resolving the UVA alias and copying D2D from it takes the same fast path the pool's device alias
+    // does -- and this is why the pool's fill beat the first version of this window by 4x.
+    void * dev_alias = nullptr;
+    if (cudaHostGetDevicePointer(&dev_alias, (void *) ((const char *) t.host + aoff), 0) != cudaSuccess) {
+        (void) cudaGetLastError();
+        dev_alias = nullptr;
+    }
+    win_entry e;
+    e.host   = t.host;
+    e.off    = aoff;
+    e.len    = len;
+    e.dev    = dev_alias;
+    e.locked = locked;
+    e.call   = g_win_call;
+    e.last   = ++g_win_clock;
+    e.ev.assign((size_t) GGML_CUDA_MAX_DEVICES, nullptr);
+    g_win.push_back(std::move(e));
+    g_win_bytes += len;
+    g_win_promotes++;
+    *out_off = aoff;
+    *out_dev = dev_alias;
+    return true;
+}
