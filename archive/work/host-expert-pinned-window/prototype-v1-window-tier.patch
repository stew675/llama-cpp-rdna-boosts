+// A model (or a device) is going away: release every range registered over that master.
+static void win_forget_host_locked(const void * host) {
+    for (int i = (int) g_win.size() - 1; i >= 0; i--) {
+        if (g_win[(size_t) i].host == host) {
+            win_release_locked((size_t) i);
+        }
+    }
+}
