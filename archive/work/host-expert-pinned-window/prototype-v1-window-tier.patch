+// ---- wip/host-expert-pinned-window: the registered WINDOW tier --------------------------------------
+// ONE residency mechanism for a pageable (model-mapping-backed) host master, replacing the pool and the
+// per-table bounce on the fill path: register the mapping range covering an expert IN PLACE and DMA from
+// the page cache, instead of copying the expert into a second pinned buffer and DMAing from that.
+// Measured (wip/host-expert-pinned-window/README.md): a 1.66 MiB expert fill is 62 us vs the pool's 137 us,
+// and a cold (page-cache miss) fill is 2.3 ms vs 17 ms.
+//
+// Registered bytes ARE the budget: `MOE_EXPERT_WINDOW_MIB` caps them process-wide and the least recently
+// used range is released when the cap is exceeded, so "how much of the host expert set is pinned" is the
+// only knob -- 100 % is the old pinned master, a fraction is the old pool, and there is no second tier.
+//
+// A demote releases the registration (and the mlock); the pages stay in the page cache, so a re-promote is
+// cheap until the kernel reclaims them.  Residency is therefore a HOPE and the budget is the invariant:
+// nothing may assume a re-promote is free.  `MOE_EXPERT_WINDOW_MLOCK=1` (default) makes residency
+// deterministic (capped by RLIMIT_MEMLOCK; a refusal is counted and the window keeps working).
+//
+// Keyed by (host master, page-aligned offset) so the children of a `-sm tensor` split SHARE one registration
+// per expert blob, with per-device drain markers (`pool_slot_event`'s pattern).  A demote only runs for a
+// range every device's copy has finished reading -- never on a device synchronize.
+
+struct win_entry {
+    const void * host   = nullptr;   // the table's host master base
+    size_t       off    = 0;         // page-aligned byte offset into it
+    size_t       len    = 0;         // page-aligned length
+    bool         locked = false;     // mlock() succeeded
+    void *       dev    = nullptr;   // device alias of `host + off` (UVA); the fill copies D2D from it
+    int64_t      last   = 0;         // LRU clock
+    int64_t      call   = 0;         // the hook-call boundary this range was last promoted/used in
+    std::vector<cudaEvent_t> ev;     // per device: drain marker of the last copy out of this range
+};
+static std::vector<win_entry> g_win;
+static int64_t  g_win_call   = 0;                          // hook-call boundary counter
+static cudaEvent_t g_win_call_ev[GGML_CUDA_MAX_DEVICES] = {nullptr};  // "everything before this drained"
+
+static size_t win_page() {
+    static const size_t p = (size_t) sysconf(_SC_PAGESIZE);
+    return p != 0 ? p : 4096;
+}
+
+static cudaEvent_t win_ev(win_entry & e, int device) {
+    if (device < 0 || device >= GGML_CUDA_MAX_DEVICES) {
+        return nullptr;
+    }
+    if ((int) e.ev.size() <= device) {
+        e.ev.resize((size_t) GGML_CUDA_MAX_DEVICES, nullptr);
+    }
+    if (e.ev[(size_t) device] == nullptr) {
+        device_guard dg(device);
+        cudaEvent_t ev = nullptr;
+        if (cudaEventCreateWithFlags(&ev, cudaEventDisableTiming) != cudaSuccess) {
+            (void) cudaGetLastError();
+            return nullptr;
+        }
+        e.ev[(size_t) device] = ev;
+    }
+    return e.ev[(size_t) device];
+}
+
+// True when no device's copy may still be reading this range.
+static bool win_idle(const win_entry & e) {
+    for (cudaEvent_t ev : e.ev) {
+        if (ev == nullptr) {
+            continue;
+        }
+#if defined(GGML_USE_HIP)
+        const bool pending = hipEventQuery((hipEvent_t) ev) == hipErrorNotReady;
+#else
+        const bool pending = cudaEventQuery(ev) == cudaErrorNotReady;
+#endif
+        (void) cudaGetLastError();
+        if (pending) {
+            return false;
+        }
+    }
+    return true;
+}
+
+// Drop one registration: unregister the range, release the mlock, destroy the drain events.
+static void win_release_locked(size_t idx) {
+    win_entry & e = g_win[idx];
+    if (e.host != nullptr && e.len > 0) {
+        (void) cudaHostUnregister((void *) ((const char *) e.host + e.off));
+        (void) cudaGetLastError();
+#if !defined(_WIN32)
+        if (e.locked) {
+            (void) munlock((const char *) e.host + e.off, e.len);
+            g_win_mlocked--;
+        }
+#endif
+    }
+    for (cudaEvent_t ev : e.ev) {
+        if (ev != nullptr) {
+            (void) cudaEventDestroy(ev);
+        }
+    }
+    if (g_win_bytes >= e.len) {
+        g_win_bytes -= e.len;
+    } else {
+        g_win_bytes = 0;
+    }
+    g_win_demotes++;
+    // swap-and-pop: `e` is dead after this
+    g_win[idx] = g_win.back();
+    g_win.pop_back();
+}
