+// One hook call's fills are issued back to back on the compute stream, so during a burst almost every
+// entry is still in flight and nothing is demotable.  Demoting on the promote path therefore fails
+// exactly when the window is working hardest -- and the fill then fell through to the per-table BOUNCE
+// (a host memcpy), which is the one path this campaign exists to delete (measured: 4x decode regression
+// with the burst-trim policy).  Instead a burst may overshoot the budget by this slack, and the trim runs
+// ONCE at the next call boundary, when the previous call's copies have drained.
+static size_t win_slack() {
+    const size_t quarter = g_win_budget / 4;
+    return quarter > (64u << 20) ? quarter : (size_t) (64u << 20);
+}
+
+// Called once per hook call (a boundary on the compute stream).  A range promoted in call N is safe to
+// demote once the event recorded at the end of call N+1 has fired, so the whole set is classified with ONE
+// device query per call instead of one per entry -- the per-entry version was a device query inside a
+// rescan loop, i.e. O(n^2) queries per call, and measured as a 4x decode regression.
+// Residency is spread over g_win; demotion only ever touches ranges whose copies have provably drained.
+static void win_boundary_locked(int device) {
+    g_win_call++;
+    if (device < 0 || device >= GGML_CUDA_MAX_DEVICES) {
+        return;
+    }
+    cudaEvent_t & ev = g_win_call_ev[device];
+    if (ev == nullptr) {
+        if (cudaEventCreateWithFlags(&ev, cudaEventDisableTiming) != cudaSuccess) {
+            (void) cudaGetLastError();
+            ev = nullptr;
+        }
+    }
+}
+
+static void win_trim_to_budget_locked(int device) {
+    if (!g_win_on || g_win.empty() || g_win_bytes <= g_win_budget) {
+        return;
+    }
+    // Everything promoted at or before call N-1 is drained once the event recorded at boundary N-1 has
+    // fired; query it ONCE.
+    bool drained_prev = true;
+    if (device >= 0 && device < GGML_CUDA_MAX_DEVICES && g_win_call_ev[device] != nullptr) {
+#if defined(GGML_USE_HIP)
+        drained_prev = hipEventQuery((hipEvent_t) g_win_call_ev[device]) != hipErrorNotReady;
+#else
+        drained_prev = cudaEventQuery(g_win_call_ev[device]) != cudaErrorNotReady;
+#endif
+        (void) cudaGetLastError();
+    }
+    const int64_t safe_before = g_win_call - 1;   // entries with call <= safe_before are drained
+    if (!drained_prev) {
+        return;                                   // still in flight: overshoot for one call (the slack)
+    }
+    // Release LRU-first, all drained entries at once (no rescan, no per-entry query).
+    std::vector<size_t> cand;
+    cand.reserve(g_win.size());
+    for (size_t i = 0; i < g_win.size(); i++) {
+        if (g_win[i].call <= safe_before) {
+            cand.push_back(i);
+        }
+    }
+    std::sort(cand.begin(), cand.end(), [](size_t a, size_t b) { return g_win[a].last < g_win[b].last; });
+    for (size_t k = 0; k < cand.size() && g_win_bytes > g_win_budget; k++) {
+        // the vector swaps the last element into a released slot, so re-find by identity
+        const void * h = g_win[cand[k]].host;
+        const size_t o = g_win[cand[k]].off;
+        for (size_t i = 0; i < g_win.size(); i++) {
+            if (g_win[i].host == h && g_win[i].off == o) {
+                win_release_locked(i);
+                break;
+            }
+        }
+    }
+}
+
+// Free at least `need` bytes, used only when the budget refuses a promote.  Safety first: a candidate must
+// be from an earlier boundary AND its own drain event must have fired, so this can never unregister a range a
+// queued copy still reads.  Bounded work (at most 64 probes) because it sits on the fill path.
+static bool win_trim_locked(size_t need) {
+    for (int tries = 0; tries < 64 && g_win_bytes + need > g_win_budget; tries++) {
+        int best = -1;
+        for (int i = 0; i < (int) g_win.size(); i++) {
+            if (g_win[(size_t) i].call >= g_win_call) {
+                continue;   // promoted during THIS call: a copy may be queued for it
+            }
+            if (best < 0 || g_win[(size_t) i].last < g_win[(size_t) best].last) {
+                best = i;
+            }
+        }
+        if (best < 0) {
+            return false;
+        }
+        if (!win_idle(g_win[(size_t) best])) {
+            g_win[(size_t) best].call = g_win_call;   // still in flight: do not consider it again here
+            continue;
+        }
+        win_release_locked((size_t) best);
+    }
+    return g_win_bytes + need <= g_win_budget;
+}
