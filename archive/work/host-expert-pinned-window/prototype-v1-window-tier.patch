+// Record the drain marker for a promoted range AFTER its copy has been issued.
+static void win_done_locked(const void * host, size_t off, int device, void * stream) {
+    if (host == nullptr || stream == nullptr) {
+        return;
+    }
+    for (size_t i = 0; i < g_win.size(); i++) {
+        win_entry & e = g_win[i];
+        if (e.host == host && e.off == off) {
+            cudaEvent_t ev = win_ev(e, device);
+            if (ev != nullptr) {
+                (void) cudaEventRecord(ev, (cudaStream_t) stream);
+            }
+            return;
+        }
+    }
+}
