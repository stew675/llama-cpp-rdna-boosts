+// The prefetch pass: once per LAYER, on the first of its six visits, for every sibling host-weight table of
+// the same layer.  ONE expert per sibling -- the first routed expert that neither tier holds -- because the
+// measured demand set is 0.5-1 miss per table visit and a single staged expert covers it.  Caller holds
+// `g_mutex`.
+static void layer_prefetch_locked(table_t & cur, const int32_t * ids, size_t nb0, size_t nb1,
+                                  int64_t n_used, int64_t n_tok) {
+    if (!g_layer_prefetch || !g_pool_enabled || !table_master_pageable(cur)) {
+        return;   // a pinned master never bounces, so it has nothing to stage
+    }
+    if (g_pf_layer == cur.layer) {
+        return;   // this layer has already staged its siblings
+    }
+    g_pf_layer = cur.layer;
+    for (table_t & u : g_tables) {
+        if (u.layer != cur.layer || &u == &cur || u.host == nullptr || u.host_bytes == 0 ||
+            u.n_experts <= 0 || u.host_pinned || !u.src_known || u.expert_bytes == 0) {
+            continue;
+        }
+        host_pool_t * pool = table_pool_peek_locked(u);
+        // first routed expert that neither the arena nor the pool holds
+        int32_t want = -1;
+        for (int64_t tok = 0; tok < n_tok && want < 0; tok++) {
+            for (int64_t j2 = 0; j2 < n_used && want < 0; j2++) {
+                const int32_t e = *(const int32_t *) ((const char *) ids + (size_t) tok * nb1 + (size_t) j2 * nb0);
+                if (e < 0 || e >= u.n_experts) {
+                    continue;
+                }
+                if (u.expert_slot.find(e) != u.expert_slot.end()) {
+                    continue;   // arena-resident
+                }
+                if (pool != nullptr && pool_resident_locked(*pool, e)) {
+                    continue;   // pool-resident
+                }
+                want = e;
+            }
+        }
+        if (want < 0) {
+            continue;
+        }
+        int bounce = -1;
+        for (int i = 0; i < (int) u.bounce.size(); i++) {
+            if (u.bounce[(size_t) i].pf_expert < 0 && !u.bounce[(size_t) i].busy) {
+                bounce = i;
+                break;
+            }
+        }
+        if (bounce < 0) {
+            // no free entry: grow the ring exactly as the fallback path would (one entry per table prefetch)
+            bounce = bounce_acquire(u);
+            if (bounce < 0) {
+                continue;
+            }
+        }
+        pf_issue_locked(u, want, bounce, u.src_align);
+    }
+}
