+// ---------------------------------------------------------------------------------------------------
+// TODO #132: THE LAYER PREFETCH.  A layer's SIX host-weight visits (gate/up/down on each device) are
+// consecutive and share ONE routing -- measured 2026-11-11: `gate dev0, gate dev1, up dev0, up dev1, down
+// dev0, down dev1` for every layer -- so the ids the first visit reads back are an EXACT lookahead for the
+// other five.  That matters because the demand read is otherwise serial on the host thread while the device
+// is idle (measured: 44.6 fallback reads/token at 0.531 ms = 23.7 ms of a 58.6 ms step on a 2-device
+// 122B split).  The prefetch stages ONE expert per sibling table into that table's EXISTING pinned bounce
+// entry, on one worker thread, so its read runs beside the host's own demand work instead of after it.
+//
+// Deliberately minimal: no new buffer and no new tier (the entry is the one the fallback path already owns),
+// no eviction (a reserved entry is never handed to `bounce_acquire`), no expiry sweep (an unconsumed entry is
+// reclaimed by `bounce_acquire` once its read has finished), and no locking in the worker -- it is handed a
+// destination pointer, a file offset and (buffered mode) a mapping pointer, and it touches NO cache state, so
+// it cannot deadlock against the host's `g_mutex`.  `MOE_HOST_POOL_LAYER_PREFETCH=0` turns it off.
+//
+// SAFETY: the worker's destination is a `cudaHostAlloc`'d bounce buffer that only the model teardown frees,
+// and `moe_cache_forget_all` quiesces (joins) the worker before it frees any of them.
+#define PF_JOBS 4
+struct pf_job_t {
+    std::atomic<int> state{0};   // 0 = free, 1 = queued/running, 2 = done (the only state the host reads)
+    bool         ok      = false;
+    pool_fd_t    fd      = -1;
+    size_t       off     = 0;
+    size_t       len     = 0;
+    char *       dst     = nullptr;
+    const char * map     = nullptr;   // buffered mode: copy out of the model mapping instead of the file
+    size_t       align   = 4096;
+};
+static pf_job_t                     g_pf_jobs[PF_JOBS];
+static std::mutex                   g_pf_mu;
+static std::condition_variable      g_pf_cv;
+static std::vector<int>             g_pf_queue;
+static std::vector<std::thread>     g_pf_threads;
+static bool                         g_pf_stop = false;
+static int64_t                      g_pf_issued = 0, g_pf_used = 0, g_pf_notready = 0, g_pf_reclaimed = 0;
+static int                          g_pf_layer = -1;   // the layer whose prefetch pass has already run
+static bool g_layer_prefetch = [] {
+    const char * e = getenv("MOE_HOST_POOL_LAYER_PREFETCH");
+    return e == nullptr || atoi(e) != 0;
+}();
+
+static void pf_worker_main() {
+    for (;;) {
+        int idx = -1;
+        {
+            std::unique_lock<std::mutex> lk(g_pf_mu);
+            g_pf_cv.wait(lk, [] { return g_pf_stop || !g_pf_queue.empty(); });
+            if (g_pf_queue.empty()) {
+                if (g_pf_stop) { return; }
+                continue;
+            }
+            idx = g_pf_queue.back();
+            g_pf_queue.pop_back();
+        }
+        pf_job_t & j = g_pf_jobs[idx];
+        bool ok = false;
+        if (j.dst != nullptr && j.len > 0) {
+            if (j.fd >= 0) {
+                // The disk tier's own entry point, so the alignment handling is the fill path's, not a copy.
+                // `pool_dio_read`'s alignment bounce is thread-local, so a worker thread is safe here.
+                ok = pool_dio_read(j.fd, j.dst, j.len, j.off, j.align);
+            } else if (j.map != nullptr) {
+                memcpy(j.dst, j.map, j.len);   // buffered: the page cache IS the source, exactly as on the host
+                ok = true;
+            }
+        }
+        j.ok = ok;
+        j.state.store(2, std::memory_order_release);
+    }
+}
+
+// Start the workers on demand (a pool-backed run only) and quiesce them before any bounce entry is freed.
+static void pf_ensure_started_locked() {
+    if (!g_pf_threads.empty() || g_pf_stop) {
+        return;
+    }
+    // Two workers over four job slots: the measured knee is depth 4 (5.8 GiB/s against 3.3 at depth 1), and a
+    // layer stages at most one expert per sibling (five), so two in flight covers the realistic depth without
+    // parking an idle thread per slot on a process that may never use them.
+    for (int i = 0; i < 2; i++) {
+        g_pf_threads.emplace_back(pf_worker_main);
+    }
+}
+
+// Join every worker and forget the queue.  Called from `moe_cache_forget_all` while it holds `g_mutex`, so it
+// must take only `g_pf_mu`; the workers never take `g_mutex`, so this cannot deadlock.
+static void pf_quiesce_locked() {
+    if (g_pf_threads.empty()) {
+        return;
+    }
+    {
+        std::lock_guard<std::mutex> lk(g_pf_mu);
+        g_pf_stop = true;
+        g_pf_queue.clear();
+    }
+    g_pf_cv.notify_all();
+    for (std::thread & th : g_pf_threads) {
+        if (th.joinable()) {
+            th.join();
+        }
+    }
+    g_pf_threads.clear();
+    {
+        std::lock_guard<std::mutex> lk(g_pf_mu);
+        g_pf_stop = false;   // a later model load in the same process may prefetch again
+    }
+    for (int i = 0; i < PF_JOBS; i++) {
+        g_pf_jobs[i].state.store(0, std::memory_order_release);
+        g_pf_jobs[i].ok = false;
+    }
+}
