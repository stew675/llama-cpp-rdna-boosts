+// Where an expert's bytes for THIS table come from, and how much of them: the single place that decides the
+// slice geometry, shared by the fallback fill and the prefetch so they can never disagree.
+struct src_read_t {
+    size_t       off;   // file offset
+    size_t       len;   // bytes to read
+    char *       dst;   // where in the pinned entry the bytes belong
+    const char * map;   // the mapping address of the same run (buffered mode)
+};
+static src_read_t table_expert_read(const table_t & t, int expert, char * buf) {
+    const bool   trim   = table_slice_readable(t);
+    const size_t rd_off = trim ? t.src_off : 0;
+    src_read_t   r;
+    r.off = t.src_offs + (size_t) expert * t.host_bytes + rd_off;
+    r.len = trim ? t.expert_bytes : t.host_bytes;
+    r.dst = buf + rd_off;
+    r.map = t.host != nullptr ? (const char *) t.host + (size_t) expert * t.host_bytes + rd_off : nullptr;
+    return r;
+}
+
+// Issue ONE prefetch read into bounce entry `pf_expert` of `t`.  Caller holds `g_mutex`.
+static void pf_issue_locked(table_t & t, int expert, int bounce, size_t align) {
+    pf_ensure_started_locked();
+    int idx = -1;
+    for (int i = 0; i < PF_JOBS; i++) {
+        if (g_pf_jobs[i].state.load(std::memory_order_acquire) == 0) {
+            idx = i;
+            break;
+        }
+    }
+    if (idx < 0) {
+        return;   // every job is busy: this layer simply does not prefetch
+    }
+    const char * base = t.bounce[(size_t) bounce].host;
+    if (base == nullptr) {
+        return;
+    }
+    const src_read_t r = table_expert_read(t, expert, (char *) base);
+    pf_job_t & j = g_pf_jobs[idx];
+    j.ok    = false;
+    j.fd    = -1;
+    j.map   = nullptr;
+    j.off   = r.off;
+    j.len   = r.len;
+    j.dst   = r.dst;
+    j.align = align != 0 ? align : 4096;
+    if (g_pool_dio && pool_file_io_available() && t.src_known && !t.src_path.empty()) {
+        if (t.src_fd < 0) {
+            t.src_fd = pool_open_file(t.src_path.c_str(), g_pool_dio);
+            if (t.src_fd >= 0) {
+                pool_fd_align(t.src_fd, &t.src_align);
+            }
+        }
+        j.fd = t.src_fd;   // drained by `pf_quiesce_locked` before any teardown closes it
+    }
+    if (j.fd < 0) {
+        j.map = r.map;     // buffered (or a platform with no pool file I/O): the mapping is the source
+        if (j.map == nullptr) {
+            return;
+        }
+    }
+    t.bounce[(size_t) bounce].pf_expert = expert;
+    t.bounce[(size_t) bounce].pf_job    = idx;
+    g_pf_issued++;
+    j.state.store(1, std::memory_order_release);
+    {
+        std::lock_guard<std::mutex> lk(g_pf_mu);
+        g_pf_queue.push_back(idx);
+    }
+    g_pf_cv.notify_one();
+}
+
+// Wait for a prefetch job, bounded: a read that has not landed in this long is abandoned (the caller reads
+// the expert itself, which is the pre-prefetch behaviour, so a stalled device costs latency and nothing else).
+static bool pf_wait(int idx, int64_t max_us) {
+    if (idx < 0 || idx >= PF_JOBS) {
+        return false;
+    }
+    const int64_t t0 = ggml_time_us();
+    while (g_pf_jobs[idx].state.load(std::memory_order_acquire) != 2) {
+        if (ggml_time_us() - t0 > max_us) {
+            return false;
+        }
+        std::this_thread::yield();
+    }
+    return g_pf_jobs[idx].ok;
+}
