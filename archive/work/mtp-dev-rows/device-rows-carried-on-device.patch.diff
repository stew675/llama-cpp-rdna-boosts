+// The device-side half of the two calls above: one row of the buffer becomes another row of the buffer, queued on the
+// backend's own stream.  This is the steady-state MTP path (the target's carry row, see common/speculative.cpp): a host
+// round trip here costs a blocking event wait plus a blocking copy on both sides, per decode round, which measured
+// 1.5 % of the decode on Windows/HIP (GitHub issue #318).
+bool llama_context::copy_h_nextn_row(int64_t src_row, int64_t dst_row) {
+    const int64_t n_rows = h_nextn_dev ? h_nextn_dev->ne[1] : 0;
+    if (src_row < 0 || dst_row < 0 || src_row >= n_rows || dst_row >= n_rows || src_row == dst_row) {
+        return false;
+    }
+
+    // the same rule as a decode that overwrites the rows: do not clobber a row the reader has not consumed yet
+    if (ev_h_nextn_read_recorded) {
+        ggml_backend_event_wait(h_nextn_backend, ev_h_nextn_read.get());
+    }
+
+    const size_t nb1 = h_nextn_dev->nb[1];
+    h_nextn_row_src->data = (char *) h_nextn_dev->data + src_row*nb1;
+    h_nextn_row_dst->data = (char *) h_nextn_dev->data + dst_row*nb1;
+
+    ggml_backend_tensor_copy_async(h_nextn_backend, h_nextn_backend, h_nextn_row_src, h_nextn_row_dst);
+
+    // the copy is behind this record, so a reader that waits on the buffer (a decode with state rows) waits for the copy
+    ggml_backend_event_record(ev_h_nextn_written.get(), h_nextn_backend);
+    ev_h_nextn_written_recorded = true;
+
+    return true;
+}
