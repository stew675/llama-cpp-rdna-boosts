@@ -1388,6 +1388,28 @@ void launch_fattn(
         blocks_num.y = parallel_blocks;
         blocks_num.z = ntiles_z_gqa*K->ne[2]*Q->ne[3];
 
+        {
+            const char * fap = std::getenv("FA_FORCE_PARALLEL");
+            if (fap) {
+                parallel_blocks = std::atoi(fap);
+                blocks_num.y = parallel_blocks;
+            }
+            static const bool fa_pin = std::getenv("FA_PIN_PARALLEL") != nullptr;
+            if (fa_pin && Q->ne[1] <= 8) {
+                parallel_blocks = std::min(max_blocks_per_sm, ntiles_KV);
+                blocks_num.y = parallel_blocks;
+            }
+        }
+
+        {
+            static const bool fa_dbg = std::getenv("FA_DEBUG") != nullptr;
+            if (fa_dbg) {
+                std::fprintf(stderr, "[FA_DEBUG] nq=%lld ntiles_x=%d ntiles_dst=%d ntiles_KV=%d parallel=%d ncols=%d ncols1=%d ncols2=%d grid=(%u,%u,%u) max_bpsm=%d stream_k=%d\n",
+                    (long long) Q->ne[1], ntiles_x, ntiles_dst, ntiles_KV, parallel_blocks, ncols, ncols1, ncols2,
+                    blocks_num.x, blocks_num.y, blocks_num.z, max_blocks_per_sm, (int) stream_k);
+            }
+        }
+
         if (parallel_blocks > 1) {
             dst_tmp.alloc(parallel_blocks*ggml_nelements(KQV));
             dst_tmp_meta.alloc(parallel_blocks*ggml_nrows(KQV));
