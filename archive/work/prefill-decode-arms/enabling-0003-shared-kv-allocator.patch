+//
+// wip/prefill-decode-arms (T0): the co-owner pair's allocation handshake
+//
+
+void llama_kv_cache::alloc_release(const slot_info_vec_t & sinfos, size_t from) {
+    llama_kv_alloc * const v_alloc = alloc();
+    if (v_alloc == nullptr) {
+        return;
+    }
+
+    std::lock_guard<std::mutex> lk(v_alloc->m);
+
+    // a batch context that is destroyed before it applied every ubatch gives those cells back, so a cancelled or
+    // failed step cannot shrink the cache silently.  Un-marking a cell that was already committed is a no-op.
+    size_t n_rel = 0;
+    for (size_t i = from; i < sinfos.size(); ++i) {
+        const auto & sinfo = sinfos[i];
+        if (sinfo.empty()) {
+            continue;
+        }
+        for (uint32_t s = 0; s < sinfo.n_stream(); ++s) {
+            for (uint32_t idx : sinfo.idxs[s]) {
+                if (v_alloc->reserved[sinfo.strm[s]][idx]) {
+                    v_alloc->reserved[sinfo.strm[s]][idx] = 0;
+                    n_rel++;
+                }
+            }
+        }
+    }
+    if (n_rel > 0) {
+        v_alloc->n_release++;
+    }
+}
+
+void llama_kv_cache::alloc_head_pull(uint32_t strm, uint32_t v) {
+    llama_kv_alloc * const v_alloc = alloc();
+    if (v_alloc == nullptr) {
+        return;
+    }
+
+    std::lock_guard<std::mutex> lk(v_alloc->m);
+
+    if (v < v_alloc->heads[strm]) {
+        v_alloc->heads[strm] = v;
+    }
+}
+
+void llama_kv_cache::alloc_head_copy(uint32_t strm_dst, uint32_t strm_src) {
+    llama_kv_alloc * const v_alloc = alloc();
+    if (v_alloc == nullptr) {
+        return;
+    }
+
+    std::lock_guard<std::mutex> lk(v_alloc->m);
+
+    v_alloc->heads[strm_dst] = v_alloc->heads[strm_src];
+}
+
+void llama_kv_cache::alloc_head_set(uint32_t strm, uint32_t v) {
+    llama_kv_alloc * const v_alloc = alloc();
+    if (v_alloc == nullptr) {
+        return;
+    }
+
+    std::lock_guard<std::mutex> lk(v_alloc->m);
+
+    v_alloc->heads[strm] = v;
+}
+
+bool llama_kv_cache::alloc_sync(const char * tag) {
+    llama_kv_alloc * const v_alloc = alloc();
+    if (v_alloc == nullptr) {
+        return true;
+    }
+
+    std::lock_guard<std::mutex> lk(v_alloc->m);
+
+    size_t n_reserved = 0;
+    for (const auto & r : v_alloc->reserved) {
+        n_reserved += std::count(r.begin(), r.end(), 1);
+    }
+
+    // outstanding marks are LEGAL while a batch is prepared-but-not-yet-applied; at a request boundary they are a
+    // leaked prepare, which is what this call exists to say out loud
+    if (n_reserved != 0) {
+        LLAMA_LOG_WARN("%s: the KV allocation handshake still holds %zu reserved cell(s) at a request boundary "
+                "(reserve=%llu commit=%llu release=%llu)\n",
+                tag, n_reserved, (unsigned long long) v_alloc->n_reserve,
+                (unsigned long long) v_alloc->n_commit, (unsigned long long) v_alloc->n_release);
+        return false;
+    }
+
+    LLAMA_LOG_DEBUG("%s: KV allocation handshake clean (reserve=%llu commit=%llu release=%llu)\n",
+            tag, (unsigned long long) v_alloc->n_reserve, (unsigned long long) v_alloc->n_commit,
+            (unsigned long long) v_alloc->n_release);
+    return true;
 }
 
