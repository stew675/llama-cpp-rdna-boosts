diff --git a/src/llama-memory-recurrent.cpp b/src/llama-memory-recurrent.cpp
index 4048d27f5..b582830ad 100644
--- a/src/llama-memory-recurrent.cpp
+++ b/src/llama-memory-recurrent.cpp
@@ -774,6 +774,185 @@ bool llama_memory_recurrent::find_slot(const llama_ubatch & ubatch) {
     return n >= n_seqs;
 }
 
+// wip/prefill-decode-arms: the device-to-device handover of one sequence's recurrent state.
+//
+// Semantics are exactly state_write(LLAMA_STATE_SEQ_FLAGS_RECR_ONLY) followed by state_read() on the other
+// memory (see state_read_meta()), which is the shape the campaign's text oracle verified:
+//   * the destination's cells for this seq are dropped first (the destination may have served a previous
+//     request with the same seq id),
+//   * the source's cells are placed into ONE contiguous destination block, whose `pos` is the last one,
+//   * the rows are copied (source cells may map to logical rows through `src`, the pending-rollback plane),
+//   * every destination row is marked as its own source (`cells[i].src = i`), which is what state_read_meta()
+//     leaves behind, and the per-seq rollback index is reset.
+// The rows are what make this a handover: r (and the PLE conv row where the model has one) first, then s.
+bool llama_memory_recurrent::seq_state_take(llama_memory_recurrent & src, llama_seq_id seq_id) {
+    if (&src == this) {
+        return true;
+    }
+
+    const int32_t n_layer = hparams.n_layer();
+
+    if ((int32_t) src.r_l.size() != n_layer || (int32_t) src.s_l.size() != n_layer ||
+        (int32_t) src.p_l.size() != n_layer || n_rs_seq != src.n_rs_seq) {
+        return false;
+    }
+
+    auto same_tensor = [](const ggml_tensor * a, const ggml_tensor * b) {
+        if (a == nullptr || b == nullptr) {
+            return a == b;
+        }
+        return a->type == b->type && a->ne[0] == b->ne[0] && a->ne[1] == b->ne[1];
+    };
+
+    for (int32_t il = 0; il < n_layer; ++il) {
+        if (!same_tensor(r_l[il], src.r_l[il]) || !same_tensor(s_l[il], src.s_l[il]) ||
+            !same_tensor(p_l[il], src.p_l[il])) {
+            return false;
+        }
+    }
+
+    if (seq_id < 0 || (size_t) seq_id >= (size_t) n_seq_max) {
+        return false;
+    }
+
+    // the source's cells for this sequence, in cell order, with the logical row each one holds
+    std::vector<uint32_t>  srows;
+    std::vector<llama_pos> spos;
+    {
+        const uint32_t plane = n_rs_seq != 0 && (size_t) seq_id < src.rs_idx.size() ? src.rs_idx[seq_id] : 0;
+
+        for (uint32_t i = 0; i < src.size; ++i) {
+            const auto & cell = src.cells[i];
+            if (!cell.has_seq_id(seq_id)) {
+                continue;
+            }
+            srows.push_back(plane * src.size + (uint32_t) (cell.src >= 0 ? cell.src : (int32_t) i));
+            spos.push_back(cell.pos);
+        }
+    }
+
+    // the destination may still hold cells of a previous request that used this seq id
+    seq_rm(seq_id, -1, -1);
+
+    if (srows.empty()) {
+        src.seq_rm(seq_id, -1, -1);
+        return true;
+    }
+
+    if (srows.size() > size) {
+        return false;
+    }
+
+    // one contiguous destination block, allocated exactly the way state_read_meta() does it
+    llama_batch_allocr balloc(hparams.n_pos_per_embd());
+
+    llama_ubatch ubatch = balloc.ubatch_reserve((uint32_t) srows.size(), 1);
+    for (size_t i = 0; i < srows.size(); ++i) {
+        ubatch.pos[i] = spos[i];
+    }
+    ubatch.n_seq_id[0] = 1;
+    ubatch.seq_id[0]   = &seq_id;
+
+    if (!find_slot(ubatch)) {
+        return false;
+    }
+
+    const uint32_t dst_row0 = head;
+
+    if (dst_row0 + srows.size() > size) {
+        return false;
+    }
+
+    // views for the batched device copy (one sync for the whole handover); a host buffer takes a plain memcpy
+    ggml_init_params vparams = {
+        /*.mem_size   =*/ (size_t) 2*3*n_layer*ggml_tensor_overhead(),
+        /*.mem_buffer =*/ nullptr,
+        /*.no_alloc   =*/ true,
+    };
+
+    ggml_context * vctx = ggml_init(vparams);
+    if (vctx == nullptr) {
+        return false;
+    }
+
+    std::vector<const ggml_tensor *> csrc;
+    std::vector<ggml_tensor *>       cdst;
+    csrc.reserve(3*n_layer);
+    cdst.reserve(3*n_layer);
+
+    auto copy_tensor_rows = [&](ggml_tensor * dst, ggml_tensor * s, size_t row_size) {
+        const bool s_host = ggml_backend_buffer_is_host(s->buffer);
+        const bool d_host = ggml_backend_buffer_is_host(dst->buffer);
+
+        size_t i = 0;
+        while (i < srows.size()) {
+            size_t j = i + 1;
+            while (j < srows.size() && srows[j] == srows[j - 1] + 1) {
+                ++j;   // a run that is contiguous on the source side
+            }
+
+            const uint32_t n_rows = (uint32_t) (j - i);
+            const uint32_t s_row  = srows[i];
+            const uint32_t d_row  = dst_row0 + (uint32_t) i;
+
+            if (s_host && d_host) {
+                memcpy((char *) dst->data + d_row*row_size, (const char *) s->data + s_row*row_size,
+                        (size_t) n_rows*row_size);
+            } else {
+                csrc.push_back(ggml_view_2d(vctx, s,   s->ne[0],   n_rows, s->nb[1],   s_row*row_size));
+                cdst.push_back(ggml_view_2d(vctx, dst, dst->ne[0], n_rows, dst->nb[1], d_row*row_size));
+            }
+
+            i = j;
+        }
+    };
+
+    for (int32_t il = 0; il < n_layer; ++il) {
+        if (r_l[il] == nullptr) {
+            continue;
+        }
+
+        copy_tensor_rows(r_l[il], src.r_l[il], ggml_row_size(r_l[il]->type, hparams.n_embd_r()));
+
+        if (p_l[il] != nullptr) {
+            copy_tensor_rows(p_l[il], src.p_l[il], ggml_row_size(p_l[il]->type, hparams.ple_conv_state()));
+        }
+    }
+
+    for (int32_t il = 0; il < n_layer; ++il) {
+        if (s_l[il] == nullptr) {
+            continue;
+        }
+
+        copy_tensor_rows(s_l[il], src.s_l[il], ggml_row_size(s_l[il]->type, hparams.n_embd_s()));
+    }
+
+    if (!csrc.empty()) {
+        ggml_backend_tensor_copy_n(csrc.data(), cdst.data(), csrc.size());
+    }
+
+    ggml_free(vctx);
+
+    // the restored rows are their own source (what state_read_meta() leaves behind): BOTH fields, because
+    // find_slot() set `src0` to `rs_z`, which is this cell only while no other cell names it as a source
+    for (size_t i = 0; i < srows.size(); ++i) {
+        cells[dst_row0 + i].src  = (int32_t) (dst_row0 + i);
+        cells[dst_row0 + i].src0 = (int32_t) (dst_row0 + i);
+    }
+
+    if (n_rs_seq != 0) {
+        set_rs_idx(seq_id, 0);
+    }
+
+    // release the source rows -- the copy above has completed (the batched copy syncs, the memcpy is immediate)
+    src.seq_rm(seq_id, -1, -1);
+
+    LLAMA_LOG_DEBUG("%s: took seq %d: %zu row(s) from row %u -> %u\n", __func__, (int) seq_id, srows.size(),
+            srows[0], dst_row0);
+
+    return true;
+}
