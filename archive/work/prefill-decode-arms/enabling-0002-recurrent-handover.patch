+
+bool llama_memory_seq_state_take(
+        llama_memory_t mem,
+        llama_memory_t src,
+          llama_seq_id seq_id) {
+    if (!mem || !src || mem == src) {
+        return false;
+    }
+
+    // only a hybrid memory carries a recurrent state that has to follow a slot; a plain attention KV is
+    // already shared (the same cells), so it has nothing to move
+    auto * dst_hybrid = dynamic_cast<llama_memory_hybrid *>(mem);
+    auto * src_hybrid = dynamic_cast<llama_memory_hybrid *>(src);
+
+    if (dst_hybrid == nullptr || src_hybrid == nullptr) {
+        return false;
+    }
+
+    return dst_hybrid->get_mem_recr()->seq_state_take(*src_hybrid->get_mem_recr(), seq_id);
+}
