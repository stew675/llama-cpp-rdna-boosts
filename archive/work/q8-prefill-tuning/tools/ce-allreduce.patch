+// Select the stream number (0..GGML_CUDA_MAX_STREAMS-1) that every backend of this comm context uses
+// for subsequent work -- the hook that lets the meta backend put token chunks on different streams.
+// NOTE: stream 0 is the only safe one while the CUDA backend's automatic concurrent-branch fork/join
+// is active (it asserts curr_stream_no == 0), which today only happens for single-token (nrows <= 1)
+// attn_norm fan-outs, i.e. never during prefill.
+static void ggml_backend_cuda_comm_set_stream_no(void * comm_ctx_v, int stream_no) {
+    auto * comm_ctx = (ggml_backend_cuda_comm_context *) comm_ctx_v;
+    if (comm_ctx == nullptr) {
+        return;
+    }
+    for (size_t i = 0; i < comm_ctx->backends.size(); ++i) {
+        auto * cctx = (ggml_backend_cuda_context *) comm_ctx->backends[i]->context;
+        cctx->curr_stream_no = stream_no;
+    }
+}
