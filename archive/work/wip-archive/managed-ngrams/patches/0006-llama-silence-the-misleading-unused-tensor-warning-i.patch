From 3ff40bcdb63a6af57f333dc045a912370c379416 Mon Sep 17 00:00:00 2001
From: Stew Forster <stew675@gmail.com>
Date: Sun, 30 Aug 2026 17:33:26 -0500
Subject: [PATCH 6/7] llama : silence the misleading unused-tensor warning in
 managed mode

TENSOR_SKIP_MANAGED skips a tensor's data like TENSOR_SKIP but without the
"model has unused tensor ... ignoring" warning, which was wrong for the
qwen4exp PLE table (its data is read on demand by the managed reader).

Verified the shared common parser already wires --lazy-buffer-size into
llama-server via common_model_params_to_llama_params, so the server needs
no changes.

Assisted-by: Claude Sonnet
---
 src/llama-model-loader.cpp | 6 ++++--
 src/llama-model-loader.h   | 1 +
 src/llama-model.cpp        | 3 ++-
 src/llama-model.h          | 1 +
 src/models/qwen4exp.cpp    | 2 +-
 5 files changed, 9 insertions(+), 4 deletions(-)

diff --git a/src/llama-model-loader.cpp b/src/llama-model-loader.cpp
index 7893140ad..98e0e9de5 100644
--- a/src/llama-model-loader.cpp
+++ b/src/llama-model-loader.cpp
@@ -1176,9 +1176,11 @@ struct ggml_tensor * llama_model_loader::create_tensor(
         }
 
         // skip unused tensors
-        if (info.op == GGML_OP_NONE || (flags & TENSOR_SKIP)) {
+        if (info.op == GGML_OP_NONE || (flags & TENSOR_SKIP) || (flags & TENSOR_SKIP_MANAGED)) {
             const size_t nbytes = ggml_nbytes(t_meta);
-            LLAMA_LOG_WARN("model has unused tensor %s (size = %zu bytes) -- ignoring\n", tn.str().c_str(), nbytes);
+            if (!(flags & TENSOR_SKIP_MANAGED)) {
+                LLAMA_LOG_WARN("model has unused tensor %s (size = %zu bytes) -- ignoring\n", tn.str().c_str(), nbytes);
+            }
 
             size_data -= nbytes;
             n_created++;
diff --git a/src/llama-model-loader.h b/src/llama-model-loader.h
index 5439c1265..bc60f759b 100644
--- a/src/llama-model-loader.h
+++ b/src/llama-model-loader.h
@@ -70,6 +70,7 @@ struct llama_model_loader {
     static const int TENSOR_SKIP_IF_VIRTUAL = 1 << 3;
     static const int TENSOR_ALLOW_RESHAPE   = 1 << 4;
     static const int TENSOR_READ_LAZY       = 1 << 5; // read rows on demand instead of loading whole tensor; requires mmap for now
+    static const int TENSOR_SKIP_MANAGED    = 1 << 6; // like TENSOR_SKIP, but for a tensor whose data is read on demand elsewhere (managed lazy reader); no "unused tensor" warning
 
     int n_kv      = 0;
     int n_tensors = 0;
diff --git a/src/llama-model.cpp b/src/llama-model.cpp
index 4ccfa8dde..442bcd016 100644
--- a/src/llama-model.cpp
+++ b/src/llama-model.cpp
@@ -3134,7 +3134,8 @@ llama_model_base::llama_model_base(const struct llama_model_params & params) : l
     TENSOR_SKIP           (llama_model_loader::TENSOR_SKIP),
     TENSOR_SKIP_IF_VIRTUAL(llama_model_loader::TENSOR_SKIP_IF_VIRTUAL),
     TENSOR_ALLOW_RESHAPE  (llama_model_loader::TENSOR_ALLOW_RESHAPE),
-    TENSOR_READ_LAZY      (llama_model_loader::TENSOR_READ_LAZY) {}
+    TENSOR_READ_LAZY      (llama_model_loader::TENSOR_READ_LAZY),
+    TENSOR_SKIP_MANAGED   (llama_model_loader::TENSOR_SKIP_MANAGED) {}
 
 ggml_tensor * llama_model_base::create_tensor(const LLM_TN_IMPL & tn, const std::initializer_list<int64_t> & ne, int flags) {
     GGML_ASSERT(ml != nullptr);
diff --git a/src/llama-model.h b/src/llama-model.h
index 38066538e..d1dcb91ce 100644
--- a/src/llama-model.h
+++ b/src/llama-model.h
@@ -788,6 +788,7 @@ struct llama_model_base : public llama_model {
     const int TENSOR_SKIP_IF_VIRTUAL;
     const int TENSOR_ALLOW_RESHAPE;
     const int TENSOR_READ_LAZY;
+    const int TENSOR_SKIP_MANAGED;
 
     explicit llama_model_base(const llama_model_params & params);
     virtual ~llama_model_base() = default;
diff --git a/src/models/qwen4exp.cpp b/src/models/qwen4exp.cpp
index 1baa80815..243b06fc3 100644
--- a/src/models/qwen4exp.cpp
+++ b/src/models/qwen4exp.cpp
@@ -178,7 +178,7 @@ void llama_model_qwen4exp::load_arch_tensors(llama_model_loader & ml) {
             // kernel would fault the whole table in), so record it as a lazy range
             ml.lazy.add_range(ple_name, *ple_w);
             per_layer_tok_embd = create_tensor(tn(LLM_TENSOR_PER_LAYER_TOKEN_EMBD, "weight"),
-                                               { hparams.ple_head_dim, ple_rows }, TENSOR_SKIP);
+                                               { hparams.ple_head_dim, ple_rows }, TENSOR_SKIP_MANAGED);
         } else
 #endif // LLAMA_LAZY_READER_POSIX
         {
