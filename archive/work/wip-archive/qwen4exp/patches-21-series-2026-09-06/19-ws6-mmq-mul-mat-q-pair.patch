diff --git a/ggml/src/ggml-cuda/mmq.cu b/ggml/src/ggml-cuda/mmq.cu
index 9915f88d0..247af03a7 100644
--- a/ggml/src/ggml-cuda/mmq.cu
+++ b/ggml/src/ggml-cuda/mmq.cu
@@ -109,6 +109,155 @@ static void ggml_cuda_mul_mat_q_switch_type_gate(ggml_backend_cuda_context & ctx
     }
