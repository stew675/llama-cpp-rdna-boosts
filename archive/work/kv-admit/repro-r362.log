## kadrep.py
#!/usr/bin/env python3
# kadrep.py PORT LOG: KV admission repro at -c 65536 (stock r362): two ~12K requests at once (fit), two ~40K at once
# (do not fit together), one short request after.  Per request: timings, stop, sha; KV-related server log lines.
import hashlib, json, random, re, sys, threading, time, urllib.request, urllib.error
port, log = sys.argv[1], sys.argv[2]
A_ = "pump valve filter gauge sensor relay bearing rotor stator flange gasket impeller coupling manifold actuator solenoid".split()
B_ = "inspected replaced calibrated cleaned tightened lubricated tested rebuilt adjusted logged flagged measured".split()
def text(seed, n):
    R = random.Random(seed)
    return " ".join("Entry %d: the %s at station %d was %s by crew %d on day %d, reading %.2f." % (i, R.choice(A_), R.randrange(9000), R.choice(B_), R.randrange(97), R.randrange(365), R.random()*500) for i in range(n)) + "\nSummarize the entries above in one sentence."
def logpos(): return sum(1 for _ in open(log, errors="replace"))
def newl(p): return [l for i, l in enumerate(open(log, errors="replace")) if i >= p]
def one(name, p, ngen, out):
    try:
        r = json.load(urllib.request.urlopen(urllib.request.Request("http://127.0.0.1:%s/completion" % port, data=json.dumps({"prompt": p, "n_predict": ngen, "temperature": 0, "top_k": 1, "cache_prompt": True}).encode(), headers={"Content-Type": "application/json"}), timeout=3600))
        t = r["timings"]
        out[name] = "%-3s done %6.1f s | prompt %6d tok @ %5.0f t/s | gen %4d @ %5.1f t/s | sha %s | %s" % (name, time.time() - T0, t["prompt_n"], t["prompt_per_second"], t["predicted_n"], t["predicted_per_second"], hashlib.sha256(r["content"].encode()).hexdigest()[:8], r["content"][:40].replace("\n", " "))
    except urllib.error.HTTPError as e:
        out[name] = "%-3s HTTP %d after %.1f s: %s" % (name, e.code, time.time() - T0, e.read()[:180])
    except Exception as e:
        out[name] = "%-3s ERROR %s after %.1f s" % (name, e, time.time() - T0)
def run(title, jobs):
    global T0
    p0 = logpos(); out = {}; T0 = time.time()
    th = [threading.Thread(target=one, args=(n, p, g, out)) for n, p, g in jobs]
    for x in th: x.start(); time.sleep(0.2)
    for x in th: x.join()
    print("== %s (wall %.1f s)" % (title, time.time() - T0))
    for n, _, _ in jobs: print("   " + out[n])
    ev = [l for l in newl(p0) if re.search(r"KV admission|failed to find|decode: failed|retrying|speculative batch|exception|error|no free|context size|truncat", l, re.I)]
    for l in ev[:8]: print("      log: " + re.sub(r"^[0-9.]+ [A-Z] ", "", l.strip())[:170])
    sys.stdout.flush()
run("two ~12K at once (fit)", [("M1", text(21, 310), 128), ("M2", text(22, 310), 128)])
run("two ~40K at once (do not fit together in 64K)", [("L1", text(31, 1040), 128), ("L2", text(32, 1040), 128)])
run("one short after", [("S1", text(14, 25), 64)])
