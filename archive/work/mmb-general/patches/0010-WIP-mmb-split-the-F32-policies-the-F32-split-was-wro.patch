From 2b95e9ac736d8e9f4755d19dd0c36f4989b71296 Mon Sep 17 00:00:00 2001
From: Stew Forster <ci@rdna-boosts.invalid>
Date: Mon, 21 Sep 2026 12:37:31 -0500
Subject: [PATCH 10/28] WIP mmb: split the F32 policies -- the F32 split was
 wrongly gated off on RDNA4

S13 of wip/mmb-general/gfx1201-porting.md.  Host-side only.

The F32 paths shared one predicate: `f32cand` required mmb_f32split(), so
`GGML_CUDA_MMB_F32SPLIT=0` silently killed the tiny-M warp-per-token kernel
too; and the split *tile* was additionally gated behind mmb_dense_flag(), which
is off on RDNA4 -- so S7 had bundled the F32 split with the quantized dense
geometry and neither ever ran there.  Now:

    tiny-M kernel   <- mmb_tiny_m_f32_ok()      only
    split tile      <- mmb_f32split_mode()/min_m/min_k only

Measured on RDNA4, both against the delivery (Flash-Next IQ4_XS, 3-GPU tensor,
interleaved r=3):

    tiny-M kernel  +4.5 % pp8192 .. +5.2 % pp32768, flat to depth
    split tile     -0.3 % pp8192, +0.9 % pp32768, +1.00 % pp65536, +1.22 % pp98304

i.e. the split tile costs a fraction of a percent at the start and pays >1 %
once the context is deep -- which is where the time goes for a long run.  Both
stay on (RDNA4 arch defaults f32split_mode = 1, tiny_m = 1), which takes
qwen4exp from S12's +4.9 / +5.2 % to +6.7 / +6.5 % at pp8192/32768 and +6.2 %
at pp65536/98304.

On gfx1151 it was the opposite way round (the M=512 router won 2.4x on the
split tile, the hc-inject pair was worse on the tiny-M kernel), which is why
these are per-arch defaults.  gfx1151 semantics are unchanged for the default
mode 1; the only interface change is that F32SPLIT=0 now disables just the
split tile rather than all F32 MMB.

HC16 (and BLK16/RES16/DOWN16) were measured and are INERT on gfx1201, so they
stay default 0:
  * Flash-Next qwen4exp, pp32768 and pp65536: identical to base (its consumer,
    the quantized dense path, does not run there -- routed is off and the
    dense types are IQ3_S-only);
  * 27B UD-IQ3_S, where the conversion stream IS live (178 MMB_CVT lines) and
    the quantized dense path DOES run: HC16 931.22/855.09, BLK16 931.20/855.22,
    RES16 931.04/854.97, DOWN16 930.87/854.79 vs base 930.97/854.86 -- a 0.03 %
    spread.
So the "kill mmb_cvt_f32_bf16" lever has no measurable payoff on this arch.

Purity: same-seed greedy text is byte-identical to the delivery on 27B UD-IQ3_S
(42cdf36d0633), Flash-Next (d73f9238f6d6) and 35B UD-Q3_K_M (461ca8cd0e88).
Other models: 27B IQ3_S +0.54 / +0.49 %, MoE neutral (+0.13 / -0.11 %).
gfx1151: the device kernel set is byte-unchanged (host-side change).
---
 ggml/src/ggml-cuda/mmb.cu | 28 +++++++++++++++++++++++-----
 1 file changed, 23 insertions(+), 5 deletions(-)

diff --git a/ggml/src/ggml-cuda/mmb.cu b/ggml/src/ggml-cuda/mmb.cu
index d7a0ec76a..0ce405561 100644
--- a/ggml/src/ggml-cuda/mmb.cu
+++ b/ggml/src/ggml-cuda/mmb.cu
@@ -1498,6 +1498,15 @@ static mmb_arch_cfg mmb_arch_defaults(const int cc) {
         // (it now measures -1.4 %), see gfx1201-s10-dense-geometry.md §6.  The sub-knobs below
         // (glu/iq3xxs_glu/routed_thresh) are therefore inert on RDNA4.
         c.routed = 0;
+        // S13: the F32 split tile had been gated behind mmb_dense_flag() (S7 bundled them), which is
+        // off on RDNA4 -- so it never ran.  It should: measured against the delivery at each depth it
+        // is -0.3 % at pp8192, +0.9 % at pp32768, +1.00 % at pp65536 and +1.22 % at pp98304 on
+        // Flash-Next IQ4_XS (interleaved r=3), i.e. it costs a fraction of a percent at the start and
+        // pays >1 % once the context is deep -- which is where the time actually goes.  The tiny-M
+        // kernel (below) is the bigger win but flatter.  See the f32w comment and
+        // wip/mmb-general/gfx1201-s13-f32-hc16.md.
+        c.f32split_mode = 1;
+        c.tiny_m       = 1;
     }
     // TODO(S12): the routed/GLU thresholds, `tall_mode`, `tiny_m*`, `f32split_*` and `cache_max` are
     // still the gfx1151 values on every arch.  Give RDNA4 its own once they are measured per arch.
@@ -1921,15 +1930,24 @@ bool ggml_cuda_mmb_supported_mm(const ggml_tensor * src0, const ggml_tensor * sr
     // keeps its path.
     const bool quant   = mmb_wtype_ok_glu(src0->type) && (mmb_dense_type_ok(src0->type) || mmb_tall_shape(src0->type, K, M, T));
     const bool bf16w   = src0->type == GGML_TYPE_BF16 && mmb_bf16w() && mmb_dense_flag();
-    const bool f32cand = src0->type == GGML_TYPE_F32 && mmb_f32split();
+    const bool f32cand = src0->type == GGML_TYPE_F32;
     if (!quant && !bf16w && !f32cand) return false;
     // shape-aware F32 (mode 1, default): take only the shapes where MMB beat rocBLAS (see the
     // F32SPLIT comment above).  Mode 2 forces every F32 GEMM here; mode 0 never gets this far.
-    // The split *tile* is the generic MoE-router GEMM and follows mmb_dense_flag() (it loses on
-    // RDNA4 like the other dense GEMMs); the warp-per-token tiny-M kernel is the qwen4exp HC inject
-    // pair, a model-specific path, and stays allowed.
+    // S13: the two F32 paths are INDEPENDENT policies.  `mmb_f32split_mode()` governs only the split
+    // *tile* and `mmb_tiny_m_f32_ok()` only the tiny-M warp-per-token kernel -- they used to share
+    // one predicate, so turning the split off silently killed the tiny-M kernel too (and S7 had
+    // gated the split behind mmb_dense_flag(), which is off on RDNA4, so neither ran there).
+    //
+    // On RDNA4 the two carry different amounts and scale differently with depth (Flash-Next IQ4_XS,
+    // 3-GPU tensor, interleaved r=3, vs the delivery):
+    //     tiny-M kernel   +4.5 % pp8192 .. +5.2 % pp32768, flat to depth
+    //     split tile      -0.3 % pp8192, +0.9 % pp32768, +1.00 % pp65536, +1.22 % pp98304
+    // so BOTH stay on.  On gfx1151 it was the other way round (the M=512 router won 2.4x on the split
+    // tile and the hc inject pair was worse on the tiny-M kernel -- see the F32SPLIT comment above);
+    // that is why these are per-arch defaults now.
     const bool f32w = f32cand && (mmb_tiny_m_f32_ok(K, M) ||
-                       (mmb_dense_flag() && (mmb_f32split_mode() >= 2 || (M >= mmb_f32split_min_m() && K >= mmb_f32split_min_k()))));
+                       (mmb_f32split() && (mmb_f32split_mode() >= 2 || (M >= mmb_f32split_min_m() && K >= mmb_f32split_min_k()))));
     if (f32cand && !f32w) return false;   // this F32 shape is better on rocBLAS -- no fusion stand-down either
     if ((f32cand ? K % 32 : K % 64) != 0 || src1->ne[0] != K || dst->ne[0] != M) return false;
     if ((src0->type == GGML_TYPE_Q4_K || src0->type == GGML_TYPE_Q5_K || src0->type == GGML_TYPE_Q6_K || src0->type == GGML_TYPE_Q3_K || src0->type == GGML_TYPE_IQ4_XS || src0->type == GGML_TYPE_IQ3_S || src0->type == GGML_TYPE_IQ3_XXS || src0->type == GGML_TYPE_IQ2_S || src0->type == GGML_TYPE_IQ2_XS || src0->type == GGML_TYPE_IQ2_XXS) && K % 256 != 0) return false;   // whole 256-value super-blocks
