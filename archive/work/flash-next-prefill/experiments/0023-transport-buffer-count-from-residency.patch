+// wip/flash-next-prefill (session 5): the transport's buffer count as this split's devices report it, or 3 (the
+// pre-decision default) when none has a slab-backed ring.
+static int ggml_backend_meta_transport_bufs(ggml_backend_t meta_backend) {
+    const size_t n_backends = ggml_backend_meta_n_backends(meta_backend);
+    int n = 0;
+    for (size_t j = 0; j < n_backends; j++) {
+        const int v = ggml_backend_meta_dev_bufs(ggml_backend_meta_simple_backend(meta_backend, j));
+        if (v > 0 && (n == 0 || v < n)) {
+            n = v;
+        }
+    }
+    return n > 0 ? n : 3;
