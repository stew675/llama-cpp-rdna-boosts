+// Both read `GGML_SCHED_PINGPONG_BUFS` (deprecated alias `GGML_SCHED_STAGE_SLOTS`) first -- a user override always
+// wins, and `set` then declines.
+GGML_BACKEND_API int  ggml_backend_cuda_transport_bufs(void);
+GGML_BACKEND_API void ggml_backend_cuda_transport_bufs_set(int n);
+
