     ggml_backend_meta_context * backend_ctx = (ggml_backend_meta_context *) backend->context;
     const size_t n_backends = ggml_backend_meta_n_backends(backend);
@@ -3664,6 +3700,20 @@ static bool ggml_backend_meta_stage_input(ggml_backend_t backend, ggml_tensor *
     }
     const size_t n_chunks = gather ? size / chunk_size_full : 0;
 
+    // wip/flash-next-prefill (session 5): follow the transport's one number.  The residency rule that picks the
+    // count runs when the expert cache's arena settles, i.e. AFTER this backend was constructed, and it only
