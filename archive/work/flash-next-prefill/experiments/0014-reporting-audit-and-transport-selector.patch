+                    const size_t b = ggml_backend_meta_split_dev_bytes(t, &ss, n_devs, d);
+                    if (b > 0) {
+                        by_layer_dev[{layer, d}] += b;
+                    }
+                }
+            } else {
+                by_layer_dev[{layer, 0}] += ggml_nbytes(t);
+            }
+        }
+    }
+    size_t max_set = 0;
+    for (const auto & kv : by_layer_dev) {
+        if (kv.second > max_set) {
+            max_set = kv.second;
+        }
+    }
+    return max_set;
+}
