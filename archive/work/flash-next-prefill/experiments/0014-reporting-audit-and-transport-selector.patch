+    if (getenv("GGML_SCHED_STAGE_SELECT_DEBUG") != nullptr) {
+        static int64_t n = 0;
+        if (n++ < 12) {
+            GGML_LOG_WARN("%s: pp_on=%d pp_n_buf=%d n_splits=%d min_tokens=%lld\n", __func__,
+                          (int) sched->pp_on, sched->pp_n_buf, sched->n_splits,
+                          (long long) sched_stage_min_tokens(sched));
+        }
+    }
     if (sched->pp_on) {
         for (int i = 0; i < sched->n_splits && pp_n_host < (int) (sizeof(pp_host) / sizeof(pp_host[0])); i++) {
             if (sched_pp_split_set(sched, &splits[i], NULL) > 0) {
@@ -3999,6 +4094,28 @@ ggml_backend_sched_t ggml_backend_sched_new(
         // default.  It is two buffers, each sized once to the largest split's host-weight set, one fill in flight,
         // consumed in place -- GGML_SCHED_PINGPONG=0 selects the ring for the A/B.
         sched->pp_on = sched_pp_on();
+        // wip/flash-next-prefill (session 4): the ping-pong's buffers are BACKEND SLOTS (`stage_buffer` +
+        // `stage_upload` + `stage_wait`), an interface only a single-device backend implements.  A `-sm tensor`
+        // split is served by the META backend, which stages per DEVICE through `stage_input` instead, so the
+        // ping-pong must DECLINE there rather than call a NULL slot function (measured 2026-11-26: a 2-card
+        // `-sm tensor` arm with `GGML_SCHED_DEVGATHER=0` took a SIGSEGV inside `sched_pp_issue`; the split now
+        // falls through to the delivery's whole-split upload, which is the transport session 3 measured
+        // 2967-3141 t/s with).  A backend that stages nothing at all (CPU) is not a reason to decline.
+        if (sched->pp_on) {
+            for (int b = 0; b < sched->n_backends; b++) {
+                const ggml_backend_i * i = &sched->backends[b]->iface;
+                if (i->stage_buffer == NULL && i->stage_input == NULL) {
+                    continue;
+                }
+                if (i->stage_buffer == NULL || i->stage_upload == NULL || i->stage_wait == NULL) {
+                    sched->pp_on = false;
+                    GGML_LOG_INFO("%s: ping-pong staging off: %s stages per device (`stage_input`), and the "
+                                  "ping-pong needs backend slots -- a split uses the whole-split upload\n",
+                                  __func__, ggml_backend_name(sched->backends[b]));
+                    break;
+                }
+            }
+        }
         sched->pp_size = 0;
         sched->pp_cur  = 0;
         // Fixed for the process lifetime (see sched_pp_choose_bufs): 1 / 2 / 3 by the device's FREE VRAM here.
