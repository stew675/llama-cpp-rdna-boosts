            ggml_backend_buffer_get_usage(input->buffer) == GGML_BACKEND_BUFFER_USAGE_WEIGHTS &&
@@ -3739,6 +3826,14 @@ static enum ggml_status ggml_backend_sched_compute_splits(ggml_backend_sched_t s
     int  pp_host[256];
     int  pp_n_host = 0;
