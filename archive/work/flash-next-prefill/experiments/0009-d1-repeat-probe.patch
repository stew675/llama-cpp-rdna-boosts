index f7c3a7322..0b4c65637 100644
--- a/ggml/src/ggml-cuda/binbcast.cu
+++ b/ggml/src/ggml-cuda/binbcast.cu
@@ -435,7 +435,65 @@ static void ggml_cuda_op_bin_bcast(
