 }
 
+// wip/flash-next-prefill D1: a DEDICATED broadcast-copy kernel for the dense F32 case.  `op_repeat` used to run
+// through the generic binary-broadcast kernel, which computes a broadcasted source index PER ELEMENT and moves
+// one scalar at a time: measured on the qwen4exp hyper-connection expansion ([2560 x 4 x 8192] F32, 846 calls in
+// an 89k prefill) it costs 2622 ms = 7.4 % of the op budget, i.e. ~3.1 ms for 335 MB = ~108 GB/s -- a third of
+// what a vectorised copy of the same bytes reaches.  When dim 0 matches and both tensors are dense F32, the
+// output is just ne1*ne2*ne3 copies of one contiguous row block, so one block copies one row with float4 loads.
+// Bit-identical: a copy is a copy.  `GGML_CUDA_REPEAT_VEC=0` restores the generic kernel (A/B and bisection).
+static __global__ void k_repeat_f32_vec(float * __restrict__ dst, const float * __restrict__ src,
+                                        const int64_t ne0, const int64_t ne1, const int64_t ne2,
+                                        const int64_t ne01, const int64_t ne02, const int64_t ne03) {
+    const int64_t b  = blockIdx.x;                 // one block per destination row
+    const int64_t i1 = b % ne1;
+    const int64_t r  = b / ne1;
+    const int64_t i2 = r % ne2;
+    const int64_t i3 = r / ne2;
+    const int64_t row = (i1 % ne01) + ne01 * ((i2 % ne02) + ne02 * (i3 % ne03));
+    const float4 * s4 = (const float4 *) (src + row * ne0);
+    float4 *       d4 = (float4 *)       (dst + b   * ne0);
+    const int64_t  n4 = ne0 >> 2;
+    for (int64_t j = threadIdx.x; j < n4; j += blockDim.x) {
+        d4[j] = s4[j];
+    }
+}
+
 void ggml_cuda_op_repeat(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    // DEFAULT OFF: it is correct (text identical) but UNPROVEN.  At the widths this kernel actually sees -- the
+    // generation-width repeats, e.g. [2560 x 4 x 2] -- the op census shows no change (2683 vs 2671 ms), because the
+    // 89k-prefill REPEAT that costs 2622 ms (7.4 % of the op budget) is served by a FUSED window in
+    // `ggml-cuda-try-fuse.cu`, not by this dispatch.  Flip it on only with a per-width win; the prefill win has to
+    // be made inside that fusion (`RESULTS-session3.md` §11).
+    static const bool vec = [] {
+        const char * e = getenv("GGML_CUDA_REPEAT_VEC");
+        return e != nullptr && e[0] != '\0' && atoi(e) != 0;
+    }();
+    const ggml_tensor * src0 = dst->src[0];
+    if (vec && src0->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32 &&
+        src0->ne[0] == dst->ne[0] && (dst->ne[0] & 3) == 0 &&
+        src0->ne[3] == 1 && src0->ne[2] <= dst->ne[2] && src0->ne[1] <= dst->ne[1] &&
+        ggml_is_contiguous(src0) && ggml_is_contiguous(dst)) {
+        const int64_t n_rows = dst->ne[1] * dst->ne[2] * dst->ne[3];
+        if (n_rows > 0 && n_rows <= (int64_t) 0x7fffffff) {
+            k_repeat_f32_vec<<<(unsigned) n_rows, 256, 0, ctx.stream()>>>(
+                (float *) dst->data, (const float *) src0->data,
+                dst->ne[0], dst->ne[1], dst->ne[2], src0->ne[1], src0->ne[2], src0->ne[3]);
+            if (cudaGetLastError() == cudaSuccess) {
+                static const bool dbg = getenv("GGML_CUDA_REPEAT_VEC_DEBUG") != nullptr;
+                if (dbg) {
+                    static int n = 0;
+                    if (n++ < 4) {
+                        GGML_LOG_INFO("%s: repeat f32 vec path [%lld x %lld x %lld x %lld] rows=%lld\n", __func__,
+                                      (long long) dst->ne[0], (long long) dst->ne[1], (long long) dst->ne[2],
+                                      (long long) dst->ne[3], (long long) n_rows);
+                    }
+                }
+                return;
+            }
+            (void) cudaGetLastError();
+        }
+    }
     ggml_cuda_op_bin_bcast<bin_bcast_cuda<op_repeat, 0>>(dst, dst->src[0], dst, nullptr, dst->src[0]->data, dst->data, ctx.stream());
 }
 
