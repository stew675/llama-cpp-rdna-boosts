+// Compute the PLE n-gram rows for the whole logical batch in one pass and cache the
+// F32 result. The per-ubatch set_input() then just memcpy's its slice - no gather, no
+// hash, no OpenMP spin in the hot path. The table is read once per batch in sorted
+// row order (sequential mmap access) instead of N random-access gathers.
+//
+// Eligibility (otherwise the cache stays inactive and the per-ubatch path is used):
+//   - tokens present (no embd batch)
+//   - single sequence, positions contiguous starting at pos0 (typical prefill)
+//   - the first n_prev predecessors of the batch must be resolvable: either the batch
+//     starts the sequence (pos0 <= 0) or the cells exist in the attn cache
+void llama_model_qwen4exp::prepare_batch(const llama_batch & batch, const llama_memory_i * memory) const {
+    // reset the cache state unconditionally
+    ple_cache_valid = false;
+    ple_emb_full.clear();
+    ple_rows_full.clear();
+
+    static const bool disabled = []() {
+        const char * env = getenv("LLAMA_PLE_CACHE_DISABLE");
+        return env && atoi(env) != 0;
+    }();
+    if (disabled) {
+        return;
+    }
+
+    const auto & hp = hparams;
+    const int64_t n_heads = hp.ple_n_heads;
+    if (n_heads == 0) {
+        return;
+    }
+
+    if (batch.n_tokens < 2 || !batch.token) {
+        return;
+    }
+
+    // single seq, contiguous positions, starting from a position whose predecessors
+    // are either in this batch or already in the attn cache cells
+    const llama_seq_id seq = batch.seq_id[0][0];
+    const llama_pos pos0 = batch.pos[0];
+    for (int32_t i = 0; i < batch.n_tokens; ++i) {
+        if (batch.n_seq_id[i] != 1 || batch.seq_id[i][0] != seq || batch.pos[i] != pos0 + i) {
+            return;
+        }
+    }
+
+    // the whole batch must be a fresh prefill of the sequence, so that every predecessor
+    // (pos - n_prev ... pos - 1) is either within the batch or before the sequence start
+    // (reads as EOS). a batch that continues an existing sequence (pos0 > 0) needs the
+    // attn cache cells for its first tokens; resolve those from the memory object.
+    const auto * mem_hyb = static_cast<const llama_memory_hybrid_idx *>(memory);
+    const auto * kv_attn = mem_hyb ? mem_hyb->get_mem_attn() : nullptr;
+
+    const llama_token eos = hp.ple_eos_token_id;
+    const int64_t n_gram = hp.ple_ngram_size;
+    const int64_t per_gram = hp.ple_heads_per_ngram;
+    const int64_t head_dim = hp.ple_head_dim;
+
+    // resolve predecessor of (seq, p) from the batch if within, else from the attn cells
+    auto pred_of = [&](int64_t i, int64_t s) -> llama_token {
+        const llama_pos p = pos0 + i - s;
+        if (p >= pos0) {
+            return batch.token[i - s];
+        }
+        if (p < 0 || !kv_attn) {
+            return LLAMA_TOKEN_NULL;
+        }
+        // look up the newest cell at position <= p for this seq (the general scan does the
+        // same with its "below" fallback; contiguous batches have no M-RoPE gaps)
+        llama_token tok = LLAMA_TOKEN_NULL;
+        kv_attn->get_cells(seq).seq_pos_token_le(seq, p, &tok);
+        return tok;
+    };
+
+    std::vector<int32_t> idx((size_t) n_heads * batch.n_tokens);
+
+    for (int64_t i = 0; i < batch.n_tokens; ++i) {
+        // an EOS in the window resets everything at or before it; missing predecessor reads as EOS
+        // this is the exact same hash as llm_graph_input_ple::set_input()
+        std::vector<int64_t> ctx(n_gram);
+        ctx[0] = batch.token[i];
+        bool cut = false;
+        for (int64_t s = 1; s < n_gram; ++s) {
+            const llama_token t = cut ? LLAMA_TOKEN_NULL : pred_of(i, s);
+            cut = cut || t < 0 || t == eos;
+            ctx[s] = cut ? eos : t;
+        }
+        for (int64_t n = 2; n <= n_gram; ++n) {
+            uint64_t mixed = (uint64_t) ctx[0] * hp.ple_layer_multipliers[0];
+            for (int64_t j = 1; j < n; ++j) {
+                mixed ^= (uint64_t) ctx[j] * hp.ple_layer_multipliers[j];
+            }
+            const int64_t base = (n - 2) * per_gram;
+            for (int64_t g = 0; g < per_gram; ++g) {
+                const int64_t h_i = base + g;
+                idx[i * n_heads + h_i] =
+                    (int32_t) (mixed % hp.ple_head_vocab_sizes[h_i] + hp.ple_head_offsets[h_i]);
+            }
+        }
+    }
+
+    ple_rows_full = idx;
+
+    // gather+dequantize the rows in sorted order (sequential mmap reads) into the flat
+    // F32 layout [ple_head_dim*n_heads, n_tokens] that get_rows would produce
+    const ggml_tensor * tbl = per_layer_tok_embd;
+    const size_t row_size = ggml_row_size(tbl->type, head_dim);
+    const auto * traits = ggml_get_type_traits(tbl->type);
+    const ggml_to_float_t to_float = traits ? traits->to_float : nullptr;
+
+    const size_t n_rows = idx.size();
+    ple_emb_full.resize(n_rows * head_dim);
+
+    if (lazy_reader) {
+        // managed path: reuse the page-cached reader for the whole batch at once
+        lazy_reader->gather(idx.data(), idx.size(), ple_emb_full.data());
+    } else if (to_float && tbl->data) {
+        // mmap path: sort the (row, dst) pairs and read the table sequentially
+        std::vector<std::pair<int32_t, size_t>> order;
+        order.reserve(n_rows);
+        for (size_t k = 0; k < n_rows; ++k) {
+            order.emplace_back(idx[k], k * head_dim);
+        }
+        std::sort(order.begin(), order.end());
+
+        std::vector<float> tmp(head_dim);
+        size_t k = 0;
+        while (k < order.size()) {
+            const int32_t row = order[k].first;
+            to_float((const uint8_t *) tbl->data + (size_t) row * row_size, tmp.data(), head_dim);
+            while (k < order.size() && order[k].first == row) {
+                std::copy(tmp.begin(), tmp.end(), ple_emb_full.begin() + order[k].second);
+                ++k;
+            }
+        }
+    } else {
+        // cannot gather on host - leave the cache inactive
+        ple_emb_full.clear();
+        ple_rows_full.clear();
+        return;
+    }
+
+    ple_cache_pos0 = pos0;
+    ple_cache_seq  = seq;
+    ple_cache_n_tokens = batch.n_tokens;
+    ple_cache_valid = true;
+}
