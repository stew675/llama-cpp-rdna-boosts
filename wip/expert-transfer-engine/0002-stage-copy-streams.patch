 #include <algorithm>
 #include <cstdint>
 #include <cstring>
+#include <atomic>
+
+// wip/expert-transfer-engine (P1) -- HOW MANY COPY STREAMS THE FILL USES.
+//
+// One copy stream serializes DMA *issue* at a measured ~4.3 us per copy
+// (wip/expert-transfer-engine/h2d-probe.cpp, gfx1201, gen5 x16): a 290-copy per-expert fill runs at
+// 41.1 GB/s on one stream and 55.5 GB/s on two, which is a single-big-copy's 55.8 GB/s; four streams add
+// nothing.  A whole-table bulk upload issues 1 copy per table, so it cannot care.  The transports that
+// issue hundreds of copies per table (a per-expert staged fill, a run-coalesced fill) are the ones this
+// exists for, and the op count is exactly what made pruning look expensive.
+//
+// `MOE_STAGE_COPY_STREAMS=1` (default) = the pre-change behaviour, one stream, byte-identical.
+// Each fill lands wholly on ONE stream (its done event is recorded there), and `stage_wait` waits the
+// slot's free event on EVERY fill stream, so slot reuse stays ordered whichever stream picks it up.
+static int stage_copy_streams() {
+    static const int n = [] {
+        const char * e = getenv("MOE_STAGE_COPY_STREAMS");
+        int v = e != nullptr ? atoi(e) : 1;
+        if (v < 1) { v = 1; }
+        if (v > 4) { v = 4; }
+        return v;
+    }();
+    return n;
+}
+
+static cudaStream_t stage_copy_stream(ggml_backend_cuda_context * cuda_ctx) {
+    const int n = stage_copy_streams();
+    if (n <= 1) {
+        return cuda_ctx->copy_stream();
+    }
+    static std::atomic<unsigned> rr{0};
+    const unsigned k = rr.fetch_add(1, std::memory_order_relaxed);
+    return cuda_ctx->stream(cuda_ctx->device, 1 + (int) (k % (unsigned) n));
+}
 
