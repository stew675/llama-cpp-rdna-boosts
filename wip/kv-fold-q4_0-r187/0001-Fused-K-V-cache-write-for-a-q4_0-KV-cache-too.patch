 // FWHT as fwht_cuda and the same q8_0 quantization as k_set_rows_q8_0_group.  0: no match.
 // GGML_CUDA_FUSE_ROPE_FWHT=0: off.
+// cache types the fused K / V cache writes reproduce: q8_0, and q4_0 (GGML_CUDA_KV_FOLD_Q4_0=0: q8_0 only)
+static bool ggml_cuda_kv_fold_type_ok(const ggml_type t) {
+    static const bool q4 = getenv("GGML_CUDA_KV_FOLD_Q4_0") == nullptr || atoi(getenv("GGML_CUDA_KV_FOLD_Q4_0")) != 0;
+    // q4_0 needs wave32: its group quantizer ballots over the 32 lanes of one wave
+    return t == GGML_TYPE_Q8_0 || (q4 && t == GGML_TYPE_Q4_0 && ggml_cuda_info().devices[ggml_cuda_get_device()].warp_size == 32);
+}
