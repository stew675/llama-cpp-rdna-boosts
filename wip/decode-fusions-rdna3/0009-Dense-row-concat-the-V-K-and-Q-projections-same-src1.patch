+// Dense row concat: two or three 1-token matmuls over the same activation with the same weight type and K (e.g. the
+// V, K and Q projections of an attention layer) run as one ksplit launch, the rows of the others appended after the
+// largest weight.  Every row keeps its own unchanged dot product; RDNA3_0 only, where the launch config depends on the
+// row count only through small_m and the rows per block, which must agree for each weight and the total.
+// Returns the index offset of the last fused matmul.  GGML_CUDA_MMVQ_ROW_CONCAT=0: off.
+int ggml_cuda_mul_mat_row_concat_try_fuse(ggml_backend_cuda_context & ctx, const ggml_cgraph * cgraph, int i) {
+    static const bool on = getenv("GGML_CUDA_MMVQ_ROW_CONCAT") == nullptr || atoi(getenv("GGML_CUDA_MMVQ_ROW_CONCAT")) != 0;
+    ggml_tensor * node = cgraph->nodes[i];
+    if (!on || node->op != GGML_OP_MUL_MAT ||
+            get_device_table_id(ggml_cuda_info().devices[ctx.device].cc) != MMVQ_PARAMETERS_RDNA3_0) {
+        return 0;
+    }
+    const auto ok = [&](const ggml_tensor * t) {
+        return t->op == GGML_OP_MUL_MAT && (t->flags & GGML_TENSOR_FLAG_COMPUTE) && t->src[1] == node->src[1] &&
+               t->src[0]->type == node->src[0]->type && t->src[0]->ne[0] == node->src[0]->ne[0] &&
+               t->src[0]->nb[1] == node->src[0]->nb[1] && ggml_is_matrix(t->src[0]) && t->src[0]->buffer != nullptr &&
+               ggml_backend_buffer_get_usage(t->src[0]->buffer) != GGML_BACKEND_BUFFER_USAGE_COMPUTE &&
+               t->ne[1] == 1 && t->ne[2] == 1 && t->ne[3] == 1 && ggml_is_contiguous(t) &&
+               ggml_cuda_should_fuse_mul_mat_vec_q(t);
+    };
+    if (!ok(node)) {
+        return 0;
+    }
+    ggml_tensor * mm[3] = { node, nullptr, nullptr };
+    int n_mm = 1;
+    int last = i;
+    for (int j = i + 1; j < std::min(cgraph->n_nodes, i + 8) && n_mm < 3; ++j) {
+        ggml_tensor * t = cgraph->nodes[j];
+        if (ggml_cuda_is_view_or_noop(t)) {
+            continue;
+        }
+        if (!ok(t) || t->src[0] == node->src[0]) {
+            break;
+        }
+        mm[n_mm++] = t;
+        last = j;
+    }
+    if (n_mm < 2) {
+        return 0;
+    }
+    int main_k = 0;
+    for (int k = 1; k < n_mm; ++k) {
+        if (mm[k]->ne[0] > mm[main_k]->ne[0]) {
+            main_k = k;
+        }
+    }
+    const ggml_type type = node->src[0]->type;
+    const bool long_k = node->src[0]->ne[0] >= 4096;
+    int64_t total = 0;
+    for (int k = 0; k < n_mm; ++k) {
+        total += mm[k]->ne[0];
+    }
+    const bool small_m = mmvq_rdna3_0_small_m_weight(type, total);
+    const int rpb = calc_rows_per_block_weight(type, 1, MMVQ_PARAMETERS_RDNA3_0, false,
+                                               calc_nwarps_weight(type, 1, MMVQ_PARAMETERS_RDNA3_0, long_k, small_m));
+    for (int k = 0; k < n_mm; ++k) {
+        const int64_t n = mm[k]->ne[0];
+        if (mmvq_rdna3_0_small_m_weight(type, n) != small_m ||
+                (rpb > 1 && (n % rpb != 0 || n < rpb * GGML_MMVQ_RDNA4_WEIGHT_MIN_BLOCKS))) {
+            return 0;
+        }
+    }
+    ggml_cuda_mm_fusion_args_host fusion_data{};
+    for (int k = 0, c = 0; k < n_mm; ++k) {
+        if (k != main_k) {
+            fusion_data.cat_x[c]   = mm[k]->src[0];
+            fusion_data.cat_dst[c] = mm[k];
+            ++c;
+        }
+    }
+    ggml_cuda_mul_mat_vec_q(ctx, mm[main_k]->src[0], mm[main_k]->src[1], nullptr, mm[main_k], &fusion_data);
+    return last - i;
+}
