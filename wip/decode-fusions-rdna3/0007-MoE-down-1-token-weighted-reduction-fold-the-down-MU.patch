From a90932e315f329563bda80086e8c7f3fa060b611 Mon Sep 17 00:00:00 2001
From: bsp2020 <bsp2020@gmail.com>
Date: Thu, 29 Oct 2026 15:27:20 +0000
Subject: [PATCH 7/9] MoE down (1 token) + weighted reduction fold: the down
 MUL_MAT_ID armed by ggml_cuda_mwr_fold_mark writes the reduction from its
 last expert lane per row block (moe_weighted_reduction order and expression),
 8 rows per block to cut the counter atomics; the reduction fusion launches
 nothing. Bit-identical; Qwen3-30B tg128 +1.3 % on 7900 XTX.
 GGML_CUDA_MWR_FOLD=0 off

---
 ggml/src/ggml-cuda/common.cuh                 | 26 ++++++++++++
 ggml/src/ggml-cuda/ggml-cuda-try-fuse.cu      |  3 ++
 ggml/src/ggml-cuda/ggml-cuda.cu               |  4 ++
 ggml/src/ggml-cuda/mmvq-moe.cu                | 38 ++++++++++++++++-
 ggml/src/ggml-cuda/mmvq.cu                    | 14 +++++++
 ggml/src/ggml-cuda/moe-weighted-reduction.cu  | 41 +++++++++++++++++++
 ggml/src/ggml-cuda/moe-weighted-reduction.cuh |  1 +
 7 files changed, 126 insertions(+), 1 deletion(-)

diff --git a/ggml/src/ggml-cuda/common.cuh b/ggml/src/ggml-cuda/common.cuh
index f38fee513..d530c2096 100644
--- a/ggml/src/ggml-cuda/common.cuh
+++ b/ggml/src/ggml-cuda/common.cuh
@@ -1774,6 +1774,7 @@ bool ggml_cuda_fusion_disabled();
 
 #define GGML_CUDA_HC_Q8_CNT 1024
 #define GGML_CUDA_MOE_GLU_Q8_CNT 4096
+#define GGML_CUDA_MOE_RED_CNT 4096
 
 struct ggml_backend_cuda_context {
     int device;
@@ -1896,7 +1897,26 @@ struct ggml_backend_cuda_context {
     // kernel resets every counter it completes)
     int * hc_q8_cnt = nullptr;
     int * moe_glu_q8_cnt = nullptr;
+    int * moe_red_cnt = nullptr;
+    // MoE down + weighted reduction fold (ggml_cuda_mwr_fold_mark): armed at the down MUL_MAT_ID for its mmvq launch, which
+    // then also writes the reduction; the reduction fusion at (mwr_done_graph, mwr_done_idx) launches nothing.
+    const ggml_tensor * mwr_fold_experts = nullptr;
+    const ggml_tensor * mwr_fold_weights = nullptr;
+    const ggml_tensor * mwr_fold_scale   = nullptr;
+    ggml_tensor *       mwr_fold_dst     = nullptr;
+    int                 mwr_fold_idx     = -1;
+    const ggml_cgraph * mwr_fold_graph   = nullptr;
+    const ggml_cgraph * mwr_done_graph   = nullptr;
+    int                 mwr_done_idx     = -1;
     // (expert slot, 32-row group) counters of the fused MoE gate/up -> Q8_1 publish (mul_mat_vec_q_moe); self-resetting
+    int * moe_red_counters() {
+        if (moe_red_cnt == nullptr) {
+            CUDA_CHECK(ggml_cuda_device_malloc((void **) &moe_red_cnt, GGML_CUDA_MAX_STREAMS*GGML_CUDA_MOE_RED_CNT*sizeof(int), device));
+            CUDA_CHECK(cudaMemsetAsync(moe_red_cnt, 0, GGML_CUDA_MAX_STREAMS*GGML_CUDA_MOE_RED_CNT*sizeof(int), stream()));
+        }
+        return moe_red_cnt + curr_stream_no*GGML_CUDA_MOE_RED_CNT;
+    }
+
     int * moe_glu_q8_counters() {
         if (moe_glu_q8_cnt == nullptr) {
             CUDA_CHECK(ggml_cuda_device_malloc((void **) &moe_glu_q8_cnt, GGML_CUDA_MAX_STREAMS*GGML_CUDA_MOE_GLU_Q8_CNT*sizeof(int), device));
@@ -2780,6 +2800,12 @@ struct ggml_cuda_mm_fusion_args_device {
     block_q8_1 * glu_q8 = nullptr;
     int * glu_q8_cnt = nullptr;
     uint32_t glu_q8_stride_channel = 0;
+    // MoE down (1 token) + weighted reduction: the last expert lane of a row block writes
+    // red_dst[r] = sum_e (dst_e[r] * scale_e) * w_e in moe_weighted_reduction's order (red_dst = nullptr: off)
+    float * red_dst = nullptr;
+    const float * red_w = nullptr;
+    const float * red_scale = nullptr;
+    int * red_cnt = nullptr;
     // GDN alpha/beta pair in one mmvf launch (ggml_cuda_gate_beta_bf16_try_fuse): rows >= gb_nrows read gb_x2 and
     // write gb_dst2; rows below write softplus(v + gb_dt[row]) * gb_a[row].
     const void * gb_x2 = nullptr;
diff --git a/ggml/src/ggml-cuda/ggml-cuda-try-fuse.cu b/ggml/src/ggml-cuda/ggml-cuda-try-fuse.cu
index 820503fd8..4ad936ce7 100644
--- a/ggml/src/ggml-cuda/ggml-cuda-try-fuse.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda-try-fuse.cu
@@ -1689,8 +1689,11 @@ int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph * cgrap
         return 0;
     }
     if (ggml_cuda_cache_blocks_fusion(cuda_ctx, cgraph, i)) {
+        cuda_ctx->mwr_fold_experts = nullptr;
         return 0;
     }
+    // MoE down + weighted reduction fold (owned by moe-weighted-reduction.cu): arms the down MUL_MAT_ID, fuses no node
+    ggml_cuda_mwr_fold_mark(*cuda_ctx, cgraph, i);
     // a skipped GDN norm whose gate node was passed (taken by another fusion) or left in an earlier graph
     if (cuda_ctx->gdn_norm_pending != nullptr && (i == 0 || i > cuda_ctx->gdn_norm_gate_at)) {
         GGML_ABORT("GDN norm %s was skipped but its gate node was never reached", cuda_ctx->gdn_norm_pending->name);
diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index abdb2d3ad..f4089f81a 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -1415,6 +1415,9 @@ ggml_backend_cuda_context::~ggml_backend_cuda_context() {
     if (moe_glu_q8_cnt != nullptr) {
         CUDA_CHECK(cudaFree(moe_glu_q8_cnt));
     }
+    if (moe_red_cnt != nullptr) {
+        CUDA_CHECK(cudaFree(moe_red_cnt));
+    }
     h2d_stage_free();
 
     for (int i = 0; i < GGML_CUDA_MAX_STREAMS; ++i) {
@@ -6152,6 +6155,7 @@ static enum ggml_status ggml_backend_cuda_graph_compute(ggml_backend_t backend,
 
     // The Q8_1 input cache is only valid within one graph execution.
     cuda_ctx->q8_1_cache_clear();
+    cuda_ctx->mwr_done_graph = nullptr;
     cuda_ctx->bf16_src1_cache_clear();
     ggml_cuda_mmb_set_active_ctx(cuda_ctx);
     ggml_cuda_mmb_begin_graph();
diff --git a/ggml/src/ggml-cuda/mmvq-moe.cu b/ggml/src/ggml-cuda/mmvq-moe.cu
index a1e170431..41b53644b 100644
--- a/ggml/src/ggml-cuda/mmvq-moe.cu
+++ b/ggml/src/ggml-cuda/mmvq-moe.cu
@@ -213,6 +213,36 @@ static __global__ void mul_mat_vec_q_moe(
         dst[channel_dst*stride_channel_dst + token_idx*stride_col_dst + row0 + threadIdx.x] = result;
     }
 
+    // MoE down + weighted reduction (fusion.red_dst, 1 token, no shared lane): each expert lane of a row block counts in; the
+    // last one sums the block's rows over the experts as moe_weighted_reduction does (same order, same expression).
+    if constexpr (has_fusion) {
+        if (warp_size == 32 && fusion.red_dst != nullptr && !shared_expert) {
+            int * cnt = fusion.red_cnt + blockIdx.x;
+            __threadfence();
+            int prev = 0;
+            if (threadIdx.x == 0) {
+                prev = atomicAdd(cnt, 1);
+            }
+            prev = __shfl_sync(0xFFFFFFFF, prev, 0, 32);
+            if (prev == (int) nchannels_dst - 1) {
+                __threadfence();
+                if ((int) threadIdx.x < rows_valid) {
+                    const int   r  = row0 + threadIdx.x;
+                    const float s0 = fusion.red_scale != nullptr ? fusion.red_scale[0] : 1.0f;
+                    float sum = (__builtin_nontemporal_load(&dst[r]) * s0) * fusion.red_w[0];
+                    for (int e = 1; e < (int) nchannels_dst; ++e) {
+                        const float s = fusion.red_scale != nullptr ? fusion.red_scale[e] : 1.0f;
+                        sum += (__builtin_nontemporal_load(&dst[e*stride_channel_dst + r]) * s) * fusion.red_w[e];
+                    }
+                    fusion.red_dst[r] = sum;
+                }
+                if (threadIdx.x == 0) {
+                    *cnt = 0;
+                }
+            }
+        }
+    }
+
     // GLU output -> Q8_1 for the down projection (fusion.glu_q8, 1 token, routed lanes): the 32 rows of a Q8_1 block come from
     // 32/rpb blocks, so each block adds its rows to the (slot, group) counter and the block that completes the group quantizes
     // it with one warp exactly as quantize_q8_1 does (same 32-lane reductions and rounding), then resets the counter.
@@ -335,6 +365,11 @@ void mul_mat_vec_q_moe_launch(
             ((int64_t) nrows_x + 3) / 4 * nch >= 32 * (int64_t) ggml_cuda_info().devices[dev].nsm) {
         rpb = 4;
     }
+    // The down + weighted reduction fold costs one counter atomic per block: 8 rows per block quarters them.  Bit-identical
+    // under the same rule as above, or when n_groups <= 2 (even rows per block keep each row's group assignment).
+    if (fusion.red_dst != nullptr && rpb == 2 && n_groups > 0 && (blocks_per_row_x % n_groups == 0 || n_groups <= 2)) {
+        rpb = 8;
+    }
     const int64_t nblocks_rows = (nrows_x + rpb - 1) / rpb;
     // Upstream's fused shared-expert lane is the last blockIdx.y column.
     dim3 block_nums(nblocks_rows, nchannels_dst + (fusion.shared_up != nullptr));
@@ -345,7 +380,8 @@ void mul_mat_vec_q_moe_launch(
     const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params(block_nums, block_dims, 0, stream);
 
     const bool has_fusion = fusion.gate != nullptr || fusion.x_bias != nullptr || fusion.gate_bias != nullptr ||
-                            fusion.x_scale != nullptr || fusion.gate_scale != nullptr || fusion.x_scale_channel_dst;
+                            fusion.x_scale != nullptr || fusion.gate_scale != nullptr || fusion.x_scale_channel_dst ||
+                            fusion.red_dst != nullptr;
 
     const auto launch = [&](auto rpb_c, auto fusion_c) {
         constexpr int  RPB   = decltype(rpb_c)::value;
diff --git a/ggml/src/ggml-cuda/mmvq.cu b/ggml/src/ggml-cuda/mmvq.cu
index 2b642d355..35efa9d21 100644
--- a/ggml/src/ggml-cuda/mmvq.cu
+++ b/ggml/src/ggml-cuda/mmvq.cu
@@ -2119,6 +2119,20 @@ void ggml_cuda_mul_mat_vec_q(
         }
     }
 
+    // MoE down + weighted reduction fold, armed by ggml_cuda_mwr_fold_mark for this MUL_MAT_ID
+    if (ids && ctx.mwr_fold_experts == dst && ggml_cuda_info().devices[ctx.device].warp_size == 32 &&
+            fusion_local.gate == nullptr && fusion_local.shared_up == nullptr &&
+            fusion_local.x_bias == nullptr && fusion_local.x_scale == nullptr && dst->ne[2] == 1 && dst->ne[3] == 1 &&
+            ggml_is_contiguous(dst) && dst->ne[0] <= 2*GGML_CUDA_MOE_RED_CNT - 2) {
+        fusion_local.red_dst   = (float *) ctx.mwr_fold_dst->data;
+        fusion_local.red_w     = (const float *) ctx.mwr_fold_weights->data;
+        fusion_local.red_scale = ctx.mwr_fold_scale ? (const float *) ctx.mwr_fold_scale->data : nullptr;
+        fusion_local.red_cnt   = ctx.moe_red_counters();
+        ctx.mwr_done_graph = ctx.mwr_fold_graph;
+        ctx.mwr_done_idx   = ctx.mwr_fold_idx;
+    }
+    ctx.mwr_fold_experts = nullptr;
+
     // If src0 is a temporary compute buffer, clear any potential padding.  A redirected expert
     // table (wip/moe-expert-cache) carries no buffer; its compact arena has no padding to clear,
     // and `ggml_nbytes(src0)` would describe the full expert count, so the memset below would run
diff --git a/ggml/src/ggml-cuda/moe-weighted-reduction.cu b/ggml/src/ggml-cuda/moe-weighted-reduction.cu
index 4fa79d458..a91c2c4b1 100644
--- a/ggml/src/ggml-cuda/moe-weighted-reduction.cu
+++ b/ggml/src/ggml-cuda/moe-weighted-reduction.cu
@@ -335,7 +335,48 @@ int ggml_cuda_moe_weighted_reduction_try_fuse(ggml_backend_cuda_context & ctx, c
     if (!ggml_cuda_check_fusion_memory_ranges(cgraph, i, count, &output_idx, 1)) {
         return 0;
     }
+    // the down projection's mmvq launch already wrote this reduction (ggml_cuda_mwr_fold_mark)
+    if (ctx.mwr_done_graph == cgraph && ctx.mwr_done_idx == i && merge == nullptr) {
+        ctx.mwr_done_graph = nullptr;
+        ctx.mwr_done_idx   = -1;
+        return count - 1;
+    }
     if (mwr_dbg2) GGML_LOG_INFO("MWR FUSED %s\n", cgraph->nodes[i]->name);
     ggml_cuda_op_moe_weighted_reduction(ctx, match.experts, match.expert_scale, match.weights, match.dst, merge);
     return count - 1;
 }
+
+// MoE down + weighted reduction fold: arm the context when node i is a 1-token MUL_MAT_ID whose output is exactly the experts
+// operand of the weighted reduction at node i + 1 (no shared-expert merge); its mmvq launch then writes the reduction and the
+// reduction fusion launches nothing.  Runs for every node (it clears the arming).  GGML_CUDA_MWR_FOLD=0: off.
+void ggml_cuda_mwr_fold_mark(ggml_backend_cuda_context & ctx, const ggml_cgraph * cgraph, int i) {
+    static const bool on = getenv("GGML_CUDA_MWR_FOLD") == nullptr || atoi(getenv("GGML_CUDA_MWR_FOLD")) != 0;
+    static const bool disable_mwr = getenv("GGML_CUDA_DISABLE_MWR") != nullptr && std::atoi(getenv("GGML_CUDA_DISABLE_MWR"));
+    ctx.mwr_fold_experts = nullptr;
+    const ggml_tensor * node = cgraph->nodes[i];
+    if (!on || disable_mwr || node->op != GGML_OP_MUL_MAT_ID || node->type != GGML_TYPE_F32 || node->ne[2] != 1 ||
+            i + 1 >= cgraph->n_nodes || cgraph->nodes[i + 1]->op != GGML_OP_MUL || ggml_cuda_mmb_blk16()) {
+        return;
+    }
+    ggml_moe_weighted_reduction_match match;
+    if (!ggml_match_moe_weighted_reduction(cgraph, i + 1, match) || match.experts != node) {
+        return;
+    }
+    const int output_idx = i + 1 + match.node_count - 1;
+    if (!ggml_cuda_check_fusion_memory_ranges(cgraph, i + 1, match.node_count, &output_idx, 1)) {
+        return;
+    }
+    // the fold writes match.dst during the down launch, whose later blocks still read the expert ids
+    const ggml_tensor * ids = node->src[2];
+    const char * d0 = (const char *) match.dst->data;
+    const char * i0 = (const char *) ids->data;
+    if (d0 < i0 + ggml_nbytes(ids) && i0 < d0 + ggml_nbytes(match.dst)) {
+        return;
+    }
+    ctx.mwr_fold_experts = node;
+    ctx.mwr_fold_weights = match.weights;
+    ctx.mwr_fold_scale   = match.expert_scale;
+    ctx.mwr_fold_dst     = match.dst;
+    ctx.mwr_fold_graph   = cgraph;
+    ctx.mwr_fold_idx     = i + 1;
+}
diff --git a/ggml/src/ggml-cuda/moe-weighted-reduction.cuh b/ggml/src/ggml-cuda/moe-weighted-reduction.cuh
index a478b7258..31136cb03 100644
--- a/ggml/src/ggml-cuda/moe-weighted-reduction.cuh
+++ b/ggml/src/ggml-cuda/moe-weighted-reduction.cuh
@@ -7,3 +7,4 @@ void ggml_cuda_op_moe_weighted_reduction(ggml_backend_cuda_context & ctx,
                                          ggml_tensor *               dst,
                                          const ggml_tensor *         merge = nullptr);
 int ggml_cuda_moe_weighted_reduction_try_fuse(ggml_backend_cuda_context & ctx, const ggml_cgraph * cgraph, int i);
+void ggml_cuda_mwr_fold_mark(ggml_backend_cuda_context & ctx, const ggml_cgraph * cgraph, int i);
-- 
