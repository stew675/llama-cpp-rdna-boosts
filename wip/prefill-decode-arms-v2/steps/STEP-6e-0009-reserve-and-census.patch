@@ -1595,6 +1625,12 @@ common_init_result::common_init_result(common_params & params, bool model_only,
                         draft_reserve.note.empty() ? "not derivable" : draft_reserve.note.c_str());
             }
         }
+        if (arms_bytes > 0) {
+            aux_bytes += arms_bytes;
+            LOG_INF("%s: MoE arena reserve = %.0f MiB in total (draft %.0f + two-arm decode arm %.0f)\n",
+                    __func__, (double) aux_bytes / 1048576.0, (double) (aux_bytes - arms_bytes) / 1048576.0,
+                    (double) arms_bytes / 1048576.0);
+        }
         llama_model_moe_cache_preflight(model, aux_bytes);
     }
 
@@ -2252,6 +2288,17 @@ const char * common_arms_pair_possible(const common_params & params) {
         return "--sleep-idle unloads the model, which would tear the pair's SHARED memory down under the "
                "other arm";
     }
+    if (params.n_cpu_moe > 0) {
+        // OPEN (2026-11-23): a 4-slot soak of the pair on the 35B-A3B host tier (-ncmoe 40, one GPU) faulted
+        // the GPU -- HSA_STATUS_ERROR_MEMORY_APERTURE_VIOLATION in rms_norm_mul_rope_f32_qk_pair -- and the
+        // server aborted.  A host-expert shape REMAPS the MoE expert tables from the prefill arm's step while
