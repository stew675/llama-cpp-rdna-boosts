+        return "a host-expert shape remaps the MoE expert tables from the prefill arm's step while the decode "
+               "arm reads them (a 4-slot soak faulted the GPU); run the pair on a GPU-resident shape until "
+               "that is root-caused";
+    }
     if (params.ctx_shift) {
         return "--context-shift mutates the shared KV of a slot the decode arm owns; run --no-context-shift "
                "(the pair does not shift a generating slot from the other arm)";
