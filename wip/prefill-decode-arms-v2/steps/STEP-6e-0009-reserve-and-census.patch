+
+        // the two-arm server's decode arm, charged on the same preflight (see COMMON_ARMS_RESERVE_MIB)
+        size_t arms_bytes = 0;
+        if (has_host_experts && params.prefill_decode_arms_mode != COMMON_ARMS_OFF) {
+            const char * why = common_arms_pair_possible(params);
+            if (why == nullptr) {
+                arms_bytes = (size_t) COMMON_ARMS_RESERVE_MIB * 1024 * 1024;
+                LOG_WRN("%s: the two-arm server's decode arm reserves %d MiB (measured 157-235 MiB per device on "
+                        "27B/Q8_0/3-GPU tensor: one narrow context's compute buffers arrive after this arena)\n",
+                        __func__, COMMON_ARMS_RESERVE_MIB);
+            } else {
+                LOG_INF("%s: the two-arm server is requested but cannot be built (%s), so it reserves NOTHING\n",
+                        __func__, why);
+            }
+        }
+
         const common_draft_reserve draft_reserve = common_draft_reserve_derive(params);
         size_t aux_bytes = 0;
-        if (has_aux) {
