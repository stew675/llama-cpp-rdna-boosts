+// Is the TWO-ARM pair possible for this configuration?  ONE function, called by the reserve derivation and by
+// the server, so a charge and a creation cannot disagree (DESIGN.md V2).  Pure: no I/O, no allocation.
+const char * common_arms_pair_possible(const common_params & params) {
+    if (params.n_parallel < 2) {
+        return "it needs at least 2 slots (--parallel >= 2): the feature is a reply that keeps generating "
+               "while ANOTHER slot's prompt is processed";
+    }
+    // note: `mmproj_use_gpu` is a POLICY flag (default on) and says nothing about whether a projector
+    // is loaded -- only the path does
+    if (!params.mmproj.path.empty()) {
+        return "multimodal input (an mmproj) drives its own encoder pipeline, which is bound to one context";
+    }
+    if (params.embedding) {
+        return "embeddings/rerank/decision requests produce no decoded tokens to hand to a second arm";
+    }
+    if (!params.lora_adapters.empty()) {
+        return "LoRA adapters are applied per context (common_set_adapter_lora), and the two arms would "
+               "never agree on which are active";
+    }
+    if (params.sampling.backend_sampling) {
+        return "backend sampling keeps its sampler chain inside one context";
+    }
+    if (params.sleep_idle_seconds > 0) {
+        return "--sleep-idle unloads the model, which would tear the pair's SHARED memory down under the "
+               "other arm";
+    }
+    // the speculator: STEP 7 refuses it on the pair until the decode arm's draft/verify round is admitted
+    // (STEP 10).  A drafter whose TARGET side is bound to one context -- the layer-input families and a
+    // gemma4 assistant that shares the target's KV -- stays refused even then.
+    if (params.speculative.has_aux()) {
+        return "a speculator's draft/verify round is not admitted on the pair yet (--spec-type none); the "
+               "layer-input families and a gemma4 assistant are refused permanently because they assume "
+               "they are the only other user of their target context";
+    }
+    return nullptr;
+}
+
 struct llama_context_params common_context_params_to_llama(const common_params & params) {
     auto cparams = llama_context_default_params();
 
