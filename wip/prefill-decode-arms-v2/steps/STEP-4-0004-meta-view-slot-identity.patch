diff --git a/src/llama-context.h b/src/llama-context.h
index afa8ddf02..3d72332e2 100644
--- a/src/llama-context.h
+++ b/src/llama-context.h
@@ -82,6 +82,9 @@ struct llama_context {
 
     llama_memory_t get_memory() const;
 
+    // The Meta backend view-slot pair this context owns (see meta_slot_base): diagnostics and the STEP 4 gate.
+    int meta_view_slot_base() const;
+
     // return true if the memory was updated
     bool memory_update(bool optimize);
 
@@ -363,6 +366,20 @@ private:
     // swap the second scheduler (and its graph-reuse state) in or out of `sched`, creating it on first use
     void sched_alt_select(bool alt);
 
+    // The Meta backend keeps, per (buffer, view slot), a rotating pair of view containers, and a graph must be
+    // built AND resolved under the same slot.  Each CONTEXT owns a pair -- `meta_slot_base` and
+    // `meta_slot_base + 1` -- from a process-wide counter assigned once at construction, so the identity is a
+    // context, never a role (a pair plus a drafter is three contexts and only two roles, and the roles'
+    // contexts then share a slot).  `alt` picks which of the pair: the main scheduler or the second one.
+    //
+    // Contract: a llama_context is never inside two graphs at once, so its two slots suffice; what must be
+    // unique per context is the SLOT IDENTITY.  Bound at the top of sched_reserve() and in sched_alt_select(),
+    // i.e. on every path that can build or reserve a graph, on the thread that builds it.
+    int  meta_slot_base = 0;
+    void meta_bind_view_slot(bool alt) const {
+        ggml_backend_meta_set_view_slot(meta_slot_base + (alt ? 1 : 0));
+    }
+
     // whether this ubatch is the draft context's second graph (the draft step) rather than its ingest /
     // KV-injection graph; the batch kind, not `n_outputs`, is the discriminator for DFlash/DFlash2
     bool sched_alt_for(const llama_ubatch & ubatch) const;
