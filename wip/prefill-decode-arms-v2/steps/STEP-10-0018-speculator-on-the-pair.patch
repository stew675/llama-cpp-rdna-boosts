+bool common_speculative_path_shares_target_kv(const std::string & path) {
+    if (path.empty()) {
+        return false;
+    }
+
+    gguf_init_params gguf_params = {
+        /* .no_alloc = */ true,
+        /* .ctx      = */ nullptr,
+    };
+
+    gguf_context_ptr gguf_ctx(gguf_init_from_file(path.c_str(), gguf_params));
+    if (!gguf_ctx) {
+        return false;   // unreadable: the server refuses it after the load instead
+    }
+
+    const int64_t arch_id = gguf_find_key(gguf_ctx.get(), "general.architecture");
+    if (arch_id < 0 || gguf_get_kv_type(gguf_ctx.get(), arch_id) != GGUF_TYPE_STRING) {
+        return false;
+    }
+
+    return std::strcmp(gguf_get_val_str(gguf_ctx.get(), arch_id), "gemma4-assistant") == 0;
+}
+
+bool common_speculative_shares_target_kv(const llama_model * model_dft) {
+    if (model_dft == nullptr) {
+        return false;
+    }
+
+    char arch[64] = {0};
+    if (llama_model_meta_val_str(model_dft, "general.architecture", arch, sizeof(arch)) < 0) {
+        return false;
+    }
+
+    return std::strcmp(arch, "gemma4-assistant") == 0;
+}
