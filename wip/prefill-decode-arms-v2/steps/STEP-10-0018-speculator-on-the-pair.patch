+// Measured (2026-11-24, 35B-A3B Q8_0 `-ncmoe 40`, two-arm server + `draft-mtp-adaptive`, 4 slots): the prefill
+// arm re-reserved a compute buffer while the decode arm captured its verify graph -> ROCm error at
+// `ggml_cuda_kernel_launch`, 40/40 requests failed.
+struct ggml_cuda_capture_excl_guard {
+    std::unique_lock<std::shared_mutex> lk;
+    ggml_cuda_capture_excl_guard();
+    ~ggml_cuda_capture_excl_guard() = default;
+};
