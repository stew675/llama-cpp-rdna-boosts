+// The stream the SYNCHRONOUS host <-> device paths issue on (set_tensor/get_tensor in all their forms, memset,
+// clear, the bounce and peer-staging copies, the KV-region row moves, the async-input ring).
+//
+// WHY IT IS NOT `cudaStreamPerThread`: HIP resolves that sentinel to the LEGACY DEFAULT stream of the current
+// device, and a graph capture claims the default stream.  A host copy issued by a thread other than the one
+// capturing -- i.e. by a second context -- is then refused with `operation not permitted when stream is
+// capturing`, and every later launch on the device fails with `operation failed due to a previous error during
+// capture`.  One context alone never hits it: only the context that is capturing issues host copies, and the
+// capture path does not upload.  A private non-blocking stream per (thread, device) is invisible to another
+// thread's capture, and it also stops two contexts serialising each other's uploads.
+//
+// SEMANTICS: identical to the sentinel in the one respect that matters -- it resolves against the CURRENT device,
+// exactly as `cudaStreamPerThread` did, so a caller that has not selected its device was already issuing the copy
+// on the wrong device.  Every caller below SYNCHRONISES before returning, so the stream choice carries no
+// ordering of its own; it only decides WHO is allowed to issue the copy.
+//
+// A failure to create the stream returns `cudaStreamPerThread` DIRECTLY and caches that decision: it is not a
+// transient error, retrying it on every host copy would cost more than the stream it replaces, and recursing
+// back into this function would overflow the stack.
+cudaStream_t ggml_cuda_host_stream() {
+    static thread_local cudaStream_t streams[GGML_CUDA_MAX_DEVICES] = {};
+    const int device = ggml_cuda_get_device();
+    if (device < 0 || device >= GGML_CUDA_MAX_DEVICES) {
+        return cudaStreamPerThread;
+    }
+    if (streams[device] == nullptr) {
+        if (cudaStreamCreateWithFlags(&streams[device], cudaStreamNonBlocking) != cudaSuccess) {
+            (void) cudaGetLastError();
+            streams[device] = cudaStreamPerThread;
+        }
+    }
+    return streams[device];
+}
