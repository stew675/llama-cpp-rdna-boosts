+// The CAPTURE BARRIER (see the declaration in common.cuh).
+//
+// A HIP library call that touches the LEGACY (blocking) stream cannot run while another thread records a graph.
+// On this ROCm line the offender is hipBLASLt -- reached through rocBLAS -- and the call that actually trips it
+// is the library's LAZY HANDLE CREATION (`hipblasCreate` initialises hipBLASLt, which synchronises the legacy
+// stream), not the GEMM dispatch: guarding the GEMMs alone left the abort at 2 of 3 runs, guarding creation
+// removed it (7 of 7 clean), and no GEMM is ever recorded INTO a capture on this shape (an instrumented run
+// logged zero).  The failure looked like:
+//
+//   Hip error: 'operation would make the legacy stream depend on a capturing blocking stream' (906)
+//       at .../hipblaslt.cpp:415
+//   E ROCm error: operation failed due to a previous error during capture
+//
+// and the sticky error then kills the CAPTURING thread on its next launch -- so the thread that aborts is not
+// the thread that failed, which is what made this expensive to localise.  Measured 2026-11-23 on the two-arm
+// server (Flash-Next GSQ-RCO IQ3_S, 3 devices `-sm tensor -mg 0`, np 2, one slot decoding while another
+// prefills): 2 of 3 runs aborted, and no gate could see it, because with ONE request in flight the two arms
+// never compute at the same time.  This is STEP 7d's family -- a process-wide/library hazard against a second
+// arm's capture -- so it gets the same kind of answer: a barrier, not a disabled feature.
+//
+// A CAPTURE takes the barrier exclusively; every library GEMM takes it shared.  The steady state is both
+// arms holding it SHARED (the whole point of the feature: two contexts computing at once); a capture is a
+// one-time-per-graph event, and the other arm waits at its next GEMM for it.  Neither the capture nor
+// hipBLASLt is disabled, so the pair keeps its graph replay AND its BLAS kernels.
+//
+// `g_ggml_cuda_capture_depth` marks the RECORDING thread: its own GEMM calls are being captured, not
+// executed, so they skip the shared side (taking it would deadlock on the exclusive side it already holds).
+// GGML_CUDA_CAPTURE_BLAS_BARRIER=0 restores the pre-barrier behaviour (A/B and bisect).
+thread_local int g_ggml_cuda_capture_depth = 0;
+
+std::shared_mutex & ggml_cuda_capture_barrier() {
+    static std::shared_mutex barrier;
+    return barrier;
+}
+
+bool ggml_cuda_capture_barrier_enabled() {
+    static const bool enabled = [] {
+        const char * e = getenv("GGML_CUDA_CAPTURE_BLAS_BARRIER");
+        return e == nullptr || atoi(e) != 0;
+    }();
+    return enabled;
+}
+
+ggml_cuda_blas_guard::ggml_cuda_blas_guard() : lk(ggml_cuda_capture_barrier(), std::defer_lock) {
+    // a GEMM issued by the RECORDING thread is being captured, not executed: the capture already owns the
+    // barrier exclusively, so taking it again here would deadlock on this thread.
+    if (g_ggml_cuda_capture_depth == 0 && ggml_cuda_capture_barrier_enabled()) {
+        lk.lock();
+    }
+}
