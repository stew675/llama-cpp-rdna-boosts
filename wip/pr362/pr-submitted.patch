Subject: [PATCH] ggml cuda: fold padded GQA-6 in RDNA3 tile flash attention

---
 ggml/src/ggml-cuda/fattn-tile.cuh | 149 ++++++++++++++++++++++++------
 1 file changed, 122 insertions(+), 27 deletions(-)

diff --git a/ggml/src/ggml-cuda/fattn-tile.cuh b/ggml/src/ggml-cuda/fattn-tile.cuh
index e0778c76b..280ebf762 100644
--- a/ggml/src/ggml-cuda/fattn-tile.cuh
+++ b/ggml/src/ggml-cuda/fattn-tile.cuh
@@ -798,7 +798,8 @@ static __device__ __forceinline__ void flash_attn_tile_iter_KQ(
         const int k_VKQ_sup,
         const int k_KQ_0,
         float * KQ_acc,
-        const fattn_kv_native_t kv_q8) {
+        const fattn_kv_native_t kv_q8,
+        const bool warp_valid) {
     constexpr int cpy_nb = ggml_cuda_get_max_cpy_bytes();
     constexpr int cpy_ne = cpy_nb / 4;
 
@@ -820,6 +821,15 @@ static __device__ __forceinline__ void flash_attn_tile_iter_KQ(
     }
     __syncthreads();
 
+    // Padded-GQA blocks still need every warp for the cooperative tile load and its barriers,
+    // but a warp owning only padded columns can skip the KQ dot product itself.
+    if (!warp_valid) {
+        if (k_KQ_0 + nbatch_K < DKQ) {
+            __syncthreads();
+        }
+        return;
+    }
+
 #ifdef FAST_FP16_AVAILABLE
     // BF16 K/V keeps packed BF16 registers and uses v_dot2_f32_bf16; F16 K/V uses the half2 (FAST) path.
     constexpr bool use_bf16 = ggml_cuda_fattn_tile_use_bf16<T_KV>();
@@ -950,7 +960,9 @@ static __device__ __forceinline__ void flash_attn_tile_iter(
         const int k_VKQ_0,
         const int k_VKQ_max,
         const int col_Q_0,
-        const fattn_kv_native_t kv_q8) {
+        const fattn_kv_native_t kv_q8,
+        const bool warp_valid,
+        const int ncols2_eff) {
     constexpr int cpy_nb = ggml_cuda_get_max_cpy_bytes();
     constexpr int cpy_ne = cpy_nb / 4;
 
@@ -987,18 +999,21 @@ static __device__ __forceinline__ void flash_attn_tile_iter(
 #pragma unroll
     for (int k_KQ_0 = 0; k_KQ_0 < DKQ - nbatch_K_last; k_KQ_0 += nbatch_K) {
         flash_attn_tile_iter_KQ<warp_size, nwarps, ncols1, ncols2, DKQ, DV, nbatch_fa, nbatch_K, use_logit_softcap, oob_check, type_KV>(
-            Qg_base, q_row, Q_tmp, K_h2, KV_tmp, stride_K2, k_VKQ_0, k_VKQ_sup, k_KQ_0, KQ_acc, kv_q8);
+            Qg_base, q_row, Q_tmp, K_h2, KV_tmp, stride_K2, k_VKQ_0, k_VKQ_sup, k_KQ_0, KQ_acc, kv_q8, warp_valid);
     }
     if (nbatch_K_last > 0) {
         constexpr int k_KQ_0 = DKQ - nbatch_K_last;
         flash_attn_tile_iter_KQ<warp_size, nwarps, ncols1, ncols2, DKQ, DV, nbatch_fa, nbatch_K_last, use_logit_softcap, oob_check, type_KV>(
-            Qg_base, q_row, Q_tmp, K_h2, KV_tmp, stride_K2, k_VKQ_0, k_VKQ_sup, k_KQ_0, KQ_acc, kv_q8);
+            Qg_base, q_row, Q_tmp, K_h2, KV_tmp, stride_K2, k_VKQ_0, k_VKQ_sup, k_KQ_0, KQ_acc, kv_q8, warp_valid);
     }
 
-    // Apply logit softcap + mask, update KQ_max:
+    // Apply logit softcap + mask, update KQ_max. Invalid warps rejoin at the reduction barrier below.
 #pragma unroll
     for (int jc0 = 0; jc0 < cpw; ++jc0) {
-        const int j = fastmodulo(col_Q_0 + (jc0 + (threadIdx.y / np)*cpw)/ncols2, ne01);
+        if (!warp_valid) {
+            break;
+        }
+        const int j = fastmodulo(col_Q_0 + (jc0 + (threadIdx.y / np)*cpw)/ncols2_eff, ne01);
 
         // V3 derived kq mask: cell values are derived instead of read from the packed mask, and the
         // choice is made ONCE per query row rather than once per cell.  Testing it inside the unrolled
@@ -1081,6 +1096,9 @@ static __device__ __forceinline__ void flash_attn_tile_iter(
     // Calculate KQ softmax, write to shared KQ buffer, re-scale VKQ accumulators:
 #pragma unroll
     for (int jc0 = 0; jc0 < cpw; jc0 += KQ_cs) {
+        if (!warp_valid) {
+            break;
+        }
