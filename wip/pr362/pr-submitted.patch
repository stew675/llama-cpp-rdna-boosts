             return;
         }
@@ -1920,6 +1993,18 @@ static void launch_fattn_tile_switch_ncols1(ggml_backend_cuda_context & ctx, ggm
     GGML_ABORT("fatal error");
 }
 
+// Experimental padded GQA-6 fold for the RDNA3 native-Q8_0 decode/verify band.
+// Enabled by default so the same binary supports fold-on/fold-off A/B runs; set to 0 to
+// retain r284's original ncols2 = 2 path. The launcher pins ncols1 = 1 for ncols2 = 8,
+// which also keeps one reduction configuration for every query width from 1 through 8.
+static inline bool ggml_cuda_fattn_tile_gqa6_fold_enabled() {
+    static const bool enabled = [] {
+        const char * env = getenv("GGML_HIP_FA_TILE_GQA6_FOLD");
+        return env == nullptr || atoi(env) != 0;
+    }();
+    return enabled;
+}
+
 template <int DKQ, int DV, bool use_logit_softcap, ggml_type type_KV>
 static void launch_fattn_tile_switch_ncols2(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
     const ggml_tensor * KQV  = dst;
@@ -1951,6 +2036,16 @@ static void launch_fattn_tile_switch_ncols2(ggml_backend_cuda_context & ctx, ggm
     // D=128 decode was re-reading the KV cache 4x for it.  The cap is lifted (r334, PR #338 -> folded
     // into block 05), so RDNA2 takes the same ncols2 the rest of the archs do.
 
+    if constexpr (DKQ == 256 && DV == 256 && type_KV == GGML_TYPE_Q8_0) {
+        const bool rdna3_target = device_cc == GGML_CUDA_CC_OFFSET_AMD + 0x1101 ||
+                                  device_cc == GGML_CUDA_CC_OFFSET_AMD + 0x1102;
+        if (rdna3_target && ggml_cuda_fattn_tile_gqa6_fold_enabled() && use_gqa_opt &&
+                Q->ne[1] <= 8 && gqa_ratio == 6) {
+            launch_fattn_tile_switch_ncols1<DKQ, DV, 8, use_logit_softcap, type_KV>(ctx, dst);
+            return;
+        }
+    }
+
     if constexpr (DKQ == 320) {
         // This branch is only used for Mistral Small 4 which has a GQA ratio of 32.
         // On AMD, simply use that GQA ratio with 32 columns / block since we always have enough SRAM.
