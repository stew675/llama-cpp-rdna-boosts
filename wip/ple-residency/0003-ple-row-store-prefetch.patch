+// defined with the gather below; shared so the two cannot drift
+static void qwen4exp_ple_rows(const llama_hparams & hp, const llama_token * tok, const llama_token * prev,
+                              int64_t n_tokens, int32_t * idx);
+
+// WIP/ple-residency Phase 2: predict a decode batch's PLE rows and hand them to the reader's store
+// before the first ubatch needs them.  Predicted from the batch's own token ids (the rows are a pure
+// function of the token window), with the two preceding tokens taken from the batch itself; the first
+// tokens of a batch that continues a cached prefix therefore predict a row or two wrong and the gather
+// fetches those on demand -- a cache miss, never a wrong answer.
+void llama_model_qwen4exp::ple_prefetch(const llama_batch_ext & batch) const {
+    if (!lazy_reader || hparams.ple_n_heads == 0 || batch.tokens.empty() || batch.n_embd > 0) {
+        return;   // no managed store, no PLE table, nothing to do, or an embd batch (no token ids)
+    }
+    const int64_t n      = (int64_t) batch.tokens.size();
+    const int64_t n_gram = hparams.ple_ngram_size;
+    const int64_t n_prev = n_gram - 1;
+    const int64_t n_heads = hparams.ple_n_heads;
+    if (n_heads <= 0 || n_prev <= 0) {
+        return;
+    }
+
+    std::vector<llama_token> tok(n);
+    std::vector<llama_token> prev((size_t) n * n_prev, LLAMA_TOKEN_NULL);
+    for (int64_t i = 0; i < n; i++) {
+        tok[i] = batch.tokens[i].id;
+    }
+    for (int64_t i = 0; i < n; i++) {
+        const llama_pos p = batch.tokens[i].pos[0];
+        if (batch.tokens[i].seq_ids.empty()) {
+            continue;
+        }
+        const llama_seq_id seq = *batch.tokens[i].seq_ids.begin();
+        for (int64_t k = 1; k <= n_prev && k <= i; k++) {
+            const auto & t = batch.tokens[i - k];
+            if (t.pos[0] == p - k && t.seq_ids.count(seq)) {
+                prev[(size_t) i * n_prev + (n_prev - k)] = t.id;
+            }
+        }
+    }
+
+    std::vector<int32_t> idx((size_t) n * n_heads);
+    qwen4exp_ple_rows(hparams, tok.data(), prev.data(), n, idx.data());
+    lazy_reader->prefetch(idx.data(), idx.size());
+    if (getenv("LLAMA_PLE_DBG")) {
+        static uint64_t n_calls = 0, n_rows = 0;
+        n_calls++; n_rows += idx.size();
+        fprintf(stderr, "ple prefetch #%llu: %lld tokens -> %zu rows (total %llu rows)\n",
+                (unsigned long long) n_calls, (long long) n, idx.size(), (unsigned long long) n_rows);
+    }
+}
