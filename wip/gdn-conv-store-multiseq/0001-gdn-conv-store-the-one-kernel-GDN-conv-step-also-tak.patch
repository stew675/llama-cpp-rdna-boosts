@@ -222,23 +228,32 @@ bool ggml_cuda_gdn_store_match_at_concat(const ggml_cgraph * cgraph, int i, ggml
     m.concat = i; m.set_rows = i_sr; m.conv = conv; m.last = j2 + 1; m.private_chain = private_chain;
