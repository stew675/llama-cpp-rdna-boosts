     const ggml_tensor * x = tr->view_src;
-    if (x->type != GGML_TYPE_F32 || !ggml_is_contiguous(x) || x->ne[2] != 1 || x->ne[3] != 1) return false;
-    const int64_t C = x->ne[0], T = x->ne[1];
-    if (T < 1 || T > 16 || C % 256 != 0) return false;
-    if (st->type != GGML_TYPE_F32 || !ggml_is_contiguous(st) || st->ne[0] != 3 || st->ne[1] != C || st->ne[2] != 1 || st->ne[3] != 1) return false;
-    if (tr->ne[0] != T || tr->ne[1] != C || tr->view_offs != 0) return false;
-    if (!ggml_is_contiguous(cc) || cc->ne[0] != T + 3 || cc->ne[1] != C || cc->ne[2] != 1 || cc->ne[3] != 1) return false;
+    const int64_t T = tr->ne[0], C = tr->ne[1], S = tr->ne[2];
+    if (T < 1 || T > 16 || C % 256 != 0 || S < 1 || S > 8 || tr->ne[3] != 1 || tr->view_offs != 0) return false;
