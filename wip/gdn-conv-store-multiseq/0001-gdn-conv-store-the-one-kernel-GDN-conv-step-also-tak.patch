     int n_chain = 0;
@@ -166,7 +172,7 @@ bool ggml_cuda_gdn_store_match_at_concat(const ggml_cgraph * cgraph, int i, ggml
     if (conv < 0 || conv + 1 >= cgraph->n_nodes) return false;
