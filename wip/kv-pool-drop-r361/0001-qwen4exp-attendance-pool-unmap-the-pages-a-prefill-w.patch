     ggml_tensor * q = q_cur;
     ggml_tensor * k = top_k_kv != nullptr ? mctx_cur->get_k_pool(ctx0, il) : mctx_cur->get_k(ctx0, il);
@@ -2877,6 +2883,12 @@ ggml_tensor * llama_model_qwen4exp::graph::build_layer_attn(
         cur = build_attn(inp,
                     nullptr, nullptr, nullptr,
                     Qcur, Kcur, Vcur, nullptr, nullptr, nullptr, kq_scale, il);
+        // ours: the dense arm wrote the mirror without the pool's resolve (see build_attn_qsa)
+        if (inp->mctx->has_kv_pool()) {
+            if (ggml_tensor * drop = inp->mctx->build_kv_pool_drop(ctx0, inp->get_k_idxs(), il)) {
+                ggml_build_forward_expand(gf, drop);
