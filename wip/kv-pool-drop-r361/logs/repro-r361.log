## poolreq.py
#!/usr/bin/env python3
# poolreq.py PORT NREC NGEN: one fresh greedy request over NREC depth2-style entries (~46 tok each), prints tokens, sha, head.
import hashlib, json, random, sys, urllib.request
port, n, ngen = sys.argv[1], int(sys.argv[2]), int(sys.argv[3]); R = random.Random(20261106)
A = "pump valve filter gauge sensor relay bearing rotor stator flange gasket impeller coupling manifold actuator solenoid regulator thermostat compressor condenser".split()
B = "inspected replaced calibrated cleaned tightened lubricated tested rebuilt adjusted logged flagged measured".split()
C = "north south east west upper lower inner outer primary secondary spare auxiliary".split()
body = " ".join("Entry %d: the %s %s at station %d was %s by crew %d on day %d, reading %.2f, cost %d." % (i, R.choice(C), R.choice(A), R.randrange(9000), R.choice(B), R.randrange(97), R.randrange(365), R.random()*500, R.randrange(100000)) for i in range(n))
req = urllib.request.Request("http://127.0.0.1:%s/completion" % port, data=json.dumps({"prompt": body + "\nSummarize the entries above in three sentences.", "n_predict": ngen, "temperature": 0, "top_k": 1, "cache_prompt": False}).encode(), headers={"Content-Type": "application/json"})
try:
    r = json.load(urllib.request.urlopen(req, timeout=900)); t = r["timings"]; c = r["content"]
    print("n=%d: prompt %d tok, gen %d @ %.1f t/s, sha %s | %s" % (n, t["prompt_n"], t["predicted_n"], t["predicted_per_second"], hashlib.sha256(c.encode()).hexdigest()[:12], c[:90].replace("\n", " ")))
except Exception as e:
    print("n=%d: ERROR %s" % (n, e))
