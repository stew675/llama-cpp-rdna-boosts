"""
Production-quality Python implementation of various data structures and algorithms.
"""

import argparse
import collections
import math
import threading
import time
from typing import Any, Dict, List, Optional, Tuple


class LRUCache:
    """Thread-safe Least Recently Used cache with O(1) get and put operations.

    Uses collections.OrderedDict for O(1) access and reordering, and threading.RLock
    for thread safety.
    """

    def __init__(self, maxsize: int) -> None:
        """Initialize the LRU cache.

        Args:
            maxsize: Maximum number of items the cache can hold.
        """
        if maxsize <= 0:
            raise ValueError("maxsize must be positive")
        self._maxsize = maxsize
        self._cache: collections.OrderedDict[str, Any] = collections.OrderedDict()
        self._lock = threading.RLock()

    def get(self, key: str) -> Optional[Any]:
        """Retrieve an item from the cache.

        Args:
            key: The key to look up.

        Returns:
            The value associated with the key, or None if not found.
        """
        with self._lock:
            if key not in self._cache:
                return None
            # Move to end (most recently used)
            self._cache.move_to_end(key)
            return self._cache[key]

    def put(self, key: str, value: Any) -> None:
        """Add or update an item in the cache.

        Args:
            key: The key to store.
            value: The value to associate with the key.
        """
        with self._lock:
            if key in self._cache:
                # Update existing key and move to end
                self._cache.move_to_end(key)
                self._cache[key] = value
            else:
                # Add new key
                if len(self._cache) >= self._maxsize:
                    # Remove least recently used (first item)
                    self._cache.popitem(last=False)
                self._cache[key] = value

    def __len__(self) -> int:
        """Return the number of items in the cache."""
        with self._lock:
            return len(self._cache)

    def __contains__(self, key: str) -> bool:
        """Check if a key is in the cache."""
        with self._lock:
            return key in self._cache


class UnionFind:
    """Union-Find data structure with path compression and union by rank.

    Supports efficient union and find operations, and provides a helper to
    retrieve component members.
    """

    def __init__(self, elements: Optional[List[str]] = None) -> None:
        """Initialize UnionFind with optional initial elements.

        Args:
            elements: Optional list of initial elements.
        """
        self._parent: Dict[str, str] = {}
        self._rank: Dict[str, int] = {}
        if elements:
            for elem in elements:
                self._parent[elem] = elem
                self._rank[elem] = 0

    def find(self, x: str) -> str:
        """Find the representative of the set containing x with path compression.

        Args:
            x: The element to find.

        Returns:
            The representative (root) of the set containing x.
        """
        if x not in self._parent:
            raise KeyError(f"Element {x} not in UnionFind")
        if self._parent[x] != x:
            self._parent[x] = self.find(self._parent[x])
        return self._parent[x]

    def union(self, x: str, y: str) -> bool:
        """Union the sets containing x and y.

        Args:
            x: An element in the first set.
            y: An element in the second set.

        Returns:
            True if a merge happened (x and y were in different sets), False otherwise.
        """
        root_x = self.find(x)
        root_y = self.find(y)

        if root_x == root_y:
            return False

        # Union by rank
        if self._rank[root_x] < self._rank[root_y]:
            self._parent[root_x] = root_y
        elif self._rank[root_x] > self._rank[root_y]:
            self._parent[root_y] = root_x
        else:
            self._parent[root_y] = root_x
            self._rank[root_x] += 1

        return True

    def connected(self, x: str, y: str) -> bool:
        """Check if x and y are in the same set.

        Args:
            x: An element.
            y: Another element.

        Returns:
            True if x and y are in the same set, False otherwise.
        """
        return self.find(x) == self.find(y)

    def groups(self) -> List[List[str]]:
        """Return the component members as a list of lists.

        Returns:
            A list of lists, where each inner list contains the members of a component.
        """
        components: Dict[str, List[str]] = {}
        for elem in self._parent:
            root = self.find(elem)
            if root not in components:
                components[root] = []
            components[root].append(elem)
        return list(components.values())


def dijkstra(graph: Dict[str, List[Tuple[str, float]]], start: str) -> Dict[str, float]:
    """Compute single-source shortest paths over an adjacency list.

    Args:
        graph: Adjacency list where keys are node names and values are lists of
               (neighbor, weight) tuples.
        start: The starting node.

    Returns:
        A dictionary mapping each reachable node to its shortest distance from start.
        Unreachable nodes are omitted.
    """
    import heapq

    distances: Dict[str, float] = {}
    # Priority queue: (distance, node)
    pq: List[Tuple[float, str]] = [(0.0, start)]
    distances[start] = 0.0

    while pq:
        current_dist, current_node = heapq.heappop(pq)

        # If we've already found a shorter path, skip
        if current_dist > distances.get(current_node, float('inf')):
            continue

        if current_node in graph:
            for neighbor, weight in graph[current_node]:
                new_dist = current_dist + weight
                if new_dist < distances.get(neighbor, float('inf')):
                    distances[neighbor] = new_dist
                    heapq.heappush(pq, (new_dist, neighbor))

    return distances


class RingBuffer:
    """A fixed-capacity byte buffer with write, read, peek, available, and free methods.

    Writes that would overflow return the number of bytes actually stored.
    """

    def __init__(self, capacity: int) -> None:
        """Initialize the ring buffer.

        Args:
            capacity: Maximum number of bytes the buffer can hold.
        """
        if capacity <= 0:
            raise ValueError("Capacity must be positive")
        self._capacity = capacity
        self._buffer: bytearray = bytearray(capacity)
        self._head: int = 0  # Write position
        self._tail: int = 0  # Read position
        self._size: int = 0  # Current number of bytes in buffer

    def write(self, data: bytes) -> int:
        """Write data to the buffer.

        Args:
            data: The bytes to write.

        Returns:
            The number of bytes actually stored (may be less than len(data) if overflow).
        """
        to_write = min(len(data), self._capacity - self._size)
        if to_write == 0:
            return 0

        for i in range(to_write):
            self._buffer[self._head] = data[i]
            self._head = (self._head + 1) % self._capacity
            self._size += 1

        return to_write

    def read(self, n: int) -> bytes:
        """Read n bytes from the buffer.

        Args:
            n: Number of bytes to read.

        Returns:
            The bytes read (may be fewer than n if buffer doesn't have enough data).
        """
        n = min(n, self._size)
        result = bytearray(n)
        for i in range(n):
            result[i] = self._buffer[self._tail]
            self._tail = (self._tail + 1) % self._capacity
            self._size -= 1
        return bytes(result)

    def peek(self, n: int) -> bytes:
        """Peek at n bytes without removing them from the buffer.

        Args:
            n: Number of bytes to peek.

        Returns:
            The bytes at the front of the buffer (may be fewer than n).
        """
        n = min(n, self._size)
        result = bytearray(n)
        for i in range(n):
            result[i] = self._buffer[(self._tail + i) % self._capacity]
        return bytes(result)

    @property
    def available(self) -> int:
        """Return the number of bytes available to read."""
        return self._size

    @property
    def free(self) -> int:
        """Return the number of bytes free in the buffer."""
        return self._capacity - self._size


def topo_sort(graph: Dict[str, List[str]]) -> List[str]:
    """Topological sort using Kahn's algorithm.

    Args:
        graph: Adjacency list representing a directed graph.

    Returns:
        A list of nodes in topological order.

    Raises:
        ValueError: If the graph contains a cycle, naming one of the nodes still involved.
    """
    # Compute in-degrees
    in_degree: Dict[str, int] = {node: 0 for node in graph}
    for node in graph:
        for neighbor in graph[node]:
            if neighbor not in in_degree:
                in_degree[neighbor] = 0
            in_degree[neighbor] += 1

    # Initialize queue with nodes having in-degree 0
    queue: List[str] = [node for node, deg in in_degree.items() if deg == 0]
    result: List[str] = []

    while queue:
        node = queue.pop(0)
        result.append(node)
        for neighbor in graph.get(node, []):
            in_degree[neighbor] -= 1
            if in_degree[neighbor] == 0:
                queue.append(neighbor)

    if len(result) != len(in_degree):
        # Find a node involved in the cycle
        for node in in_degree:
            if in_degree[node] > 0:
                raise ValueError(f"Cycle detected involving node: {node}")
        raise ValueError("Cycle detected")

    return result


class Matrix:
    """Immutable 2-D float matrix with matrix operations.

    Supports matrix multiplication, addition, subtraction, transpose,
    determinant (LU with partial pivoting), and inverse.
    """

    def __init__(self, data: List[List[float]]) -> None:
        """Initialize the matrix.

        Args:
            data: A 2-D list of floats representing the matrix.
        """
        if not data or not data[0]:
            raise ValueError("Matrix cannot be empty")
        # Validate rectangular shape
        row_len = len(data[0])
        for row in data:
            if len(row) != row_len:
                raise ValueError("All rows must have the same length")
        self._data: List[List[float]] = [row[:] for row in data]
        self._rows: int = len(data)
        self._cols: int = row_len

    @property
    def rows(self) -> int:
        """Return the number of rows."""
        return self._rows

    @property
    def cols(self) -> int:
        """Return the number of columns."""
        return self._cols

    def __matmul__(self, other: 'Matrix') -> 'Matrix':
        """Matrix multiplication."""
        if self._cols != other._rows:
            raise ValueError(f"Matrix dimensions mismatch: {self._rows}x{self._cols} and {other._rows}x{other._cols}")
        result: List[List[float]] = [[0.0] * other._cols for _ in range(self._rows)]
        for i in range(self._rows):
            for j in range(other._cols):
                for k in range(self._cols):
                    result[i][j] += self._data[i][k] * other._data[k][j]
        return Matrix(result)

    def __add__(self, other: 'Matrix') -> 'Matrix':
        """Element-wise addition."""
        if self._rows != other._rows or self._cols != other._cols:
            raise ValueError("Matrix dimensions must match for addition")
        result: List[List[float]] = [
            [self._data[i][j] + other._data[i][j] for j in range(self._cols)]
            for i in range(self._rows)
        ]
        return Matrix(result)

