@@ -765,13 +776,24 @@ void parse_env() {
     // cache is not a second copy competing for RAM.
     g_pool_enabled     = moe_host_pool_on();
     g_pool_auto        = g_pool_enabled && (moe_host_pool_mib() < 0);
-    g_pool_frac        = env_int("MOE_HOST_POOL_FRAC", 80);
+    // DEFAULT = FULL COVERAGE (100 % of each host expert tensor), subject to the `MOE_HOST_POOL_RAM_PCT`
+    // ceiling below.  The pool's decode cost is dominated by misses it does not hold: at `-ncmoe 48` on the
