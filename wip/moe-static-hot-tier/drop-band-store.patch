+// Retain an evicted resident in the store: copy `t.expert_bytes` from `src` (the arena slot, about to be
+// overwritten) into the expert's entry, taking a free entry, else the least recently written one that is
+// not `avoid` (the entry a caller is about to read).  Pure D2D: the bytes are already on the device.
+static void l2_retain_locked(table_t & t, int32_t expert, const char * src, void * stream, int avoid) {
+    if (t.l2_cap <= 0 || t.l2_base == nullptr || (int) t.l2_slot.size() != t.l2_cap) {
+        return;
+    }
+    int entry = -1;
+    const auto it = t.l2_index.find(expert);
+    if (it != t.l2_index.end()) {
+        entry = it->second;
+    }
+    if (entry < 0) {
+        for (int i = 0; i < t.l2_cap; i++) {
+            if (t.l2_slot[(size_t) i] < 0) {
+                entry = i;
+                break;
+            }
+        }
+    }
+    if (entry < 0) {
+        int64_t best = INT64_MAX;
+        for (int i = 0; i < t.l2_cap; i++) {
+            if (i == avoid || t.l2_slot[(size_t) i] < 0) {
+                continue;
+            }
+            if (t.l2_stamp[(size_t) i] < best) {
+                best  = t.l2_stamp[(size_t) i];
+                entry = i;
+            }
+        }
+        if (entry < 0) {
+            return;
+        }
+        t.l2_index.erase(t.l2_slot[(size_t) entry]);
+        t.l2_evicts++;
+        g_l2_evicts++;
+    }
+    char * dst = t.l2_base + (size_t) entry * t.expert_bytes;
+    if (cudaMemcpyAsync(dst, src, t.expert_bytes, cudaMemcpyDeviceToDevice, (cudaStream_t) stream) != cudaSuccess) {
+        (void) cudaGetLastError();   // fail soft: the store is an optimisation, never a correctness source
+        t.l2_slot[(size_t) entry] = -1;
+        t.l2_index.erase(expert);
+        return;
+    }
+    t.l2_slot[(size_t) entry] = expert;
+    t.l2_index[expert]        = entry;
+    t.l2_stamp[(size_t) entry] = t.clock;
+    t.l2_retains++;
+    g_l2_retains++;
+}
