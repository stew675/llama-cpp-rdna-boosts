+// =====================================================================================================
+// PROTOTYPE (wip/moe-static-hot-tier): a SECOND-LEVEL VRAM expert store in the band a prefill -> decode
+// drop returns.
+//
+// The band is free arena VA between the decode boundary and the tables (the slab allocates arena top-down,
+// so the free run sits just above the boundary) and a prefill reclaims it by moving the boundary up.  Today
+// its only consumer is table GROWTH (`MOE_EXPERT_CACHE_STEADY_REARM`), which re-sizes whole tables at the
+// drop and gets stood down whole at the next prefill: on a saturated split that costs -41 % of a 5 k
+// prompt's prefill for 0.42 pp of routed mass (campaign record RESULTS-2026-11-15, §1-§3).
+//
+// This store is the alternative that costs the prefill nothing:
+//   * ONE slab arena allocation per device, partitioned per table by expert-sized entries -- the store is
+//     never addressed as table slots, so `arena + slot * expert_bytes` (every routed-op kernel) is
+//     untouched and no kernel changes;
+//   * an arena eviction RETAINS the victim's bytes here (a D2D copy of bytes that are about to be
+//     overwritten -- no host I/O, no extra read: the weight was already on the device);
+//   * a miss whose expert is in the store is served from it (D2D into the slot) instead of from the pinned
+//     host pool, which is the whole point: the LRU dropped the expert, the bytes never left VRAM;
+//   * a boundary move (prefill) frees the WHOLE region in one call -- no table stood down, no remap rebuilt,
+//     no slot count changed -- so the prefill sees exactly the residency it would have had with no store.
+// Every copy is of the same expert bytes the fill would have written, so the text is bit-identical.
+// =====================================================================================================
+static bool    g_l2_on      = true;   // MOE_EXPERT_L2=0 is the A/B arm (bit-for-bit the pre-change path)
+static int64_t g_l2_mib     = 0;      // MOE_EXPERT_L2_MIB: per-device cap, 0/unset = the whole free band
+static int64_t g_l2_hits    = 0;
+static int64_t g_l2_retains = 0;
+static int64_t g_l2_evicts  = 0;
+static int64_t g_l2_drops   = 0;
+static int64_t g_l2_bytes   = 0;      // resident across all devices, now
+static void *  g_l2_region[GGML_CUDA_MAX_DEVICES]       = {};
+static size_t  g_l2_region_bytes[GGML_CUDA_MAX_DEVICES] = {};
+
+// Drop a table's view of the store.  The bytes stay owned by the device region (freed as a unit).
+static void l2_clear_table_locked(table_t & t) {
+    t.l2_base = nullptr;
+    t.l2_cap  = 0;
+    t.l2_slot.clear();
+    t.l2_stamp.clear();
+    t.l2_index.clear();
+}
+
+// Free the whole region on one device.  Called from the prefill's boundary move: the band is the work
+// pool's now, so the store is dropped WHOLE -- that is the property that makes it free (no table is stood
+// down, nothing is re-read, and the residency the prefill sees is the one it would have seen without it).
+static size_t l2_free_locked(int device) {
+    size_t freed = 0;
+    for (table_t & t : g_tables) {
+        if (t.device != device) {
+            continue;
+        }
+        l2_clear_table_locked(t);
+    }
+    if (g_l2_region[device] != nullptr) {
+        // A D2D copy issued from the take-over hook can be a node of a captured graph, and the region's
+        // address is about to stop existing: invalidate captures exactly as a table stand-down does.
+        ggml_cuda_graph_mem_freed(device);
+        ggml_cuda_slab_arena_free(device, g_l2_region[device], g_l2_region_bytes[device]);
+        freed = g_l2_region_bytes[device];
+        g_l2_bytes -= (int64_t) g_l2_region_bytes[device];
+        if (g_l2_bytes < 0) {
+            g_l2_bytes = 0;
+        }
+        g_l2_region[device]       = nullptr;
+        g_l2_region_bytes[device] = 0;
+        g_l2_drops++;
+    }
+    return freed;
+}
+
+// Size / partition the store from the arena's CURRENT free VA (the band the drop just returned) and hand
+// every eligible table an equal BYTE share of it.  Re-planned at every drop: the region is a cache, so
+// throwing its content away to re-partition costs nothing but the retained copies.
+static void l2_plan_locked(int device) {
+    if (!g_l2_on || g_gtt_arena || !ggml_cuda_slab_enabled()) {
+        return;
+    }
+    // Eligibility FIRST, with no device call: a device with no tables is never touched (a hidden ordinal
+    // would make the guard itself fail), and a device whose tables are all wholly resident has nothing to
+    // store.
+    std::vector<int> elig;
+    size_t used = 0;
+    for (int i = 0; i < (int) g_tables.size(); i++) {
+        const table_t & t = g_tables[i];
+        if (t.device != device || !t.allocated || t.slots <= 0 || t.expert_bytes == 0 || t.identity) {
+            continue;   // stood down, or already wholly resident (no miss can ever reach the store)
+        }
+        used += t.arena_reserved;
+        elig.push_back(i);
+    }
+    if (elig.empty()) {
+        return;
+    }
+    device_guard dg(device);
+    l2_free_locked(device);
+    const size_t cap_total = ggml_cuda_slab_arena_total(device);
+    if (cap_total <= used) {
+        return;   // no band on this device (the sizing already took it)
+    }
+    size_t want = cap_total - used;
+    if (g_l2_mib > 0 && want > (size_t) g_l2_mib << 20) {
+        want = (size_t) g_l2_mib << 20;
+    }
+    // A quarter of the band is deliberately left free: the boundary moves in 64 MiB chunks and a store that
+    // fills the band exactly would be dropped by the first chunk of any prefill growth.
+    want = (want / 4) * 3;
+    if (want / elig.size() == 0) {
+        return;
+    }
+    // Allocate ONE block (the slab rounds to its arena unit) and carve it up by each table's own expert size.
+    // A free band that is FRAGMENTED into runs smaller than `want` still has a store to take: descend until a
+    // run fits (a shape whose arena is 70 % resident leaves only ~2 GiB of band, in pieces).
+    void * base = nullptr;
+    size_t alloc_bytes = want;
+    for (int attempt = 0; attempt < 10 && base == nullptr; attempt++) {
+        base = ggml_cuda_slab_arena_alloc(device, alloc_bytes);
+        if (base == nullptr) {
+            alloc_bytes = alloc_bytes * 3 / 4;
+            if (alloc_bytes < (1u << 20) || alloc_bytes < elig.size() * 4096) {
+                break;
+            }
+        }
+    }
+    if (base == nullptr) {
+        static bool warned = false;
+        if (!warned) {
+            warned = true;
+            GGML_LOG_INFO("%s: drop-band expert store NOT armed on device %d: the arena's free band is %.1f MiB "
+                          "but no single free run holds the store (fragmented); nothing is lost, the miss path "
+                          "is unchanged\n", __func__, device, (double) want / (1024 * 1024));
+        }
+        return;
+    }
+    want = alloc_bytes;
+    // The share MUST be re-derived here: the descent above can shrink the block, and a share computed from
+    // the original `want` would carve the last tables' entries PAST the end of the region -- into another
+    // table's arena or the work region -- which is silent VRAM corruption (measured on the 122B, whose band
+    // is small and fragmented: the corrupted arm generated 1 032 characters instead of 3 499).
+    const size_t share = want / elig.size();
+    if (share == 0) {
+        ggml_cuda_slab_arena_free(device, base, want);
+        return;
+    }
+    const size_t unit = ggml_cuda_slab_arena_unit(device);
+    const size_t reserved = unit > 0 ? unit * ((want + unit - 1) / unit) : want;
+    g_l2_region[device]       = base;
+    g_l2_region_bytes[device] = reserved;
+    g_l2_bytes += (int64_t) reserved;
+    // The region's address is a kernel argument for any captured graph that contains a store copy.
+    ggml_cuda_graph_mem_freed(device);
+
+    size_t off = 0;
+    int    n_tables = 0;
+    int    n_entries = 0;
+    for (int i : elig) {
+        table_t & t = g_tables[i];
+        const size_t k = share / t.expert_bytes;
+        if (k == 0) {
+            continue;
+        }
+        if (off + k * t.expert_bytes > want) {
+            break;   // never carve past the block (see the share note above)
+        }
+        t.l2_base = (char *) base + off;
+        t.l2_cap  = (int) k;
+        t.l2_slot.assign(k, -1);
+        t.l2_stamp.assign(k, 0);
+        t.l2_index.clear();
+        off += k * t.expert_bytes;
+        n_tables++;
+        n_entries += (int) k;
+    }
+    if (n_tables == 0) {
+        l2_free_locked(device);
+        return;
+    }
+    GGML_LOG_INFO("%s: L2 (VRAM) expert store: device %d, %.1f MiB in the band the drop returned (%d entries "
+                  "over %d table(s), %.0f KiB each; MOE_EXPERT_L2=0 disables it)\n", __func__, device,
+                  (double) reserved / (1024 * 1024), n_entries, n_tables,
+                  (double) (n_entries > 0 ? share / 1024 : 0));
+}
+
+static void l2_plan_all_locked() {
+    // PROTOTYPE knobs, read once.  `MOE_EXPERT_L2=0` is the A/B arm and is bit-for-bit the pre-change path
+    // (nothing is allocated, `l2_cap` stays 0, so the miss path never touches the store).
+    static bool parsed = false;
+    if (!parsed) {
+        parsed   = true;
+        g_l2_on  = env_int("MOE_EXPERT_L2", 1) != 0;
+        g_l2_mib = env_int("MOE_EXPERT_L2_MIB", 0);
+        if (g_l2_mib < 0) {
+            g_l2_mib = 0;
+        }
+    }
+    if (!g_l2_on || g_gtt_arena || !ggml_cuda_slab_enabled()) {
+        return;
+    }
+    bool have[GGML_CUDA_MAX_DEVICES] = {};
+    for (const table_t & t : g_tables) {
+        if (t.device >= 0 && t.device < GGML_CUDA_MAX_DEVICES) {
+            have[t.device] = true;
+        }
+    }
+    for (int d = 0; d < GGML_CUDA_MAX_DEVICES; d++) {
+        if (have[d] && g_l2_region[d] == nullptr) {
+            l2_plan_locked(d);
+        }
+    }
+}
