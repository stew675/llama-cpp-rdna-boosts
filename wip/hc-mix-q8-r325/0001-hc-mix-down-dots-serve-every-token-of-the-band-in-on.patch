From d91b25d8f36f9ea24f81fe975ec62362f606bee1 Mon Sep 17 00:00:00 2001
From: bsp2020 <bsp2020@gmail.com>
Date: Sat, 21 Nov 2026 02:18:22 +0000
Subject: [PATCH 1/2] hc mix: down dots serve every token of the band in one
 block (weights read once per call; GGML_CUDA_HC_DOWN_MT=0: per-token grid)

---
 ggml/src/ggml-cuda/hc-mix.cu | 164 ++++++++++++++++++++++++++++++++++-
 1 file changed, 163 insertions(+), 1 deletion(-)

diff --git a/ggml/src/ggml-cuda/hc-mix.cu b/ggml/src/ggml-cuda/hc-mix.cu
index 3a6353da28..688e2341f7 100644
--- a/ggml/src/ggml-cuda/hc-mix.cu
+++ b/ggml/src/ggml-cuda/hc-mix.cu
@@ -383,6 +383,147 @@ static __global__ void hc_mix_down_dots(
     }
 }
 
+// hc_mix_down_dots with every token of the band in one block: grid (rows, 1) instead of
+// (rows, NT), so each weight row is read once per call instead of once per token.  Per token the thread item
+// order, the dp4a dot (vec_dot_q8_0_q8_1's v/u loads and impl), the warp butterfly and the fixed-order sum of
+// the 8 warp partials are the per-token kernel's, so lo / inject / y_v are bit-identical to it.  The done
+// counters stay per (token, q8 group); this block increments the counter of every token and finishes the
+// groups it completes.  GGML_CUDA_HC_DOWN_MT=0: the per-token grid.
+template <int NT>
+static __global__ void hc_mix_down_dots_mt(
+        const block_q8_0 * w_down, float * lo, const int nrows_down,
+        const block_q8_0 * w_inject, float * inject, const int nrows_inject,
+        const block_q8_1 * y, const int blocks_per_row,
+        const int64_t y_stride_t, const int64_t lo_stride_t, const int64_t inject_stride_t,
+        block_q8_1 * y_v, const int blocks_up, const float inv_hc, unsigned int * done,
+        const float * xn, const float * w_inject_f32, const int nrows_inject_f32, const int ncols2, const int64_t xn_stride_t) {
+    // the F32 inject rows keep one block per (row, token): each reads a whole hc_dim row (~10x a down row), so a
+    // token loop there would set the grid's tail; they are the first nrows_inject_f32*NT blocks
+    const int row = (int) blockIdx.x - nrows_inject_f32*NT;
+    const int tid = 32*threadIdx.y + threadIdx.x;
+    if (row < 0) {
+        // the per-token kernel's F32 inject block verbatim
+        const int r = (int) blockIdx.x / NT;
+        const int t = (int) blockIdx.x % NT;
+        const float2 * x2 = (const float2 *) (xn + (int64_t) t*xn_stride_t);
+        const float2 * w2 = (const float2 *) (w_inject_f32 + (int64_t) r*2*ncols2);
+        float sumf = 0.0f;
+        for (int col2 = tid; col2 < ncols2; col2 += 256) {
+            const float2 tmpx = x2[col2];
+            const float2 tmpw = w2[col2];
+            sumf += tmpx.x*tmpw.x;
+            sumf += tmpx.y*tmpw.y;
+        }
+        sumf = warp_reduce_sum<32>(sumf);
+        __shared__ float buf[32];
+        if (tid < 32) {
+            buf[tid] = 0.0f;
+        }
+        __syncthreads();
+        buf[tid/32] = sumf;
+        __syncthreads();
+        if (tid < 32) {
+            sumf = buf[tid];
+            sumf = warp_reduce_sum<32>(sumf);
+            if (tid == 0) {
+                inject[(int64_t) t*inject_stride_t + r] = sumf * inv_hc;
+            }
+        }
+        return;
+    }
+    const bool is_inject = row >= nrows_down;
+    const int r = is_inject ? row - nrows_down : row;
+    const block_q8_0 * w = (is_inject ? w_inject : w_down) + (int64_t) r*blocks_per_row;
+
+    constexpr int qi  = QI8_0;             // 8
+    constexpr int vdr = VDR_Q8_0_Q8_1_MMVQ;
+    const int n_groups = 8*32 / (qi/vdr);
+    const int kqs = vdr * (tid % (qi/vdr));
+
+    float acc[NT];
+#pragma unroll
+    for (int t = 0; t < NT; ++t) {
+        acc[t] = 0.0f;
+    }
+    for (int it = tid / (qi/vdr); it < blocks_per_row; it += n_groups) {
+        const block_q8_0 * bq8_0 = w + it;
+        int v[vdr];
+#pragma unroll
+        for (int i = 0; i < vdr; ++i) {
+            v[i] = get_int_b2(bq8_0->qs, kqs + i);
+        }
+        const float d0 = bq8_0->d;
+#pragma unroll
+        for (int t = 0; t < NT; ++t) {
+            const block_q8_1 * bq8_1 = y + (int64_t) t*y_stride_t + it;
+            int u[vdr];
+#pragma unroll
+            for (int i = 0; i < vdr; ++i) {
+                u[i] = get_int_b4(bq8_1->qs, kqs + i);
+            }
+            acc[t] += vec_dot_q8_0_q8_1_impl<float, vdr>(v, u, d0, __low2half(bq8_1->ds));
+        }
+    }
+
+    __shared__ float tmp_shared[7][NT];
+#pragma unroll
+    for (int t = 0; t < NT; ++t) {
+        acc[t] = warp_reduce_sum<32>(acc[t]);
+        if (threadIdx.y > 0 && threadIdx.x == 0) {
+            tmp_shared[threadIdx.y-1][t] = acc[t];
+        }
+    }
+    __syncthreads();
+    if (threadIdx.y > 0) {
+        return;
+    }
+#pragma unroll
+    for (int t = 0; t < NT; ++t) {
+#pragma unroll
+        for (int l = 0; l < 7; ++l) {
+            acc[t] += tmp_shared[l][t];
+        }
+        if (threadIdx.x == 0) {
+            float * dst = is_inject ? inject + (int64_t) t*inject_stride_t : lo + (int64_t) t*lo_stride_t;
+            dst[r] = is_inject ? acc[t] * inv_hc : acc[t];
+        }
+    }
+    if (y_v == nullptr || is_inject) {
+        return;
+    }
+    // one counter per q8_1 group (done[kb]), not per (token, group): this block wrote lo[t][r] for every token
+    // above, so the group's 32nd increment means all NT groups are complete; y_v depends on lo only (bit-identical)
+    const int kb   = r / 32;
+    const int lane = threadIdx.x;
+    unsigned int prev = 0;
+    if (lane == 0) {
+        __threadfence();
+        prev = atomicAdd(&done[kb], 1u);
+    }
+    prev = __shfl_sync(0xFFFFFFFF, prev, 0, 32);
+    if (prev != 31) {
+        return;
+    }
+    __threadfence();
+#pragma unroll
+    for (int t = 0; t < NT; ++t) {
+        const float x = ggml_cuda_op_silu_single(__builtin_nontemporal_load(&lo[(int64_t) t*lo_stride_t + kb*32 + lane]) * inv_hc);
+        float amax = fabsf(x);
+        float sum  = x;
+        amax = warp_reduce_max<32>(amax);
+        sum  = warp_reduce_sum<32>(sum);
+        const float  d = amax / 127.0f;
+        const int8_t q = amax == 0.0f ? 0 : (int8_t) roundf(x / d);
+        y_v[t*blocks_up + kb].qs[lane] = q;
+        if (lane == 0) {
+            y_v[t*blocks_up + kb].ds = make_half2(d, sum);
+        }
+    }
+    if (lane == 0) {
+        done[kb] = 0;   // reset for the next launch (zero-once persistent counters)
+    }
+}
+
 // silu(lo/hc) and Q8_1 quantize of the low-rank vector, then the Q8_0 matrix-
 // vector product w^T v (the "up" dot). The quantize kernel is merged into the
 // dot kernel: every block quantizes all of v in its prologue (the writes are
@@ -1597,7 +1738,28 @@ static void ggml_cuda_op_hc_mix_q8(ggml_backend_cuda_context & ctx, ggml_tensor
             done = done_alloc.get();
         }
     }
-    {
+    static const bool down_mt = [] { const char * e = getenv("GGML_CUDA_HC_DOWN_MT"); return !e || std::atoi(e); }();
+    if (down_mt && n_tokens >= 1 && n_tokens <= 8) {
+        const dim3 block_nums(hc_lr + n_inject_q8 + (inj_f32_down ? hc*n_tokens : 0), 1);
+        const ggml_cuda_kernel_launch_params launch_params = {block_nums, dim3(32, 8), 0, stream};
+#define HC_DOWN_MT(NT) ggml_cuda_kernel_launch(hc_mix_down_dots_mt<NT>, launch_params, \
+                (const block_q8_0 *) w_down->data, lo, (int) hc_lr, \
+                n_inject_q8 ? (const block_q8_0 *) w_inject->data : nullptr, inject, n_inject_q8, \
+                y_xn, blocks_down, (int64_t) blocks_down, (int64_t) hc_lr, inject_stride_t, \
+                pre ? y_v : nullptr, blocks_up, 1.0f / (float) hc, done, \
+                (const float *) xn, inj_f32_down ? (const float *) w_inject->data : nullptr, inj_f32_down ? (int) hc : 0, (int) (hc_dim / 2), hc_dim)
+        switch (n_tokens) {
+            case 1: HC_DOWN_MT(1); break;
+            case 2: HC_DOWN_MT(2); break;
+            case 3: HC_DOWN_MT(3); break;
+            case 4: HC_DOWN_MT(4); break;
+            case 5: HC_DOWN_MT(5); break;
+            case 6: HC_DOWN_MT(6); break;
+            case 7: HC_DOWN_MT(7); break;
+            default: HC_DOWN_MT(8); break;
+        }
+#undef HC_DOWN_MT
+    } else {
         const dim3 block_nums(hc_lr + n_inject_q8 + (inj_f32_down ? hc : 0), n_tokens);
         const dim3 block_dims(32, 8);
         const ggml_cuda_kernel_launch_params launch_params = {block_nums, block_dims, 0, stream};
-- 
