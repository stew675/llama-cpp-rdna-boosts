From bf5095087287216316404add882ce662821400d5 Mon Sep 17 00:00:00 2001
From: overdoingism <overdoingism@users.noreply.github.com>
Date: Wed, 18 Nov 2026 05:25:14 +0800
Subject: [PATCH] FA band: 128-dim heads with a GQA ratio that is not a
 multiple of 8 (GGML_HIP_FA_BAND_WMMA_H128=0 turns it off)

Outside the band an odd GQA ratio folds no heads: the generic dispatch folds the largest power of two that
divides the ratio, and the tile kernel needs every column of a block on one K/V head.  A GQA 7 decode
(56 query heads on 8 K/V heads, 128-dim) therefore reads each K/V head once per query head.  The band
folds the group into ncols2 = 8 and masks the unused columns; this lets 128-dim heads in, with the
32-column block for every query width (no 64-column band row for this head size yet).  Ratios that are a
multiple of 8 fold whole in the generic dispatch and stay there.

test-backend-ops: FLASH_ATTN_EXT cases for 128-dim heads with GQA 5, 6, 7 and 12 (eval), and decode /
verify perf cases for GQA 5, 7 and 8.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ggml/src/ggml-cuda/fattn-mma-f16.cuh |  4 ++--
 ggml/src/ggml-cuda/fattn-rdna.cuh    | 19 ++++++++++++++++++-
 ggml/src/ggml-cuda/fattn.cu          | 12 ++++++++++++
 tests/test-backend-ops.cpp           | 26 ++++++++++++++++++++++++++
 4 files changed, 58 insertions(+), 3 deletions(-)

diff --git a/ggml/src/ggml-cuda/fattn-mma-f16.cuh b/ggml/src/ggml-cuda/fattn-mma-f16.cuh
index 8dec6f09e..e264b6d10 100644
--- a/ggml/src/ggml-cuda/fattn-mma-f16.cuh
+++ b/ggml/src/ggml-cuda/fattn-mma-f16.cuh
@@ -2760,8 +2760,8 @@ static __global__ void flash_attn_ext_f16(
     // the KV iterations i, i+P, i+2P, ... of its tile; block P-1 writes the tile-finishing partial
     // (needs_fixup) and the others the fixup-buffer partials (is_fixup), which is exactly the layout
     // flash_attn_stream_k_fixup_uniform combines (b = tile*P + i).  Compiled only for the instances
-    // the band dispatches to (head 256, GQA folded into ncols2 = 8).
-    if constexpr (!use_sparse && DKQ == 256 && DV == 256 && ncols2 == 8) {
+    // the band dispatches to (head 256, or head 128 unless GGML_HIP_FA_BAND_WMMA_H128=0; GQA folded into ncols2 = 8).
+    if constexpr (!use_sparse && ((DKQ == 256 && DV == 256) || (DKQ == 128 && DV == 128 && ncols1 <= 4)) && ncols2 == 8) {
         if (gridDim.y > 1) {
             const int tile     = blockIdx.x;
             const int sequence =  tile /(iter_j*iter_z_gqa*ne12);
diff --git a/ggml/src/ggml-cuda/fattn-rdna.cuh b/ggml/src/ggml-cuda/fattn-rdna.cuh
index 1c2626477..a3f32f7f4 100644
--- a/ggml/src/ggml-cuda/fattn-rdna.cuh
+++ b/ggml/src/ggml-cuda/fattn-rdna.cuh
@@ -409,6 +409,20 @@ static inline bool ggml_cuda_fattn_band_fetch_ahead_enabled() {
     return v;
 }
 
+// 128-dim heads in the band (on by default; GGML_HIP_FA_BAND_WMMA_H128=0 turns it off).  Outside the band an odd GQA ratio
+// folds no heads at all (the generic dispatch folds the largest power of two dividing the ratio, and the tile
+// kernel needs every column of a block on one K/V head), so a GQA 7 decode reads each K/V head once per query
+// head.  The band folds the group into ncols2 = 8 and masks the unused columns.  Ratios that are a multiple of 8
+// already fold whole in the generic dispatch and stay there.  The band's numbers differ from the tile kernel's
+// (another summation order); decode and verify (1..8 rows) stay bit-identical to each other.
+static inline bool ggml_cuda_fattn_band_wmma_h128_enabled() {
+    static const bool v = []() {
+        const char * env = getenv("GGML_HIP_FA_BAND_WMMA_H128");
+        return env == nullptr || atoi(env) != 0;
+    }();
+    return v;
+}
+
 // Self-contained band predicate shared by the kernel chooser, the ncols dispatcher and launch_fattn,
 // so the three can never disagree (a disagreement would launch the WMMA kernel with ncols2 != 8,
 // whose band fast path is compiled out and whose stream-k split is query-width dependent).
@@ -460,6 +474,9 @@ static inline bool ggml_cuda_fattn_band_wmma_applies(const int cc, const ggml_te
     const bool kv_f16    = K->type == GGML_TYPE_F16 && V->type == GGML_TYPE_F16;
     const bool kv_ok     = kv_quant || kv_f16;
 
-    return gqa_opt && Q->ne[1] <= 8 && Q->ne[3] == 1 && Q->ne[0] == 256 && V->ne[0] == 256 &&
+    const bool head_ok = (Q->ne[0] == 256 && V->ne[0] == 256) ||
+        (Q->ne[0] == 128 && V->ne[0] == 128 && gqa_ratio % 8 != 0 && ggml_cuda_fattn_band_wmma_h128_enabled());
+
+    return gqa_opt && Q->ne[1] <= 8 && Q->ne[3] == 1 && head_ok &&
         gqa_ratio > 4 && gqa_ratio <= ggml_cuda_fattn_band_wmma_gqa_max() && logit_softcap == 0.0f && kv_ok;
 }
diff --git a/ggml/src/ggml-cuda/fattn.cu b/ggml/src/ggml-cuda/fattn.cu
index 35ae5603b..c87ecd030 100644
--- a/ggml/src/ggml-cuda/fattn.cu
+++ b/ggml/src/ggml-cuda/fattn.cu
@@ -246,6 +246,18 @@ static void ggml_cuda_flash_attn_ext_mma_f16_switch_ncols2(ggml_backend_cuda_con
     GGML_ASSERT(Q->ne[2] % K->ne[2] == 0);
     const int gqa_ratio = Q->ne[2] / K->ne[2];
 
+    if constexpr (DKQ == 128 && DV == 128) {
+        // 128-dim heads (GGML_HIP_FA_BAND_WMMA_H128=0 turns them off): the 32-column block for every query width, two output tiles
+        // for widths 5..8 (no 64-column band row for this head size yet).
+        if (ggml_cuda_fattn_band_wmma_applies(cc, dst)) {
+            if (ggml_cuda_fattn_band_wmma_ncols1(dst) == 4) {
+                ggml_cuda_flash_attn_ext_mma_f16_case<DKQ, DV, 4, 8>(ctx, dst);
+            } else {
+                ggml_cuda_flash_attn_ext_mma_f16_case<DKQ, DV, 2, 8>(ctx, dst);
+            }
+            return;
+        }
+    }
     if constexpr (DKQ == 256 && DV == 256) {
         if (ggml_cuda_fattn_band_wmma_applies(cc, dst)) {
             // Query widths 5..8 in one 64-column block, but in the band's OWN geometry (case<..., true>,
diff --git a/tests/test-backend-ops.cpp b/tests/test-backend-ops.cpp
index df778ba87..959630b8d 100644
--- a/tests/test-backend-ops.cpp
+++ b/tests/test-backend-ops.cpp
@@ -11379,6 +11379,21 @@ static std::vector<std::unique_ptr<test_case>> make_test_cases_eval() {
     test_cases.emplace_back(new test_set_rows(GGML_TYPE_F32, GGML_TYPE_F32, GGML_TYPE_I64, { 1, 8, 1, 3 }, { 1, 1 }, 2, false));
     test_cases.emplace_back(new test_set_rows(GGML_TYPE_F32, GGML_TYPE_F32, GGML_TYPE_I32, { 1, 8, 1, 3 }, { 1, 1 }, 2, false));
     test_cases.emplace_back(new test_set_rows(GGML_TYPE_F32, GGML_TYPE_Q8_0, GGML_TYPE_I32, { 256, 5, 1, 3 }, { 1, 1, }, 1, false));
+    // the FA band for 128-dim heads (with GGML_HIP_FA_BAND_WMMA_H128=0 these run the tile kernel): GQA 5, 6, 7 and 12
+    // on 8 and 4 K/V heads, query widths 1..16 (9..16: the n-gram verify rows), q8_0 and f16 K/V; at kv 4096 a 256-cell group
+    // masked for every row
+    for (ggml_type type_KV : { GGML_TYPE_Q8_0, GGML_TYPE_F16 }) {
+        for (int64_t nh : { 8, 4 }) {
+            for (int64_t nr2 : { 5, 6, 7, 12 }) {
+                for (int kv : { 512, 1024, 4096 }) {
+                    for (int nb : { 1, 2, 4, 5, 8, 9, 16 }) {
+                        test_cases.emplace_back(new test_flash_attn_ext(128, 128, nh, {nr2, 1}, kv, nb, true, false, 0, 0, GGML_PREC_F32,
+                                                                        type_KV, type_KV, {0, 1, 2, 3}, true, false, 0, false, false, kv == 4096));
+                    }
+                }
+            }
+        }
+    }
     for (ggml_type src_type : {GGML_TYPE_F16, GGML_TYPE_F32}) {
         for (ggml_type type : all_types) {
             for (int b : {1, 7}) {
@@ -14683,6 +14698,17 @@ static std::vector<std::unique_ptr<test_case>> make_test_cases_perf() {
     test_cases.emplace_back(new test_flash_attn_ext(64, 64, 8, {8, 1}, 7680,   1, true, false, 0, 0, GGML_PREC_F32, GGML_TYPE_Q8_0, GGML_TYPE_Q8_0));
     test_cases.emplace_back(new test_flash_attn_ext(64, 64, 8, {8, 1}, 7680, 512, true, false, 0, 0, GGML_PREC_F32, GGML_TYPE_Q8_0, GGML_TYPE_Q8_0));
 
+    // decode / verify attention of 128-dim heads whose GQA ratio is not a power of two (the FA band; the tile kernel
+    // with GGML_HIP_FA_BAND_WMMA_H128=0), next to GQA 8 (folded whole either way)
+    for (int64_t nr2 : { 5, 7, 8 }) {
+        for (int kv : { 4096, 16384, 45056 }) {
+            for (int nb : { 1, 4, 8, 16 }) {
+                test_cases.emplace_back(new test_flash_attn_ext(128, 128, 8, {nr2, 1}, kv, nb, true, false, 0, 0, GGML_PREC_F32, GGML_TYPE_Q8_0, GGML_TYPE_Q8_0));
+            }
+        }
+        test_cases.emplace_back(new test_flash_attn_ext(128, 128, 8, {nr2, 1}, 16384, 1, true, false, 0, 0, GGML_PREC_F32, GGML_TYPE_F16, GGML_TYPE_F16));
+    }
+
     // sparse decode at long context
     test_cases.emplace_back(new test_flash_attn_ext(512, 512, 1, { 8, 1}, 49152, 1, true, false, 0, 0, GGML_PREC_F32, GGML_TYPE_F16, GGML_TYPE_F16, {0, 1, 2, 3}, true, false,    0));
     test_cases.emplace_back(new test_flash_attn_ext(512, 512, 1, { 8, 1}, 49152, 1, true, false, 0, 0, GGML_PREC_F32, GGML_TYPE_F16, GGML_TYPE_F16, {0, 1, 2, 3}, true, false, 2048));
