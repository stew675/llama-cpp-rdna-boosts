         GGML_ASSERT(fwht_n == 0 && kv.k_dst == nullptr);
     }
+    GGML_ASSERT(!no_norm);
 
     if (ncols < 1024) {
         const dim3 block_dims(256, 1, 1);
@@ -1171,11 +1197,16 @@ static void rms_norm_mul_rope_cuda(
 void ggml_cuda_op_rms_norm_mul_rope_fused(ggml_backend_cuda_context & ctx,
