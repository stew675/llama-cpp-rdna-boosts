From 77ccbabb02d4f7b90a18e43a2b1d3e4cddf06e04 Mon Sep 17 00:00:00 2001
From: overdoingism <overdoingism@users.noreply.github.com>
Date: Fri, 20 Nov 2026 01:51:52 +0800
Subject: [PATCH 1/3] ggml-alloc: a GLU may take the memory of one of its
 inputs (GGML_GLU_INPLACE, on unless 0)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ggml/src/ggml-alloc.c | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/ggml/src/ggml-alloc.c b/ggml/src/ggml-alloc.c
index 20fc5dbc1..106bcd586 100644
--- a/ggml/src/ggml-alloc.c
+++ b/ggml/src/ggml-alloc.c
@@ -18,6 +18,18 @@
 //#define AT_PRINTF(...) GGML_LOG_DEBUG(__VA_ARGS__)
 #define AT_PRINTF(...)
 
+// GGML_GLU_INPLACE: a GLU may take the memory of one of its inputs (same layout, no other reader), so the gate, the up and
+// the GLU output of an FFN are not all live at once (Qwen3.8-27B: 136 MiB each at a 2048-token ubatch).  The CPU and
+// CUDA / HIP GLU kernels read each element before they write it.  On unless GGML_GLU_INPLACE=0.
+static bool ggml_glu_inplace(void) {
+    static int on = -1;
+    if (on < 0) {
+        const char * e = getenv("GGML_GLU_INPLACE");
+        on = e == NULL || atoi(e) != 0;
+    }
+    return on != 0;
+}
+
 // ops that return true for this function must not use restrict pointers for their backend implementations
 bool ggml_op_can_inplace(enum ggml_op op) {
     switch (op) {
@@ -42,6 +54,9 @@ bool ggml_op_can_inplace(enum ggml_op op) {
         case GGML_OP_SOFT_MAX_BACK:
             return true;
 
+        case GGML_OP_GLU:
+            return ggml_glu_inplace();
+
         default:
             return false;
     }
