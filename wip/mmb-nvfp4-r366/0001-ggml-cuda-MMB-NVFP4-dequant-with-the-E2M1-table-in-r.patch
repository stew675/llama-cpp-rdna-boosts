From 9991400459c4ee7307b72202e9490a8a1d3c9bac Mon Sep 17 00:00:00 2001
From: bsp2020 <bsp2020@gmail.com>
Date: Thu, 26 Nov 2026 19:57:23 -0800
Subject: [PATCH 1/2] ggml-cuda MMB: NVFP4 dequant with the E2M1 table in
 registers

ggml-cuda MMB: NVFP4 weights dequantized with the E2M1 table held in registers (byte permutes, not one table load per value) and packed to bf16 without the rounding adds (an UE4M3 x E2M1 product has at most 6 significant bits, so bf16 holds it exactly); bit-identical; Inkling routed MoE prefill pp4096 1960 -> 2018 t/s (+2.9 %), 28K prompt 1516 -> 1581 (GGML_CUDA_MMB_FP4_PERM=0: the table loads, WTYPE 19)
---
 ggml/src/ggml-cuda/mmb.cu | 59 +++++++++++++++++++++++++++++----------
 1 file changed, 44 insertions(+), 15 deletions(-)

diff --git a/ggml/src/ggml-cuda/mmb.cu b/ggml/src/ggml-cuda/mmb.cu
index 62f6c3a191..de9160fb64 100644
--- a/ggml/src/ggml-cuda/mmb.cu
+++ b/ggml/src/ggml-cuda/mmb.cu
@@ -417,7 +417,24 @@ __device__ __forceinline__ void mmb_dq_row_mxfp4(const uint8_t * base, uint32_t
 // dequantize one weight row's NVFP4 block (36 B: 64 values, uint8 d[4] UE4M3 per-16-element scales
 // + qs[32]) into 64 bf16.  value = ue4m3(d[sub]) * kvalues_mxfp4[nibble] (the UE4M3 scale is halved
 // and the E2M1 table doubled, so the product is exact).  One 64-value block per K-step.
-__device__ __forceinline__ void mmb_dq_row_nvfp4(const uint8_t * base, uint32_t * arow) {
+// The E2M1 values (kvalues_fp4: 0 1 2 3 4 6 8 12, then the negatives) of the 4 nibble indices in the bytes of `idx` (each
+// 0..15), as 4 int8 bytes: byte selects from the table held in registers, not one table load per value (GGML_CUDA_MMB_FP4_PERM=0:
+// the table loads).  Same values, so the same products and bf16 roundings.
+__device__ __forceinline__ uint32_t mmb_fp4_lut4(const uint32_t idx) {
+    const uint32_t lo  = __builtin_amdgcn_perm(0x0C080604u, 0x03020100u, idx & 0x07070707u);  // table[0..7]
+    const uint32_t hi  = __builtin_amdgcn_perm(0xF4F8FAFCu, 0xFDFEFF00u, idx & 0x07070707u);  // table[8..15]
+    return __builtin_amdgcn_perm(hi, lo, 0x03020100u | ((idx & 0x08080808u) >> 1));
+}
+__device__ __forceinline__ float mmb_s8(const uint32_t x, const int j) { return (float) (int8_t) (x >> (8*j)); }
+// bf16 pair of two floats that bf16 holds exactly (the low 16 bits are zero): mmb_pack2's round-to-nearest adds nothing, so
+// this is the same bits without the rounding adds.  An NVFP4 value d * e2m1 is such a float: the UE4M3 scale has at most 4
+// significant bits and the E2M1 value (0, 1, 1.5 times a power of two) at most 2, so the product has at most 6 (bf16 has 8),
+// and its exponent stays inside bf16's (= fp32's) range.
+__device__ __forceinline__ uint32_t mmb_pack2_exact(float a, float b) {
+    return __builtin_amdgcn_perm(__float_as_uint(a), __float_as_uint(b), 0x03020706u);  // as mmb_pack2: a low, b high
+}
+
+__device__ __forceinline__ void mmb_dq_row_nvfp4(const uint8_t * base, uint32_t * arow, const bool fp4_perm) {
     const uint8_t * sc = base;
     const uint32_t * q = (const uint32_t *)(base + 4);
 #pragma unroll
@@ -428,6 +445,14 @@ __device__ __forceinline__ void mmb_dq_row_nvfp4(const uint8_t * base, uint32_t
         for (int w = 0; w < 2; ++w) {
             const uint32_t v = q[s * 2 + w];
             const uint32_t lo = v & 0x0F0F0F0Fu, hi = (v >> 4) & 0x0F0F0F0Fu;
+            if (fp4_perm) {
+                const uint32_t vl = mmb_fp4_lut4(lo), vh = mmb_fp4_lut4(hi);
+                out[2*w]         = mmb_pack2_exact(d * mmb_s8(vl, 0), d * mmb_s8(vl, 1));
+                out[2*w + 1]     = mmb_pack2_exact(d * mmb_s8(vl, 2), d * mmb_s8(vl, 3));
+                out[4 + 2*w]     = mmb_pack2_exact(d * mmb_s8(vh, 0), d * mmb_s8(vh, 1));
+                out[4 + 2*w + 1] = mmb_pack2_exact(d * mmb_s8(vh, 2), d * mmb_s8(vh, 3));
+                continue;
+            }
             out[2*w]     = mmb_pack2(d * (float)kvalues_mxfp4[ lo        & 0xFu], d * (float)kvalues_mxfp4[(lo >>  8) & 0xFu]);
             out[2*w + 1] = mmb_pack2(d * (float)kvalues_mxfp4[(lo >> 16) & 0xFu], d * (float)kvalues_mxfp4[(lo >> 24)      & 0xFu]);
             out[4 + 2*w]     = mmb_pack2(d * (float)kvalues_mxfp4[ hi        & 0xFu], d * (float)kvalues_mxfp4[(hi >>  8) & 0xFu]);
@@ -830,7 +855,7 @@ __device__ __forceinline__ void mmb_tile_gemm(const uint8_t * __restrict__ Wbase
