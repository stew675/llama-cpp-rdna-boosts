# FA kernel-chooser/plan trace instrumentation (2026-09-11)
#
# Adds GGML_CUDA_FA_TRACE=1 logging to the FlashAttention kernel-family chooser and to
# launch_fattn's plan, for n_q <= 8 only:
#   [FATPATH]  n_q, the chosen family (100=VEC, 200=TILE, 400=MMA_F16), mask presence, K/V types
#   [FATTRACE] n_q, ncols1/ncols2, stream_k, ntiles_dst/KV, parallel_blocks, the launch grid
#   [FATTRACE2] n_q, ncols, nwarps, nbatch_fa, need_f16_K/V
# Apply with: git apply fa-kernel-chooser-trace.patch   (revert before landing)
# This is how F1 was localised: with a quantized K/V the chooser returned VEC at n_q<=2 and
# TILE at n_q>=3, splitting the decode/verify band across two kernel families.

diff --git a/ggml/src/ggml-cuda/fattn-common.cuh b/ggml/src/ggml-cuda/fattn-common.cuh
--- a/ggml/src/ggml-cuda/fattn-common.cuh
+++ b/ggml/src/ggml-cuda/fattn-common.cuh
@@ -1116,6 +1116,19 @@ void launch_fattn(
         const int iter_k = K->ne[1] / FATTN_KQ_STRIDE;
 
         KV_max.alloc(ne_KV_max);
+        if (getenv("GGML_CUDA_FA_TRACE") && Q->ne[1] <= 8) {
+            fprintf(stderr, "[FATTRACE] n_q=%d ncols1=%d ncols2=%d stream_k=%d sparse=%d K=%d V=%d"
+                    " ntiles_x=%d ntiles_z_gqa=%d ntiles_dst=%d ntiles_KV=%d n_kv=%lld"
+                    " maxblk_sm=%d nsm=%d par_blocks=%d grid=(%u,%u,%u) name=%s\n",
+                    (int) Q->ne[1], ncols1, ncols2, (int) stream_k, (int) use_sparse,
+                    (int) K->type, (int) V->type,
+                    ntiles_x, ntiles_z_gqa, ntiles_dst, ntiles_KV, (long long) n_kv,
+                    max_blocks_per_sm, nsm, parallel_blocks,
+                    blocks_num.x, blocks_num.y, blocks_num.z, dst->name);
+            fprintf(stderr, "[FATTRACE2] n_q=%d ncols=%d nwarps=%d nbatch_fa=%d mask=%d f16K=%d f16V=%d name=%s\n",
+                    (int) Q->ne[1], ncols, nwarps, nbatch_fa, mask != nullptr ? 1 : 0,
+                    (int) need_f16_K, (int) need_f16_V, dst->name);
+        }
         ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params(blocks_num_KV_max, block_dim_KV_max, 0, main_stream);
         ggml_cuda_kernel_launch(flash_attn_mask_to_KV_max<ncols1>, launch_params,
             (const half2 *) mask->data, KV_max.ptr, iter_k, s31, s33);
diff --git a/ggml/src/ggml-cuda/fattn.cu b/ggml/src/ggml-cuda/fattn.cu
--- a/ggml/src/ggml-cuda/fattn.cu
+++ b/ggml/src/ggml-cuda/fattn.cu
@@ -734,6 +733,11 @@ size_t ggml_cuda_flash_attn_ext_get_alloc_size(int device, const ggml_tensor * d
 
 void ggml_cuda_flash_attn_ext(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
     ggml_cuda_set_device(ctx.device);
+    if (getenv("GGML_CUDA_FA_TRACE") && dst->src[0]->ne[1] <= 8) {
+        fprintf(stderr, "[FATPATH] n_q=%d best=%d mask=%d K=%d V=%d name=%s\n",
+                (int) dst->src[0]->ne[1], (int) ggml_cuda_get_best_fattn_kernel(ggml_cuda_get_device(), dst),
+                dst->src[3] != nullptr ? 1 : 0, (int) dst->src[1]->type, (int) dst->src[2]->type, dst->name);
+    }
     switch (ggml_cuda_get_best_fattn_kernel(ggml_cuda_get_device(), dst)) {
         case BEST_FATTN_KERNEL_NONE:
             GGML_ABORT("fatal error");

