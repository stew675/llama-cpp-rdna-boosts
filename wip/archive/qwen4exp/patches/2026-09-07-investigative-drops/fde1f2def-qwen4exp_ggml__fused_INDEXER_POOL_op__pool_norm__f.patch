 }
 
+// ggml_indexer_pool
+
+struct ggml_tensor * ggml_indexer_pool(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * k,
+        struct ggml_tensor  * blk_cells,
+        struct ggml_tensor  * w,
+        int                   r,
+        float                 eps) {
+    GGML_ASSERT(k->type == GGML_TYPE_F32 || k->type == GGML_TYPE_BF16);
+    GGML_ASSERT(blk_cells->type == GGML_TYPE_I32);
+    GGML_ASSERT(w->type        == GGML_TYPE_F32);
+    GGML_ASSERT(blk_cells->ne[0] % r == 0);
+    GGML_ASSERT(k->ne[0] == w->ne[0]);
+
+    const int64_t n_blocks = blk_cells->ne[0] / r;
+
+    struct ggml_tensor * result = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, k->ne[0], n_blocks * k->ne[2], 1);
+
+    result->op     = GGML_OP_INDEXER_POOL;
+    result->src[0] = k;
+    result->src[1] = blk_cells;
+    result->src[2] = w;
+    ggml_set_op_params_i32(result, 0, r);
+    ggml_set_op_params_f32(result, 1, eps);
+
+    return result;
+}
+
 // ggml_flash_attn_back
 
