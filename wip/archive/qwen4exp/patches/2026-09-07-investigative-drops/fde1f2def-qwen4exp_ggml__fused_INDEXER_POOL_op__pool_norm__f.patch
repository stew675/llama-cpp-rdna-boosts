diff --git a/ggml/src/ggml-cuda/indexer-pool.cu b/ggml/src/ggml-cuda/indexer-pool.cu
new file mode 100644
index 000000000..fa89cfd28
--- /dev/null
+++ b/ggml/src/ggml-cuda/indexer-pool.cu
@@ -0,0 +1,153 @@
+// Fused indexer block-pool + rms-norm for the qwen4exp QSA sparse-attention path.
+//
+// Replaces the per-op chain
+//     members  = get_rows(K, blk_cells)
+//     pooled   = (sum over the r block members in order) * (1/r)
+//     pooled   = rms_norm(pooled, W, eps)      (rows = merged (block, stream))
+// with ONE kernel that replicates the per-op F32 arithmetic EXACTLY, so the output
+// is byte-identical to the per-op chain (same gather addresses, same sequential
+// per-element add order, same scalar scale, same 256/1024-thread rms_norm reduction
+// order as ggml-cuda/norm.cu rms_norm_f32).  Numerics parity is the contract: the
+// decode graph's downstream top-k selection is sensitive to last-ulp score changes.
+//
+// src0 = K   : raw indexer cache [idx_dim, n_kv, n_stream] F32 (view of the cache)
+// src1 = BLK : block->cell index map [r*n_blocks, n_stream] I32 (blk_cells)
+// src2 = W   : rms-norm weights [idx_dim] F32 (index_k_norm)
+// op_params  : 0 = r (i32, block size in cells), 1 = eps (f32)
+// dst        : pooled + rms-normed per-block keys [idx_dim, n_blocks*n_stream, 1] F32
+//              row r0 = b + s*n_blocks (block b of stream s), matching the reshape
+//              the per-op path feeds to rms_norm.
+
+#include "indexer-pool.cuh"
+#include "common.cuh"
+
+static __device__ __forceinline__ float indexer_pool_ld_val(const void * p, const bool is_bf16) {
+    if (is_bf16) {
+        // ggml bf16 -> f32 is an exact `bits << 16` (ggml_bf16_to_fp32)
+        return __uint_as_float(((uint32_t) *(const uint16_t *) p) << 16);
+    }
+    return *(const float *) p;
+}
+
+static __device__ __forceinline__ float indexer_pool_norm_col(
+        const char * K, const int * blk_row, const int c, const int idx_dim,
+        const int r, const float rinv, const int64_t nb0K, const int64_t nb1K, const bool is_bf16) {
+    // per-element block-mean pool: sequential F32 adds over the r members in cell order
+    // (members are F32 after the gather's bf16->f32 upcast in the per-op path)
+    float acc = 0.0f;
+    const char * Kcol = K + (int64_t) c * nb0K;
+    for (int i = 0; i < r; ++i) {
+        acc += indexer_pool_ld_val(Kcol + (int64_t) blk_row[i] * nb1K, is_bf16);
+    }
+    return acc * rinv;
+}
+
+template <int BLOCK_SIZE>
+static __global__ void indexer_pool_kernel(
+        const char * __restrict__ K,
+        const int   * __restrict__ BLK,
+        const float * __restrict__ W,
+        float * __restrict__ dst,
+        const int    idx_dim,
+        const int    r,
+        const float  rinv,
+        const float  eps,
+        const int    n_blocks,
+        const int    n_stream,
+        const int64_t nb0K,   // K element stride (bytes: 2 bf16 / 4 f32)
+        const int64_t nb1K,   // K cell stride (bytes)
+        const int64_t nb2K,   // K stream stride (bytes)
+        const int64_t nb1B,   // BLK stream stride (bytes)
+        const bool    is_bf16) {
+    const int r0 = blockIdx.x;             // merged (block, stream) row index
+    const int s  = r0 / n_blocks;          // stream
+    const int b  = r0 - s*n_blocks;        // block
+    const int tid = threadIdx.x;
+
+    const char * Ks    = K  + (int64_t) s*nb2K;
+    const int  * blk_row = (const int *) ((const char *) BLK + (int64_t) s*nb1B) + (int64_t) r*b;
+
+    extern __shared__ float smem[];
+    float * pooled = smem;                         // pooled[c], c in [0, idx_dim)
+    float * s_vals = smem + idx_dim;               // block_reduce warp leaders
+
+    // pass 1: pool each column this thread owns (same strided walk as rms_norm_f32)
+    float tmp = 0.0f;
+    for (int c = tid; c < idx_dim; c += BLOCK_SIZE) {
+        const float pv = indexer_pool_norm_col(Ks, blk_row, c, idx_dim, r, rinv, nb0K, nb1K, is_bf16);
+        pooled[c] = pv;
+        tmp += pv * pv;
+    }
+    __syncthreads();
+
+    const float mean  = block_reduce<block_reduce_method::SUM, BLOCK_SIZE>(tmp, s_vals) / (float) idx_dim;
+    const float scale = rsqrtf(mean + eps);
+
+    // pass 2: write dst = scale * pooled * W  (mul order as rms_norm_f32's do_multiply)
+    for (int c = tid; c < idx_dim; c += BLOCK_SIZE) {
+        dst[(int64_t) r0 * idx_dim + c] = scale * pooled[c] * W[c];
+    }
+}
+
+static void ggml_cuda_indexer_pool_impl(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * K   = dst->src[0];
+    const ggml_tensor * BLK = dst->src[1];
+    const ggml_tensor * W   = dst->src[2];
+
+    const int   r    = ggml_get_op_params_i32(dst, 0);
+    const float eps  = ggml_get_op_params_f32(dst, 1);
+    const int   idx_dim = (int) K->ne[0];
+    const int   n_kv   = (int) K->ne[1];
+    const int   n_stream = (int) K->ne[2];
+
+    const int64_t n_cells = BLK->ne[0];           // r*n_blocks
+    GGML_ASSERT(n_cells % r == 0);
+    const int n_blocks = (int) (n_cells / r);
+    GGML_ASSERT(n_blocks > 0);
+    const bool is_bf16 = K->type == GGML_TYPE_BF16;
+    GGML_ASSERT((K->type == GGML_TYPE_F32 || is_bf16) && W->type == GGML_TYPE_F32);
+    GGML_ASSERT(W->ne[0] == idx_dim);
+    GGML_ASSERT(dst->type == GGML_TYPE_F32);
+
+    // mirror rms_norm_f32_cuda's dispatch: ncols < 1024 -> 256-thread block
+    const int block_size = idx_dim < 1024 ? 256 : 1024;
+
+    // K strides: the raw cache view [idx_dim, n_kv, n_stream]
+    // (cell stride nb[1], stream stride nb[2]); BLK [r*n_blocks, n_stream]
+    const int64_t nb1K = K->nb[1];
+    const int64_t nb2K = K->nb[2];
+    const int64_t nb1B = BLK->nb[1];
+
+    float * dst_data = (float *) dst->data;
+    const float rinv = 1.0f / (float) r;
+    const int64_t nb0K = K->nb[0];   // 2 (bf16) or 4 (f32)
+
+    cudaStream_t stream = ctx.stream();
+    const dim3 blocks_num(n_blocks * n_stream);
+    const size_t smem = (idx_dim + 32) * sizeof(float);   // pooled + warp-leader slots
+
+    const ggml_cuda_kernel_launch_params launch_params = {blocks_num, dim3(block_size, 1, 1), smem, stream};
+    if (block_size == 1024) {
+        ggml_cuda_kernel_launch(indexer_pool_kernel<1024>, launch_params,
+            (const char *) K->data, (const int *) BLK->data, (const float *) W->data, dst_data,
+            idx_dim, r, rinv, eps, n_blocks, n_stream, nb0K, nb1K, nb2K, nb1B, is_bf16);
+    } else {
+        ggml_cuda_kernel_launch(indexer_pool_kernel<256>, launch_params,
+            (const char *) K->data, (const int *) BLK->data, (const float *) W->data, dst_data,
+            idx_dim, r, rinv, eps, n_blocks, n_stream, nb0K, nb1K, nb2K, nb1B, is_bf16);
+    }
+}
+
+void ggml_cuda_indexer_pool(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    ggml_cuda_indexer_pool_impl(ctx, dst);
+}
+
+bool ggml_cuda_indexer_pool_supported(int device, const ggml_tensor * dst) {
+    GGML_ASSERT(dst->op == GGML_OP_INDEXER_POOL);
+    GGML_UNUSED(device);
+    const ggml_tensor * K   = dst->src[0];
+    const ggml_tensor * BLK = dst->src[1];
+    const ggml_tensor * W   = dst->src[2];
+    return (K->type == GGML_TYPE_F32 || K->type == GGML_TYPE_BF16) && BLK->type == GGML_TYPE_I32 &&
+           W->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32;
+}
