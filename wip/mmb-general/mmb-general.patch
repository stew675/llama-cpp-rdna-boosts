diff --git a/ggml/src/ggml-cuda/fattn-qsa3.cu b/ggml/src/ggml-cuda/fattn-qsa3.cu
new file mode 100644
index 000000000..d78d75853
--- /dev/null
+++ b/ggml/src/ggml-cuda/fattn-qsa3.cu
@@ -0,0 +1,696 @@
+#include "common.cuh"
+#include "fattn-qsa.cuh"
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+// qsa3: packed-block WMMA prefill for the qwen4exp QSA (sparse) attention.
+//
+// The VEC kernel (fattn-qsa.cu) walks the top-k list cell by cell with v_dot2 and one query
+// column per block; this one shares a block of work across G = 4 queries and 12 query heads
+// (48 output rows) and runs the score and PV passes on the F16 WMMA tensor cores over a
+// package of 4 key blocks (16 keys) at a time.
+//
+// It consumes the packed F16 layouts built by the launcher's fused pack kernels below from the natural
+// contiguous F16 cache view (op src[7]/src[8], `ggml_flash_attn_qsa_set_packed`):
+//   pk  [16, 4, 16, n_kv/4*n_kvh]   F16   keys, 4-key blocks, (a, k, b, n) at a+16k+64b+1024n
+//   pv  [ 4, 256, n_kv/4*n_kvh, 1]  F16   values, (k, d, n) at k+4d+1024n
+// and derives the per-group block union here (rows/merge kernels), so the attention kernel
+// reads each needed key/value block exactly once for the 48 rows that share it.
+//
+// Ported from the Strix Halo branch's qsa-attn (qsa3); the op plumbing here is the delivery's
+// GGML_OP_FLASH_ATTN_QSA (src[3] = idx, src[4] = mask or NULL, src[5] = cell_vis, src[6] = q_vis).
+// Prefill-only: the launcher's support check requires q->ne[1] >= 128, so the W = 1..8
+// decode/verify band always takes the VEC kernel and width purity holds by construction.
+
+typedef float v8f  __attribute__((ext_vector_type(8)));
+
+#define QSA3_L2E 1.4426950408889634f
+#define QSA3_G 4
+
+// Fragment-layout shim.  Both gens compute a 16x16x16 F16 tile with fp32 accumulation; only the
+// lane bookkeeping differs (see gated_delta_net_chunked_bf16.cu vs ..._gfx11.cu):
+//   gfx11: 16 halfs/lane (the whole K row, lanes 16-31 mirror 0-15), accumulator m = 2*e + hi
+//   gfx12:  8 halfs/lane ("two runs of four": k = 4*hi + {0..3} and 4*hi + 8 + {0..3}), m = 8*hi + e
+#if defined(RDNA4)
+typedef _Float16 qsa3_frag_t __attribute__((ext_vector_type(8)));
+#define QSA3_ACC_M(e, hi) (8*(hi) + (e))
+#else
+typedef short qsa3_frag_t __attribute__((ext_vector_type(16)));
+#define QSA3_ACC_M(e, hi) (2*(e) + (hi))
+#endif
+
+// K-contiguous fragment from a 16-wide F16 row (gfx12 reads the lane's two 8-byte runs).
+static __device__ __forceinline__ qsa3_frag_t qsa3_frag_row(const uint16_t * row, const int hi) {
+#if defined(RDNA4)
+    const uint16_t * p = row + 4 * hi;
+    return __builtin_bit_cast(qsa3_frag_t, (uint2[2]){*reinterpret_cast<const uint2 *>(p), *reinterpret_cast<const uint2 *>(p + 8)});
+#else
+    (void) hi;
+    return __builtin_bit_cast(qsa3_frag_t, (uint4[2]){*reinterpret_cast<const uint4 *>(row), *reinterpret_cast<const uint4 *>(row + 8)});
+#endif
+}
+
+// the kernel's row map is 48 rows = QSA3_G queries x QSA3_HQ heads; the model's gqa is 12
+#define QSA3_HQ 12
+
+static __device__ __forceinline__ uint16_t qsa3_f2h(const float f) { return __builtin_bit_cast(uint16_t, (_Float16) f); }
+static __device__ __forceinline__ float qsa3_h2f(const uint16_t h) { return (float) __builtin_bit_cast(_Float16, h); }
+
+// Portable WMMA dispatch: gfx12 renamed the builtin and uses the 8-half fragment above; gfx11 keeps
+// the first-gen builtin and its 16-half fragment.  The kernels are runtime-gated to RDNA3_5/RDNA4
+// (ggml_cuda_flash_attn_qsa3_supported), so only the matching arm is ever launched.
+static __device__ __forceinline__ v8f qsa3_wmma_f16(const qsa3_frag_t a, const qsa3_frag_t b, const v8f c) {
+#if defined(RDNA4)
+    return __builtin_amdgcn_wmma_f32_16x16x16_f16_w32_gfx12(a, b, c);
+#else
+    return __builtin_amdgcn_wmma_f32_16x16x16_f16_w32(a, b, c);
+#endif
+}
+
+// ------------------------------------------------------------------------------------------------------------
+// union builder, kernel A: per query row, check that the (validity-transformed) row is non-decreasing; if not,
+// rank-sort it into srow[q] and set sflag[q]. Sentinel 0x7FFFFFFF for invalid (-1 / >= nk) entries.
+#define QSA3_SENT 0x7FFFFFFF
+__global__ __launch_bounds__(256) void qsa3_rows_kernel(
+        const int * __restrict__ ids, const size_t i1, const int ns, const int nk, const int bitmap_words,
+        int * __restrict__ srow, int * __restrict__ sflag) {
+    extern __shared__ int ent[];   // [ns] normalized keys (the sortedness check and the fallback sort)
+    // Bitmap path (only when bitmap_words > 0, see the launcher): a nk-bit cell presence map plus the
+    // 256 per-lane scan offsets, carved out of the same dynamic smem right after ent.
+    uint32_t * bitmap = reinterpret_cast<uint32_t *>(ent + ns);
+    int      * ssum   = reinterpret_cast<int *>(bitmap + bitmap_words);
+    __shared__ int unsorted;
+    __shared__ int nvalid;
+    const int q = blockIdx.x, tid = threadIdx.x;
+    const int * row = reinterpret_cast<const int *>(reinterpret_cast<const char *>(ids) + (size_t) q * i1);
+    for (int j = tid; j < ns; j += 256) { const int key = row[j]; ent[j] = (key >= 0 && key < nk) ? key : QSA3_SENT; }
+    if (tid == 0) { unsorted = 0; }
+    __syncthreads();
+    for (int j = tid; j + 1 < ns; j += 256) { if (ent[j] > ent[j+1]) { unsorted = 1; } }
+    __syncthreads();
+    if (unsorted) {
+        int * dst = srow + (size_t) q * ns;
+        if (bitmap_words > 0) {
+            // The row is the indexer's top-k selection, i.e. a SET of cell ids, so a presence bitmap
+            // enumerates it in ascending order - exactly the order the rank sort produces - for
+            // O(ns + nk/32) per row instead of O(ns^2).  The rows are long contiguous runs of a few
+            // ranges, so the bitmap is also dense and the popcount scan is cheap.
+            for (int i = tid; i < bitmap_words; i += 256) { bitmap[i] = 0u; }
+            __syncthreads();
+            for (int j = tid; j < ns; j += 256) {
+                const int v = ent[j];
+                if (v >= 0 && v < nk) { atomicOr(&bitmap[v >> 5], 1u << (v & 31)); }
+            }
+            __syncthreads();
+            const int per = (bitmap_words + 255) / 256;
+            const int w0  = tid * per, w1 = min(w0 + per, bitmap_words);
+            int cnt = 0;
+            for (int w = w0; w < w1; ++w) { cnt += __popc(bitmap[w]); }
+            ssum[tid] = cnt;
+            __syncthreads();
+            if (tid == 0) {
+                int run = 0;
+                for (int i = 0; i < 256; ++i) { const int v = ssum[i]; ssum[i] = run; run += v; }
+                nvalid = run;
+            }
+            __syncthreads();
+            int o = ssum[tid];
+            for (int w = w0; w < w1; ++w) {
+                uint32_t m = bitmap[w];
+                while (m) { const int b = __ffs(m) - 1; m &= m - 1; dst[o++] = (w << 5) + b; }
