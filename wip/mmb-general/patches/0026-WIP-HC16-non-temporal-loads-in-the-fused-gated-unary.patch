From f2e3df704d36fb929c1337831f908846af8a1004 Mon Sep 17 00:00:00 2001
From: Stew Forster <stew675@gmail.com>
Date: Sun, 20 Sep 2026 13:45:17 -0500
Subject: [PATCH 26/28] WIP HC16: non-temporal loads in the fused gated-unary
 producer (+ ggml_cuda_nt_load helper)

unary_gated_op_kernel (the fused sigmoid/silu+mul that produces attn_gated and
final_output) 228.3 -> 190.3 ms (-38.0, two builds) with non-temporal LOADS on x
and g; the dst store stays normal (its consumer wants it cached).

k_bin_bcast was tested too and reverted: a non-temporal src0 load cost +52.8 ms
(the broadcast src1 operand and the residual pattern evidently want the cache).

__builtin_nontemporal_load only accepts builtin scalar/vector pointers, so the
new ggml_cuda_nt_load<T>() helper in common.cuh falls back to a normal access for
wrapper types (__half/bfloat16/float4) -- without it the __half instantiations of
the templated kernels fail to compile.

Bit-identical: PPL 10.6015, greedy 9c281c415082, QSA / GDN / FA-EXT OK, width
probe PASS, plain == draft-mtp byte-identical.
---
 ggml/src/ggml-cuda/common.cuh | 14 ++++++++++++++
 ggml/src/ggml-cuda/unary.cu   |  4 +++-
 2 files changed, 17 insertions(+), 1 deletion(-)

diff --git a/ggml/src/ggml-cuda/common.cuh b/ggml/src/ggml-cuda/common.cuh
index 934b9cffb..e23628d4b 100644
--- a/ggml/src/ggml-cuda/common.cuh
+++ b/ggml/src/ggml-cuda/common.cuh
@@ -143,6 +143,20 @@ static __device__ __forceinline__ void ggml_cuda_pdl_lc() {
 #endif // defined(GGML_CUDA_USE_PDL) && defined(__CUDA_ARCH__) && __CUDA_ARCH__ >= GGML_CUDA_CC_HOPPER
 }
 
+// Non-temporal (streaming) load for pure-streaming kernels: it keeps the access out of the L2/MALL
+// that the surrounding weight GEMMs need (see the WIP mmb-general notes).  __builtin_nontemporal_load
+// only accepts pointers to builtin scalar/vector types, so wrapper types (__half, bfloat16, float4,
+// ...) fall back to a normal access -- a templated kernel therefore takes the hint on its f32 path
+// only, which is the path these activations use.
+template <typename T>
+static __device__ __forceinline__ T ggml_cuda_nt_load(const T * p) {
+    if constexpr (std::is_same<T, float>::value) {
+        return __builtin_nontemporal_load(p);
+    } else {
+        return *p;
+    }
+}
+
 #ifdef __CUDA_ARCH_LIST__
 constexpr bool ggml_cuda_has_arch_impl(int) {
     return false;
diff --git a/ggml/src/ggml-cuda/unary.cu b/ggml/src/ggml-cuda/unary.cu
index fe3d4d20d..9b5a8d287 100644
--- a/ggml/src/ggml-cuda/unary.cu
+++ b/ggml/src/ggml-cuda/unary.cu
@@ -296,7 +296,9 @@ static __global__ void unary_gated_op_kernel(const T * x, const T * g, T * dst,
     const int64_t j1 = o0 == o1 ? j0 : (i / n) * o1 + (i % n);
 
     ggml_cuda_pdl_sync();
-    const float v = op((float)x[j0]) * (float)g[j1];
+    // streaming loads only (the dst is consumed immediately, so its store stays cached); -38 ms on
+    // this kernel in situ at gfx1151 pp8192.  `ggml_cuda_nt_load` no-ops for the non-f32 instantiations.
+    const float v = op((float)ggml_cuda_nt_load(x + j0)) * (float)ggml_cuda_nt_load(g + j1);
     if (store_f32) dst[i] = (T)v;
     if (dst16 != nullptr) {
         dst16[i] = unary_f2bf(v);
-- 
