From b53816777c5bfff57df5dd5eecc355b5c4cbb6ba Mon Sep 17 00:00:00 2001
From: Stew Forster <stew675@gmail.com>
Date: Sat, 19 Sep 2026 17:41:13 -0500
Subject: [PATCH 04/37] WIP mmb: portable WMMA wrappers (RDNA4 no-op) so the
 multi-arch build compiles; gfx1201 TU verified

---
 ggml/src/ggml-cuda/mmb.cu | 32 +++++++++++++++++++++++++-------
 1 file changed, 25 insertions(+), 7 deletions(-)

diff --git a/ggml/src/ggml-cuda/mmb.cu b/ggml/src/ggml-cuda/mmb.cu
index 559c76783..dc62ab376 100644
--- a/ggml/src/ggml-cuda/mmb.cu
+++ b/ggml/src/ggml-cuda/mmb.cu
@@ -19,6 +19,24 @@ __device__ __forceinline__ uint32_t mmb_pack2(float a, float b) { return (uint32
 __constant__ int8_t mmb_kv_iq4nl[16] = {-127, -104, -83, -65, -49, -35, -22, -10, 1, 13, 25, 38, 53, 69, 89, 113};
 __device__ __forceinline__ float mmb_h2f(uint16_t h) { return (float) __builtin_bit_cast(_Float16, h); }
 
+// Portable WMMA dispatch: gfx12 renamed the builtins and uses different fragment types.  The kernels
+// are runtime-gated to RDNA3_5 (mmb_enabled), so on RDNA4 the wrappers are never launched -- they
+// exist only so the multi-arch build compiles, and are deliberately no-ops there.
+__device__ __forceinline__ v8f mmb_wmma_bf16(v16s a, v16s b, v8f c) {
+#if defined(RDNA4)
+    (void) a; (void) b; return c;
+#else
+    return __builtin_amdgcn_wmma_f32_16x16x16_bf16_w32(a, b, c);
+#endif
+}
+__device__ __forceinline__ v8f mmb_wmma_f16(v16s a, v16s b, v8f c) {
+#if defined(RDNA4)
+    (void) a; (void) b; return c;
+#else
+    return __builtin_amdgcn_wmma_f32_16x16x16_f16_w32(a, b, c);
+#endif
+}
+
 __global__ void mmb_cvt_f32_bf16(const float * __restrict__ x, uint16_t * __restrict__ y, const size_t n) {
     size_t i = ((size_t)blockIdx.x * blockDim.x + threadIdx.x) * 8;
     if (i + 8 <= n) {
@@ -288,7 +306,7 @@ __device__ __forceinline__ void mmb_tile_gemm(const uint8_t * __restrict__ Wbase
 #pragma unroll
             for (int i = 0; i < TM; ++i)
 #pragma unroll
-                for (int j = 0; j < TN; ++j) { if constexpr (TAIL) { if (!jact[j]) continue; } acc[i][j] = __builtin_amdgcn_wmma_f32_16x16x16_bf16_w32(b[j], a[i], acc[i][j]); }
+                for (int j = 0; j < TN; ++j) { if constexpr (TAIL) { if (!jact[j]) continue; } acc[i][j] = mmb_wmma_bf16(b[j], a[i], acc[i][j]); }
         }
         __syncthreads();
         if (ks + 1 < nks) store_lds(ks + 1);
@@ -386,7 +404,7 @@ hc_gate_mix_kernel(const uint8_t * __restrict__ W, const uint16_t * __restrict__
 #pragma unroll
             for (int c = 0; c < HC; ++c)
 #pragma unroll
-                for (int j = 0; j < 2; ++j) acc[c][j] = __builtin_amdgcn_wmma_f32_16x16x16_bf16_w32(b[j], a[c], acc[c][j]);
+                for (int j = 0; j < 2; ++j) acc[c][j] = mmb_wmma_bf16(b[j], a[c], acc[c][j]);
         }
         __syncthreads();
         if (ks + 1 < nks) store_lds();
@@ -525,8 +543,8 @@ __device__ __forceinline__ void mmb_tile_gemm_glu(const uint8_t * __restrict__ W
 #pragma unroll
                 for (int j = 0; j < TN; ++j) {
                     if constexpr (TAIL) { if (!jact[j]) continue; }
-                    accg[i][j] = __builtin_amdgcn_wmma_f32_16x16x16_bf16_w32(b[j], ag[i], accg[i][j]);
-                    accu[i][j] = __builtin_amdgcn_wmma_f32_16x16x16_bf16_w32(b[j], au[i], accu[i][j]);
+                    accg[i][j] = mmb_wmma_bf16(b[j], ag[i], accg[i][j]);
+                    accu[i][j] = mmb_wmma_bf16(b[j], au[i], accu[i][j]);
                 }
         }
         __syncthreads();
@@ -616,9 +634,9 @@ mmb_f32split_kernel(const float * __restrict__ W, const float * __restrict__ X,
             for (int i = 0; i < TM; ++i)
 #pragma unroll
                 for (int j = 0; j < TN; ++j) {
-                    acc[i][j] = __builtin_amdgcn_wmma_f32_16x16x16_f16_w32(bh[j], ah[i], acc[i][j]);
-                    acc[i][j] = __builtin_amdgcn_wmma_f32_16x16x16_f16_w32(bl[j], ah[i], acc[i][j]);
-                    if constexpr (!TWO) acc[i][j] = __builtin_amdgcn_wmma_f32_16x16x16_f16_w32(bh[j], al[i], acc[i][j]);
+                    acc[i][j] = mmb_wmma_f16(bh[j], ah[i], acc[i][j]);
+                    acc[i][j] = mmb_wmma_f16(bl[j], ah[i], acc[i][j]);
+                    if constexpr (!TWO) acc[i][j] = mmb_wmma_f16(bh[j], al[i], acc[i][j]);
                 }
         }
         __syncthreads();
-- 
