From 49eff7f1840d63746d1cceb828482ea3a95af886 Mon Sep 17 00:00:00 2001
From: Stew Forster <stew675@gmail.com>
Date: Sun, 20 Sep 2026 19:49:33 -0500
Subject: [PATCH 36/38] WIP mmb: tile-class threshold 128 -> BN_SMALL (the
 small tile re-dequantizes the A panel)

mmb_build_desc2 sends experts with cnt >= THRESH to the BN=128 tile and the rest
to BN=32.  The two classes differ ONLY in how many jt tiles cover an expert's
rows: for a 128-row expert the small class needs 4 tiles, each of which re-runs
the same 64-row A-panel dequant -- so it does 4x the weight dequant for the same
WMMA work and the same B-column padding.

Sweep (Flash-Next IQ4_XS, fixed prompt, min-of-2, GLU kernel):
  THRESH  0 -> 1078.4 ms   16 -> 1028.6   32 -> 992.0   48 -> 1014.6
         64 -> 1031.4     128 -> 1161.4 (the old default)
The optimum is exactly THRESH == BN_SMALL = 32, which is also the analytic rule:
the small tile only pays when ONE block covers the expert; past that the big tile
does the same WMMA for 1/k the dequant.

Same for the routed (non-GLU) tile: mr 395.9 -> 361.5 ms (-8.7 %) at 32.

Flash-Next: mrg 1161.4 -> 990.4, mr 401.2 -> 361.5, MMB family 2822 -> 2601 ms
(-7.8 %).  35B Q4_K: mrg 279.9 -> 263.7, mr 187.7 -> 181.7, family 987 -> 962 ms
(-2.5 %) -- so it is not IQ3_S-specific.

Bit-identical, as it must be: BN only changes WHICH rows a block covers, never
the K reduction order of any output element.  PPL 10.6015, greedy 9c281c415082,
width probe PASS.  Both thresholds keep an env override
(GGML_CUDA_MMB_GLU_THRESH / GGML_CUDA_MMB_ROUTED_THRESH) for A/B.
---
 ggml/src/ggml-cuda/mmb.cu | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/ggml/src/ggml-cuda/mmb.cu b/ggml/src/ggml-cuda/mmb.cu
index 3f13e41ca..f0f9f1d16 100644
--- a/ggml/src/ggml-cuda/mmb.cu
+++ b/ggml/src/ggml-cuda/mmb.cu
@@ -1234,6 +1234,11 @@ bool mmb_tall()    { return mmb_tall_mode() != 0; }
 bool mmb_gatemix_flag() { static const int v = getenv("LLAMA_HC_GATEMIX") ? atoi(getenv("LLAMA_HC_GATEMIX")) : 0; return v != 0; }
 bool mmb_down16_flag() { static const int v = getenv("GGML_CUDA_MMB_DOWN16") ? atoi(getenv("GGML_CUDA_MMB_DOWN16")) : 0; return v != 0; }
 bool mmb_glu()     { static const int v = getenv("GGML_CUDA_MMB_GLU") ? atoi(getenv("GGML_CUDA_MMB_GLU")) : 1; return v != 0; }
+// Tile-class threshold: experts with >= this many rows take the BN=128 tile, the rest the BN=32 one.
+// The small tile re-dequantizes the same A panel once per jt tile (4x the weight dequant per output
+// for a 128-row expert), so this is the knob that trades B-column padding against dequant volume.
+int mmb_glu_thresh() { static const int v = getenv("GGML_CUDA_MMB_GLU_THRESH") ? atoi(getenv("GGML_CUDA_MMB_GLU_THRESH")) : 32; return v; }
+int mmb_routed_thresh() { static const int v = getenv("GGML_CUDA_MMB_ROUTED_THRESH") ? atoi(getenv("GGML_CUDA_MMB_ROUTED_THRESH")) : 32; return v; }
 // IQ3_XXS: implemented and correct.  Its MMB *routed* path (individual gate/up MUL_MAT_ID) is a
 // win, but the MMB *fused GLU* path is a NET LOSS on the UD-Q3_K_M workload (the fused kernel's
 // dequant/loop shape costs more than the bf16-WMMA gain): full-on 1921 vs routed-only 2121 t/s
@@ -1546,7 +1551,7 @@ void ggml_cuda_mul_mat_id_mmb(ggml_backend_cuda_context & ctx, const ggml_tensor
     const int sis1 = (int) (src1->nb[2] / src1->nb[1]);
     ggml_cuda_launch_mm_ids_helper((const int32_t *) ids->data, ids_src1.get(), ids_dst.get(), bounds.get(),
         E, T, n_used, ne11, si1, sis1, /*write_inverse=*/false, stream);
-    constexpr int BN_SMALL = 32, THRESH = 128;
+    constexpr int BN_SMALL = 32; const int THRESH = mmb_routed_thresh();
     const int nbig_max   = n_rows / BN + E + 1;
     const int nsmall_max = E * ((THRESH + BN_SMALL - 1) / BN_SMALL) + 1;
     ggml_cuda_pool_alloc<uint32_t> desc_big(ctx.pool(), nbig_max);
@@ -1627,7 +1632,7 @@ void ggml_cuda_mul_mat_id_mmb_glu(ggml_backend_cuda_context & ctx, const ggml_te
     const int sis1 = (int) (src1->nb[2] / src1->nb[1]);
     ggml_cuda_launch_mm_ids_helper((const int32_t *) ids->data, ids_src1.get(), ids_dst.get(), bounds.get(),
         E, T, n_used, ne11, si1, sis1, /*write_inverse=*/false, stream);
-    constexpr int BN_SMALL = 32, THRESH = 128;
+    constexpr int BN_SMALL = 32; const int THRESH = mmb_glu_thresh();
     const int nbig_max   = n_rows / BN + E + 1;
     const int nsmall_max = E * ((THRESH + BN_SMALL - 1) / BN_SMALL) + 1;
     ggml_cuda_pool_alloc<uint32_t> desc_big(ctx.pool(), nbig_max);
