+    const int nh_kv  = (int) k->ne[2];
     const int ngroups = (n_q + QSA3_G - 1) / QSA3_G;
     const int cap     = (QSA3_G * ns + 3) & ~3;
 
 
+    // Fused pack (session 7): one pass per tensor from the natural [D, n_head_kv, n_kv] F16 view into the
+    // block layouts the attention kernel reads.  Replaces cast+permute+cont+reshape+permute+cont.
+    ggml_cuda_pool_alloc<uint16_t> pk16(ctx.pool(), (size_t) 256 * nk * nh_kv);
+    ggml_cuda_pool_alloc<uint16_t> pv16(ctx.pool(), (size_t) 256 * nk * nh_kv);
