@@ -547,10 +595,24 @@ void ggml_cuda_flash_attn_qsa3(ggml_backend_cuda_context & ctx, ggml_tensor * ds
     const int n_q    = (int) q->ne[1];
     const int ns     = (int) ids->ne[0];
