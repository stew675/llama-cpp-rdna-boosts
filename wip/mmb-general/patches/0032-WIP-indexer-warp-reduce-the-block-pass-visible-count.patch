From 2da50418d08eeee486eb5d7b085f6ae9f023a169 Mon Sep 17 00:00:00 2001
From: Stew Forster <stew675@gmail.com>
Date: Sun, 20 Sep 2026 17:22:38 -0500
Subject: [PATCH 32/37] WIP indexer: warp-reduce the block-pass visible-count
 atomic

indexer_topk_histogram_blocks had every one of its 256 threads do
atomicAdd(&s_sumw, mysum) on a single shared address -- 256 serialized
same-address atomics per CU per pass.  Reduce per warp with shuffles and do one
atomic per warp (8 instead of 256).  Integer sum is exact/order-free, so the
result is bit-identical.

rocprofv3 pp8192: histogram_blocks 22.34 -> 19.79 ms (-11 %), family 74.3 -> 71.7;
pp32768: 471.94 -> 461.79 ms (-2 %), family 1156.9 -> 1146.6.  PPL 10.6015,
greedy 9c281c415082 (unchanged).
---
 ggml/src/ggml-cuda/indexer-topk.cu | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/ggml/src/ggml-cuda/indexer-topk.cu b/ggml/src/ggml-cuda/indexer-topk.cu
index 4a480a0d6..ae3b8210c 100644
--- a/ggml/src/ggml-cuda/indexer-topk.cu
+++ b/ggml/src/ggml-cuda/indexer-topk.cu
@@ -672,7 +672,16 @@ static __global__ void indexer_topk_histogram_blocks(
             }
         }
     }
-    atomicAdd(&s_sumw, mysum);
+    // warp-reduce mysum, then one atomic per warp: a same-address atomicAdd from every thread
+    // serializes (256 per CU per pass) and dominated this kernel.  integer sum is order-free.
+    int ws = mysum;
+    #pragma unroll
+    for (int off = 16; off > 0; off >>= 1) {
+        ws += __shfl_down(ws, off);
+    }
+    if ((tid & 31) == 0) {
+        atomicAdd(&s_sumw, ws);
+    }
     __syncthreads();
     if (tid == 0) {
         // every cell in [B0*r, min(B1*r, n_kv)) belongs to one of this range's blocks; those not
