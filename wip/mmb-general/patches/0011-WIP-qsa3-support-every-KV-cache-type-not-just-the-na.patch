From 8a959786c8b4101c0c00b688376a2bedff4b552e Mon Sep 17 00:00:00 2001
From: Stew Forster <stew675@gmail.com>
Date: Sat, 19 Sep 2026 21:30:56 -0500
Subject: [PATCH 11/31] WIP qsa3: support every KV cache type, not just the
 native pair

The qsa3 kernels read only the packed F16 layouts, so the cache type is
irrelevant to them - but the pack must be materialized as F16, and the backend
dup cannot cast a quantized tensor (and cannot permute one at all).  Materialize
F16 from the cache's *natural* contiguous view before any permute, routing the
quantized types through the one conversion the dup supports (quantized -> F32):
qsa3_f16_cast() then permute+pack in F16.

gfx1151, IQ4_XS, pp8192: f16 819.4->861.7, bf16 791.2->854.5, q8_0 780.5->856.6
(all converge - the kernel reads the same f16 packs).  PPL parity on all three
(c16384: bf16 3.3932/3.3900, q8_0 3.3861/3.3879, f16 3.3883/3.3869).
---
 src/models/qwen4exp.cpp | 50 +++++++++++++++++++++++++++++++++--------
 1 file changed, 41 insertions(+), 9 deletions(-)

diff --git a/src/models/qwen4exp.cpp b/src/models/qwen4exp.cpp
index 7af4c7353..90db3c449 100644
--- a/src/models/qwen4exp.cpp
+++ b/src/models/qwen4exp.cpp
@@ -1575,7 +1575,36 @@ ggml_tensor * llama_model_qwen4exp::graph::build_qsa_top_k(
 // fattn-qsa3.cu).  The pack is a pure graph composition - reshape + permute + cont - so no new
 // ggml op is needed.  Keys: [D, n_kv, n_kvh, 1] -> [16, 4, 16, n_kv/4*n_kvh]; Values:
 // [D, n_kv, n_kvh, 1] -> [4, 256, n_kv/4*n_kvh, 1].  Both are built only for the prefill band and
-// native F16/BF16 caches (see build_attn_qsa); anything else leaves the VEC kernel in charge.
+// any cache type the graph can materialize as F16 (the native ones, or a quantized cache cast on
+// the way in); anything else leaves the VEC kernel in charge.
+// The cache types the qsa3 pack can consume: the native pair plus every type the VEC kernel can
+// dequantize (the cast below materializes them).  Kept in sync with the VEC kernel's type list.
+static bool qwen4exp_qsa3_kv_type(ggml_type type) {
+    switch (type) {
+        case GGML_TYPE_F16:
+        case GGML_TYPE_BF16:
+        case GGML_TYPE_Q8_0:
+        case GGML_TYPE_Q4_0:
+        case GGML_TYPE_Q4_1:
+        case GGML_TYPE_Q5_0:
+        case GGML_TYPE_Q5_1:
+        case GGML_TYPE_IQ4_NL:
+            return true;
+        default:
+            return false;
+    }
+}
+
+// qsa3 works on F16 packs.  Materialize the cache view as F16 from its *natural* (contiguous)
+// layout before any permute: a quantized tensor cannot be permuted, and the backend dup only
+// dequantizes to F32, so those route through an F32 intermediate.  The permute/cont that follows
+// is then a plain F16 copy.
+static ggml_tensor * qsa3_f16_cast(ggml_context * ctx0, ggml_tensor * raw) {
+    if (raw->type == GGML_TYPE_F16)  { return raw; }
+    if (raw->type == GGML_TYPE_BF16) { return ggml_cast(ctx0, raw, GGML_TYPE_F16); }
+    return ggml_cast(ctx0, ggml_cast(ctx0, raw, GGML_TYPE_F32), GGML_TYPE_F16);
+}
+
 static ggml_tensor * qsa_pack_keys_graph(ggml_context * ctx0, ggml_tensor * keys) {
     GGML_ASSERT(keys->ne[0] == 256 && keys->ne[1] % 4 == 0 && keys->ne[3] == 1);
     ggml_tensor * contiguous = ggml_is_contiguous(keys) ? keys : ggml_cont(ctx0, keys);
@@ -1687,6 +1716,9 @@ ggml_tensor * llama_model_qwen4exp::graph::build_attn_qsa(
     ggml_tensor * q = q_cur;
     ggml_tensor * k = mctx_cur->get_k(ctx0, il);
     ggml_tensor * v = mctx_cur->get_v(ctx0, il);
+    // the natural cache views, kept for the qsa3 packs (which must cast before permuting)
+    ggml_tensor * k_raw = k;
+    ggml_tensor * v_raw = v;
     ggml_tensor * cur;
 
     if (qsa_sparse) {
@@ -1709,14 +1741,14 @@ ggml_tensor * llama_model_qwen4exp::graph::build_attn_qsa(
             const char * env = getenv("GGML_CUDA_QSA3");
             return env != nullptr && atoi(env) != 0;
         }();
-        if (qsa3_pack && n_stream == 1 && q_p->ne[1] >= 128 && k->ne[0] == 256 && k->ne[1] % 4 == 0 &&
-            (k->type == GGML_TYPE_F16 || k->type == GGML_TYPE_BF16)) {
-            // the pack wants the F16 layout; a bf16 cache is cast on the way in (one extra pass
-            // over the cache).  Neither tensor is an explicit graph root - the QSA op's new srcs
-            // pull them in when `cur` is expanded.
-            ggml_tensor * kc = k->type == GGML_TYPE_F16 ? k : ggml_cast(ctx0, k, GGML_TYPE_F16);
-            ggml_tensor * vc = v->type == GGML_TYPE_F16 ? v : ggml_cast(ctx0, v, GGML_TYPE_F16);
-            ggml_flash_attn_qsa_set_packed(cur, qsa_pack_keys_graph(ctx0, kc), qsa_pack_values_graph(ctx0, vc));
+        if (qsa3_pack && n_stream == 1 && q_p->ne[1] >= 128 && k_raw->ne[0] == 256 && k_raw->ne[2] % 4 == 0 &&
+            qwen4exp_qsa3_kv_type(k_raw->type)) {
+            // cast on the natural layout, then permute into the op's [D, n_kv, n_head_kv] order;
+            // the pack helper does the final cont.  Neither tensor is an explicit graph root - the
+            // QSA op's new srcs pull them in when `cur` is expanded.
+            ggml_tensor * k16 = ggml_permute(ctx0, qsa3_f16_cast(ctx0, k_raw), 0, 2, 1, 3);
+            ggml_tensor * v16 = ggml_permute(ctx0, qsa3_f16_cast(ctx0, v_raw), 0, 2, 1, 3);
+            ggml_flash_attn_qsa_set_packed(cur, qsa_pack_keys_graph(ctx0, k16), qsa_pack_values_graph(ctx0, v16));
         }
 
         ggml_flash_attn_qsa_set_prec(cur, GGML_PREC_F32);
