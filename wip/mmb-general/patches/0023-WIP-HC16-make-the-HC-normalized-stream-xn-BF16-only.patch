 ggml/src/ggml-cuda/ggml-cuda.cu | 13 +++++-
 ggml/src/ggml-cuda/mmb.cu       | 83 +++++++++++++++++++++++++++------
 ggml/src/ggml-cuda/mmb.cuh      |  7 +++
 ggml/src/ggml-cuda/norm.cu      |  4 +-
 ggml/src/ggml-cuda/unary.cu     | 12 ++---
 6 files changed, 121 insertions(+), 30 deletions(-)

