+// HC16 producer step 2: the fused rms_norm+mul of the HC normalized stream (a broadcast
+// [n_embd, hc] gamma over a 3D [n_embd, hc, nt] activation) may emit a BF16 copy of its output
+// into slot 0 in ADDITION to the F32 output.  The following MMB dense GEMM (the hc down
+// projection) then reads that copy instead of running its own mmb_cvt pass.  The BF16 value is
+// rounded exactly as mmb_cvt_f32_bf16 would, so the GEMM result is bit-identical.
+bool ggml_cuda_mmb_hc16_copy_ok(const ggml_tensor * mul_tensor, const ggml_tensor * mul_src) {
+    if (!mmb_enabled() || !mmb_hc16()) return false;
+    if (!mul_tensor || !mul_src) return false;
+    if (mul_tensor->type != GGML_TYPE_F32 || mul_src->type != GGML_TYPE_F32) return false;
+    if (mul_tensor->ne[0] != mul_src->ne[0]) return false;                                                                // [n_embd]
+    if (mul_src->ne[1] != mul_tensor->ne[1] || mul_src->ne[2] != 1 || mul_src->ne[3] != 1) return false;                  // broadcast [n_embd, hc]
+    if (mul_tensor->ne[1] <= 1 || mul_tensor->ne[2] <= 1 || mul_tensor->ne[3] != 1) return false;                          // 3D [n_embd, hc, nt]
+    if (mul_tensor->ne[2] < mmb_min_t()) return false;   // the GEMM's T = nt must reach the MMB prefill gate
+    return true;
+}
