--- a/ggml/src/ggml-cuda/dsv4-hc.cu
+++ b/ggml/src/ggml-cuda/dsv4-hc.cu
@@ -125,7 +125,8 @@ static __global__ void dsv4_hc_pre_f32(
         int64_t sd0,
         int64_t sd1,
         float   scale,
-        uint16_t * dst16 = nullptr) {
+        uint16_t * dst16 = nullptr,
+        bool    store_f32 = true) {
     ggml_cuda_pdl_lc();
     const int64_t ir = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
     const int64_t nr = n_embd * n_tokens;
@@ -163,7 +164,7 @@ static __global__ void dsv4_hc_pre_f32(
     }
 
     const float v = scale * sum;
-    dst[i0*sd0 + it*sd1] = v;
+    if (store_f32) dst[i0*sd0 + it*sd1] = v;
     if (dst16 != nullptr) {
         dst16[i0*sd0 + it*sd1] = dsv4_f2bf(v);
     }
@@ -300,7 +301,11 @@ void ggml_cuda_op_dsv4_hc_pre(ggml_backend_cuda_context & ctx, ggml_tensor * dst
     // read (RNE-rounded exactly as mmb_cvt_f32_bf16), so it skips its own conversion pass.  The F32
     // output is still written, so every other consumer is unaffected (bit-identical).
     uint16_t * dst16 = nullptr;
-    if (ggml_cuda_mmb_wants_bf16_copy(dst)) {
+    bool store_f32 = true;
+    if (ggml_cuda_mmb_is_bf16_only(dst)) {
+        dst16 = ggml_cuda_mmb_slot_reserve(ctx, 0, dst, (size_t) ggml_nelements(dst));
+        store_f32 = false;
+    } else if (ggml_cuda_mmb_wants_bf16_copy(dst)) {
         dst16 = ggml_cuda_mmb_slot_reserve(ctx, 0, dst, (size_t) ggml_nelements(dst));
     }
     ggml_cuda_kernel_launch(kernel, launch_params,
@@ -309,7 +314,7 @@ void ggml_cuda_op_dsv4_hc_pre(ggml_backend_cuda_context & ctx, ggml_tensor * dst
             nbx0 / sizeof(float), nbx1 / sizeof(float), nbx2 / sizeof(float),
             nbw0 / sizeof(float), nbw1 / sizeof(float), nbw2 / sizeof(float),
             nbd0 / sizeof(float), nbd1 / sizeof(float),
-            scale, dst16);
+            scale, dst16, store_f32);
 }
 
