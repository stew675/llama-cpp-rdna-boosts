 ggml/src/ggml-cuda/norm.cu      | 29 +++++++++------
 ggml/src/ggml-cuda/unary.cu     | 66 +++++++++++++++++++--------------
 4 files changed, 88 insertions(+), 44 deletions(-)

diff --git a/ggml/src/ggml-cuda/dsv4-hc.cu b/ggml/src/ggml-cuda/dsv4-hc.cu
