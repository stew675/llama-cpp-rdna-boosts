From bd261f0bfcc8e34b5bb5a38da76ad09502167cc8 Mon Sep 17 00:00:00 2001
From: Stew Forster <stew675@gmail.com>
Date: Sun, 20 Sep 2026 17:08:53 -0500
Subject: [PATCH 31/36] WIP indexer: accumulate pass1 histogram bins per block
 instead of per cell

Every cell of a block shares the block key and every invisible cell shares
key_inf, so a run of VEC cells bins into at most two bins.  Accumulate the
per-block visible count and one per-thread pending counter for the invisible
key_inf bin, then flush with one atomic per block (and one per thread for the
invisible stream) instead of one atomic per cell.  Integer bin counts are
unchanged (bit-identical), only the atomic traffic shrinks.

rocprofv3 pp8192: histogram_pass1 23.74 -> 13.38 ms (-44 %);
pp32768: 341.8 -> 266.0 ms (-22 %); family 1156.9 ms (-6.4 %).
PPL c2048 10.6015, greedy 9c281c415082 (unchanged).
---
 ggml/src/ggml-cuda/indexer-topk.cu | 44 ++++++++++++++++++++++--------
 1 file changed, 33 insertions(+), 11 deletions(-)

diff --git a/ggml/src/ggml-cuda/indexer-topk.cu b/ggml/src/ggml-cuda/indexer-topk.cu
index db612ffbd..4a480a0d6 100644
--- a/ggml/src/ggml-cuda/indexer-topk.cu
+++ b/ggml/src/ggml-cuda/indexer-topk.cu
@@ -559,12 +559,22 @@ static __global__ void indexer_topk_histogram_pass1(
     const int nskv = s*n_kv;
     int * row_wvis = wvis + (size_t) row * n_blocks;
 
+    // every cell of a block shares the block key, and every invisible cell shares key_inf, so a
+    // whole run bins into at most two bins.  accumulate per block (and one per-thread pending
+    // counter for the invisible key_inf bin) and flush with one atomic per block instead of one
+    // atomic per cell.  the integer bin counts are identical -- only the atomic traffic shrinks.
+    const int inf_bin = ((key_inf & state.prefix_mask) == state.prefix)
+            ? (int) ((key_inf >> shift) & (NBINS - 1)) : -1;
+    int inf_pending = 0;
+
     const int col0 = hb * bchunk * r;
     const int col1 = min(col0 + bchunk * r, ncols);
     for (int base = col0 + tid*VEC; base < col1; base += BLOCK_SIZE*VEC) {
         int      cur_b   = -1;
         int      cur_w   = 0;
-        uint32_t cur_key = key_inf;
+        int      cur_h   = 0;
+        int      cur_bin = 0;
+        bool     cur_match = false;
         #pragma unroll
         for (int v = 0; v < VEC; ++v) {
             const int c = base + v;
@@ -575,29 +585,41 @@ static __global__ void indexer_topk_histogram_pass1(
             if (b != cur_b) {
                 if (cur_b >= 0) {
                     atomicAdd(&row_wvis[cur_b], cur_w);
+                    if (cur_match && cur_h > 0) {
+                        atomicAdd(&histogram[cur_bin], cur_h);
+                    }
                 }
-                cur_b   = b;
-                cur_w   = 0;
-                cur_key = indexer_topk_block_key(score, extra, b, t, s, n_blocks, n_tps);
+                cur_b     = b;
+                cur_w     = 0;
+                cur_h     = 0;
+                const uint32_t cur_key = indexer_topk_block_key(score, extra, b, t, s, n_blocks, n_tps);
+                cur_match = (cur_key & state.prefix_mask) == state.prefix;
+                cur_bin   = (int) ((cur_key >> shift) & (NBINS - 1));
             }
-            uint32_t key = cur_key;
             bool vis = true;
             if (extra.cell_pos != nullptr) {
                 const int cp = extra.cell_pos[c + nskv];
                 vis = (cp >= 0 && cp <= q);
-                if (!vis) {
-                    key = key_inf;
-                }
             }
-            cur_w += vis ? 1 : 0;
-            if ((key & state.prefix_mask) == state.prefix) {
-                atomicAdd(&histogram[(key >> shift) & (NBINS - 1)], 1);
+            if (vis) {
+                cur_w += 1;
+                if (cur_match) {
+                    cur_h += 1;
+                }
+            } else if (inf_bin >= 0) {
+                inf_pending += 1;
             }
         }
         if (cur_b >= 0) {
             atomicAdd(&row_wvis[cur_b], cur_w);
+            if (cur_match && cur_h > 0) {
+                atomicAdd(&histogram[cur_bin], cur_h);
+            }
         }
     }
+    if (inf_pending > 0) {
+        atomicAdd(&histogram[inf_bin], inf_pending);
+    }
     __syncthreads();
     const size_t off = ((size_t) row * blocks_per_row + hb) * NBINS;
     block_histograms[off + tid] = histogram[tid];
-- 
