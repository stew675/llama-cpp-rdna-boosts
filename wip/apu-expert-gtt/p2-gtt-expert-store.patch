+// wip/apu-expert-gtt P2: the GTT expert store's buffer type -- the UMA-only resident expert tier.
+//
+// The region itself (one `mmap` + `MADV_HUGEPAGE`, registered ONCE `Mapped|ReadOnly`, sliced into
+// per-(tensor, expert) slots) is `gtt-expert-store.cu`; this is only the buffer type that carves tensors out
+// of it, and it follows the delivery's KV-region pattern (`ggml_backend_cuda_kv_region_buffer_type_split`):
+//
+//   * a DEVICE buffer type (`is_host` NULL, `device` = the owning GPU), so the scheduler places the expert
+//     tables among that device's weights and `MUL_MAT_ID` reads them IN PLACE -- no new op, no new dispatch,
+//     no per-layer copy, and no scheduler input-copy of the table (which is what a HOST buffer type would
+//     cost: every ubatch would re-upload the expert bank);
+//   * the plain device type's vtable CONTRACT (alignment, alloc-size, the same `alloc_buffer` shape), so
+//     `ggml_backend_cuda_device_supports_op` needs no knowledge of it and a shape it cannot hold is declined
+//     by a NULL from `alloc_buffer`;
+//   * a name that is UNIQUE per device.  `llama_kv_cache` (and any future caller that keys a buft -> context
+//     map by name) collapses two device bufts that answer the same string into the FIRST one's context -- the
+//     same discipline the windowed KV region and the KV pool mirror already follow.
+//
+// Nothing here is reachable on a discrete device: the model loader only asks for a GTT store on an
+// IGPU (`prop.integrated`), and `MOE_EXPERT_GTT=0` never asks at all.
+static const char * ggml_backend_cuda_gtt_store_buffer_type_name(ggml_backend_buffer_type_t buft) {
+    return ((ggml_backend_cuda_buffer_type_context *) buft->context)->name.c_str();
+}
+
+static bool ggml_backend_buft_is_cuda_gtt_store(ggml_backend_buffer_type_t buft) {
+    return buft != nullptr && buft->iface.get_name == ggml_backend_cuda_gtt_store_buffer_type_name;
+}
+
+static void * ggml_backend_cuda_gtt_store_get_base(ggml_backend_buffer_t buffer) {
+    return buffer->context;
+}
+
+// The buffer is a VIEW of the GTT store: the region outlives every buffer cut from it, so freeing releases
+// nothing.  The region is released once, by `ggml_cuda_gtt_store_free()`.
+static void ggml_backend_cuda_gtt_store_free_buffer(ggml_backend_buffer_t buffer) {
+    GGML_UNUSED(buffer);
+}
+
+// The GTT store is ordinary host memory that the GPU also reads (one address, `iommu=off`), so every host-side
+// copy is a plain `memcpy` with no flush and no staging -- measured coherent in both registration modes
+// (probe 10) and after a fill that overwrote resident bytes (probe 12).
+static void ggml_backend_cuda_gtt_store_memset_tensor(ggml_backend_buffer_t buffer, ggml_tensor * tensor,
+        uint8_t value, size_t offset, size_t size) {
+    if (tensor->buffer->buft != buffer->buft) {
+        GGML_ABORT("tensor is not in the GTT store");
+    }
+    memset((char *) tensor->data + offset, value, size);
+}
+
+static void ggml_backend_cuda_gtt_store_set_tensor(ggml_backend_buffer_t buffer, ggml_tensor * tensor,
+        const void * data, size_t offset, size_t size) {
+    if (tensor->buffer->buft != buffer->buft) {
+        GGML_ABORT("tensor is not in the GTT store");
+    }
+    memcpy((char *) tensor->data + offset, data, size);
+}
+
+static void ggml_backend_cuda_gtt_store_get_tensor(ggml_backend_buffer_t buffer, const ggml_tensor * tensor,
+        void * data, size_t offset, size_t size) {
+    if (tensor->buffer->buft != buffer->buft) {
+        GGML_ABORT("tensor is not in the GTT store");
+    }
+    memcpy(data, (const char *) tensor->data + offset, size);
+}
+
+static void ggml_backend_cuda_gtt_store_clear(ggml_backend_buffer_t buffer, uint8_t value) {
+    memset(buffer->context, value, buffer->size);
+}
+
+static const ggml_backend_buffer_i ggml_backend_cuda_gtt_store_buffer_i = {
+    /* .free_buffer     = */ ggml_backend_cuda_gtt_store_free_buffer,
+    /* .get_base        = */ ggml_backend_cuda_gtt_store_get_base,
+    /* .init_tensor     = */ NULL,
+    /* .memset_tensor   = */ ggml_backend_cuda_gtt_store_memset_tensor,
+    /* .set_tensor      = */ ggml_backend_cuda_gtt_store_set_tensor,
+    /* .get_tensor      = */ ggml_backend_cuda_gtt_store_get_tensor,
+    /* .set_tensor_2d   = */ NULL,
+    /* .get_tensor_2d   = */ NULL,
+    /* .cpy_tensor      = */ NULL,
+    /* .clear           = */ ggml_backend_cuda_gtt_store_clear,
+    /* .reset           = */ NULL,
+};
+
+static size_t ggml_backend_cuda_gtt_store_get_alignment(ggml_backend_buffer_type_t buft) {
+    // One page: every resident expert table starts page-aligned inside the region, so every per-expert slot
+    // is at `base + e * nb[2]` in both addresses and a future `O_DIRECT` arm would have an aligned head.
+    GGML_UNUSED(buft);
+    return 4096;
+}
+
+static size_t ggml_backend_cuda_gtt_store_get_alloc_size(ggml_backend_buffer_type_t buft, const ggml_tensor * tensor) {
+    // The plain device type's own rule, deliberately: a quantized tensor whose `ne[0]` is not a multiple of
+    // `MATRIX_ROW_PADDING` reserves one padded row past its end, and several kernels read a full padded row.
+    // In a GTT store the bytes after a tensor belong to the NEXT expert table, so dropping that reservation would
+    // turn a padded read into a read of a neighbour's data -- or, at the end of the region, past the mapping.
+    return ggml_backend_cuda_buffer_type_get_alloc_size(buft, tensor);
+}
+
+static ggml_backend_buffer_t ggml_backend_cuda_gtt_store_buffer_type_alloc_buffer(
+        ggml_backend_buffer_type_t buft, size_t size) {
+    const ggml_backend_cuda_buffer_type_context * buft_ctx =
+        (const ggml_backend_cuda_buffer_type_context *) buft->context;
+
+    if (size == 0) {
+        // `--fit` / `--no-alloc` probe load: a dummy buffer, and NO region (a probe must not reserve the
+        // budget's non-swappable RAM).  `ggml_backend_buffer_init` with a zero size and no base is enough.
+        return ggml_backend_buffer_init(buft, ggml_backend_cuda_gtt_store_buffer_i, nullptr, 0);
+    }
+
+    ggml_cuda_set_device(buft_ctx->device);
+    void * base = ggml_cuda_gtt_store_carve(buft_ctx->device, size);
+    if (base == nullptr) {
+        // A DECLINE, not an abort: the loader places the tensors it cannot fit in the plain device buffer.
+        GGML_LOG_WARN("%s: device %d: the GTT expert store declined a %.2f MiB carve; those expert tables stay in "
+                      "the plain device buffer\n", __func__, buft_ctx->device, (double) size / 1048576.0);
+        return nullptr;
+    }
+    GGML_LOG_INFO("%s: device %d: %.2f MiB of expert tables placed in the GTT store at %p\n", __func__,
+                  buft_ctx->device, (double) size / 1048576.0, base);
+    return ggml_backend_buffer_init(buft, ggml_backend_cuda_gtt_store_buffer_i, base, size);
+}
+
+// One instance per device (the extent and the registration live in the GTT store module, not here).
+static ggml_backend_buffer_type_t ggml_backend_cuda_gtt_store_buffer_type(int device) {
+    if (device < 0 || device >= ggml_backend_cuda_get_device_count()) {
+        return nullptr;
+    }
+
+    static struct ggml_backend_buffer_type bufts[GGML_CUDA_MAX_DEVICES];
+    static bool init[GGML_CUDA_MAX_DEVICES] = {};
+
+    if (!init[device]) {
+        bufts[device] = {
+            /* .iface    = */ {
+                /* .get_name            = */ ggml_backend_cuda_gtt_store_buffer_type_name,
+                /* .alloc_buffer        = */ ggml_backend_cuda_gtt_store_buffer_type_alloc_buffer,
+                /* .alloc_buffer_n      = */ NULL,
+                /* .get_alignment       = */ ggml_backend_cuda_gtt_store_get_alignment,
+                /* .get_max_size        = */ NULL, // defaults to SIZE_MAX: the GTT store is ONE carve per device
+                /* .get_alloc_size      = */ ggml_backend_cuda_gtt_store_get_alloc_size,
+                /* .get_alloc_size_n    = */ NULL,
+                /* .is_host             = */ NULL,
+            },
+            /* .device   = */ ggml_backend_reg_dev_get(ggml_backend_cuda_reg(), device),
+            /* .context  = */ new ggml_backend_cuda_buffer_type_context{device,
+                std::string(GGML_CUDA_NAME) + "GTTStore" + std::to_string(device), 0},
+        };
+        init[device] = true;
+    }
+
+    return &bufts[device];
+}
+
 // wip/host-expert-master-drop (TODO #55): the POOL-BACKED host expert master buffer type.
 //
 // It is a host buffer type that carries its device (`ROCm_HostMap`), so a `MUL_MAT_ID` weight placed in it
@@ -10251,6 +10404,11 @@ static bool ggml_backend_cuda_device_supports_buft(ggml_backend_dev_t dev, ggml_
     ggml_backend_cuda_device_context * dev_ctx = (ggml_backend_cuda_device_context *) dev->context;
     const bool integrated = ggml_cuda_info().devices[dev_ctx->device].integrated;
     return (ggml_backend_buft_is_cuda(buft) && buft->device == dev) || (integrated && ggml_backend_buft_is_cuda_host(buft)) ||
+        // wip/apu-expert-gtt P2: the GTT expert store.  It is a DEVICE buffer type on this device (its backing
+        // is registered host memory, one address with the device VA), so an expert table placed in it stays in
+        // this device's split and `MUL_MAT_ID` reads it in place.  Not a host buft on purpose: a host buft would
+        // make the table a scheduler INPUT and re-upload the expert bank on every ubatch.
+        (ggml_backend_buft_is_cuda_gtt_store(buft) && buft->device == dev) ||
         (ggml_backend_buft_is_cuda_kv_pool_mirror(buft) && buft->device == dev);
 }
 
@@ -10457,6 +10615,42 @@ static ggml_backend_buffer_type_t ggml_backend_cuda_device_moe_host_master_buft(
     return ggml_backend_cuda_host_map_buffer_type_dev(dev_ctx->device);
 }
 
+// wip/apu-expert-gtt P2: the two device hooks the model loader reaches the GTT expert store through.
+//
+// `open` accepts (or refuses) a budget and answers the buffer type the resident expert tables should be
+// placed in; the loader makes the placement decision itself (`plan_host_expert_placement`, so `-lme` and the
+// heat ranking are the DISCRETE path's own code, not a second policy).  `report` prints the once-per-load
+// census, with the bytes the loader read from the GGUF into the GTT store.
+static ggml_backend_buffer_type_t ggml_backend_cuda_device_gtt_store_open(ggml_backend_dev_t dev,
+        size_t extent_bytes, const char * source) {
+    ggml_backend_cuda_device_context * dev_ctx = (ggml_backend_cuda_device_context *) dev->context;
+    if (dev_ctx == nullptr || !ggml_cuda_gtt_store_wanted()) {
+        return nullptr;
+    }
+    // An APU only: on a discrete device the expert set belongs in VRAM, and this tier would be host memory
+    // read across PCIe.  Same `prop.integrated` question the expert cache's own guard asks, and the reason
+    // the GTT store must be provably inert on every non-APU device.
+    if (!ggml_cuda_info().devices[dev_ctx->device].integrated) {
+        return nullptr;
+    }
+    ggml_cuda_set_device(dev_ctx->device);
+    char err[192] = {0};
+    if (!ggml_cuda_gtt_store_open(dev_ctx->device, extent_bytes, source, err, sizeof(err))) {
+        GGML_LOG_WARN("%s: device %d: no GTT expert store: %s\n", __func__, dev_ctx->device, err);
+        return nullptr;
+    }
+    return ggml_backend_cuda_gtt_store_buffer_type(dev_ctx->device);
+}
+
+static void ggml_backend_cuda_device_gtt_store_report(ggml_backend_dev_t dev, size_t filled_bytes,
+        int n_tables, int64_t n_slots) {
+    const ggml_backend_cuda_device_context * dev_ctx = (const ggml_backend_cuda_device_context *) dev->context;
+    if (dev_ctx == nullptr) {
+        return;
+    }
+    ggml_cuda_gtt_store_report(dev_ctx->device, filled_bytes, n_tables, n_slots);
+}
+
 static size_t ggml_backend_cuda_device_slab_work_size(ggml_backend_dev_t dev) {
     // OPEN 2 (TODO #42): the movable-boundary slab WORK region's current size (the boundary), or 0 when this
     // device has no slab.  `llama_context` compares it against the narrow size it last settled on to decide
@@ -10598,6 +10792,8 @@ static const ggml_backend_device_i ggml_backend_cuda_device_interface = {
     /* .moe_heat_open             = */ ggml_backend_cuda_device_moe_heat_open,
     /* .moe_heat_score            = */ ggml_backend_cuda_device_moe_heat_score,
     /* .moe_cache_set_host_fill_mode = */ ggml_backend_cuda_device_moe_cache_set_host_fill_mode,
+    /* .gtt_store_open            = */ ggml_backend_cuda_device_gtt_store_open,
+    /* .gtt_store_report          = */ ggml_backend_cuda_device_gtt_store_report,
 };
 
 // backend reg
diff --git a/ggml/src/ggml-cuda/gtt-expert-store.cu b/ggml/src/ggml-cuda/gtt-expert-store.cu
new file mode 100644
index 000000000..e4ca85663
--- /dev/null
+++ b/ggml/src/ggml-cuda/gtt-expert-store.cu
@@ -0,0 +1,414 @@
+// wip/apu-expert-gtt P2: the GTT expert store's region.  See `gtt-expert-store.cuh` for the design and the
+// measurements it rests on; the buffer type that carves tensors out of this region lives in `ggml-cuda.cu`.
+//
+// This file owns exactly three things:
+//   1. the region's lifetime -- `mmap` + `MADV_HUGEPAGE` + ONE `cudaHostRegister(Mapped[|ReadOnly])`, and at
+//      teardown `cudaHostUnregister` THEN `munmap` (probe 09: the registration is a hold that outlives the
+//      unregister while the VMA lives, so both are required to actually release the pages);
+//   2. the bump allocator the buffer type carves from;
+//   3. the census.
+//
+// It deliberately contains no policy: `-lme` -> bytes, the heat ranking and which tensors are resident are
+// the model loader's (`plan_host_expert_placement`), so the discrete path and this one share one decision.
+
+#include "gtt-expert-store.cuh"
+
+#include "common.cuh"
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <ctime>
+#include <mutex>
+
+#if !defined(_WIN32)
+#include <sys/mman.h>
+#include <unistd.h>
+#include <cerrno>
+#endif
+
+// One GTT store per device.  A `-sm tensor` split over several APUs would open one per device; gfx1151 is one
+// device here, and the plan only ever asks the device it found.
+struct gtt_store_t {
+    int      device    = -1;
+    bool     opened    = false;   // a budget was accepted (the region may not exist yet: `no_alloc`/`--fit`)
+    size_t   extent    = 0;       // the planned extent (the budget), page rounded down
+    void *   base      = nullptr; // the region: host VA == device VA (asserted)
+    size_t   created   = 0;       // the extent actually mapped and registered
+    bool     ro        = false;   // registered ReadOnly
+    size_t   used      = 0;       // bump watermark
+    size_t   carve_min = 0;
+    size_t   carve_max = 0;
+    double   create_ms = 0.0;     // mmap + MADV_HUGEPAGE + the ONE registration
+    int      n_carves  = 0;
+    size_t   fill      = 0;       // bytes the loader read from the GGUF into the GTT store
+    int      n_tables  = 0;
+    int64_t  n_slots   = 0;
+    char     source[192] = {0};   // the budget's source, verbatim from the plan
+};
+
+static gtt_store_t      g_stores[GGML_CUDA_MAX_DEVICES];
+static std::mutex       g_store_mutex;
+
+// ---------------------------------------------------------------------------------------------------------
+// environment
+// ---------------------------------------------------------------------------------------------------------
+
+bool ggml_cuda_gtt_store_wanted() {
+    static const bool on = [] {
+        const char * e = getenv("MOE_EXPERT_GTT");
+        return e == nullptr || atoi(e) != 0;
+    }();
+    return on;
+}
+
+bool ggml_cuda_gtt_store_ro() {
+    static const bool ro = [] {
+        const char * e = getenv("MOE_EXPERT_GTT_RO");
+        return e == nullptr || atoi(e) != 0;
+    }();
+    return ro;
+}
+
+// ---------------------------------------------------------------------------------------------------------
+// small /proc helpers (the census and the budget assertion)
+// ---------------------------------------------------------------------------------------------------------
+
+static size_t gtt_meminfo_kib(const char * key) {
+#if defined(_WIN32)
+    GGML_UNUSED(key);
+    return 0;
+#else
+    FILE * f = fopen("/proc/meminfo", "r");
+    if (f == nullptr) {
+        return 0;
+    }
+    char line[256];
+    const size_t klen = strlen(key);
+    size_t out = 0;
+    while (fgets(line, sizeof(line), f) != nullptr) {
+        if (strncmp(line, key, klen) == 0 && line[klen] == ':') {
+            out = (size_t) strtoull(line + klen + 1, nullptr, 10);
+            break;
+        }
+    }
+    fclose(f);
+    return out;
+#endif
+}
+
+// AnonHugePages + Rss of the VMA that starts at `base`.  The GTT store is ONE `mmap`, so one header line matches.
+static void gtt_smaps_of(const void * base, size_t * huge_kib, size_t * rss_kib) {
+    *huge_kib = 0;
+    *rss_kib  = 0;
+#if defined(_WIN32)
+    GGML_UNUSED(base);
+#else
+    FILE * f = fopen("/proc/self/smaps", "r");
+    if (f == nullptr || base == nullptr) {
+        if (f != nullptr) {
+            fclose(f);
+        }
+        return;
+    }
+    char want[32];
+    snprintf(want, sizeof(want), "%lx", (unsigned long) (uintptr_t) base);
+    char line[512];
+    bool in = false;
+    while (fgets(line, sizeof(line), f) != nullptr) {
+        // a header line looks like `7f...-7f... rw-p 00000000 00:00 0 ...`
+        if (strchr(line, '-') != nullptr && (line[0] >= '0' && line[0] <= '9') &&
+                strncmp(line, want, strlen(want)) == 0 && line[strlen(want)] == '-') {
+            in = true;
+            continue;
+        }
+        if (line[0] >= '0' && line[0] <= '9' && strchr(line, '-') != nullptr) {
+            in = false;   // the next mapping
+            continue;
+        }
+        if (!in) {
+            continue;
+        }
+        if (strncmp(line, "AnonHugePages:", 14) == 0) {
+            *huge_kib = (size_t) strtoull(line + 14, nullptr, 10);
+        } else if (strncmp(line, "Rss:", 4) == 0) {
+            *rss_kib = (size_t) strtoull(line + 4, nullptr, 10);
+        }
+    }
+    fclose(f);
+#endif
+}
+
+// ---------------------------------------------------------------------------------------------------------
+// lifetime
+// ---------------------------------------------------------------------------------------------------------
+
+static void gtt_store_release_locked(gtt_store_t & s) {
+#if !defined(_WIN32)
+    if (s.base != nullptr) {
+        // unregister FIRST, then unmap: probe 09 measured the hold surviving `hipHostUnregister` while the
+        // VMA lives, so releasing in the other order would leave the pages pinned with no way back.
+        const cudaError_t err = cudaHostUnregister(s.base);
+        if (err != cudaSuccess) {
+            (void) cudaGetLastError();
+            GGML_LOG_WARN("%s: device %d: cudaHostUnregister of the %.2f GiB GTT expert store failed: %s\n", __func__,
+                    s.device, (double) s.created / 1073741824.0, cudaGetErrorString(err));
+        }
+        if (munmap(s.base, s.created) != 0) {
+            GGML_LOG_WARN("%s: device %d: munmap of the GTT expert store failed: %s\n", __func__, s.device,
+                    strerror(errno));
+        }
+    }
+#endif
+    s.base    = nullptr;
+    s.created = 0;
+    s.used    = 0;
+    s.opened  = false;
+}
+
+void ggml_cuda_gtt_store_free() {
+    std::lock_guard<std::mutex> lock(g_store_mutex);
+    for (auto & s : g_stores) {
+        if (s.opened || s.base != nullptr) {
+            gtt_store_release_locked(s);
+        }
+    }
+}
+
+// Create the region: `mmap` + `MADV_HUGEPAGE` + ONE registration.  Registration of an UNTOUCHED region is
+// 30.5 ms/GiB (probe 11) and the kernel forms the huge pages there; the loader's fill then writes straight
+// into them with no page faults at all, which is why this is not pre-faulted with a memset first.
+static bool gtt_store_create_locked(gtt_store_t & s, char * err, size_t errn) {
+#if defined(_WIN32)
+    // POSIX-only shape: `mmap`/`MADV_HUGEPAGE` residency plus one flat address.  WDDM gives a distinct device
+    // alias for host memory, and this design refuses to run on two addresses (see the header).  Decline.
+    snprintf(err, errn, "the GTT expert store is a POSIX/mmap shape and needs one address for host and device");
+    GGML_UNUSED(s);
+    return false;
+#else
+    struct timespec t0 = {0, 0}, t1 = {0, 0};
+    clock_gettime(CLOCK_MONOTONIC, &t0);
+
+    const size_t page = (size_t) sysconf(_SC_PAGESIZE);
+    size_t extent = s.extent & ~(page - 1);
+    if (extent < page) {
+        snprintf(err, errn, "the %.2f MiB budget rounds to nothing at this page size", (double) s.extent / 1048576.0);
+        return false;
+    }
+
+    void * p = mmap(nullptr, extent, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0);
+    if (p == MAP_FAILED) {
+        snprintf(err, errn, "mmap of %.2f MiB failed: %s", (double) extent / 1048576.0, strerror(errno));
+        return false;
+    }
+    // Best-effort: without THP the GTT store is still correct, just a 4 KiB tier (and the read rate is the thing
+    // the census reports, so a machine that refused THP is visible rather than silent).
+    if (madvise(p, extent, MADV_HUGEPAGE) != 0) {
+        GGML_LOG_WARN("%s: device %d: MADV_HUGEPAGE on the %.2f GiB GTT expert store failed: %s (the GTT store will be "
+                      "4 KiB pages; the census reports the realised granularity)\n", __func__, s.device,
+                      (double) extent / 1073741824.0, strerror(errno));
+    }
+
+    const unsigned int flags = cudaHostRegisterMapped | (s.ro ? cudaHostRegisterReadOnly : 0u);
+    cudaError_t reg = cudaHostRegister(p, extent, flags);
+    if (reg != cudaSuccess) {
+        const char * msg = cudaGetErrorString(reg);
+        (void) cudaGetLastError();
+        // A driver that refuses the ReadOnly arm is not a reason to lose the GTT store: fall back to the writable
+        // registration ONCE and say so (the census then reports `writable`, which is the 60 GB/s arm).
+        if (s.ro) {
+            GGML_LOG_WARN("%s: device %d: cudaHostRegister(Mapped|ReadOnly) of the %.2f GiB GTT expert store was "
+                          "refused (%s); registering it WRITABLE instead -- expect the writable read rate\n",
+                          __func__, s.device, (double) extent / 1073741824.0, msg);
+            reg = cudaHostRegister(p, extent, cudaHostRegisterMapped);
+            if (reg == cudaSuccess) {
+                s.ro = false;
+            }
+        }
+        if (reg != cudaSuccess) {
+            msg = cudaGetErrorString(reg);
+            (void) cudaGetLastError();
+            (void) munmap(p, extent);
+            snprintf(err, errn, "cudaHostRegister of %.2f MiB failed: %s", (double) extent / 1048576.0, msg);
+            return false;
+        }
+    }
+
+    // ONE address, or nothing.  With `iommu=off` the runtime returns the host pointer unchanged (measured);
+    // if it ever returns a second address, the loader's fill (`read_raw` into `tensor->data`) and the
+    // kernel's read would disagree, and there is no fault-and-retry on this part to catch it.
+    void * d = p;
+    if (cudaHostGetDevicePointer(&d, p, 0) != cudaSuccess) {
+        (void) cudaGetLastError();
+        d = p;
+    }
+    if (d != p) {
+        (void) cudaHostUnregister(p);
+        (void) munmap(p, extent);
+        snprintf(err, errn, "the runtime gave the registered region a SECOND address (host %p, device %p); the "
+                 "GTT store needs one (iommu=off)", p, d);
+        return false;
+    }
+
+    clock_gettime(CLOCK_MONOTONIC, &t1);
+    s.create_ms = (double) (t1.tv_sec - t0.tv_sec) * 1000.0 + (double) (t1.tv_nsec - t0.tv_nsec) / 1.0e6;
+
+    s.base    = p;
+    s.created = extent;
+    s.used    = 0;
+    static std::once_flag once_exit;
+    std::call_once(once_exit, [] {
+        // The registration is a HOLD (probe 09) and the hold outlives `cudaHostUnregister` while the VMA
+        // lives, so release both explicitly rather than relying on process teardown order.
+        atexit(ggml_cuda_gtt_store_free);
+    });
+    return true;
+#endif
+}
+
+bool ggml_cuda_gtt_store_open(int device, size_t extent_bytes, const char * source, char * err, size_t errn) {
+    if (device < 0 || device >= GGML_CUDA_MAX_DEVICES) {
+        snprintf(err, errn, "device %d is out of range", device);
+        return false;
+    }
+    std::lock_guard<std::mutex> lock(g_store_mutex);
+    gtt_store_t & s = g_stores[device];
+    if (s.opened && s.base != nullptr) {
+        // Idempotent for the same request (a second `llama_model` in one process, e.g. llama-bench reloading
+        // because its params differ).  A DIFFERENT extent under a live region cannot be honoured: the carved
+        // tensors are already placed.
+        if (s.extent == extent_bytes) {
+            snprintf(s.source, sizeof(s.source), "%s", source != nullptr ? source : "");
+            return true;
+        }
+        snprintf(err, errn, "a GTT store of %.2f MiB is already live on device %d; %.2f MiB cannot replace it in "
+                 "place", (double) s.extent / 1048576.0, device, (double) extent_bytes / 1048576.0);
+        return false;
+    }
+    s.device  = device;
+    s.opened  = true;
+    s.extent  = extent_bytes;
+    s.ro      = ggml_cuda_gtt_store_ro();
+    s.fill    = 0;
+    s.n_tables = 0;
+    s.n_slots  = 0;
+    s.carve_min = 0;
+    s.carve_max = 0;
+    s.n_carves  = 0;
+    snprintf(s.source, sizeof(s.source), "%s", source != nullptr ? source : "");
+    // The region is created HERE, before a single expert tensor is placed, so a refusal is a clean decline
+    // (the loader keeps today's placement) instead of a half-placed model.  A `--fit` / `--no-alloc` probe
+    // load never reaches this point -- the loader skips the GTT store plan entirely there -- so nothing reserves
+    // non-swappable RAM for a load that allocates no weights.
+    if (!gtt_store_create_locked(s, err, errn)) {
+        s.opened = false;
+        return false;
+    }
+    return true;
+}
+
+// ---------------------------------------------------------------------------------------------------------
+// the bump allocator
+// ---------------------------------------------------------------------------------------------------------
+
+void * ggml_cuda_gtt_store_carve(int device, size_t size) {
+    if (device < 0 || device >= GGML_CUDA_MAX_DEVICES || size == 0) {
+        return nullptr;
+    }
+    std::lock_guard<std::mutex> lock(g_store_mutex);
+    gtt_store_t & s = g_stores[device];
+    if (!s.opened || s.base == nullptr) {
+        return nullptr;
+    }
+    const size_t align = 4096;   // a page: one GGUF expert slab is 0.45-0.92 MiB, so this costs < 1 %
+    const size_t off   = (s.used + align - 1) & ~(align - 1);
+    if (size > s.created || off > s.created - size) {
+        GGML_LOG_ERROR("%s: device %d: a %.2f MiB carve does not fit the %.2f MiB GTT expert store (%.2f MiB used)\n",
+                __func__, device, (double) size / 1048576.0, (double) s.created / 1048576.0,
+                (double) s.used / 1048576.0);
+        return nullptr;
+    }
+    void * p = (char *) s.base + off;
+    s.used   = off + size;
+    s.carve_min = s.carve_min == 0 ? size : (size < s.carve_min ? size : s.carve_min);
+    s.carve_max = size > s.carve_max ? size : s.carve_max;
+    s.n_carves += 1;
+    return p;
+}
+
+// ---------------------------------------------------------------------------------------------------------
+// the census
+// ---------------------------------------------------------------------------------------------------------
+
+// One line, at INFO (so it is read at `-lv 4`, like every other census) -- and it says what this session does
+// NOT do: the GTT store is an ALL-RESIDENT tier here.  Eviction, the warm copy-engine arm and prefill streaming
+// are P3/P4/P5, so a run whose expert set does not fit the budget is a *hot subset* whose non-resident
+// experts stay on their layer's device, not a streaming tier.
+void ggml_cuda_gtt_store_report(int device, size_t filled_bytes, int n_tables, int64_t n_slots) {
+    if (device < 0 || device >= GGML_CUDA_MAX_DEVICES) {
+        return;
+    }
+    size_t extent = 0, created = 0, used = 0, carve_min = 0, carve_max = 0;
+    int    n_carves = 0;
+    double create_ms = 0.0;
+    bool ro = false;
+    char source[192] = {0};
+    void * base = nullptr;
+    {
+        std::lock_guard<std::mutex> lock(g_store_mutex);
+        gtt_store_t & s = g_stores[device];
+        if (!s.opened || s.base == nullptr) {
+            return;
+        }
+        extent    = s.extent;
+        created   = s.created;
+        used      = s.used;
+        carve_min = s.carve_min;
+        carve_max = s.carve_max;
+        n_carves  = s.n_carves;
+        create_ms = s.create_ms;
+        ro        = s.ro;
+        base      = s.base;
+        snprintf(source, sizeof(source), "%s", s.source);
+        s.fill     = filled_bytes;
+        s.n_tables = n_tables;
+        s.n_slots  = n_slots;
+    }
+
+    const double mib = 1024.0 * 1024.0;
+    size_t huge_kib = 0;
+    size_t rss_kib  = 0;
+    gtt_smaps_of(base, &huge_kib, &rss_kib);
+
+    // The budget assertion (P1.2): the GTT store is registered, non-swappable host memory, so it must stay under
+    // the machine's own memory -- the measured over-commit this replaces (2026-10-19: a 123 GiB box went to
+    // 121 GiB resident + 13 GiB swap) is exactly what an unchecked GTT store would repeat.
+    const size_t avail_kib = gtt_meminfo_kib("MemAvailable");
+    const size_t total_kib = gtt_meminfo_kib("MemTotal");
+    const double thp = created > 0 ? 100.0 * (double) huge_kib / ((double) created / 1024.0) : 0.0;
+
+    GGML_LOG_INFO("%s: device %d: GTT expert store %.1f MiB realised of %.1f MiB requested (%s), registered %s, "
+                  "%.1f%% huge pages (%.1f MiB AnonHugePages, %.1f MiB Rss), region created+registered in %.0f ms "
+                  "(%.1f ms/GiB), carved %.1f MiB in %d tables / %lld "
+                  "expert slots, in %d buffer carve%s of %.1f-%.1f MiB; %.1f MiB read from the GGUF into it; MemAvailable %.1f "
+                  "MiB of %.1f MiB total after the load\n",
+                  __func__, device, (double) created / mib, (double) extent / mib, source,
+                  ro ? "ReadOnly" : "WRITABLE", thp, (double) huge_kib / 1024.0, (double) rss_kib / 1024.0,
+                  create_ms, created > 0 ? create_ms / ((double) created / 1073741824.0) : 0.0,
+                  (double) used / mib, n_tables, (long long) n_slots,
+                  n_carves, n_carves == 1 ? "" : "s", (double) carve_min / mib, (double) carve_max / mib, (double) filled_bytes / mib,
+                  (double) avail_kib / 1024.0, (double) total_kib / 1024.0);
+
+    // The resident set this session can serve.  Say so out loud rather than implying the >RAM case works.
+    GGML_LOG_INFO("%s: device %d: GTT expert store scope: ALL-RESIDENT arm only.  The GTT store holds the hottest "
+                  "%d expert tables that fit the budget; anything that did not fit keeps its layer's plain "
+                  "device buffer.  There is no eviction, no streaming refill and no prefill streaming yet "
+                  "(P3-P5), so a set larger than the budget is a hot subset, not a streaming tier.  Kill "
+                  "switch: MOE_EXPERT_GTT=0.\n", __func__, device, n_tables);
+
+    if (total_kib > 0 && created / 1024 > total_kib) {
+        GGML_LOG_WARN("%s: device %d: the GTT store (%.1f MiB) is larger than the machine's MemTotal (%.1f MiB); the "
+                      "budget is not bounded by MemAvailable on this host\n", __func__, device,
+                      (double) created / mib, (double) total_kib / 1024.0);
+    }
+}
diff --git a/ggml/src/ggml-cuda/gtt-expert-store.cuh b/ggml/src/ggml-cuda/gtt-expert-store.cuh
new file mode 100644
index 000000000..27eb37ffd
--- /dev/null
+++ b/ggml/src/ggml-cuda/gtt-expert-store.cuh
@@ -0,0 +1,60 @@
+// wip/apu-expert-gtt P2: the UMA **GTT expert store** -- one registered anonymous region that holds the
+// resident MoE expert set, read in place by `MUL_MAT_ID`.
+//
+// THE SHAPE (wip/apu-expert-gtt/README.md §0): ONE `mmap(PROT_READ|PROT_WRITE, MAP_NORESERVE)` +
+// `MADV_HUGEPAGE`, registered once with `cudaHostRegister(Mapped|ReadOnly)`, sliced into per-(tensor, expert)
+// slots.  There is no pinned master, no host pool, no arena and no slab in this tier: on an APU host RAM and
+// "VRAM" are one DRAM, so the registered region *is* the resident expert set and residency is the whole
+// policy.  The measurements this rests on are `wip/apu-expert-gtt/MEASUREMENTS.md` §13 (P1.0):
+//
+//   * THPs survive `hipHostRegister` (AnonHugePages 1024.0/1024 before and after);
+//   * a registered READ-ONLY range reads at 232.1 GB/s, the same range registered WRITABLE at 60
+//     (`MOE_EXPERT_GTT_RO=0` is the A/B that keeps that claim honest on the real region, not just a probe);
+//   * `pread` INTO the registered region is accepted and the GPU reads the fresh bytes (including on the
+//     reuse arm), so the host may fill the slots through its own mapping with no flush;
+//   * with `iommu=off` the host VA **is** the device VA, which is what lets ONE pointer be both the fill
