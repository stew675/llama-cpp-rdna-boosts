                 FILE * mi = fopen("/proc/meminfo", "r");
                 long long avail_mib = -1;
                 if (mi != nullptr) {
diff --git a/ggml/include/ggml-backend.h b/ggml/include/ggml-backend.h
index d72bb88d7..b8bbee7f4 100644
--- a/ggml/include/ggml-backend.h
+++ b/ggml/include/ggml-backend.h
@@ -90,6 +90,33 @@ extern "C" {
     // r212: tell the host pool how the model was loaded (1 = O_DIRECT) so its fills can mirror it.
     GGML_API void                  ggml_backend_dev_moe_cache_set_host_fill_mode(ggml_backend_dev_t dev, int direct);
 
+    // wip/apu-expert-gtt P2: the GTT EXPERT STORE -- a UMA-only resident expert tier.  `open` accepts (or
+    // refuses) a budget of `extent_bytes` and answers the DEVICE buffer type to place the resident MoE expert
+    // tables in, or NULL when this device offers no GTT store (a discrete device, `MOE_EXPERT_GTT=0`, or a platform
+    // where the region cannot have one address for host and device -- with `iommu=off` the host VA IS the device
+    // VA, which is what lets one pointer be both the fill destination and the kernel's source).  The budget is
+    // the model loader's: it resolves `-lme` into bytes, so the same flag sizes the discrete box's pinned tier
+    // and this one, and `source` says which arm produced the number for the census.  `report` prints the
+    // once-per-load census with the bytes the loader read from the GGUF into the GTT store.  No-op for a backend
+    // without a GTT store.
+    GGML_API ggml_backend_buffer_type_t ggml_backend_dev_gtt_store_open(ggml_backend_dev_t dev, size_t extent_bytes, const char * source);
+    GGML_API void                  ggml_backend_dev_gtt_store_report(ggml_backend_dev_t dev, size_t filled_bytes, int n_tables, int64_t n_slots);
+    // How many bytes the GTT store may lock (`RLIMIT_MEMLOCK`), or SIZE_MAX for unlimited / no lock.  The
+    // loader clamps the store's extent to it and refuses a model that only fits because of the store when it
+    // cannot be locked.  SIZE_MAX for a backend without a store.
+    GGML_API size_t                ggml_backend_dev_gtt_store_lockable(ggml_backend_dev_t dev);
+    // wip/apu-expert-gtt P3: make the GTT store this run's expert ARENA (the cache's slot storage, with
+    // `extent_bytes` as its budget) instead of a whole-tensor placement.  Used when the store cannot hold the
+    // whole set -- the set is then served by residency.  False = declined, fall back to placement.
+    // `pinned_layers` (P3c) are the MTP/nextn head's expert layers: full residency, outside the budget.
+    GGML_API bool                  ggml_backend_dev_gtt_store_arena(ggml_backend_dev_t dev, size_t extent_bytes,
+                                                                  const int * pinned_layers, int n_pinned_layers);
+
+    // wip/apu-expert-gtt P3c: SIZE_MAX when no GTT store is open on `dev` (the caller sizes its own), otherwise
+    // the largest run the LIVE store can still hand out.  A second model in one process must place within it and
+    // must not size, grow or take the arena tier (the extent is the first model's budget).
+    GGML_API size_t                ggml_backend_dev_gtt_store_free_bytes(ggml_backend_dev_t dev);
+
     // wip/slab-ring-region: arm/disarm the allocator's reserved H2D staging-ring hole.  Armed at a wide
     // (prefill) pass, disarmed at the prefill -> decode drop, so a decode-only stretch gets the VRAM back.
     // No-op for a backend without a slab or with no ring hole.
diff --git a/ggml/src/ggml-backend-impl.h b/ggml/src/ggml-backend-impl.h
index 87c8164ec..49d5faf84 100644
--- a/ggml/src/ggml-backend-impl.h
+++ b/ggml/src/ggml-backend-impl.h
@@ -577,6 +577,51 @@ extern "C" {
         // positional-initializer reason above; zero-initialized for backends that do not set it (a backend
         // that never answers leaves the pool on its own default).
         void (*moe_cache_set_host_fill_mode)(ggml_backend_dev_t dev, int direct);
+
+        // (optional) wip/apu-expert-gtt P2: the GTT EXPERT STORE -- a UMA-only resident expert tier (one
+        // registered anonymous region, `mmap` + MADV_HUGEPAGE + `cudaHostRegister(Mapped|ReadOnly)`, sliced into
+        // per-(tensor, expert) slots) that the resident MoE expert tables are placed in and that `MUL_MAT_ID`
+        // reads in place.  `open` accepts (or refuses) a budget of `extent_bytes` -- the model loader resolves
+        // `-lme` into that number, so the same flag sizes the discrete box's pinned tier and this one -- and
+        // answers the DEVICE buffer type the loader should place the resident expert tables in, or NULL when
+        // this device offers no GTT store (a discrete device, `MOE_EXPERT_GTT=0`, or a platform where the region
+        // cannot have one address for host and device).  `report` prints the once-per-load census with the bytes
+        // the loader read from the GGUF into the GTT store.  APPENDED at the very end for the positional-initializer
+        // reason above; zero-initialized for backends that do not set them, so a backend without a GTT store simply
+        // never answers and the loader keeps today's placement.
+        ggml_backend_buffer_type_t (*gtt_store_open)(ggml_backend_dev_t dev, size_t extent_bytes, const char * source);
+        void (*gtt_store_report)(ggml_backend_dev_t dev, size_t filled_bytes, int n_tables, int64_t n_slots);
+
+        // (optional) how many bytes the GTT store may LOCK in this process (`RLIMIT_MEMLOCK`), or SIZE_MAX for
+        // unlimited.  Locking is what makes the tier a reservation: probe 16 (`wip/apu-expert-gtt`) measured
+        // that a merely-registered region is reclaimable under memory pressure.  The model loader clamps the
+        // store's extent to this, and REFUSES a model that only fits because of the store when it cannot be
+        // locked at all -- so a system configuration that cannot lock returns a small number and the loader
+        // decides, never this backend.  SIZE_MAX also means "the store does not lock", which is what the
+        // `MOE_EXPERT_GTT_MLOCK=0` kill switch must look like to the policy.  APPENDED at the very end for
+        // the positional-initializer reason above; zero-initialized means "no answer" -> SIZE_MAX below.
+        size_t (*gtt_store_lockable)(ggml_backend_dev_t dev);
+
+        // (optional) wip/apu-expert-gtt P3: make the GTT store this run's expert ARENA -- the slot storage the
+        // expert cache's tables allocate from, with `extent_bytes` as the cache's budget.  Called instead of
+        // `gtt_store_open` when the store cannot hold the whole expert set, because then the set is served by
+        // residency rather than by placement.  Returns false when the tier is declined (the store is too small
+        // to be a useful arena), and the caller then falls back to whole-tensor placement.  APPENDED at the very
+        // end for the positional-initializer reason above; zero-initialized = no arena tier.
+        //
+        // P3c: `pinned_layers` are the MTP/nextn HEAD's expert layers.  They are sized at their full slot count
+        // and are NOT part of the `-lme` arithmetic (the head is read on every draft step, so the residency
+        // policy must not trade it away, and its bytes must not eat the trunk's budget).
+        bool (*gtt_store_arena)(ggml_backend_dev_t dev, size_t extent_bytes,
+                                const int * pinned_layers, int n_pinned_layers);
+
+        // (optional) wip/apu-expert-gtt P3c follow-up: SIZE_MAX when no GTT store is open on this device (the
+        // caller sizes its own), otherwise the largest run the LIVE store can still hand out.  A second model in
+        // one process (a separate MTP drafter's head, or a reload) must place within that and must never size,
+        // grow or take the arena tier: the region's extent is the FIRST model's budget.  APPENDED at the very
+        // end for the positional-initializer reason above; zero-initialized = "no store", which is what a
+        // backend without one must answer.
+        size_t (*gtt_store_free_bytes)(ggml_backend_dev_t dev);
     };
 
     struct ggml_backend_device {
diff --git a/ggml/src/ggml-backend.cpp b/ggml/src/ggml-backend.cpp
index 474166cef..d78c24c29 100644
--- a/ggml/src/ggml-backend.cpp
+++ b/ggml/src/ggml-backend.cpp
@@ -329,6 +329,43 @@ void ggml_backend_dev_moe_cache_set_host_fill_mode(ggml_backend_dev_t dev, int d
     dev->iface.moe_cache_set_host_fill_mode(dev, direct);
 }
 
+// wip/apu-expert-gtt P2: the GTT expert store (see ggml-backend-impl.h for the contract).
+ggml_backend_buffer_type_t ggml_backend_dev_gtt_store_open(ggml_backend_dev_t dev, size_t extent_bytes, const char * source) {
+    if (dev == nullptr || dev->iface.gtt_store_open == nullptr) {
+        return nullptr;
+    }
+    return dev->iface.gtt_store_open(dev, extent_bytes, source);
+}
+
+void ggml_backend_dev_gtt_store_report(ggml_backend_dev_t dev, size_t filled_bytes, int n_tables, int64_t n_slots) {
+    if (dev == nullptr || dev->iface.gtt_store_report == nullptr) {
+        return;
+    }
+    dev->iface.gtt_store_report(dev, filled_bytes, n_tables, n_slots);
+}
+
+bool ggml_backend_dev_gtt_store_arena(ggml_backend_dev_t dev, size_t extent_bytes,
+                                      const int * pinned_layers, int n_pinned_layers) {
+    if (dev == nullptr || dev->iface.gtt_store_arena == nullptr) {
+        return false;
+    }
+    return dev->iface.gtt_store_arena(dev, extent_bytes, pinned_layers, n_pinned_layers);
+}
+
+size_t ggml_backend_dev_gtt_store_free_bytes(ggml_backend_dev_t dev) {
+    if (dev == nullptr || dev->iface.gtt_store_free_bytes == nullptr) {
+        return SIZE_MAX;
+    }
+    return dev->iface.gtt_store_free_bytes(dev);
+}
+
+size_t ggml_backend_dev_gtt_store_lockable(ggml_backend_dev_t dev) {
+    if (dev == nullptr || dev->iface.gtt_store_lockable == nullptr) {
+        return SIZE_MAX;
+    }
+    return dev->iface.gtt_store_lockable(dev);
+}
