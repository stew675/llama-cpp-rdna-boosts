diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index bf574ecf9..84430b1ce 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -124,6 +124,7 @@
 #include "ggml-cuda-vmm-region.h"
 #include "ggml-cuda-moe-cache-hooks.cuh"
 #include "ggml-cuda-arena.cuh"
+#include "gtt-expert-store.cuh"
 
 static_assert(sizeof(half) == sizeof(ggml_fp16_t), "wrong fp16 size");
 
@@ -5269,6 +5270,158 @@ static ggml_backend_buffer_type_t ggml_backend_cuda_kv_pool_mirror_buft_for_dev(
