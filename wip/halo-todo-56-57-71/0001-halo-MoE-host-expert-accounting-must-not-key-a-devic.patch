From eebdc2f30aca36c30ce1b3d4b8b20b82890c727c Mon Sep 17 00:00:00 2001
From: Stew Forster <stew675@gmail.com>
Date: Tue, 20 Oct 2026 09:21:07 -0500
Subject: [PATCH 1/3] halo: MoE host-expert accounting must not key a
 device-less host buffer

moe_host_expert_account() inserted acc[buft_dev] unconditionally.  The plain
CPU buffer type has .device = NULL upstream (ggml-backend.cpp FIXME), so a
CPU-only model (no usable accelerator) keyed a null device and
llama_context aborted in ggml_backend_dev_memory().  Fall back to the layer's
real device (the test harness's host-expert override shape) and skip when
there is no device at all.

Verified: CPU-only gpt-oss-20b -ngl 0 generates; test-llama-archs -a qwen4exp
(HIP_VISIBLE_DEVICES='') now runs its CPU row (Mixed batch 3.32e-14, OK).
---
 src/llama-model-loader.cpp | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/src/llama-model-loader.cpp b/src/llama-model-loader.cpp
index 1d9731731..e70976177 100644
--- a/src/llama-model-loader.cpp
+++ b/src/llama-model-loader.cpp
@@ -1163,6 +1163,14 @@ void llama_model_loader::lazy_read::add_range(const std::string & name, const ll
 // tensor across them; under `-sm layer`/single-GPU the host buffer already carries the layer's real device.
 // (Before this, every `-sm tensor` shard was keyed to device 0, which reserved the expert-cache arena on
 // device 0 only.)
+//
+// A host buffer type does not have to carry a device: `ggml_backend_cpu_buffer_type()` has
+// `.device = NULL` upstream (the FIXME in ggml-backend.cpp), so a plain CPU placement (a CPU-only
+// run, or `--override-tensor exps=CPU`) yields a null buft device.  Key the account to the layer's
+// real device in that case (the test harness's host-expert override is exactly this shape: the CPU
+// buffer type on a GPU layer), and skip it entirely when there is no device at all -- a CPU-only
+// model has no device to reserve a staging ring or expert-cache arena on, and inserting a null key
+// made `llama_context` abort in `ggml_backend_dev_memory`.
 static void moe_host_expert_account(std::map<ggml_backend_dev_t, size_t> & acc,
         const std::string & name, size_t bytes, ggml_backend_buffer_type_t buft,
         const buft_list_t * buft_list_layer) {
@@ -1188,7 +1196,11 @@ static void moe_host_expert_account(std::map<ggml_backend_dev_t, size_t> & acc,
             return;
         }
     }
-    acc[buft_dev] += bytes;
+    const ggml_backend_dev_t dev = buft_dev != nullptr ? buft_dev : layer_dev;
+    if (dev == nullptr) {
+        return;
+    }
+    acc[dev] += bytes;
 }
 
 struct ggml_tensor * llama_model_loader::create_tensor(
