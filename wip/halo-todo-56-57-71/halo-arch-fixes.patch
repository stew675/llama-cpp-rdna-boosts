+// The sparse QSA op has a second form: the mask is replaced by the compact cell_vis/q_vis keys
+// (src[5]/src[6]).  Only the CUDA kernel derives the visibility inline; the CPU reference
+// implements the mask form and aborts on this one.  Probe the form the graph will actually build,
+// so a device that cannot run it takes the dense masked path (exactly LLAMA_QSA_SPARSE_FA=0)
+// instead of aborting.  Under -sm tensor model.dev_layer() is the Meta device, whose supports_op()
+// requires EVERY child to accept, so this is also the tensor-split safety condition.
+static bool qsa_derived_vis_supported(const llama_model & model, const llama_hparams & hparams, int il, ggml_type type_kv) {
+    ggml_backend_dev_t dev = model.dev_layer(il);
+    if (dev == nullptr) {
+        return false;
+    }
+
+    const ggml_init_params params = {
+        /*.mem_size   =*/ 8*ggml_tensor_overhead(),
+        /*.mem_buffer =*/ nullptr,
+        /*.no_alloc   =*/ true,
+    };
+    ggml_context * ctx = ggml_init(params);
+    if (ctx == nullptr) {
+        return false;
+    }
+
+    // minimal shapes: the back-end predicate reads the source types and the head size (D) only
+    const int64_t D = hparams.n_embd_head_k(il);
+    ggml_tensor * q        = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, D,       1, 1, 1);
+    ggml_tensor * k        = ggml_new_tensor_4d(ctx, type_kv,       D,       1, 1, 1);
+    ggml_tensor * v        = ggml_new_tensor_4d(ctx, type_kv,       D,       1, 1, 1);
+    ggml_tensor * idx      = ggml_new_tensor_4d(ctx, GGML_TYPE_I32, 1,       1, 1, 1);
+    ggml_tensor * cell_vis = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, 1,       1);
+    ggml_tensor * q_vis    = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, 1,       1);
+
+    const bool ok = ggml_backend_dev_supports_op(dev,
+            ggml_flash_attn_qsa(ctx, q, k, v, idx, nullptr, 1.0f, 0.0f, cell_vis, q_vis));
+    ggml_free(ctx);
+    return ok;
+}
+
