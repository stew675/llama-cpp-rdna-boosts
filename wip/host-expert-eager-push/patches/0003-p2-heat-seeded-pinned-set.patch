+// Pin one expert's bytes in the mapping (the primitive both the seed and first-use admission use).
+static void push_mlock_expert(table_t & t, int32_t expert);
+
+// P2 increment 2: SEED the pinned set from the persisted heat map, at sizing, in the same ranked order the
+// arena's own heat seed uses -- so a cold start pins the set the previous run learned instead of whatever the
+// router happens to touch first.  No prior (a first run, or MOE_EXPERT_HEATMAP=0) => nothing happens here and
+// first-use admission fills the set as before.  Caller holds `g_mutex`.
+void push_mlock_seed_locked(table_t & t) {
+    if (g_push_mlock_budget == 0 || !g_push_mlock_seed || g_push_mlock_stop || t.host == nullptr ||
+        t.n_experts <= 0 || t.expert_bytes == 0) {
+        return;
+    }
+    if ((int) t.heat.size() != t.n_experts) {
+        return;   // no prior for this table
+    }
+    const std::vector<uint32_t> & rank_by = heat_rank_vec(t);
+    uint64_t total = 0;
+    for (uint32_t v : t.heat) {
+        total += v;
+    }
+    if (total == 0) {
+        return;
+    }
+    std::vector<int32_t> rank((size_t) t.n_experts);
+    for (int e = 0; e < t.n_experts; e++) {
+        rank[(size_t) e] = e;
+    }
+    std::sort(rank.begin(), rank.end(), [&](int32_t a, int32_t b) {
+        if (rank_by[(size_t) a] != rank_by[(size_t) b]) {
+            return rank_by[(size_t) a] > rank_by[(size_t) b];
+        }
+        return a < b;
+    });
+    const long before = g_push_mlock_experts;
+    for (int i = 0; i < t.n_experts && !g_push_mlock_stop; i++) {
+        push_mlock_expert(t, rank[(size_t) i]);
+    }
+    g_push_mlock_seeded += g_push_mlock_experts - before;
+}
