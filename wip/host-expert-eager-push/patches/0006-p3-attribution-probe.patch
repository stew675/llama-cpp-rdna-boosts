+// P3 attribution probe: host microseconds inside the copy call, and the current device at the call.  Default
+// off, so a normal run is byte-for-byte unaffected (one branch per fill).
+static cudaError_t copy_slot_from_src(const table_t & t, void * dst, const expert_src_t & src,
+                                      cudaStream_t stream) {
+    if (!g_pi_on && !g_pi_setdev) {
+        return copy_slot_from_src_impl(t, dst, src, stream);
+    }
+    int dev = -1;
+    (void) cudaGetDevice(&dev);
+    if (dev != t.device) {
+        g_pi_mismatch++;
+        if (g_pi_setdev) {
+            (void) cudaSetDevice(t.device);
+        }
+    }
+    if (!g_pi_on) {
+        return copy_slot_from_src_impl(t, dst, src, stream);
+    }
+    const auto t0  = std::chrono::steady_clock::now();
+    const cudaError_t err = copy_slot_from_src_impl(t, dst, src, stream);
+    const uint64_t us = (uint64_t) std::chrono::duration_cast<std::chrono::microseconds>(
+            std::chrono::steady_clock::now() - t0).count();
+    g_pi_calls++;
+    g_pi_us += us;
+    if (src.kind == cudaMemcpyHostToDevice) {
+        g_pi_h2d++;
+        g_pi_us_h2d += us;
+    } else {
+        g_pi_d2d++;
+    }
+    return err;
+}
