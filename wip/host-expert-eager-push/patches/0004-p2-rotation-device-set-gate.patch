+// ---- the eviction gate (P2 increment 3) ----------------------------------------------------------
+//
+// A pinned range may be `munlock`ed only when NO device can still be reading it.  Under `-sm tensor` the
+// same host pages are read by several devices (each table_t is a device's slice of one host tensor), so
+// "finished" is a SET of streams, not one.  The gate is the campaign's epoch scheme: one boundary event per
+// device per op (recorded on that device's stream at the host hook), a per-expert epoch of its last read, and
+// a release allowed only when the read is at least one full boundary behind and the events for it (and every
+// later one in the ring) have completed -- stream ordering then makes the answer exact.
+//
+// The ring is 4 deep and a slot may be reused by a newer epoch: that is SAFE, because a newer event on the
+// same stream completing implies the older read on that stream completed too.  What must never happen is a
+// release on a *stale* "not ready" or on an epoch whose event has not been recorded at all -- hence the
+// `epoch <= recorded` check below.
+static constexpr int PUSH_EV_RING = 4;
+static uint64_t     g_push_epoch     = 0;    // completed host boundaries (ops)
+static uint64_t     g_push_ev_epoch[GGML_CUDA_MAX_DEVICES][PUSH_EV_RING] = {};
+static cudaEvent_t  g_push_ev[GGML_CUDA_MAX_DEVICES][PUSH_EV_RING] = {};
+static bool         g_push_ev_used[GGML_CUDA_MAX_DEVICES] = {};
+static long         g_push_released = 0;
+static long         g_push_release_denied = 0;
+
+static bool push_mlock_on() {
+    return g_push_mlock_budget > 0;
+}
+
+// The gate, the rotation and the boundary hook.  Called from `moe_cache_update_host` (once per op), so every
+// read the fills of that op issue is bracketed by an event on that device's stream.
+static bool push_gate_safe_locked(const table_t & t, int32_t e) {
+    if (!g_push_mlock_rotate) {
+        return false;
+    }
+    if (e < 0 || e >= t.n_experts || (int) t.push_read_epoch.size() != t.n_experts) {
+        return false;
+    }
+    const uint32_t read_at = t.push_read_epoch[(size_t) e];
+    // One full boundary of lag: the event for `read_at` is still in the ring and not yet superseded by a
+    // *later* boundary on the same device.
+    if ((uint64_t) read_at + 1 >= g_push_epoch) {
+        return false;
+    }
+    // The device SET: every table that shares this host base can read these pages (a tensor split gives each
+    // device its own slice of the same expert).  Cached once per table -- the sweep must not rescan g_tables
+    // per expert (that is 144 tables x 144 experts per boundary).
+    table_t & tt = const_cast<table_t &>(t);
+    if (tt.push_devices.empty()) {
+        for (const table_t & o : g_tables) {
+            if (o.host == t.host && o.device >= 0 && o.device < GGML_CUDA_MAX_DEVICES) {
+                tt.push_devices.push_back(o.device);
+            }
+        }
+        if (tt.push_devices.empty() && t.device >= 0) {
+            tt.push_devices.push_back(t.device);
+        }
+    }
+    for (const int dev : tt.push_devices) {
+        if (!g_push_ev_used[dev]) {
+            continue;   // this device has never recorded a boundary: nothing of its can be in flight
+        }
+        const int      slot = (int) ((uint64_t) read_at % PUSH_EV_RING);
+        cudaEvent_t    ev   = g_push_ev[dev][slot];
+        if (ev == nullptr || g_push_ev_epoch[dev][slot] < (uint64_t) read_at) {
+            return false;   // the ring no longer holds an event at least as new as the read: be conservative
+        }
+#if defined(GGML_USE_HIP)
+        if (hipEventQuery((hipEvent_t) ev) == hipErrorNotReady) {
+#else
+        if (cudaEventQuery(ev) == cudaErrorNotReady) {
+#endif
+            (void) cudaGetLastError();
+            return false;
+        }
+        (void) cudaGetLastError();
+    }
+    return true;
+}
+
+// Release the pinned experts that nothing has read since the previous sweep.  Runs at the policy's own decay
+// cadence, never per token, and only ever releases what the gate proves safe.
+static void push_rotate_locked() {
+    if (!push_mlock_on() || !g_push_mlock_rotate) {
+        return;
+    }
+    long released_now = 0;
+    for (table_t & t : g_tables) {
+        if (t.push_locked.empty() || t.host == nullptr || released_now >= g_push_rotate_max) {
+            continue;
+        }
+        for (int e = 0; e < t.n_experts; e++) {
+            if (released_now >= g_push_rotate_max) {
+                break;
+            }
+            if (!t.push_locked[(size_t) e]) {
+                continue;
+            }
+            // The staleness signal is the POLICY's, not the fill count: the arena absorbs most reads, so an
+            // expert that is merely arena-resident has not been "filled lately" and must NOT be released.
+            if (t.expert_slot.find(e) != t.expert_slot.end()) {
+                continue;   // resident in the arena: keep its host pages warm
+            }
+            const auto cit = (int) t.count.size() == t.n_experts ? t.count[(size_t) e] : 0;
+            if (cit > 0) {
+                continue;   // still being routed: keep it pinned
+            }
+            if (!push_gate_safe_locked(t, e)) {
+                g_push_release_denied++;
+                continue;
+            }
+            void * addr = (void *) ((const char *) t.host + (size_t) e * t.host_bytes + t.src_off);
+            if (munlock(addr, t.expert_bytes) != 0) {
+                continue;
+            }
+            t.push_locked[(size_t) e] = 0;
+            t.push_read_epoch[(size_t) e] = 0;
+            g_push_mlock_bytes -= t.expert_bytes;
+            g_push_mlock_experts--;
+            g_push_released++;
+            released_now++;
+        }
+    }
+    if (g_push_released > 0 && g_push_mlock_stop) {
+        const bool room = g_push_mlock_bytes + (1u << 20) <= g_push_mlock_budget;
+        if (room) {
+            g_push_mlock_stop = false;   // the budget has room again: first-use admission may resume
+        }
+    }
+}
+
+static void push_gate_boundary_locked(int device, void * stream) {
+    if (!push_mlock_on() || device < 0 || device >= GGML_CUDA_MAX_DEVICES) {
+        return;
+    }
+    const uint64_t ep   = g_push_epoch;
+    const int      slot = (int) (ep % PUSH_EV_RING);
+    if (g_push_ev[device][slot] == nullptr) {
+        if (cudaEventCreateWithFlags(&g_push_ev[device][slot], cudaEventDisableTiming) != cudaSuccess) {
+            (void) cudaGetLastError();
+            return;
+        }
+    }
+    if (cudaEventRecord(g_push_ev[device][slot], (cudaStream_t) stream) != cudaSuccess) {
+        (void) cudaGetLastError();
+        return;
+    }
+    g_push_ev_epoch[device][slot] = ep;
+    g_push_ev_used[device]        = true;
+    g_push_epoch++;
+    // The rotation cadence is WALL CLOCK, not an op count.  This hook runs once per TABLE per op and the table
+    // set grows lazily, so any "every N boundaries" rule is wrong near startup (it fired every 1-2 tables and
+    // turned a periodic sweep into a continual one: measured 9.2 t/s vs ~40).  `mlock`/`munlock` on populated
+    // page-cache pages is also ~ms/MiB, so the pinned set has to be near-static anyway.
+    static auto last_sweep = std::chrono::steady_clock::time_point{};
+    static long sweep_ms   = -1;
+    if (sweep_ms < 0) {
+        const char * e = getenv("MOE_HOST_PUSH_MLOCK_PERIOD_MS");
+        sweep_ms = e != nullptr ? atol(e) : 2000;
+    }
+    const auto now = std::chrono::steady_clock::now();
+    if (last_sweep.time_since_epoch().count() == 0 ||
+            std::chrono::duration_cast<std::chrono::milliseconds>(now - last_sweep).count() >= sweep_ms) {
+        last_sweep = now;
+        push_rotate_locked();
+    }
+}
