From cde73535d304a7495e9ea21bde4a30c4aec08d0a Mon Sep 17 00:00:00 2001
From: briansp2020 <bsp2020@gmail.com>
Date: Fri, 9 Oct 2026 03:15:53 +0000
Subject: [PATCH 1/3] moe-cache: re-arm a stood-down layer's other tables with
 it, so the layer stays slot-uniform

When the work pool takes slab chunks, moe_cache_evict_slab_range drops only the tables whose storage lay in
the taken range.  moe_cache_rearm then re-allocated just those, so a layer could come back with, e.g.,
ffn_up_exps at 193 slots next to ffn_gate_exps / ffn_down_exps at 502: the non-uniform layer that sizing
explicitly refuses ("the shared remap would name different experts per role").  Seen with -sm layer and
--host-experts mmap after a 17.8k-token prefill: greedy output changed on every request (a different sha
each time) and, with admissions frozen, settled on a stable but different sha.  Re-arm every allocated table
of the layer together, so the existing loop sizes them to one target.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ggml/src/ggml-cuda/moe-expert-cache.cu | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/ggml/src/ggml-cuda/moe-expert-cache.cu b/ggml/src/ggml-cuda/moe-expert-cache.cu
index 8736a8c4f..b31214577 100644
--- a/ggml/src/ggml-cuda/moe-expert-cache.cu
+++ b/ggml/src/ggml-cuda/moe-expert-cache.cu
@@ -3436,6 +3436,15 @@ bool moe_cache_rearm() {
     if (by_layer.empty()) {
         return false;
     }
+    // The layer's tables that kept their slots are re-armed with it: left at their old size they would make the
+    // layer non-uniform (the eviction drops only the tables whose storage lay in the taken range).
+    for (int i = 0; i < (int) g_tables.size(); ++i) {
+        const table_t & t = g_tables[i];
+        const auto it = by_layer.find(t.layer);
+        if (it != by_layer.end() && t.device >= 0 && t.allocated && t.slots > 0) {
+            it->second.push_back(i);
+        }
+    }
 
     int n_rearmed = 0;
     for (auto & kv : by_layer) {
-- 
