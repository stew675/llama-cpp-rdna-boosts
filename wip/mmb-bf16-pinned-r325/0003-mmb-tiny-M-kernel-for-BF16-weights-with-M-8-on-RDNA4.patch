 // that the extra live registers and reduced block count cost more than the traffic saved.  Kept as
 // a knob because the balance is a property of this cache, not of the algorithm.
-template<int MMAX, int TT, bool XBF16 = false>
+// WBF16: W is a BF16 [M][K] weight -- four values per 8-byte load, widened to F32, the same F32
+// accumulation and reduction as the F32 weight (the shared-expert gate M=1 and the BF16 hc inject M=4 of a GSQ
+// IQ3_S Flash-Next otherwise pad the 256-row dense tile).
+template<int MMAX, int TT, bool XBF16 = false, bool WBF16 = false>
 __global__ void __launch_bounds__(MMB_NT)
-mmb_tiny_m_f32_kernel(const float * __restrict__ W, const float * __restrict__ X,
+mmb_tiny_m_f32_kernel(const void * __restrict__ Wv, const float * __restrict__ X,
                       float * __restrict__ D, const int M, const int K, const int T) {
     constexpr int NWARPS = MMB_NT / 32;
     const int lane = threadIdx.x & 31, w = threadIdx.x >> 5;
@@ -1322,7 +1325,16 @@ mmb_tiny_m_f32_kernel(const float * __restrict__ W, const float * __restrict__ X
             }
         }
 #pragma unroll
-        for (int m = 0; m < MMAX; ++m) wv[m] = (m < M) ? *(const float4 *) (W + (size_t) m * K + k) : make_float4(0.f, 0.f, 0.f, 0.f);
+        for (int m = 0; m < MMAX; ++m) {
+            if (m >= M) { wv[m] = make_float4(0.f, 0.f, 0.f, 0.f); continue; }
+            if constexpr (WBF16) {
+                const uint2 p = *(const uint2 *) ((const uint16_t *) Wv + (size_t) m * K + k);   // K % 4 == 0: 8-byte aligned
+                wv[m] = make_float4(gm_bf2f((uint16_t) p.x), gm_bf2f((uint16_t) (p.x >> 16)),
+                                    gm_bf2f((uint16_t) p.y), gm_bf2f((uint16_t) (p.y >> 16)));
+            } else {
+                wv[m] = *(const float4 *) ((const float *) Wv + (size_t) m * K + k);
+            }
+        }
 #pragma unroll
         for (int i = 0; i < TT; ++i)
 #pragma unroll
@@ -1346,6 +1358,30 @@ mmb_tiny_m_f32_kernel(const float * __restrict__ W, const float * __restrict__ X
         }
     }
 }
+// The tiny-M dispatch (TT / MMAX / bf16-activation variants), shared by the F32 and the BF16 weight.
+template <bool WBF16>
+static void mmb_tiny_m_launch(const void * W, const float * Xf, const bool xh, float * Df, const int M, const int K, const int T,
+                              const int tt, cudaStream_t stream) {
+    constexpr int NWARPS = MMB_NT / 32;
+    const bool wide = M > 4;   // M <= 4 fits TT accumulators with MMAX=4; above that, one token
+    const int eff  = wide ? 1 : (tt >= 4 ? 4 : (tt == 2 ? 2 : 1));
+    dim3 tg((T + NWARPS * eff - 1) / (NWARPS * eff));
+    if (wide) {
+        if (xh)  mmb_tiny_m_f32_kernel<8, 1, true,  WBF16><<<tg, MMB_NT, 0, stream>>>(W, Xf, Df, M, K, T);
+        else     mmb_tiny_m_f32_kernel<8, 1, false, WBF16><<<tg, MMB_NT, 0, stream>>>(W, Xf, Df, M, K, T);
+    } else if (eff == 4) {
+        if (xh)  mmb_tiny_m_f32_kernel<4, 4, true,  WBF16><<<tg, MMB_NT, 0, stream>>>(W, Xf, Df, M, K, T);
+        else     mmb_tiny_m_f32_kernel<4, 4, false, WBF16><<<tg, MMB_NT, 0, stream>>>(W, Xf, Df, M, K, T);
+    } else if (eff == 2) {
+        if (xh)  mmb_tiny_m_f32_kernel<4, 2, true,  WBF16><<<tg, MMB_NT, 0, stream>>>(W, Xf, Df, M, K, T);
+        else     mmb_tiny_m_f32_kernel<4, 2, false, WBF16><<<tg, MMB_NT, 0, stream>>>(W, Xf, Df, M, K, T);
+    } else {
+        if (xh)  mmb_tiny_m_f32_kernel<4, 1, true,  WBF16><<<tg, MMB_NT, 0, stream>>>(W, Xf, Df, M, K, T);
+        else     mmb_tiny_m_f32_kernel<4, 1, false, WBF16><<<tg, MMB_NT, 0, stream>>>(W, Xf, Df, M, K, T);
+    }
+    CUDA_CHECK(cudaGetLastError());
+}
