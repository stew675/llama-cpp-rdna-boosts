diff --git a/ggml/src/ggml-cuda/ggml-cuda-try-fuse.cu b/ggml/src/ggml-cuda/ggml-cuda-try-fuse.cu
index 917e3c6e2..d8b524014 100644
--- a/ggml/src/ggml-cuda/ggml-cuda-try-fuse.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda-try-fuse.cu
@@ -3269,6 +3269,48 @@ int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph * cgrap
     if (const int n_hc_mix = ggml_cuda_hc_mix_try_fuse(*cuda_ctx, cgraph, i)) {
         return n_hc_mix;
     }
+    // qwen4exp under tensor split (prefill): DSV4_HC_POST -> RMS_NORM -> MUL(gamma) in one kernel (norm.cu), bit-identical
+    // to the three kernels.  The hc_post output stays an output (next layer's residual).  ggml-cuda.cu's graph
+    // optimizer keeps x / residual / post alive until the MUL; the overlap check is a tripwire.  GGML_CUDA_HC_POST_RMS=0 off.
+    if (node->op == GGML_OP_DSV4_HC_POST && node->src[3] == nullptr) {
+        static const bool hc_post_rms = [] { const char * e = getenv("GGML_CUDA_HC_POST_RMS"); return e == nullptr || atoi(e) != 0; }();
+        if (hc_post_rms) {
+            const int limit = std::min(cgraph->n_nodes, i + 16);
+            int idxs[16];
+            enum ggml_op ops[16];
+            int n = 0;
+            idxs[n] = i; ops[n++] = node->op;
+            int k = i + 1;
+            while (k < limit && ggml_cuda_is_view_or_noop(cgraph->nodes[k]) && !ggml_is_empty(cgraph->nodes[k])) {
+                ++k;
+            }
+            ggml_tensor * rms = k < limit ? cgraph->nodes[k] : nullptr;
+            if (rms != nullptr && rms->op == GGML_OP_RMS_NORM && rms->src[0] == node) {
+                idxs[n] = k; ops[n++] = rms->op;
+                int g = k + 1;
+                while (g < limit && ggml_cuda_is_view_or_noop(cgraph->nodes[g]) && !ggml_is_empty(cgraph->nodes[g])) {
+                    ++g;
+                }
+                ggml_tensor * mul = g < limit ? cgraph->nodes[g] : nullptr;
+                if (mul != nullptr && mul->op == GGML_OP_MUL && (mul->src[0] == rms || mul->src[1] == rms)) {
+                    idxs[n] = g; ops[n++] = mul->op;
+                    const int outs[2] = { i, g };
+                    auto overlap = [](const ggml_tensor * a, const ggml_tensor * b) {
+                        const char * a0 = (const char *) a->data; const char * a1 = a0 + ggml_nbytes(a);
+                        const char * b0 = (const char *) b->data; const char * b1 = b0 + ggml_nbytes(b);
+                        return a0 < b1 && b0 < a1;
+                    };
+                    // other blocks still read x (shared by the hc rows) and residual while xn is written
+                    const bool alias = overlap(mul, node->src[0]) || overlap(mul, node->src[1]) || overlap(mul, node->src[2]) ||
+                                       overlap(node, node->src[0]) || overlap(node, node->src[2]) || overlap(mul, node);
+                    if (!alias && ggml_can_fuse_subgraph_ext(cgraph, idxs, n, ops, outs, 2) &&
+                        ggml_cuda_op_dsv4_hc_post_rms_fused(*cuda_ctx, node, rms, mul)) {
+                        return g - i;
+                    }
+                }
+            }
+        }
+    }
     // qwen4exp hyper-connection combine+norm fusions (owned by hyperconn.cu).
     if (const int n_hc_comb = ggml_cuda_hc_combine_norm_try_fuse(*cuda_ctx, cgraph, i)) {
         return n_hc_comb;
diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 5e250a093..98eacca03 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -4951,6 +4951,43 @@ struct cuda_gc_timer {
 
 // GGML_CUDA_BF16_SRC1_CACHE=0 disables the per-graph BF16 src1 reuse (bf16_src1_cache in common.cuh).
 
+// GGML_CUDA_BF16_PRODUCER=2 (debug): compare a cached BF16 src1 with the conversion it replaced, element by element.
+static __global__ void ggml_cuda_bf16_src1_cmp(const nv_bfloat16 * a, const nv_bfloat16 * b, int64_t n, unsigned long long * bad) {
+    for (int64_t i = blockIdx.x * (int64_t) blockDim.x + threadIdx.x; i < n; i += (int64_t) gridDim.x * blockDim.x) {
+        if (__bfloat16_as_ushort(a[i]) != __bfloat16_as_ushort(b[i])) atomicAdd(bad, 1ull);
+    }
+}
+static void ggml_cuda_bf16_src1_verify(ggml_backend_cuda_context & ctx, const ggml_tensor * src1, const nv_bfloat16 * cached, int64_t n, cudaStream_t stream) {
+    static unsigned long long hits = 0, bad_total = 0, skipped = 0;
+#if defined(GGML_USE_HIP)
+    hipStreamCaptureStatus cap = hipStreamCaptureStatusNone;
+    CUDA_CHECK(hipStreamIsCapturing(stream, &cap));
+    const bool capturing = cap != hipStreamCaptureStatusNone;
+#else
+    cudaStreamCaptureStatus cap = cudaStreamCaptureStatusNone;
+    CUDA_CHECK(cudaStreamIsCapturing(stream, &cap));
+    const bool capturing = cap != cudaStreamCaptureStatusNone;
+#endif
+    if (capturing) {   // a graph capture cannot synchronize: those hits are not checked
+        ++skipped;
+        return;
+    }
+    ggml_cuda_pool_alloc<nv_bfloat16> ref(ctx.pool(), n);
+    ggml_get_to_bf16_cuda(GGML_TYPE_F32)(src1->data, ref.get(), n, stream);
+    ggml_cuda_pool_alloc<unsigned long long> cnt(ctx.pool(), 1);
+    unsigned long long * dbad = cnt.get();
+    CUDA_CHECK(cudaMemsetAsync(dbad, 0, sizeof(*dbad), stream));
+    ggml_cuda_bf16_src1_cmp<<<256, 256, 0, stream>>>(cached, ref.get(), n, dbad);
+    unsigned long long bad = 0;
+    CUDA_CHECK(cudaMemcpyAsync(&bad, dbad, sizeof(bad), cudaMemcpyDeviceToHost, stream));
+    CUDA_CHECK(cudaStreamSynchronize(stream));
+    ++hits; bad_total += bad;
+    if (bad != 0 || hits % 500 == 1) {
+        GGML_LOG_WARN("BF16_PRODUCER verify: %s n=%lld mismatches %llu (hits %llu, total mismatches %llu, %llu captured hits not checked)\n",
+                      src1->name, (long long) n, bad, hits, bad_total, skipped);
+    }
+}
+
