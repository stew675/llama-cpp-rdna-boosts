+uint32_t llama_memory_hybrid_idx_context::qsa_n_kv_window() const {
+    const uint32_t n_kv = get_idx() ? get_idx()->get_n_kv() : 0;
+    const llama_kv_cache * idx = mem ? mem->get_mem_idx() : nullptr;
+    if (idx == nullptr) {
