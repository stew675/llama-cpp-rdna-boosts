+void ggml_cuda_ple_conv_direct(ggml_backend_cuda_context & ctx, const ggml_cuda_ple_conv_match & m) {
+    static bool dbg = getenv("GGML_CUDA_CONV_DEBUG") != nullptr;
+    if (dbg) { fprintf(stderr, "PLE_CONV_DIRECT C=%lld T=%lld H=%lld K=%lld dil=%lld tail_from=%lld\n", (long long) m.C, (long long) m.T, (long long) m.H, (long long) m.K, (long long) m.dil, (long long) m.tail_from); dbg = false; }
