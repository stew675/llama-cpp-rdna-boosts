         nf = ggml_cuda_slab_up(bytes, cchunk) + cchunk;
@@ -380,25 +468,48 @@ void ggml_cuda_slab_set_narrow_floor(int device, size_t bytes) {
     if (nf <= s.narrow_floor) {
