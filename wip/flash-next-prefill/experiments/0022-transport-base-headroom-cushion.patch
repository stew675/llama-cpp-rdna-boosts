+                      "region's VA does not move, so this needs no idle window\n",
+                      __func__, device, (double) s.narrow_floor / 1048576.0, (double) nf / 1048576.0,
+                      (double) tbase / 1048576.0, (double) (tbase - nf) / 1048576.0);
