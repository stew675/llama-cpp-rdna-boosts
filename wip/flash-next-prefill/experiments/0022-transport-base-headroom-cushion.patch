+    // (the deferred path, applied at the idle window -- the correctness fallback).  0 = not established
+    // (`narrow_floor` is then the base, i.e. the pre-cushion layout).
+    size_t                   transport_base = 0;
+    size_t                   band_raise_n   = 0;  // band raises the cushion absorbed without a VA move
+    size_t                   band_overrun_n = 0;  // band raises that EXCEEDED the cushion (deferred)
     int                      ring_slots   = 0;  // slots the ring region was sized for (capacity = region/slots)
     std::multiset<size_t>    work_needs;        // REQUESTED size of every live work view -- the floor the
                                                 //  boundary may shrink to (see `work_alloc`)
@@ -296,10 +309,72 @@ void ggml_cuda_slab_set_ring_region(size_t bytes) {
     g_slab_ring_region_bytes = bytes;
 }
 
+// wip/flash-next-prefill (session 5): the unit a decode/verify COMPUTE-band raise actually moves in -- the
+// compute buffer's own chunk (`GGML_COMPUTE_BUFFER_CHUNK_MIB`, the unit `ggml_vbuffer_chunk_alloc_size`
+// rounds a compute buffer to).  The transport region's headroom is denominated in THESE, never in a magic
+// 256/512 MiB: a raise is always a whole number of chunks.
+static size_t ggml_cuda_slab_compute_chunk_bytes() {
+    static const size_t cchunk = []() {
+        const char * e = getenv("GGML_COMPUTE_BUFFER_CHUNK_MIB");
+        return (size_t) (e ? atoll(e) : 256) << 20;
+    }();
+    return cchunk;
+}
+
+// wip/flash-next-prefill (session 5): the transport region's headroom CUSHION, in compute chunks
+// (`GGML_CUDA_SLAB_TRANSPORT_HEADROOM_CHUNKS`, default 2; 0 restores the pre-cushion layout).  It is a
+// CUSHION, not a guarantee: a very long prompt can still want more band than it holds, and that case keeps
+// the deferred path as the CORRECTNESS fallback (the handover's `experiments/0020` window).  The default is
+// the smallest cushion that covers the observed case -- the field shape needed exactly two chunks,
+// 1536 -> 1792 -> 2048 MiB -- and if the overrun counter in the census is non-zero, N is too small for that
+// shape, which is the number to tune (not the presence of the fallback).
+static size_t ggml_cuda_slab_headroom_chunks() {
+    static const size_t n = []() {
+        const char * e = getenv("GGML_CUDA_SLAB_TRANSPORT_HEADROOM_CHUNKS");
+        return (size_t) (e ? atoll(e) : 2);
+    }();
+    return n;
+}
+
+// The transport region's base offset: the narrow floor plus the cushion, FIXED for the run once
+// established.  Every reader goes through this one value -- `arena_alloc_transient` (the region's blocks),
+// the wide placement and the seed floor -- because the region's VA must not move under a live block.
+static size_t ggml_cuda_slab_transport_base(const ggml_cuda_slab & s) {
+    if (s.narrow_floor == 0) {
+        return 0;
+    }
+    return s.transport_base > s.narrow_floor ? s.transport_base : s.narrow_floor;
+}
+
+// Establish (or re-base) the transport region's base for a band of `narrow_floor` bytes: the floor plus N
+// compute chunks, clamped to what the mapping can actually hold (never its last slab chunk, which the wide
+// view and a usable arena need).  A base that already covers the band is KEPT, so raising the band inside
+// the cushion moves nothing; only a raise past the base re-derives it, and that may only happen in a window
+// where no region block and no wide view is live (`ggml_cuda_slab_set_narrow_floor` defers otherwise).
+// Caller holds `g_slab_mutex`.
+static void ggml_cuda_slab_transport_base_establish(ggml_cuda_slab & s, size_t narrow_floor) {
+    if (narrow_floor == 0 || s.transport_base >= narrow_floor) {
+        return;
+    }
+    const size_t cchunk = ggml_cuda_slab_compute_chunk_bytes();
+    // `room` is what the mapping has above the band with one slab chunk left for the wide view/arena.
+    const size_t room = s.mapped > narrow_floor + s.chunk ? s.mapped - narrow_floor - s.chunk : 0;
+    size_t headroom = ggml_cuda_slab_headroom_chunks() * cchunk;
+    if (cchunk > 0 && headroom > room) {
+        headroom = room / cchunk * cchunk;   // whole chunks only; 0 when none fit
+    }
+    const size_t base = ggml_cuda_slab_up(narrow_floor + headroom, s.chunk);
+    s.transport_base = base + s.chunk <= s.mapped ? base : narrow_floor;
+}
+
 // wip/slab-ring-region / first-prefill-latency: the chunk-aligned ring region to CARVE from the current
 // request (0 when there is no room -- the ring then stays on the cudaMalloc path).  Used only at the point
 // the region is actually carved into the work layout.  Caller holds `g_slab_mutex`.
-static size_t ggml_cuda_slab_ring_candidate(const ggml_cuda_slab & s, size_t narrow_floor, int device) {
+//
+// session 5: `s` is mutable because carving is also where the transport region's BASE is established -- the
+// two are one layout decision (`ggml_cuda_slab_transport_base_establish`), and the room test below must use
+// the base, not the floor, or the cushion is not accounted for and the region overlaps the wide view.
+static size_t ggml_cuda_slab_ring_candidate(ggml_cuda_slab & s, size_t narrow_floor, int device) {
     size_t ring = g_slab_ring_region_bytes;
     if (ring == 0) {
         return 0;
@@ -327,22 +402,38 @@ static size_t ggml_cuda_slab_ring_candidate(const ggml_cuda_slab & s, size_t nar
         }
     }
     ring = ggml_cuda_slab_up(ring, s.chunk);
-    if (narrow_floor + ring + s.chunk > s.mapped) {
-        ring = 0;   // no room for a meaningful region: leave the staging path a cudaMalloc slot
+    // The region lives at the transport BASE (floor + cushion), so the cushion is part of this layout test.
+    {
+        const size_t base_before = ggml_cuda_slab_transport_base(s);
+        ggml_cuda_slab_transport_base_establish(s, narrow_floor);
+        const size_t base = ggml_cuda_slab_transport_base(s);
+        if (base != base_before) {
+            GGML_LOG_INFO("%s: dev=%d: transport region base %.1f MiB = decode/verify band %.1f MiB + a "
+                          "%.1f MiB headroom cushion (%zu x %.0f MiB compute chunks); a band raise that fits "
+                          "under the base moves nothing\n",
+                          __func__, device, (double) base / 1048576.0, (double) narrow_floor / 1048576.0,
+                          (double) (base - narrow_floor) / 1048576.0, ggml_cuda_slab_headroom_chunks(),
+                          (double) ggml_cuda_slab_compute_chunk_bytes() / 1048576.0);
+        }
+        if (base + ring + s.chunk > s.mapped) {
+            ring = 0;   // no room for a meaningful region: leave the staging path a cudaMalloc slot
+        }
     }
     return ring;
 }
 
-// The base offset of the wide (prefill) view: narrow = [0, narrow_floor), ring = [narrow_floor,
-// narrow_floor + ring_region), wide = [narrow_floor + ring_region, boundary), arena = [boundary, mapped).
+// The base offset of the wide (prefill) view: narrow = [0, `narrow_floor`, which may grow into the
+// cushion), cushion = [`narrow_floor`, `transport_base`), transport = [`transport_base`, `transport_base`
+// + `ring_region`), wide = [`transport_base` + `ring_region`, boundary), arena = [boundary, mapped).
