+// wip/flash-next-prefill (the ping-pong the slab/arena work was asked for): a staged host weight is consumed
+// IN THE RING SLOT instead of being copied into the graph-allocated split input first.  That is the retired
+// r250 "redirect" form, and it is safe HERE for a reason r250 did not have: such a split is a multi-token
+// prefill split, and a multi-token graph is never captured (`GGML_CUDA_GRAPH_MAX_TOKENS` is 16), so no captured
+// graph can bake the input pointer in.  It removes the whole ring -> input D2D (~41 GB/ubatch on the COMPUTE
+// stream at this shape) and with it the last thing that kept the fill from being a pure ping-pong.
+// `GGML_SCHED_STAGE_REDIRECT=0` restores the copy (A/B and bisection).
+static bool sched_stage_redirect(void) {
+    static const bool on = [] {
+        const char * e = GGML_ENV_STR("GGML_SCHED_STAGE_REDIRECT");
+        return e == nullptr || e[0] == '\0' || atoi(e) != 0;
+    }();
+    return on;
+}
