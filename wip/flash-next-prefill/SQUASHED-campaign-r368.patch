+// wip/flash-next-prefill D1: a DEDICATED broadcast-copy kernel for the dense F32 case.  `op_repeat` used to run
+// through the generic binary-broadcast kernel, which computes a broadcasted source index PER ELEMENT and moves
+// one scalar at a time: measured on the qwen4exp hyper-connection expansion ([2560 x 4 x 8192] F32, 846 calls in
+// an 89k prefill) it costs 2622 ms = 7.4 % of the op budget, i.e. ~3.1 ms for 335 MB = ~108 GB/s -- a third of
+// what a vectorised copy of the same bytes reaches.  When dim 0 matches and both tensors are dense F32, the
+// output is just ne1*ne2*ne3 copies of one contiguous row block, so one block copies one row with float4 loads.
+// Bit-identical: a copy is a copy.  `GGML_CUDA_REPEAT_VEC=0` restores the generic kernel (A/B and bisection).
+static __global__ void k_repeat_f32_vec(float * __restrict__ dst, const float * __restrict__ src,
+                                        const int64_t ne0, const int64_t ne1, const int64_t ne2,
+                                        const int64_t ne01, const int64_t ne02, const int64_t ne03) {
+    const int64_t b  = blockIdx.x;                 // one block per destination row
+    const int64_t i1 = b % ne1;
+    const int64_t r  = b / ne1;
+    const int64_t i2 = r % ne2;
+    const int64_t i3 = r / ne2;
+    const int64_t row = (i1 % ne01) + ne01 * ((i2 % ne02) + ne02 * (i3 % ne03));
+    const float4 * s4 = (const float4 *) (src + row * ne0);
+    float4 *       d4 = (float4 *)       (dst + b   * ne0);
+    const int64_t  n4 = ne0 >> 2;
+    for (int64_t j = threadIdx.x; j < n4; j += blockDim.x) {
+        d4[j] = s4[j];
+    }
+}
