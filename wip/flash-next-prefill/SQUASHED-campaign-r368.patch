+// Fill one buffer with a split's host-weight set: the wait on the buffer's FREE event first (the split that
+// consumed it may still be reading), then the uploads, then the DONE event the consumer waits on.
+static bool sched_pp_issue(ggml_backend_sched_t sched, struct ggml_backend_sched_split * split, int buf) {
+    ggml_backend_t backend = sched->backends[split->backend_id];
+    size_t  need  = 0;
+    const int n = sched_pp_split_set(sched, split, &need);
+    sched->pp_n_ent[buf] = 0;
+    if (n <= 0) {
+        if (getenv("GGML_SCHED_STAGE_SELECT_DEBUG") != nullptr) {
+            static int warned = 0;
+            if (warned++ < 4) {
+                GGML_LOG_WARN("%s: ping-pong: split %d has no stageable host-weight set (n=%d, need=%zu) -> "
+                              "serial path\n", __func__, split->backend_id, n, need);
+            }
+        }
+        return false;
+    }
+    if (n > (int) (sizeof(sched->pp_ent[0]) / sizeof(sched->pp_ent[0][0]))) {
+        return false;   // a set too wide to lay out: leave it to the serial path
+    }
+    if (need > sched->pp_size) {
+        if (sched->pp_size != 0) {
+            static bool warned = false;
+            if (!warned) {
+                warned = true;
+                GGML_LOG_WARN("%s: ping-pong buffer grows %.1f -> %.1f MiB (a split set larger than the "
+                              "largest seen so far; sized once to the largest layer, this should not recur)\n",
+                              __func__, (double) sched->pp_size / (1024.0 * 1024.0),
+                              (double) need / (1024.0 * 1024.0));
+            }
+        }
+        sched->pp_size = need;
+    }
+    // the previous consumer of this buffer must have finished reading it
+    backend->iface.stage_wait(backend, sched_stage_ev(sched, split->backend_id, buf, false));
+    void * base = backend->iface.stage_buffer(backend, buf, sched->pp_size);
+    if (base == NULL) {
+        if (getenv("GGML_SCHED_STAGE_SELECT_DEBUG") != nullptr) {
+            static int warned = 0;
+            if (warned++ < 4) {
+                GGML_LOG_WARN("%s: ping-pong: stage_buffer(%d, %.1f MiB) returned NULL -> the split takes the "
+                              "serial path\n", __func__, buf, (double) sched->pp_size / 1048576.0);
+            }
+        }
+        return false;
+    }
+    sched->pp_base[buf]    = base;
+    sched->pp_backend[buf] = split->backend_id;
+
+    size_t off = 0;
+    int    k   = 0;
+    for (int i = 0; i < split->n_inputs; i++) {
+        struct ggml_tensor * input = split->inputs[i];
+        if (!sched_stage_is_host_weight(input)) {
+            continue;
+        }
+        struct ggml_tensor * input_cpy = tensor_copy(input, split->backend_id, sched->cur_copy);
+        if (sched_input_gatherable(sched, split, input, input_cpy)) {
+            continue;
+        }
+        const size_t size = ggml_nbytes(input);
+        backend->iface.stage_upload(backend, (char *) base + off, input->data, size,
+                                    sched_stage_ev(sched, split->backend_id, buf, true));
+        sched->pp_ent[buf][k].dst  = input_cpy;
+        sched->pp_ent[buf][k].off  = off;
+        sched->pp_ent[buf][k].size = size;
+        k++;
+        off += (size + 255u) & ~(size_t) 255u;
+    }
+    sched->pp_n_ent[buf] = k;
+    sched->pp_held       = true;
+    return k > 0;
+}
