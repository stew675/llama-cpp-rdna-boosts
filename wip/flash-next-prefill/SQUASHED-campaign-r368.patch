+        src0->ne[0] == dst->ne[0] && (dst->ne[0] & 3) == 0 &&
+        src0->ne[3] == 1 && src0->ne[2] <= dst->ne[2] && src0->ne[1] <= dst->ne[1] &&
+        ggml_is_contiguous(src0) && ggml_is_contiguous(dst)) {
+        const int64_t n_rows = dst->ne[1] * dst->ne[2] * dst->ne[3];
+        if (n_rows > 0 && n_rows <= (int64_t) 0x7fffffff) {
+            k_repeat_f32_vec<<<(unsigned) n_rows, 256, 0, ctx.stream()>>>(
+                (float *) dst->data, (const float *) src0->data,
+                dst->ne[0], dst->ne[1], dst->ne[2], src0->ne[1], src0->ne[2], src0->ne[3]);
+            if (cudaGetLastError() == cudaSuccess) {
+                static const bool dbg = getenv("GGML_CUDA_REPEAT_VEC_DEBUG") != nullptr;
+                if (dbg) {
+                    static int n = 0;
+                    if (n++ < 4) {
+                        GGML_LOG_INFO("%s: repeat f32 vec path [%lld x %lld x %lld x %lld] rows=%lld\n", __func__,
