+// The buffer COUNT, chosen ONCE at scheduler construction from the device's FREE VRAM at startup (the earliest
+// point the scheduler can ask; nothing of ours is allocated yet) and then fixed for the life of the process:
+// 1 buffer <= 14 GiB free, 2 <= 24 GiB free, 3 above.  The buffers do not overlap compute with one
+// (measured 1943 vs 2401/2446 t/s for 2/3 on the 89k prefill), and each costs the largest split set of VRAM that
+// the decode band would otherwise keep, so a small card gets the small pipeline.  A count that is re-chosen later
+// FLAPS (measured: 1 on the priming pass, 3 once the slab settles, then 1 again) and every 1-buffer graph costs
+// ~21 %; hence "set once, before anything else is allocated".
+// `GGML_SCHED_PINGPONG_BUFS=1|2|3` overrides (A/B and bisection).
+static double sched_pp_startup_free_gib(ggml_backend_sched_t sched) {
+    size_t min_free = 0;
+    for (int b = 0; b < sched->n_backends; b++) {
+        ggml_backend_dev_t dev = ggml_backend_get_device(sched->backends[b]);
+        if (dev == NULL) { continue; }
+        const enum ggml_backend_dev_type t = ggml_backend_dev_type(dev);
+        if (t != GGML_BACKEND_DEVICE_TYPE_GPU && t != GGML_BACKEND_DEVICE_TYPE_ACCEL) { continue; }
+        size_t fr = 0, tot = 0;
+        ggml_backend_dev_memory(dev, &fr, &tot);
+        if (fr != 0 && (min_free == 0 || fr < min_free)) { min_free = fr; }
+    }
+    return (double) min_free / (1024.0 * 1024.0 * 1024.0);
+}
