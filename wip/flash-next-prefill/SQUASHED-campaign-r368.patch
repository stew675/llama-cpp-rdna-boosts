+// ============================================================================================
+// wip/flash-next-prefill D1: the `weight_before_ffn` REPEAT + MUL pair of `build_moe_ffn`.
+//
+// src/llama-graph.cpp emits, for an arch that applies the routing weights BEFORE the expert FFN:
+//
+//     repeated = ggml_repeat_4d(cur, n_embd, n_expert_used, n_tokens, 1);   // [n_embd,1,T] -> [n_embd,K,T]
+//     cur      = ggml_mul(repeated, weights);                               // weights [1,K,T]
+//
+// The repeat MATERIALISES the broadcast: n_embd * K * T * 4 B (839 MB for the 89k Flash-Next prefill at
+// `-ub 8192`: 2560 x 10 x 8192 x 4), which the mul then reads back and writes again -- 2.5 GB of traffic per
+// layer per ubatch for one multiply per element.  Measured with GGML_CUDA_OP_TIMING on that shape: REPEAT
+// 2622 ms (7.4 % of the op budget) + MUL 1134 ms (3.2 %) = 3.76 s, 10.6 % of the whole op set.
+//
+// The fusion writes the product directly, `dst[j,k,t] = src[j,t] * w[k,t]`, which is the SAME two F32 operands
+// multiplied ONCE in F32 -- bit-identical, not an approximation (this is why it needs no KLD allowance).
+// Anchored at the REPEAT: it is served here and the MUL is skipped, so the materialised buffer is never
+// written.  Declines (and the pair runs unfused) unless the repeat is a pure dim-1 broadcast with exactly one
+// consumer, the mul is the same shape, both are contiguous F32, and the fusion-window range check passes.
+// GGML_CUDA_FUSE_MOE_WEIGHT=0 is the kill switch (A/B and bisection).
+// ============================================================================================
+
+static __global__ void moe_weight_broadcast_kernel(float * __restrict__ dst, const float * __restrict__ src,
+                                                    const float * __restrict__ w, int64_t n_embd, int64_t n_used) {
+    // One block per (token, expert) row: the row's activation segment `src[t]` times ONE scalar weight.
+    const int64_t row = blockIdx.x;          // t * n_used + k == the row of `w`
+    const float   wv  = w[row];
+    const float * s   = src + (row / n_used) * n_embd;
+    float *       d   = dst + row * n_embd;
+    if ((n_embd & 3) == 0) {
+        const float4 * s4 = (const float4 *) s;
+        float4 *       d4 = (float4 *) d;
+        const int64_t  n4 = n_embd >> 2;
+        for (int64_t j = threadIdx.x; j < n4; j += blockDim.x) {
+            float4 v = s4[j];
+            v.x *= wv; v.y *= wv; v.z *= wv; v.w *= wv;
+            d4[j] = v;
+        }
+        return;
+    }
+    for (int64_t j = threadIdx.x; j < n_embd; j += blockDim.x) {
+        d[j] = s[j] * wv;
+    }
+}
+
+static bool ggml_cuda_fuse_moe_weight_on() {
+    // DEFAULT OFF: measured 2305.9 vs 2412.1 t/s (-4.4 %) on the Flash-Next 89k prefill against the unfused
+    // pair, with identical text.  `GGML_OP_MUL` is in-place-capable, so the unfused pair already writes the
+    // broadcast ONCE and multiplies it in place -- there is no second 839 MB buffer to remove, and this fusion
+    // adds a redundant source re-read plus a second live buffer.  Kept only as the record of that measurement
+    // (`wip/flash-next-prefill/RESULTS-session3.md`); a vectorised REPEAT kernel is the win instead.
+    static const bool on = [] {
+        const char * e = getenv("GGML_CUDA_FUSE_MOE_WEIGHT");
+        return e != nullptr && e[0] != '\0' && atoi(e) != 0;
+    }();
+    return on;
+}
+
+static bool ggml_cuda_fuse_moe_weight_debug() {
+    static const bool on = [] { const char * e = getenv("GGML_CUDA_FUSE_MOE_WEIGHT_DEBUG"); return e != nullptr && atoi(e) != 0; }();
+    return on;
+}
+
+// Returns the number of graph nodes to skip when the pair is fused (always 1, the MUL), 0 otherwise.
+int ggml_cuda_moe_weight_broadcast_try_fuse(ggml_backend_cuda_context & ctx, const ggml_cgraph * cgraph, int i) {
+    if (!ggml_cuda_fuse_moe_weight_on() || cgraph->nodes[i]->op != GGML_OP_REPEAT) {
+        return 0;
+    }
+    const ggml_tensor * rep = cgraph->nodes[i];
+    if (rep->type != GGML_TYPE_F32 || !ggml_is_contiguous(rep) || rep->ne[3] != 1 || rep->ne[1] < 2) {
+        return 0;
+    }
+    const ggml_tensor * s0 = rep->src[0];
+    if (s0 == nullptr || s0->type != GGML_TYPE_F32 || !ggml_is_contiguous(s0) ||
+        s0->ne[0] != rep->ne[0] || s0->ne[1] != 1 || s0->ne[2] != rep->ne[2] || s0->ne[3] != rep->ne[3]) {
+        return 0;   // not a pure dim-1 broadcast
+    }
+    // the repeat must have exactly ONE consumer: the mul.  Otherwise its buffer is still a graph result (a
+    // LoRA delta, a second reader) and the fusion would silently drop a consumer.
+    if (!ggml_node_has_n_uses(cgraph, i, 1) || i + 1 >= cgraph->n_nodes) {
+        return 0;
+    }
+    const ggml_tensor * mul = cgraph->nodes[i + 1];
+    if (mul->op != GGML_OP_MUL || mul->type != GGML_TYPE_F32 || !ggml_is_contiguous(mul) ||
+        !ggml_are_same_shape(mul, rep)) {
+        return 0;
+    }
+    const ggml_tensor * w = mul->src[0] == rep ? mul->src[1] : (mul->src[1] == rep ? mul->src[0] : nullptr);
+    if (w == nullptr || w->type != GGML_TYPE_F32 || !ggml_is_contiguous(w) ||
+        w->ne[0] != 1 || w->ne[1] != rep->ne[1] || w->ne[2] != rep->ne[2] || w->ne[3] != 1) {
+        return 0;
+    }
+    const int output_idx = i + 1;
+    if (!ggml_cuda_check_fusion_memory_ranges(cgraph, i, 2, &output_idx, 1)) {
+        return 0;
+    }
+    ggml_tensor * dst = const_cast<ggml_tensor *>(mul);
+    const int64_t n_used = rep->ne[1];
+    const int64_t n_tok  = rep->ne[2];
+    moe_weight_broadcast_kernel<<<(unsigned) (n_used * n_tok), 256, 0, ctx.stream()>>>(
+        (float *) dst->data, (const float *) s0->data, (const float *) w->data, rep->ne[0], n_used);
+    if (cudaGetLastError() != cudaSuccess) {
+        (void) cudaGetLastError();
+        return 0;   // the MUL/REPEAT pair then runs unfused, which is the correct (slower) answer
+    }
+    if (ggml_cuda_fuse_moe_weight_debug()) {
+        GGML_LOG_INFO("MWB FUSED %s [%lld x %lld x %lld]\n", mul->name,
+                      (long long) rep->ne[0], (long long) n_used, (long long) n_tok);
+    }
+    return 1;
+}
