+// wip/flash-next-prefill (session 4, the sizing audit): the largest host-weight SET a scheduler split
+// carries.  A split is a contiguous run of the graph on one backend, which on a host-expert MoE is one
+// layer's routed tables, so its set size is the per-layer SUM of the host-resident expert tables (per device
+// on a tensor split, exactly like `max_host_expert_slice_bytes`).  The transport buffer is sized to this set,
+// not to one table: measured on the 89k Flash-Next shape the largest table is 450 MiB while the largest set
+// is 1137.5 MiB (gate/up/down of the widest layer), and a region sized from the table alone under-carves by
+// 2.5x the real need.
+//
+// `--fit` and the slab's transport region both read this (llama-context.cpp's ring auto-size), so the three
+// numbers that used to disagree -- the fit's `h2d_stage_bound`, the context's knee cap and the buffers' own
+// `pp_size` -- have one source.
+size_t llama_model::max_host_expert_layer_bytes() const {
+    const size_t n_devs = get_split_state_ud.n_devices;
+    const bool   split  = n_devs > 1 && n_devs <= GGML_BACKEND_META_MAX_DEVICES && get_split_state_ud.model != nullptr;
+    // key: (layer, device); value: the layer's host expert bytes on that device.  A layer with no host
+    // tables is absent (it is resident), which is what we want -- only a staged set costs a buffer.
+    std::map<std::pair<int, size_t>, size_t> by_layer_dev;
+    for (const auto & [ctx, bufs] : pimpl->ctxs_bufs) {
+        ggml_context * c = ctx.get();
+        for (ggml_tensor * t = ggml_get_first_tensor(c); t != nullptr; t = ggml_get_next_tensor(c, t)) {
+            if (t->buffer == nullptr || !ggml_backend_buffer_is_host(t->buffer)) {
+                continue;
+            }
+            if (ggml_backend_buffer_get_usage(t->buffer) != GGML_BACKEND_BUFFER_USAGE_WEIGHTS) {
+                continue;
+            }
+            const std::string name = t->name;
+            if (name.find("exps") == std::string::npos) {
+                continue;
+            }
+            int layer = -1;
+            if (sscanf(name.c_str(), "blk.%d.", &layer) != 1 || layer < 0) {
+                continue;   // not a layer's expert table (a fused/merged host tensor): not a split set member
+            }
+            if (split) {
+                const ggml_backend_meta_split_state ss =
+                        llama_meta_device_get_split_state(t, const_cast<void *>(static_cast<const void *>(&get_split_state_ud)));
+                for (size_t d = 0; d < n_devs; d++) {
+                    const size_t b = ggml_backend_meta_split_dev_bytes(t, &ss, n_devs, d);
+                    if (b > 0) {
+                        by_layer_dev[{layer, d}] += b;
+                    }
+                }
+            } else {
+                by_layer_dev[{layer, 0}] += ggml_nbytes(t);
+            }
+        }
+    }
+    size_t max_set = 0;
+    for (const auto & kv : by_layer_dev) {
+        if (kv.second > max_set) {
+            max_set = kv.second;
+        }
+    }
+    return max_set;
+}
