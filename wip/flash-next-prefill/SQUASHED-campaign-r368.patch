+// Is this input one of the entries the CURRENT ping-pong buffer holds?  Returns the offset, or (size_t) -1.
+static size_t sched_pp_entry_off(ggml_backend_sched_t sched, const struct ggml_tensor * input_cpy) {
+    for (int k = 0; k < sched->pp_n_ent[sched->pp_cur]; k++) {
