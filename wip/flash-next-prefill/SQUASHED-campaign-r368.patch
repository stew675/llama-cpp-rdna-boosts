+bool moe_cache_residency(int device, int64_t * covered, int64_t * host) {
+    if (device < 0 || device >= GGML_CUDA_MAX_DEVICES) {
+        if (covered != nullptr) { *covered = 0; }
+        if (host != nullptr)    { *host    = 0; }
+        return false;
+    }
+    const int64_t cov = g_res_covered_mirror[device].load(std::memory_order_relaxed);
+    const int64_t all = g_res_host_mirror[device].load(std::memory_order_relaxed);
+    // Capacity, not current occupancy: the selector asks "could the device keep this set", which is what
+    // decides how many bytes come over the link in the steady state.  Lock-free -- see the mirrors' comment.
+    if (covered != nullptr) { *covered = cov; }
+    if (host != nullptr)    { *host    = all; }
+    return all > 0;
+}
