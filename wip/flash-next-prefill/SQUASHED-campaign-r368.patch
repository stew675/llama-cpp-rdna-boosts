+// The buffer COUNT.  wip/flash-next-prefill (session 5, the maintainer's change request): it is NOT chosen
+// from the device's free VRAM any more.  The buffers moved INSIDE the slab (the transport region is a carve in
+// the slab's work band, released at every prefill -> decode transition), so their real cost is the hot set they
+// take away from the DECODE arena -- and the free-VRAM figure at scheduler construction knows nothing about the
+// arena, which is sized later (`MoE expert cache (auto): arena ... residency`).  Three buffers are ~2 % faster
+// at prefill than two, but the third one's set hurts decode badly when the arena cannot hold a good working set.
+//
+// So: the number comes from the RESIDENCY RULE in the backend that owns the slab
+// (`ggml_cuda_moe_transport_decide`, run when the expert cache's arena settles), read through the existing
+// generic device hook (`slab_ring_slots`, which the CUDA backend answers with its own decided count) so this
+// layer keeps no copy of it -- the SAME number sizes the transport region and the Meta backend's ring depth.
+// This function only chooses the FALLBACK for a transport that is not slab-backed (plain `cudaMalloc` slots),
+// where the budget still is free VRAM at startup.  `GGML_SCHED_PINGPONG_BUFS=1|2|3` always wins (A/B and
+// bisection).
+static int sched_pp_free_vram_rule(ggml_backend_sched_t sched) {
+    size_t min_free = 0;    // the SMALLEST free figure: on a split each device owns its own buffers
+    for (int b = 0; b < sched->n_backends; b++) {
+        ggml_backend_dev_t dev = ggml_backend_get_device(sched->backends[b]);
+        if (dev == NULL) {
+            continue;
+        }
+        const enum ggml_backend_dev_type t = ggml_backend_dev_type(dev);
+        if (t != GGML_BACKEND_DEVICE_TYPE_GPU && t != GGML_BACKEND_DEVICE_TYPE_ACCEL) {
+            continue;
+        }
+        size_t fr = 0, tot = 0;
+        ggml_backend_dev_memory(dev, &fr, &tot);
+        if (fr != 0 && (min_free == 0 || fr < min_free)) {
+            min_free = fr;
+        }
+    }
+    const size_t GiB = (size_t) 1 << 30;
+    if (min_free == 0)               { return 3; }   // unknown device: the deepest stage
+    if (min_free <= 14 * GiB)        { return 1; }
+    if (min_free <= 24 * GiB)        { return 2; }
+    return 3;
+}
