@@ -608,6 +620,425 @@ static void devremap_free_locked(table_t & t) {
     t.dr_cap = 0; t.dr_device = -1; t.dr_lag_n = 0; t.dr_map_ok = false;
 }
 
+// ---- sparse registration of a pageable host master (--host-experts mmap) ---------------------------------------
+// RDNA has no XNACK, so a kernel cannot read a pageable host address (issue #116).  A pageable expert master is made
+// GPU-readable without pinning all of it: a second read-only MAP_SHARED mapping of the model file (the same page
+// cache, no extra RAM) is registered with hipHostRegister only where a GPU may read it - the experts not resident in
+// the arena of some table of that master - and a registered range is device-readable at its CPU address.
+// Invariant: every expert a GPU may read from the host (a cold read, or a fill from the alias) is registered when
+// the read is enqueued and stays registered until it has completed (the trim synchronizes every device first).
+
+// OS portability of the sparse registration: every mapping, locking and page-cache call goes through
+// these helpers.  On Windows `file_alias_locked` finds no alias, so no master is sparse (the cache declines a pageable
+// master) and none of them is reached; the stubs keep the build compiling.
+#if defined(_WIN32)
+typedef long long sreg_off_t;
+static size_t sreg_page() { return 4096; }
+static size_t sreg_phys_bytes() { return 0; }
+static void   sreg_willneed(uintptr_t a, size_t n) { (void) a; (void) n; }
+static void   sreg_populate_range(uintptr_t a, size_t n) { (void) a; (void) n; }
+static bool   sreg_mlock(const void * p, size_t n) { (void) p; (void) n; return false; }
+static void   sreg_munlock(const void * p, size_t n) { (void) p; (void) n; }
+static bool   sreg_map_fixed(uintptr_t a, size_t n, int fd, sreg_off_t off) { (void) a; (void) n; (void) fd; (void) off; return false; }
+static bool   sreg_resident(uintptr_t a, size_t n, unsigned char * vec) { (void) a; (void) n; (void) vec; return false; }
+#else
+typedef off_t sreg_off_t;
+static size_t sreg_page() {
+    static const size_t pg = (size_t) sysconf(_SC_PAGESIZE);
+    return pg;
+}
+static size_t sreg_phys_bytes() {
+    const long pages = sysconf(_SC_PHYS_PAGES);
+    return pages > 0 ? (size_t) pages * sreg_page() : 0;
+}
+static void sreg_willneed(uintptr_t a, size_t n) {
+    (void) madvise((void *) a, n, MADV_WILLNEED);
+}
+static void sreg_populate_range(uintptr_t a, size_t n) {
+#ifndef MADV_POPULATE_READ
+#define MADV_POPULATE_READ 22
+#endif
+    (void) madvise((void *) a, n, MADV_POPULATE_READ);
+}
+static bool sreg_mlock(const void * p, size_t n) {
+    return mlock(p, n) == 0;
+}
+static void sreg_munlock(const void * p, size_t n) {
+    (void) munlock(p, n);
+}
+// [a, a + n) of an alias replaced by a fresh read-only mapping of `fd` from `off`
+static bool sreg_map_fixed(uintptr_t a, size_t n, int fd, sreg_off_t off) {
+    return mmap((void *) a, n, PROT_READ, MAP_SHARED | MAP_FIXED, fd, off) != MAP_FAILED;
+}
+// every page of the page-aligned [a, a + n) is in the page cache (`vec`: n / page entries)
+static bool sreg_resident(uintptr_t a, size_t n, unsigned char * vec) {
+    if (mincore((void *) a, n, vec) != 0) {
+        return false;
+    }
+    for (size_t i = 0; i < n / sreg_page(); i++) {
+        if (!(vec[i] & 1)) {
+            return false;
+        }
+    }
+    return true;
+}
+#endif
+
+static std::map<uintptr_t, size_t> g_sreg;              // registered runs: page-aligned start -> bytes (disjoint)
+static size_t  g_sreg_bytes = 0;
+static size_t  g_sreg_peak  = 0;
+static int64_t g_sreg_fail  = 0;                         // hipHostRegister refusals
+static int64_t g_sreg_calls = 0;                         // successful hipHostRegister calls (runs created)
+static int64_t g_sreg_keep  = 0;                         // admissions skipped because a registration failed
+static int64_t g_sreg_stay  = 0;                         // admissions skipped because the victim left the page cache
+static int64_t g_sreg_nolock = 0;                        // registered runs that could not be mlocked (reclaimable)
+static int64_t g_stage_tables = 0;                       // prefill tables staged from the arena + registered alias
+static int64_t g_route_fills  = 0;                       // small-prefill routed fills from the arena + registered alias
+static int64_t g_sreg_remaps = 0;                        // unregistered runs remapped (drops the driver's SVM range)
+struct sreg_alias_t { uintptr_t lo, hi; int fd; sreg_off_t off; };
+static std::vector<sreg_alias_t> g_sreg_alias;           // every alias mapping: [lo, hi) maps `fd` from `off`
+
+// Replace [a, a + len) of an alias with a fresh mapping of the same file pages.  hipHostUnregister leaves KFD's SVM
+// range behind: when the kernel later reclaims one of its pages the driver re-faults the WHOLE range from disk
+// (svm_range_restore_work).  Unmapping the range removes it.
+static void sreg_remap(uintptr_t a, size_t len) {
+    static const bool off = getenv("GGML_MOE_SREG_NOREMAP") != nullptr && atoi(getenv("GGML_MOE_SREG_NOREMAP")) != 0;
+    if (off) {
+        return;
+    }
+    for (const sreg_alias_t & m : g_sreg_alias) {
+        if (a >= m.lo && a + len <= m.hi) {
+            if (sreg_map_fixed(a, len, m.fd, m.off + (sreg_off_t) (a - m.lo))) {
+                g_sreg_remaps++;
+            }
+            return;
+        }
+    }
+}
+static int64_t g_sreg_trims = 0;
+static std::atomic<bool> g_any_sparse{false};            // some table has a sparse (mmap) master
+static const size_t SREG_PAD = 8192;                     // > the MMQ K-tile over-read past an expert's last row
+
+// Register every page of [lo, hi) that is not registered yet (as new disjoint runs).  False on a refusal.
+static bool sreg_ensure(uintptr_t lo, uintptr_t hi) {
+    const size_t pg = sreg_page();
+    lo &= ~(uintptr_t) (pg - 1);
+    hi  = (hi + pg - 1) & ~(uintptr_t) (pg - 1);
+    uintptr_t cur = lo;
+    while (cur < hi) {
+        auto it = g_sreg.lower_bound(cur);
+        if (it != g_sreg.end() && it->first == cur) {
+            cur += it->second;
+            continue;
+        }
+        if (it != g_sreg.begin()) {
+            auto p = std::prev(it);
+            if (p->first + p->second > cur) {
+                cur = p->first + p->second;
+                continue;
+            }
+        }
+        const uintptr_t gap_end = (it == g_sreg.end()) ? hi : std::min<uintptr_t>(hi, it->first);
+        sreg_willneed(cur, gap_end - cur);   // large readahead instead of 4 KiB faults
+        // hipHostRegister does not pin (HMM mirror): without the lock the kernel reclaims these GPU-only-read pages
+        // first and the KFD restore worker re-reads them from disk with the queues stopped.
+        static const bool nolock = getenv("GGML_MOE_SREG_NOMLOCK") != nullptr && atoi(getenv("GGML_MOE_SREG_NOMLOCK")) != 0;
+        if (!nolock && !sreg_mlock((void *) cur, gap_end - cur) && g_sreg_nolock++ < 2) {
+            GGML_LOG_WARN("moe_cache sparse registration: mlock %p + %zu failed: %s (registered pages stay reclaimable)\n",
+                          (void *) cur, (size_t) (gap_end - cur), strerror(errno));
+        }
+        const cudaError_t err = cudaHostRegister((void *) cur, gap_end - cur, cudaHostRegisterPortable | cudaHostRegisterReadOnly);
+        if (err != cudaSuccess) {
+            (void) cudaGetLastError();
+            sreg_munlock((void *) cur, gap_end - cur);
+            if (g_sreg_fail++ < 2) {
+                GGML_LOG_WARN("moe_cache sparse registration: register %p + %zu failed: %s\n", (void *) cur,
+                              (size_t) (gap_end - cur), cudaGetErrorString(err));
+            }
+            return false;
+        }
+        g_sreg[cur]   = gap_end - cur;
+        g_sreg_bytes += gap_end - cur;
+        g_sreg_peak   = std::max(g_sreg_peak, g_sreg_bytes);
+        g_sreg_calls++;
+        cur = gap_end;
+    }
+    return true;
+}
+
+// The bytes of expert `e` THIS table (device) reads in place: its own slice when the slice is contiguous (an axis-1
+// split: gate/up under -sm tensor), else the whole expert (an axis-0 slice interleaves with the other device row by row).
+static void sparse_span(const table_t & t, int32_t e, uintptr_t & lo, uintptr_t & hi) {
+    const bool strided = t.split_axis == 0 && t.host_pitch != 0;
+    lo = (uintptr_t) t.host_dev + (uintptr_t) e * t.host_bytes + (strided ? 0 : (uintptr_t) t.src_off);
+    hi = lo + (strided ? t.host_bytes : t.expert_bytes);
+}
+
+// Make expert `e` of a sparse table device-readable.  False when it cannot be (the caller must not let a GPU read it).
+static bool sparse_need_locked(const table_t & t, int32_t e) {
+    if (!t.host_sparse || t.host_dev == nullptr) {
+        return true;
+    }
+    if (e < 0 || e >= t.n_experts) {
+        return false;
+    }
+    uintptr_t lo, hi;
+    sparse_span(t, e, lo, hi);
+    if (sreg_ensure(lo, hi + SREG_PAD)) {
+        return true;
+    }
+    return sreg_ensure(lo, hi);   // the pad may run past the mapping
+}
+
+// Read [lo, hi) of a pageable mapping into the page cache with several threads (one synchronous fault stream reads
+// the NVMe at a fraction of its bandwidth).
+static void sparse_populate(uintptr_t lo, uintptr_t hi) {
+    const size_t pg = sreg_page();
+    lo &= ~(uintptr_t) (pg - 1);
+    const int       n_thr = 8;
+    const uintptr_t step  = ((hi - lo) / n_thr + pg - 1) & ~(uintptr_t) (pg - 1);
+    std::vector<std::thread> thr;
+    for (int i = 0; i < n_thr; i++) {
+        const uintptr_t a = lo + (uintptr_t) i * step, b = std::min<uintptr_t>(hi, a + step);
+        if (a < b) {
+            thr.emplace_back([a, b] { sreg_populate_range(a, b - a); });
+        }
+    }
+    for (auto & th : thr) {
+        th.join();
+    }
+}
+
+// Copy this device's slice of expert `e` from the (populated) mapping to `dst` in the arena's compact layout.
+static void sparse_pack_expert(const table_t & t, int32_t e, char * dst) {
+    const char * src = (const char *) t.host_dev + (size_t) e * t.host_bytes + t.src_off;
+    if (t.split_axis == 0 && t.host_pitch != 0) {
+        const size_t rows = t.host_bytes / t.host_pitch, row_bytes = t.expert_bytes / rows;
+        for (size_t r = 0; r < rows; r++) {
+            memcpy(dst + r * row_bytes, src + r * t.host_pitch, row_bytes);
+        }
+    } else {
+        memcpy(dst, src, t.expert_bytes);
+    }
+}
+
+// Copy experts 0..k-1 of a sparse table into arena slots 0..k-1 through a pinned staging buffer: the master stays
+// unregistered (registering, then dropping, what the arena holds costs a register call per expert).
+static bool sparse_stage_fill_locked(const table_t & t, int k) {
+    static char *  stage     = nullptr;
+    static size_t  stage_cap = 0;
+    const bool     do2d = t.split_axis == 0 && t.host_pitch != 0;
+    const int64_t  rows = do2d ? (int64_t) (t.host_bytes / t.host_pitch) : 1;
+    if (rows <= 0 || t.expert_bytes % (size_t) rows != 0) {
+        return false;
+    }
+    const size_t need = std::max<size_t>(t.expert_bytes, 64u << 20);
+    if (stage_cap < need) {
+        if (stage != nullptr) {
+            (void) cudaFreeHost(stage);
+        }
+        stage = nullptr;
+        stage_cap = 0;
+        if (cudaMallocHost((void **) &stage, need) != cudaSuccess) {
+            (void) cudaGetLastError();
+            stage = nullptr;
+            return false;
+        }
+        stage_cap = need;
+    }
+    device_guard dg(t.device);
+    const int per = (int) (stage_cap / t.expert_bytes);
+    for (int e0 = 0; e0 < k; e0 += per) {
+        const int n = std::min(per, k - e0);
+        for (int j = 0; j < n; j++) {
+            sparse_pack_expert(t, e0 + j, stage + (size_t) j * t.expert_bytes);
+        }
+        if (cudaMemcpy((char *) t.arena + (size_t) e0 * t.expert_bytes, stage, (size_t) n * t.expert_bytes,
+                       cudaMemcpyHostToDevice) != cudaSuccess) {
+            (void) cudaGetLastError();
+            return false;
+        }
+    }
+    return true;
+}
+
+// Expert `e` of a sparse table is entirely in the page cache (so registering it reads nothing from disk).
+static bool sparse_in_ram_locked(const table_t & t, int32_t e) {
+    const size_t    pg = sreg_page();
+    uintptr_t lo, hi;
+    sparse_span(t, e, lo, hi);
+    lo &= ~(uintptr_t) (pg - 1);
+    hi  = (hi + pg - 1) & ~(uintptr_t) (pg - 1);
+    static std::vector<unsigned char> vec;
+    vec.resize((hi - lo) / pg);
+    return sreg_resident(lo, hi - lo, vec.data());
+}
+
+// Unregister every run no GPU read can reach: experts resident in every table of their master.  Synchronizes every
+// device first (a queued fill or cold read may still use a run).
+static void sparse_trim_locked(const char * why) {
+    bool any = false;
+    std::vector<std::pair<uintptr_t, uintptr_t>> need;
+    for (table_t & t : g_tables) {
+        if (!t.host_sparse || t.host_dev == nullptr) {
+            continue;
+        }
+        any = true;
+        if (!t.allocated || t.sparse_off || t.arena == nullptr || t.slots <= 0) {
+            continue;   // no arena: nothing reads this master in place (update_host / get_cold decline the table)
+        }
+        const uintptr_t base = (uintptr_t) t.host_dev;
+        if (t.expert_slot.empty()) {
+            need.emplace_back(base, base + (uintptr_t) t.n_experts * t.host_bytes + SREG_PAD);
+            continue;
+        }
+        std::vector<uint8_t> res((size_t) t.n_experts, 0);
+        for (const auto & kv : t.expert_slot) {
+            if (kv.first >= 0 && kv.first < t.n_experts) {
+                res[(size_t) kv.first] = 1;
+            }
+        }
+        for (int32_t e = 0; e < t.n_experts; e++) {
+            if (!res[(size_t) e]) {
+                uintptr_t lo, hi;
+                sparse_span(t, e, lo, hi);
+                need.emplace_back(lo, hi + SREG_PAD);
+            }
+        }
+    }
+    if (!any) {
+        return;
+    }
+    int n_dev = 0;
+    (void) cudaGetDeviceCount(&n_dev);
+    for (int d = 0; d < n_dev; d++) {
+        device_guard dg(d);
+        (void) cudaDeviceSynchronize();
+    }
+    const size_t pg = sreg_page();
+    for (auto & iv : need) {
+        iv.first  &= ~(uintptr_t) (pg - 1);
+        iv.second  = (iv.second + pg - 1) & ~(uintptr_t) (pg - 1);
+    }
+    std::sort(need.begin(), need.end());
+    std::vector<std::pair<uintptr_t, uintptr_t>> merged;
+    for (const auto & iv : need) {
+        if (!merged.empty() && iv.first <= merged.back().second) {
+            merged.back().second = std::max(merged.back().second, iv.second);
+        } else {
+            merged.push_back(iv);
+        }
+    }
+    const size_t before = g_sreg_bytes;
+    size_t k = 0;
+    for (auto it = g_sreg.begin(); it != g_sreg.end();) {
+        const uintptr_t a = it->first, b = it->first + it->second;
+        while (k < merged.size() && merged[k].second <= a) {
+            k++;
+        }
+        const bool needed = k < merged.size() && merged[k].first < b;
+        if (!needed) {
+            (void) cudaHostUnregister((void *) a);
+            (void) cudaGetLastError();
+            sreg_munlock((void *) a, it->second);
+            sreg_remap(a, it->second);
+            g_sreg_bytes -= it->second;
+            it = g_sreg.erase(it);
+        } else {
+            ++it;
+        }
+    }
+    g_sreg_trims++;
+    int64_t n_res = 0, n_all = 0;
+    for (const table_t & t : g_tables) {
+        n_res += (int64_t) t.expert_slot.size();
+        n_all += t.n_experts;
+    }
+    if (strcmp(why, "periodic") != 0 || before != g_sreg_bytes) {
