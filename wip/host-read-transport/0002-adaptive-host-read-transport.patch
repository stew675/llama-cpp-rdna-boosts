 ggml/src/ggml-cuda/moe-expert-cache.cu | 413 ++++++++++++++++++++++++-
 include/llama.h                        |   5 +
 src/llama-model-loader.cpp             |  35 ++-
 src/llama.cpp                          |   3 +
 tools/llama-bench/llama-bench.cpp      |   4 +-
 6 files changed, 450 insertions(+), 15 deletions(-)

