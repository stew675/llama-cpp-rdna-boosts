@@ -405,6 +405,39 @@ bool    g_pool_prewarm     = true;   // MOE_HOST_POOL_PREWARM: fill every pool s
 // unless asked (`file` is a candidate default for the promotion, not this instrument).
 bool    g_pool_fill_src_file   = false;  // MOE_HOST_POOL_FILL_SRC=file:   the pool FILL reads the file
 bool    g_pool_demand_src_file = false;  // MOE_HOST_POOL_DEMAND_SRC=file: the bounce/demand read does
+// wip/host-read-transport DESIGN.md: the ADAPTIVE host-read transport.  `MOE_HOST_POOL_TRANSPORT` (or the
+// loader's `--load-mode`, see `moe_cache_set_host_fill_mode`) owns the decision when set; UNSET leaves the
+// delivered `pool_decide_dio_locked` heuristic untouched.
+//
+// The three arms read the SAME page-cache pages into the same buffer, so a transport change can only change
+// TIMING -- proven: greedy text `de81b28cab7d` is byte-identical in all four arm combinations.
+enum { POOL_TR_MAP = 0, POOL_TR_FILE = 1, POOL_TR_DIO = 2, POOL_TR_N = 3 };
+static int     g_pool_tr_mode     = -1;    // -1 unset, 0|1|2 = PINNED arm, 3 = auto (optimistic start + monitor)
+static int     g_pool_transport   = POOL_TR_MAP;
+static bool    g_pool_tr_applied  = false;
+static bool    g_pool_tr_env_set  = false;  // MOE_HOST_POOL_TRANSPORT / _DIO pinned it: the loader cannot override
+static int     g_pool_tr_switches = 0;
+// STALL detection: purely relative -- a read that took K times this arm's own recent mean, N times running.
+// No latency in ms and no rate in MiB/s, because both are box-specific guesses.
+static double  g_pool_tr_stall_k  = 4.0;   // MOE_HOST_POOL_TR_STALL_K  (x this arm's own mean)
+static int     g_pool_tr_stall_n  = 4;     // MOE_HOST_POOL_TR_STALL_N  (consecutive, then switch)
+static double  g_pool_tr_ewma_us  = 0.0;   // this arm's mean per-read latency
+static int64_t g_pool_tr_reads    = 0;     // reads observed on this arm
+static int     g_pool_tr_stalls   = 0;
+// THE PROBE-FILL A/B (maintainer decision 2026-11-11: "detect stalls", no hard-coded MiB/s anywhere).  Every
+// Nth fill is served by the NEXT arm instead of the current one.  Same bytes, so the pool content is identical
+// either way and the sample costs NO extra I/O -- it IS a fill that had to happen.  That makes it an exact A/B
+// (two latencies, same bytes, same box, same moment, same cache state) with no ahead-of-time prediction, which
+// is impossible in-process: fadvise skips pages the process has mapped and madvise keeps the page cache.
+// `MOE_HOST_POOL_TR_PROBE_N` consecutive wins by `MOE_HOST_POOL_TR_PROBE_GAIN` latch the ladder one step, for
+// good: a box that fell short once is likely to again, and the page cache a reverse switch would rebuild may be
+// the very thing causing the shortfall.  One-way is the DECISION, not an omission.
+static int64_t g_pool_tr_probe_every  = 128;   // MOE_HOST_POOL_TR_PROBE_FILLS (0 = off)
+static double  g_pool_tr_probe_gain   = 1.5;   // MOE_HOST_POOL_TR_PROBE_GAIN  (the other arm must be X faster)
+static int     g_pool_tr_probe_n      = 3;     // MOE_HOST_POOL_TR_PROBE_N     (consecutive wins to latch)
+static int     g_pool_tr_probe_wins   = 0;
+static int64_t g_pool_tr_bounce_reads = 0;     // the demand path's own probe cadence
+
 // TODO #87 (1): `MOE_HOST_POOL_DIO` is AUTO by default -- decided once, at the first pool build, from
 // MemAvailable vs the host expert set (the same measurement `MOE_HOST_POOL_RAM_PCT` takes).  Buffered fills
 // (DIO=0) let the page cache act as an L3, which is worth +90 % decode / +155 % prefill when the set fits;
@@ -1153,6 +1186,44 @@ void parse_env() {
         const char * ds = getenv("MOE_HOST_POOL_DEMAND_SRC");
         g_pool_fill_src_file   = fs != nullptr && strcmp(fs, "file") == 0;
         g_pool_demand_src_file = ds != nullptr && strcmp(ds, "file") == 0;
+        // wip/host-read-transport: the adaptive transport.  A numeric env keeps every existing recipe valid
+        // (`MOE_HOST_POOL_DIO=0|1` is still honoured by the delivered logic when TRANSPORT is unset).
+        const char * tr = getenv("MOE_HOST_POOL_TRANSPORT");
+        if (getenv("MOE_HOST_POOL_DIO") != nullptr) {
+            g_pool_tr_env_set = true;   // the legacy knob is an explicit override too
+        }
+        if (tr != nullptr) {
+            g_pool_tr_env_set = true;
+            if      (strcmp(tr, "auto") == 0) g_pool_tr_mode = 3;
+            else if (strcmp(tr, "map")  == 0) g_pool_tr_mode = POOL_TR_MAP;
+            else if (strcmp(tr, "file") == 0) g_pool_tr_mode = POOL_TR_FILE;
+            else if (strcmp(tr, "dio")  == 0) g_pool_tr_mode = POOL_TR_DIO;
+            else {
+                GGML_LOG_WARN("%s: MOE_HOST_POOL_TRANSPORT=%s is not one of auto|map|file|dio; ignoring\n",
+                              __func__, tr);
+                g_pool_tr_mode = -1;
+            }
+        }
+        g_pool_tr_stall_k = (double) env_int("MOE_HOST_POOL_TR_STALL_K", 400) / 100.0;
+        if (g_pool_tr_stall_k < 1.5) {
+            g_pool_tr_stall_k = 1.5;
+        }
+        g_pool_tr_stall_n = env_int("MOE_HOST_POOL_TR_STALL_N", 4);
+        if (g_pool_tr_stall_n < 1) {
+            g_pool_tr_stall_n = 1;
+        }
+        g_pool_tr_probe_every = env_int("MOE_HOST_POOL_TR_PROBE_FILLS", 128);
+        if (g_pool_tr_probe_every < 0) {
+            g_pool_tr_probe_every = 0;
+        }
+        g_pool_tr_probe_gain = (double) env_int("MOE_HOST_POOL_TR_PROBE_GAIN", 150) / 100.0;
+        if (g_pool_tr_probe_gain < 1.1) {
+            g_pool_tr_probe_gain = 1.1;
+        }
+        g_pool_tr_probe_n = env_int("MOE_HOST_POOL_TR_PROBE_N", 3);
+        if (g_pool_tr_probe_n < 1) {
+            g_pool_tr_probe_n = 1;
+        }
     }
     // TODO #87 (1): AUTO by default (see `g_pool_dio_req`).  An explicit `MOE_HOST_POOL_DIO=0|1` wins and is
     // decided here, so an A/B never depends on the machine.
@@ -1643,7 +1714,57 @@ static int64_t pool_available_ram_bytes() {
         }
     }
     fclose(f);
-    return kb > 0 ? kb * 1024 : -1;
+    int64_t avail = kb > 0 ? kb * 1024 : -1;
+    // wip/host-read-transport (TODO #306 option 3): `MemAvailable` is HOST-WIDE, so inside a memory cgroup
+    // (container, systemd scope) the fit test asks about RAM this process may not use -- it answers "the set
+    // fits", the run lives in the mapping arm, and the mapping collapses (measured: 898 MiB/s of mapping
+    // fills in a 32G scope whose host reported ~57 GiB available).  Take the smaller of the two.
+    {
+        // The process's OWN cgroup, not the root: `/sys/fs/cgroup/memory.max` is the host's limit ("max"),
+        // and reading it is what made the first version of this report "the set fits" inside a 32G scope.
+        char path[512] = "";
+        FILE * cg = fopen("/proc/self/cgroup", "r");
+        if (cg != nullptr) {
+            char line[512];
+            while (fgets(line, sizeof(line), cg) != nullptr) {
+                if (strncmp(line, "0::", 3) == 0) {              // cgroup v2: "0::<path>"
+                    char * nl = strchr(line, '\n');
+                    if (nl != nullptr) {
+                        *nl = '\0';
+                    }
+                    snprintf(path, sizeof(path), "/sys/fs/cgroup%s", line + 3);
+                    break;
+                }
+            }
+            fclose(cg);
+        }
+        char fmax[600], fcur[600];
+        snprintf(fmax, sizeof(fmax), "%s/memory.max", path[0] != '\0' ? path : "/sys/fs/cgroup");
+        snprintf(fcur, sizeof(fcur), "%s/memory.current", path[0] != '\0' ? path : "/sys/fs/cgroup");
+        char line[256];
+        int64_t lim = -1, cur = -1;
+        FILE * g = fopen(fmax, "r");       // cgroup v2
+        if (g != nullptr) {
+            if (fgets(line, sizeof(line), g) != nullptr && strncmp(line, "max", 3) != 0) {
+                lim = atoll(line);
+            }
+            fclose(g);
+        }
+        g = fopen(fcur, "r");
+        if (g != nullptr) {
+            if (fgets(line, sizeof(line), g) != nullptr) {
+                cur = atoll(line);
+            }
+            fclose(g);
+        }
+        if (lim > 0 && cur >= 0) {
+            const int64_t room = lim - cur;
+            if (room > 0 && (avail < 0 || room < avail)) {
+                avail = room;
+            }
+        }
+    }
+    return avail;
 #elif defined(GGML_USE_HIP) && defined(_WIN32)
     return ggml_hip_win_available_ram_bytes();
 #else
@@ -1912,6 +2033,207 @@ static void pool_decide_dio_locked(int64_t host_total, int64_t planned_pool) {
                   g_pool_dio ? "the set does not fit beside the pool" : "the set fits beside the pool");
 }
 
+// ---------------------------------------------------------------------------------------------------------
+// wip/host-read-transport: the ADAPTIVE transport (see `wip/host-read-transport/DESIGN.md`).  Caller holds
+// `g_mutex` for every function here.
+
+static const char * pool_transport_name(int a) {
+    return a == POOL_TR_FILE ? "file" : (a == POOL_TR_DIO ? "dio" : "map");
+}
+
+// A transport switch MUST close every open file handle: the O_DIRECT bit lives in the OPEN FLAGS
+// (`pool_open_file(path, dio)`), so a cached fd keeps serving the old transport.  Caller holds `g_mutex`.
+static void pool_transport_reopen_locked() {
+    for (auto & kv : g_host_pools) {
+        if (kv.second.fd >= 0) {
+            pool_close_file(kv.second.fd);
+            kv.second.fd = -1;
+        }
+    }
+    for (table_t & t : g_tables) {
+        if (t.src_fd >= 0) {
+            pool_close_file(t.src_fd);
+            t.src_fd = -1;
+        }
+    }
+}
+
+static void pool_transport_apply_locked(int next, const char * why) {
+    if (next < 0 || next >= POOL_TR_N) {
+        return;
+    }
+    const int prev = g_pool_transport;
+    if (g_pool_tr_applied && next == prev) {
+        return;
+    }
+    g_pool_tr_applied = true;
+    pool_transport_reopen_locked();
+    g_pool_transport        = next;
+    g_pool_dio              = next == POOL_TR_DIO;
+    g_pool_fill_src_file    = next >= POOL_TR_FILE;
+    g_pool_demand_src_file  = next >= POOL_TR_FILE;
+    g_pool_tr_stalls        = 0;
+    g_pool_tr_probe_wins    = 0;
+    g_pool_tr_ewma_us       = 0.0;
+    g_pool_tr_reads         = 0;
+    if (next != prev) {
+        g_pool_tr_switches++;
+    }
+    GGML_LOG_INFO("%s: host read transport -> %s (%s)\n", __func__, pool_transport_name(next), why);
+}
+
+// Decide the transport ONCE, at the first pool build.  The capacity question is the only one that decides
+// MAP-vs-disk, and it is a CAPACITY question -- a rate cannot answer it (the mapping's advantage is the WARM
+// case, 17 GiB/s, which no in-process probe can see: `posix_fadvise` skips mapped pages and
+// `madvise(MADV_DONTNEED)` drops the PTEs but not the page cache, both measured).  So:
+//   * the set fits the cache (cgroup-aware `pool_available_ram_bytes`)  -> MAP   (the fast arm, warm)
+//   * it does not                                                       -> FILE  (the general-purpose baseline;
+//                                                                                  the monitor may escalate to DIO)
+// A wrong prior is corrected by the runtime monitor, in one direction (see `pool_transport_observe_locked`).
+static void pool_transport_init_locked(const table_t & t, int64_t planned_pool) {
+    (void) t;
+    if (g_pool_tr_applied || g_pool_tr_mode < 0) {
+        return;
+    }
+    if (g_pool_tr_mode < 3) {
+        // a PIN: no monitoring (an A/B arm must be the arm it names)
+        g_pool_transport = -1;
+        pool_transport_apply_locked(g_pool_tr_mode,
+            g_pool_tr_env_set ? "pinned by MOE_HOST_POOL_TRANSPORT / MOE_HOST_POOL_DIO"
+                              : "pinned by --load-mode");
+        return;
+    }
+    // CAMPAIGN INSTRUMENT: start on a named arm (the only way to exercise escalation on demand).
+    {
+        const char * st = getenv("MOE_HOST_POOL_TR_START");
+        if (st != nullptr) {
+            int forced = -1;
+            if      (strcmp(st, "map")  == 0) forced = POOL_TR_MAP;
+            else if (strcmp(st, "file") == 0) forced = POOL_TR_FILE;
+            else if (strcmp(st, "dio")  == 0) forced = POOL_TR_DIO;
+            if (forced >= 0) {
+                g_pool_transport = -1;
+                pool_transport_apply_locked(forced, "MOE_HOST_POOL_TR_START (campaign instrument)");
+                return;
+            }
+        }
+    }
+    // OPTIMISTIC START (maintainer decision, 2026-11-11): always begin on the mapping arm and let the
+    // fall-down handle it.  The mapping is the fastest arm whenever the page cache holds the set (17 GiB/s
+    // random warm against 7 for a buffered read), it is what every delivered run uses today, and being wrong
+    // about it costs one epoch of evidence (64 MiB of reads) before the monitor moves.  So NO capacity prior
+    // selects the arm: the cgroup-aware `pool_available_ram_bytes()` stays as the root-cause fix for the other
+    // users of that number (the pinned-pool RAM ceiling), not as a transport selector.
+    (void) planned_pool;
+    g_pool_transport = -1;
+    pool_transport_apply_locked(POOL_TR_MAP, "optimistic start (the mapping is the fast arm when cached)");
+}
+
+// The next arm in the ladder (map -> file -> dio) that this platform can serve (-1 = none).  Caller holds
+// `g_mutex`.
+static int pool_transport_next_arm_locked() {
+    for (int a = g_pool_transport + 1; a < POOL_TR_N; a++) {
+        if (a == POOL_TR_MAP || pool_file_io_available()) {
+            return a;
+        }
+    }
+    return -1;
+}
+
+// Move ONE step down the ladder (map -> file -> dio) and stay there.  One way is the DECISION: a box that
+// fell short once is likely to again, and the page cache a reverse switch would rebuild may itself be what
+// caused the shortfall, so a slower consistent point beats a flapping optimum.  Caller holds `g_mutex`.
+static void pool_transport_escalate_locked(const char * why) {
+    const int next = pool_transport_next_arm_locked();
+    g_pool_tr_stalls = 0;
+    if (next >= 0) {
+        pool_transport_apply_locked(next, why);
+    }
+}
+
+// Read `len` bytes through `arm` into `dst`, timed.  `map_src` is the exact address to memcpy from (the mapping
+// arm needs it; a file arm uses `file_off`).  Shared by the probe-fill A/B.  Caller holds `g_mutex`.
+static bool pool_read_via_arm_locked(const char * path, size_t file_off, const char * map_src, size_t len,
+                                     char * dst, int arm, int64_t * us_out) {
+    if (us_out != nullptr) {
+        *us_out = 0;
+    }
+    if (len == 0 || dst == nullptr) {
+        return false;
+    }
+    if (arm == POOL_TR_MAP) {
+        if (map_src == nullptr) {
+            return false;
+        }
+        const int64_t t0 = ggml_time_us();
+        memcpy(dst, map_src, len);
+        if (us_out != nullptr) {
+            *us_out = ggml_time_us() - t0;
+        }
+        return true;
+    }
+    if (path == nullptr || path[0] == '\0' || !pool_file_io_available()) {
+        return false;
+    }
+    pool_fd_t fd = pool_open_file(path, arm == POOL_TR_DIO);
+    if (fd < 0) {
+        return false;
+    }
+    size_t align = 4096;
+    pool_fd_align(fd, &align);
+    const int64_t t0 = ggml_time_us();
+    const bool ok = arm == POOL_TR_DIO
+                      ? pool_dio_read(fd, dst, len, file_off, align)
+                      : pool_pread(fd, dst, len, file_off) == (pool_ssize_t) len;
+    if (us_out != nullptr) {
+        *us_out = ggml_time_us() - t0;
+    }
+    pool_close_file(fd);
+    return ok;
+}
+
+// One probe sample: the other arm served the same-sized read.  Latch the ladder when it wins by `gain` x,
+// `N` samples running, against what the CURRENT arm's reads have been taking.
+static void pool_transport_probe_compare_locked(int64_t probe_us, int64_t cur_us) {
+    if (probe_us <= 0 || cur_us <= 0) {
+        return;
+    }
+    if ((double) probe_us * g_pool_tr_probe_gain < (double) cur_us) {
+        if (++g_pool_tr_probe_wins >= g_pool_tr_probe_n) {
+            const int next = pool_transport_next_arm_locked();
+            char why[192];
+            snprintf(why, sizeof(why), "probe fill: %s served the same read in %lld us against this arm's "
+                     "%lld us, %d samples running", next >= 0 ? pool_transport_name(next) : "?",
+                     (long long) probe_us, (long long) cur_us, g_pool_tr_probe_wins);
+            pool_transport_escalate_locked(why);
+        }
+    } else {
+        g_pool_tr_probe_wins = 0;
+    }
+}
+
+// Observe ONE read (bytes, wall time) and escalate on a STALL.  Called from the fill and the bounce path.
+static void pool_transport_observe_locked(int64_t bytes, int64_t us) {
+    if (g_pool_tr_mode != 3 || g_pool_transport >= POOL_TR_DIO || bytes <= 0 || us < 0) {
+        return;
+    }
+    g_pool_tr_reads++;
+    if (g_pool_tr_reads > 32 && g_pool_tr_ewma_us > 0.0) {
+        if ((double) us > g_pool_tr_stall_k * g_pool_tr_ewma_us) {
+            if (++g_pool_tr_stalls >= g_pool_tr_stall_n) {
+                char why[160];
+                snprintf(why, sizeof(why), "stall: %d consecutive reads over %.1fx this arm's own %.0f us",
+                         g_pool_tr_stalls, g_pool_tr_stall_k, g_pool_tr_ewma_us);
+                pool_transport_escalate_locked(why);
+                return;
+            }
+        } else {
+            g_pool_tr_stalls = 0;
+        }
+    }
