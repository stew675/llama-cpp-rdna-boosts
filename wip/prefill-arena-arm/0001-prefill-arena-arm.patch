+                    if (!warned) {
+                        warned = true;
+                        GGML_LOG_WARN("%s: arming the arena on a %lld-token pass (no narrow warmup has "
+                                      "primed the sizing): the wide prefill work layout is live, so the "
+                                      "arena sizes below its steady-state capacity.  Harmless for a "
+                                      "prefill-only workload; a server should warm up first.\n",
