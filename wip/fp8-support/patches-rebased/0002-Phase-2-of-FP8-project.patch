+    // normal: E in 1..14, round mantissa to 3 bits (RNE)
+    uint32_t man_3 = man >> 20;
+    const uint32_t frac = man & 0xFFFFF;
+    if (frac > 0x80000 || (frac == 0x80000 && (man_3 & 1))) {
