+            M = (uint32_t)(val >> shift);
+            const uint64_t frac = val & ((1ull << shift) - 1);
+            const uint64_t half = 1ull << (shift - 1);
+            if (frac > half || (frac == half && (M & 1))) {
+                M++;
+            }
+        }
+        if (M >= 8) {
+            return (uint8_t)((sign << 7) | 0x08); // smallest normal (E=1, M=0)
+        }
+        return (uint8_t)((sign << 7) | M);
+    }
