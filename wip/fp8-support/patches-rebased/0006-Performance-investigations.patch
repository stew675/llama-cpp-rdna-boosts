+            const fp8x8_t b1_n = kk < 7 ? *reinterpret_cast<const fp8x8_t *>(&sB[t0 + TILE_N + row_lane][kk_next + k_half]) : b1;
+            t00 = __builtin_amdgcn_wmma_f32_16x16x16_fp8_fp8_w32_gfx12(a0, b0, t00);
