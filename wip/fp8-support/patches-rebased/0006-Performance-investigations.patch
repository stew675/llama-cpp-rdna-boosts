-            acc_cb = __builtin_amdgcn_wmma_f32_16x16x16_fp8_fp8_w32_gfx12(a_frag, b_frag, acc_cb);
+            const int kk_next = (kk + 1) * 16;
+            const fp8x8_t a0_n = kk < 7 ? *reinterpret_cast<const fp8x8_t *>(&sA[rm + row_lane][4 + kk_next + k_half]) : a0;
