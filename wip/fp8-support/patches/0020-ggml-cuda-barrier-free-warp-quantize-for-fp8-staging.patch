index 6cd8790c2..ca47c02eb 100644
--- a/ggml/src/ggml-cuda/fp8.cuh
+++ b/ggml/src/ggml-cuda/fp8.cuh
@@ -145,6 +145,67 @@ __global__ void quantize_fp8(
     y_q[(int64_t) token * k + col0 + tid] = fp8_e4m3_from_f32(v * red[1]);
