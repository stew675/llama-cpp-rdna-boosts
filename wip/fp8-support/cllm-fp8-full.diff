+    ggml_cuda_pool_alloc<float>   src1_s(ctx.pool(), n_pad * n_col_blocks);
+    uint8_t * src1_q_d = src1_q.get();
+    float   * src1_s_d = src1_s.get();
+    GGML_ASSERT(src1_q_d != nullptr);
+    GGML_ASSERT(src1_s_d != nullptr);
