From 4d61b67f1057c915f641b33929804657f3cc898d Mon Sep 17 00:00:00 2001
From: briansp2020 <bsp2020@gmail.com>
Date: Fri, 9 Oct 2026 19:39:03 +0000
Subject: [PATCH 1/2] allreduce-hip: fewer blocks for small (decode / verify)
 messages

A decode or verify all-reduce is ~10-40 KB (n_embd x a few tokens) and latency-bound, and each of the 8 blocks
signals and polls its own arrival slot, so the call waits for the slowest of them.  Messages up to
GGML_CUDA_AR_SMALL_BYTES (default 64 KiB) now launch GGML_CUDA_AR_SMALL_BLOCKS blocks (default 4); larger
messages and the fused stage (which pre-writes every block's arrival slot) keep 8.  Data striping already uses
gridDim.x and the arrival layout keeps room for 8 blocks, so only the launch changes.  Bit-identical.

2 x R9700, Flash-Next -sm tensor: one-token decode 8 -> 2 blocks 14.56 -> 14.19 ms/token; with MTP n-max 3
(verify batches) 4 blocks measured best, ~+0.9 % greedy t/s.  GGML_CUDA_AR_SMALL_BLOCKS=8 restores the old launch.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ggml/src/ggml-cuda/allreduce-hip.cu | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/ggml/src/ggml-cuda/allreduce-hip.cu b/ggml/src/ggml-cuda/allreduce-hip.cu
index 0cd74df41..d41a184f6 100644
--- a/ggml/src/ggml-cuda/allreduce-hip.cu
+++ b/ggml/src/ggml-cuda/allreduce-hip.cu
@@ -546,6 +546,11 @@ struct ggml_cuda_ar_pipeline {
     // printed at pipeline teardown.  Zero cost when disabled (two pointer
     // checks per call).  Not for integration.
     bool                     prof_enabled;
+    // Small-message block count: a decode / verify AR is latency-bound (~10-40 KB), and every block signals and
+    // polls its own arrival slot, so the call waits for the slowest of them.  Fewer blocks there cut the per-call
+    // latency (8 -> 2 blocks: ~3.7 us per AR on 2 x R9700 at one token; with MTP verify batches 4 blocks measured best).  Larger messages keep the full grid for bandwidth.
+    int                      small_blocks;
+    size_t                   small_bytes;
     hipEvent_t               prof_t0[GGML_CUDA_AR_PROF_MAX];
     hipEvent_t               prof_t1[GGML_CUDA_AR_PROF_MAX];
     int64_t                  prof_ne[GGML_CUDA_AR_PROF_MAX];
@@ -807,6 +812,8 @@ ggml_cuda_ar_pipeline * ggml_cuda_ar_pipeline_init(const int * devices, size_t n
         p->devices[i] = devices[i];
     }
     p->prof_enabled     = ggml_cuda_ar_env_u64("GGML_CUDA_AR_PROFILE", 0) != 0;
+    p->small_blocks     = (int) std::min<uint64_t>(std::max<uint64_t>(ggml_cuda_ar_env_u64("GGML_CUDA_AR_SMALL_BLOCKS", 4), 1), GGML_CUDA_AR_KERNEL_BLOCKS);
+    p->small_bytes      = (size_t) ggml_cuda_ar_env_u64("GGML_CUDA_AR_SMALL_BYTES", 64 * 1024);
     if (p->prof_enabled) {
         GGML_LOG_WARN("%s: per-call profiling enabled (GGML_CUDA_AR_PROFILE=1); "
                       "this is WIP tuning instrumentation\n", __func__);
@@ -1524,8 +1531,10 @@ bool ggml_cuda_ar_allreduce(
                     CUDA_CHECK(hipMemsetAsync(data, 0, chunk_dst_bytes, stream));
                 }
 
+// the fused stage pre-writes every block's arrival slot, so it keeps the full grid
+                const int ar_blocks = (!p->fused && chunk_dst_bytes <= p->small_bytes) ? p->small_blocks : GGML_CUDA_AR_KERNEL_BLOCKS;
 #define LAUNCH_AR_KERNEL(T_dst, T_wire) \
-                ggml_cuda_ar_kernel<T_dst, T_wire><<<dim3(GGML_CUDA_AR_KERNEL_BLOCKS), dim3(256), 0, stream>>>( \
+                ggml_cuda_ar_kernel<T_dst, T_wire><<<dim3(ar_blocks), dim3(256), 0, stream>>>( \
                     reinterpret_cast<const T_dst *>(data), \
                     reinterpret_cast<T_dst *>(data), \
                     reinterpret_cast<T_wire *>(p->host_wire.dev), \
-- 
