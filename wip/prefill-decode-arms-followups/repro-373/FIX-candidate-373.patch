     return t;
 }
 
+//
+// crash #373: the VMM POOL's peer-access grants, and the query the cross-device copy paths use.
+//
+// A pool mapping is granted READWRITE to its own device and, BEST EFFORT, to every peer -- the same rule the
+// movable-boundary slab already follows (`ggml_cuda_vmm_map_phys` in ggml-cuda-slab.cu), and for the same measured
+// reason: on a box whose MoE arena has taken nearly all VRAM the driver can refuse to build a peer mapping, and
+// `cuMemSetAccess` then returns `invalid argument`.  The slab learned this the hard way -- granting every descriptor
+// in ONE call meant a single refused peer poisoned the whole grant -- so the rule there is: grant the owner alone,
+// then each peer on its own, keep the mask of what was actually granted, and let the copy path STAGE the pairs the
+// driver refused.  The pool did not do any of that: it granted all descriptors in one call and wrapped it in a
+// CU_CHECK, so a refused grant ABORTED the process.  It was invisible while one context existed (its pools are
+// created and grown during load and the first reserve, before the arena fills); the two-arm server (block 17) adds a
+// SECOND context whose pools grow at request time, when the arena is full -- measured: `HipVMM Failure: invalid
+// argument` in `alloc()` from `mul_mat_q`, ~2 s into the first request, and only with the arena on
+// (`MOE_EXPERT_CACHE_MIB=0` clean) and only with the pair (pair OFF clean).
+//
+// The registry below lets `ggml_cuda_peer_copy_ok()` answer for pool destinations exactly as it does for slabs.
+struct ggml_cuda_pool_peer_range {
+    const void * pool;
+    uintptr_t    base;
+    size_t       size;
+    uint32_t     mask;   // physical devices that hold READWRITE on this range
+};
+
+static std::mutex                            g_pool_peer_mutex;
+static std::vector<ggml_cuda_pool_peer_range> g_pool_peer_ranges;
+
+// Register (or update) one pool's range and grant mask.  `mask` is the intersection of every grant the pool has
+// ever made, so it is pessimistic on purpose: a wrong "yes" faults the GPU, which nothing can catch.
+static void ggml_cuda_pool_peer_register(const void * pool, uintptr_t base, size_t size, uint32_t mask) {
+    std::lock_guard<std::mutex> lock(g_pool_peer_mutex);
+    for (auto & r : g_pool_peer_ranges) {
+        if (r.pool == pool) {
+            r.base = base;
+            r.size = size;
+            r.mask = mask;
+            return;
+        }
+    }
+    g_pool_peer_ranges.push_back({ pool, base, size, mask });
+}
+
+static void ggml_cuda_pool_peer_unregister(const void * pool) {
+    std::lock_guard<std::mutex> lock(g_pool_peer_mutex);
+    for (size_t i = 0; i < g_pool_peer_ranges.size(); i++) {
+        if (g_pool_peer_ranges[i].pool == pool) {
+            g_pool_peer_ranges.erase(g_pool_peer_ranges.begin() + (ptrdiff_t) i);
+            return;
+        }
+    }
+}
+
+// Pool destinations: process-wide and pessimistic, like the slab's answer -- a peer copy fails while ANY live
+// range's grants are incomplete, so every live pool's mask is intersected.
+bool ggml_cuda_pool_peer_copy_ok(const void * dst, size_t nbytes) {
+    if (dst == nullptr || nbytes == 0) {
+        return true;
+    }
+    std::lock_guard<std::mutex> lock(g_pool_peer_mutex);
+    uint32_t pending = 0;
+    uint32_t common  = ~0u;
+    bool     in_pool = false;
+    const uintptr_t lo = (uintptr_t) dst;
+    const uintptr_t hi = lo + nbytes - 1;
+    for (const auto & r : g_pool_peer_ranges) {
+        if (r.base == 0 || r.size == 0) {
+            continue;
+        }
+        pending |= r.mask;
+        common  &= r.mask;
+        if (hi >= r.base && lo <= r.base + r.size - 1) {
+            in_pool = true;
+        }
+    }
+    if (!in_pool) {
+        // outside every pool: nothing here can fault, the slab (or the driver) decides
+        return true;
+    }
+    return (common & pending) == pending;
+}
