-
     bool res = llama_memory_hybrid_context::apply();
 
-    // TEMP DEBUG: the attention child has read its n_kv by now; widen the suspect window if asked
-    const uint32_t dbg_nkv_attn = get_attn() ? get_attn()->get_n_kv() : 0;
-    if (dbg_widen_us > 0) {
-        usleep(dbg_widen_us);
-    }
-
     if (ctx_idx) {
         res = res & ctx_idx->apply();
-
-        // TEMP DEBUG (crash #373)
-        const llama_kv_cache_context * dbg_idx = static_cast<const llama_kv_cache_context *>(ctx_idx.get());
-        if (dbg_all || dbg_nkv_attn != dbg_idx->get_n_kv()) {
-            const uint32_t used_attn = get_attn()->dbg_n_kv_used();
-            const uint32_t used_idx  = dbg_idx   ->dbg_n_kv_used();
-            fprintf(stderr,
-                    "[DBG_APPLY] %s tid=%lu n_tok=%u n_seqs_unq=%u | attn n_kv=%u used=%u size=%u | idx n_kv=%u used=%u size=%u | %s\n",
-                    dbg_nkv_attn == dbg_idx->get_n_kv() ? "agree" : "MISMATCH",
