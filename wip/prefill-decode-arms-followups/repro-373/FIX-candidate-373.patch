-                // upstream's batched copy is the fallback (a meta buffer has no cpy_tensor_n, so it lands on the
-                // per-tensor path - which is why the staged band above exists)
+                // upstream's batched copy is the fallback.  The staged band above is what a meta buffer takes on
+                // purpose (one pageable allocation + a synchronise per piece is the cliff r157 removed); this call
+                // serves the pieces whose window did not fit, and since TODO #365 the meta buffer HAS a
+                // `cpy_tensor_n`, so those land on per-child device copies instead of per-tensor host copies
                 std::vector<const ggml_tensor *> srcs(mbuf_cur.org.begin(), mbuf_cur.org.end());
                 std::vector<ggml_tensor *> dsts(mbuf_cur.cpy.begin(), mbuf_cur.cpy.end());
                 ggml_backend_tensor_copy_n(srcs.data(), dsts.data(), mbuf_cur.org.size());
@@ -7188,6 +7190,96 @@ bool llama_memory_seq_state_take(
         return e != nullptr && atoi(e) != 0;
     }();
 
+    // wip/prefill-decode-arms (diagnostic, LLAMA_RS_VERIFY_TAKE=1): is the transfer FAITHFUL?  This runs for
