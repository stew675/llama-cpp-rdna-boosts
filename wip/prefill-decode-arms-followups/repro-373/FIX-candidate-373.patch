From 00a568fba2e756f3d4a36e9f5598f90e4d168584 Mon Sep 17 00:00:00 2001
From: Stew Forster <ci@rdna-boosts.invalid>
Date: Sun, 22 Nov 2026 16:04:47 -0600
Subject: [PATCH] crash #373 fix (candidate): one apply lock per memory GROUP
 -- the pair's two arms mutate one KV cell map from two threads, which is the
 qwen4exp n_kv abort AND a std::set/tree corruption in
 llama_kv_cache::prepare()'s rollback snapshot; plus set the meta view slot on
 every sched_alt_select (hardening, unproven)

---
 src/llama-context.cpp           | 17 ++++++++++++++---
 src/llama-kv-cache.cpp          | 20 --------------------
 src/llama-kv-cache.h            |  6 ------
 src/llama-memory-hybrid-idx.cpp | 29 -----------------------------
 tools/server/server.cpp         | 20 --------------------
 5 files changed, 14 insertions(+), 78 deletions(-)

diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index 7faad42b6..153105d6b 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -24,6 +24,8 @@
 #include "llama.h"
 
 #include <algorithm>
+#include <chrono>
+#include <cstdio>
 #include <cinttypes>
 #include <cmath>
 #include <cstring>
@@ -1555,6 +1557,18 @@ void llama_context::sched_new(const sched_params & params) {
 }
 
 void llama_context::sched_alt_select(bool alt) {
+    // a CO-OWNER context (the decode arm) takes the second pair of view slots, so two contexts computing at the
+    // same time never share a meta view container (wip/prefill-decode-arms).
+    //
+    // crash #373: set it on EVERY call, not only when the alt state changes.  `g_meta_view_slot` is thread_local and
+    // starts at 0, and `sched_alt_in_use` starts false -- so a context that never switches schedulers returned below
+    // on its first graph and kept slot 0, i.e. the SAME slot as its co-owner.  Both arms then registered and looked
+    // up the per-graph VIEWS of their shared KV cache (an external view uses the buffer of its view source, see
+    // ggml_backend_meta_buffer_context) in one rotating container, each clearing it under the other: measured as a
+    // SIGSEGV inside libstdc++/libggml-base on `std::set`/`std::unordered_map` nodes, and as the `simple_tensor ==
+    // null` / `tensor write out of bounds` aborts the process-global slot used to cause.
+    ggml_backend_meta_set_view_slot((cparams.ctx_other != nullptr ? 2 : 0) + (alt ? 1 : 0));
+
     if (alt == sched_alt_in_use) {
         return;
     }
@@ -1571,9 +1585,6 @@ void llama_context::sched_alt_select(bool alt) {
     std::swap(sched, sched_alt);
     std::swap(gf_res_prev_active, gf_res_prev_active_alt);
     sched_alt_in_use = alt;
-    // a CO-OWNER context (the decode arm) takes the second pair of view slots, so two contexts computing at the
-    // same time never share a meta view container (wip/prefill-decode-arms)
-    ggml_backend_meta_set_view_slot((cparams.ctx_other != nullptr ? 2 : 0) + (alt ? 1 : 0));
 }
 
 bool llama_context::sched_alt_for(const llama_ubatch & ubatch) const {
