+        return;
+    }
+    cudaEvent_t & ev = g_win_call_ev[device];
+    if (ev == nullptr) {
+        if (cudaEventCreateWithFlags(&ev, cudaEventDisableTiming) != cudaSuccess) {
+            (void) cudaGetLastError();
+            ev = nullptr;
+        }
+    }
+}
+
+static void win_trim_to_budget_locked(int device) {
+    if (!g_win_on || g_win.empty() || g_win_bytes <= g_win_budget) {
+        return;
+    }
+    // Everything promoted at or before call N-1 is drained once the event recorded at boundary N-1 has
+    // fired; query it ONCE.
+    bool drained_prev = true;
+    if (device >= 0 && device < GGML_CUDA_MAX_DEVICES && g_win_call_ev[device] != nullptr) {
+#if defined(GGML_USE_HIP)
