+// with the burst-trim policy).  Instead a burst may overshoot the budget by this slack, and the trim runs
+// ONCE at the next call boundary, when the previous call's copies have drained.
+static size_t win_slack() {
+    const size_t quarter = g_win_budget / 4;
+    return quarter > (64u << 20) ? quarter : (size_t) (64u << 20);
