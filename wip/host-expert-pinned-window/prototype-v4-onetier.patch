+// wip/host-expert-pinned-window: ONE registration per host tensor, shared by every per-device table of it.
+// A `-sm tensor` split registers one master from three children; the second `cudaHostRegister` of the same
+// range is refused as an overlap, which would leave those devices silently on the slow path (they would
+// have no alias and so no in-place cold read), so the binding has to be shared rather than per table.
+struct win_tensor_reg {
+    void * base = nullptr;   // page-aligned registration base
+    size_t len  = 0;         // registered length
+    void * dev  = nullptr;   // UVA alias of `base`
+    bool   locked = false;   // mlock()ed (MOE_EXPERT_WINDOW_MLOCK): the pages are HELD, not merely mapped
+    int    refs = 0;         // tables currently bound to it
+};
+static std::map<const void *, win_tensor_reg> g_win_tensors;   // key: the host tensor base
+
+// Release this table's reference to its host tensor's registration (the last one unregisters).
+static void win_unbind_tensor(table_t & t) {
+    t.host_dev       = nullptr;
+    t.host_dev_bound = false;
+    if (t.host == nullptr) {
+        return;
+    }
+    const auto it = g_win_tensors.find(t.host);
+    if (it == g_win_tensors.end()) {
+        return;
+    }
+    if (--it->second.refs > 0) {
+        return;
+    }
+    (void) cudaHostUnregister(it->second.base);
+    (void) cudaGetLastError();
+#if !defined(_WIN32)
+    if (it->second.locked) {
+        (void) munlock(it->second.base, it->second.len);
+    }
+#endif
+    if (g_win_bytes >= it->second.len) { g_win_bytes -= it->second.len; } else { g_win_bytes = 0; }
+    g_win_tensors.erase(it);
+}
