 bool ggml_cuda_lightning_indexer_supported(int device, const ggml_tensor * dst) {
+    // The 4-head qwen4exp prefill score must run on the WMMA4 arm.  On RDNA3_0 (gfx1100) that arm
+    // is opt-in (see indexer4_arch_enabled), and the generic vec fallback is *slower* than the
+    // unfused per-op chain there (issue #59: ~5.4% at d64K), so report unsupported and let the
+    // model build the chain instead.  The model probes this through the backend, so the arch
+    // policy stays in one place (indexer4_arch_enabled).
+    const int cc = ggml_cuda_info().devices[device].cc;
+    const ggml_tensor * q = dst->src[0];
+    if (q != nullptr && q->ne[1] == 4 && GGML_CUDA_CC_IS_RDNA3_0(cc) && !indexer4_arch_enabled(cc)) {
+        return false;
+    }
     return supports_indexer4(device, dst) || ggml_cuda_lightning_indexer_generic_supported(device, dst);
 }
