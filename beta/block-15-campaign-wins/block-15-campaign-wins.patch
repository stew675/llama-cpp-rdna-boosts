+#ifdef FAST_FP16_AVAILABLE
+    if (!ggml_cuda_fattn_kv_native_enabled()) {
+        return false;
+    }
+    if (t == nullptr || t->type != GGML_TYPE_BF16) {
+        return false;
+    }
+    // The staged chunk is 16 bytes, i.e. GGML_CUDA_FA_Q8_CHUNK 2-byte elements (the same chunk unit
