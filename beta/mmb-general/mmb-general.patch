+    // MIRRORED layout is a gfx11 builtin only and has no RDNA4 device code.
+    using AB=tile<16,8,half2,DATA_LAYOUT_I_MAJOR>;
+#endif
+    using C=tile<16,16,float,DATA_LAYOUT_J_MAJOR>;
