+bool ggml_cuda_mmb_gatemix() { return mmb_gatemix_flag(); }
+// True while the MMB gate is on; used by the graph optimizer to stand its own IQ4_NL MoE MMQ
+// fusions down so the ops reach the mmb dispatch in ggml_cuda_mul_mat / _mul_mat_id instead.
+bool ggml_cuda_mmb_active() { return mmb_enabled(); }
+bool ggml_cuda_mmb_dense_will_take(const ggml_tensor * w) {
+    if (!mmb_enabled() || !w) return false;
+    switch (w->type) {
+        case GGML_TYPE_IQ4_NL: case GGML_TYPE_Q8_0: case GGML_TYPE_Q4_K: case GGML_TYPE_Q5_1: case GGML_TYPE_IQ3_S: case GGML_TYPE_Q5_K: case GGML_TYPE_Q6_K: case GGML_TYPE_IQ4_XS: case GGML_TYPE_Q3_K: case GGML_TYPE_IQ3_XXS: return true;
+        default: return false;
+    }
+}
+bool ggml_cuda_mmb_routed_will_take(const ggml_tensor * w) {
+    if (!mmb_enabled() || !w) return false;
+    return w->type == GGML_TYPE_IQ4_NL || w->type == GGML_TYPE_Q4_K || w->type == GGML_TYPE_Q5_1 || w->type == GGML_TYPE_IQ3_S || w->type == GGML_TYPE_Q8_0 || w->type == GGML_TYPE_Q5_K || w->type == GGML_TYPE_Q6_K || w->type == GGML_TYPE_IQ4_XS || w->type == GGML_TYPE_Q3_K || w->type == GGML_TYPE_IQ3_XXS;
+}
