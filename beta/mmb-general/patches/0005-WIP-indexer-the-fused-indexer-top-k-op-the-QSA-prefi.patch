+    CUDA_CHECK(cudaGetLastError());
+}
+bool ggml_cuda_lightning_indexer_supported(int device, const ggml_tensor * dst) {
+    return supports_indexer4(device, dst) || ggml_cuda_lightning_indexer_generic_supported(device, dst);
+}
