+// A row-block device->host read.  Defined with the 2-D interfaces below; the CUDA buffer's 2-D read reaches it
+// long before that, because the backend never issues a 2-D D2H into host memory (see the definition).
+static void ggml_cuda_rows_to_host(int device, const char * src, void * data, size_t size, size_t n_copies,
+        size_t stride_tensor, size_t stride_data, cudaStream_t stream, bool sync);
