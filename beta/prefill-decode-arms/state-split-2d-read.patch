-                    size, n, cudaMemcpyDeviceToHost, ggml_cuda_host_stream()));
-            CUDA_CHECK(cudaStreamSynchronize(ggml_cuda_host_stream()));
-            for (size_t e = 0; e < n; ++e) {
-                memcpy((char *) data + (e0 + e) * stride_data, pin + e * size, size);
-            }
-        }
-        return;
-    }
-    CUDA_CHECK(cudaMemcpy2DAsync(
-        data, stride_data, (const char *) tensor->data + offset, stride_tensor, size, n_copies, cudaMemcpyDeviceToHost, ggml_cuda_host_stream()));
-    CUDA_CHECK(cudaStreamSynchronize(ggml_cuda_host_stream()));
+    // A PINNED destination does not get the 2-D copy either: it is one device's pinned allocation read by every
+    // device of a split, and the peer grant the 2-D direction needs is refused here -- so the row block is read
+    // as 1-D copies (device-staged when it is big enough) in every case, see ggml_cuda_rows_to_host.
+    ggml_cuda_rows_to_host(ctx->device, (const char *) tensor->data + offset, data, size, n_copies,
+            stride_tensor, stride_data, ggml_cuda_host_stream(), /*sync =*/ true);
 }
 
 static void ggml_backend_cuda_buffer_set_tensor_n(ggml_backend_buffer_t buffer, struct ggml_tensor * const * tensors, const void * const * data, const size_t * offsets, const size_t * sizes, size_t n_tensors) {
@@ -3943,27 +3934,70 @@ static char * ggml_cuda_kv_region_dev_stage(int device, size_t need, std::unique
     return (char *) buf[device];
 }
 
-static void ggml_backend_cuda_kv_region_rows_to_host(ggml_backend_cuda_buffer_context * ctx, const char * src, void * data,
-        size_t size, size_t n_copies, size_t stride_tensor, size_t stride_data) {
-    if (stride_tensor == size && stride_data == size) {
-        CUDA_CHECK(cudaMemcpyAsync(data, src, (n_copies - 1) * stride_tensor + size, cudaMemcpyDeviceToHost, ggml_cuda_host_stream()));
-        CUDA_CHECK(cudaStreamSynchronize(ggml_cuda_host_stream()));
+// A row-block DEVICE -> HOST read is never a 2-D copy on this backend.
+//
+// WHY (r384-wip, the beta tester's third crash): on ROCm a `hipMemcpy2DAsync` D2H into host memory asks the
+// runtime for a peer grant of the destination's pinned allocation to the copying device's agent
+// (`hsa_amd_agents_allow_access`, and `hipMemSetAccess` for a VMM allocation).  Every buffer of
+// `ggml_backend_cuda_host_buffer_type()` -- llama.cpp's pinned output buffer (`llama_context::output_host_buft`)
+// and its state stage, above all -- is allocated by ONE device and read from ALL devices of a `-sm tensor` split,
+// so each copy from a device that does not own it needs that grant; on a box whose slabs leave the driver no room
+// the grant is REFUSED ("Allow p2p access failed - hsa_amd_agents_allow_access with err 4096", the same refusal
+// `ggml_cuda_peer_copy_ok` exists for) and `hipMemcpy2D` returns `invalid argument`.  Measured on the beta
+// candidate: a 5-row logits read of a split `result_output` aborted the server on device 1 while its twin copy on
+// device 0 -- the allocation's owner -- succeeded:
+//   2-D read of 'result_output' failed (invalid argument): 331092 bytes x 5 copies, tensor pitch 331092,
+//   host pitch 993280, offset 0 (ROCm1 buffer)
+// A 1-D copy of the same bytes is accepted from every device, and that is the class already recorded for the
+// movable-boundary slab and the mixed KV region (INVARIANTS.md r183/r253/r204).  So this issues:
+//   * ONE 1-D copy when the block is tight (both pitches are the width) or there is a single copy,
+//   * the device-staged chunked form when the call may synchronize and the block is above the bounce threshold:
+//     one 2-D DEVICE-to-DEVICE gather into the reading device's own staging buffer, one 1-D D2H per chunk into
+//     that device's own pinned chunk, then a host scatter -- a 2-D gather on a device buffer needs no grant,
+//     and no 2-D device-to-host copy is issued anywhere, and
+//   * one 1-D copy per row otherwise: the ASYNC form, which must not synchronize (the caller batches many
+//     reads behind one backend synchronize), and the small block the staging pair would only slow down.
+// `GGML_CUDA_BOUNCE_MIN=0` keeps the per-row arm selectable, as it does for the pageable bounce.
+static void ggml_cuda_rows_to_host(int device, const char * src, void * data, size_t size, size_t n_copies,
+        size_t stride_tensor, size_t stride_data, cudaStream_t stream, bool sync) {
+    if (n_copies == 0 || size == 0) {
+        return;
+    }
+    // a bare CUDA_CHECK names the API and the error, never the block that was refused
+    auto check = [&](cudaError_t err) {
+        if (err == cudaSuccess) {
+            return;
+        }
+        (void) cudaGetLastError();
+        GGML_LOG_ERROR("%s: device %d: row-block read failed (%s): %zu bytes x %zu copies, tensor pitch %zu, "
+                       "host pitch %zu (%s)\n", __func__, device, cudaGetErrorString(err), size, n_copies,
+                       stride_tensor, stride_data, sync ? "staged" : "async");
+        GGML_ABORT("%s: row-block read failed", __func__);
+    };
+
+    if (stride_tensor == size && stride_data == size) {   // a tight block is ONE 1-D copy
+        check(cudaMemcpyAsync(data, src, (n_copies - 1) * stride_tensor + size, cudaMemcpyDeviceToHost, stream));
+        if (sync) {
+            check(cudaStreamSynchronize(stream));
+        }
         return;
     }
-    if (size * n_copies >= ggml_cuda_bounce_min()) {   // GGML_CUDA_BOUNCE_MIN=0 keeps the per-row arm selectable
+    // `size <= ggml_cuda_pin_chunk_bytes`: a row bigger than the staging pair cannot be staged at all (the chunk
+    // is capped, so the gather would overflow it) -- such a block is read one 1-D copy per row instead.
+    if (sync && size <= ggml_cuda_pin_chunk_bytes && size * n_copies >= ggml_cuda_bounce_min()) {   // GGML_CUDA_BOUNCE_MIN=0 keeps the per-row arm selectable
         std::unique_lock<std::mutex> pin_lock;
         std::unique_lock<std::mutex> stg_lock;
-        char * pin   = ggml_cuda_pin_chunk(ctx->device, pin_lock);
-        char * stage = ggml_cuda_kv_region_dev_stage(ctx->device,
+        char * pin   = ggml_cuda_pin_chunk(device, pin_lock);
+        char * stage = ggml_cuda_kv_region_dev_stage(device,
                 std::min(ggml_cuda_kv_region_stage_max, size * n_copies), stg_lock);
         if (pin != nullptr && stage != nullptr) {
             const size_t rows = std::max<size_t>(1, std::min<size_t>(ggml_cuda_pin_chunk_bytes,
                     ggml_cuda_kv_region_stage_max) / size);
             for (size_t e0 = 0; e0 < n_copies; e0 += rows) {
                 const size_t n = std::min(rows, n_copies - e0);
-                ggml_cuda_cpy_2d_rows(stage, src + e0 * stride_tensor, size, n, stride_tensor, size, ggml_cuda_host_stream());
-                CUDA_CHECK(cudaMemcpyAsync(pin, stage, n * size, cudaMemcpyDeviceToHost, ggml_cuda_host_stream()));
-                CUDA_CHECK(cudaStreamSynchronize(ggml_cuda_host_stream()));
+                ggml_cuda_cpy_2d_rows(stage, src + e0 * stride_tensor, size, n, stride_tensor, size, stream);
+                check(cudaMemcpyAsync(pin, stage, n * size, cudaMemcpyDeviceToHost, stream));
+                check(cudaStreamSynchronize(stream));
                 for (size_t e = 0; e < n; ++e) {
                     memcpy((char *) data + (e0 + e) * stride_data, pin + e * size, size);
                 }
@@ -3972,10 +4006,17 @@ static void ggml_backend_cuda_kv_region_rows_to_host(ggml_backend_cuda_buffer_co
         }
     }
     for (size_t e = 0; e < n_copies; ++e) {
-        CUDA_CHECK(cudaMemcpyAsync((char *) data + e * stride_data, src + e * stride_tensor, size, cudaMemcpyDeviceToHost,
-                ggml_cuda_host_stream()));
+        check(cudaMemcpyAsync((char *) data + e * stride_data, src + e * stride_tensor, size, cudaMemcpyDeviceToHost, stream));
     }
-    CUDA_CHECK(cudaStreamSynchronize(ggml_cuda_host_stream()));
+    if (sync) {
+        check(cudaStreamSynchronize(stream));
+    }
+}
+
+static void ggml_backend_cuda_kv_region_rows_to_host(ggml_backend_cuda_buffer_context * ctx, const char * src, void * data,
+        size_t size, size_t n_copies, size_t stride_tensor, size_t stride_data) {
+    ggml_cuda_rows_to_host(ctx->device, src, data, size, n_copies, stride_tensor, stride_data,
+            ggml_cuda_host_stream(), /*sync =*/ true);
 }
 
 // the write direction is the mirror image: pack the host rows into the pinned chunk, one 1-D H2D per chunk, then
@@ -8812,21 +8853,19 @@ static void ggml_backend_cuda_get_tensor_2d_async(ggml_backend_t backend, const
     // server ABORTS the moment a prompt cache save touches it (measured: `gate-state-pipe.sh` with
     // LLAMA_KV_REGION=1, `llama_io_write_host::flush_async` -> this assert).
     GGML_ASSERT(ggml_backend_buft_is_cuda(buf->buft) && "unsupported buffer type");
+    // the write twin (ggml_backend_cuda_set_tensor_2d_async) selects its device here; the copy below is issued on
+    // this context's stream, so the current device must be this one
+    ggml_cuda_set_device(cuda_ctx->device);
     ggml_cuda_async_input_drain(cuda_ctx->device);
 
-    // A failed copy here used to abort through CUDA_CHECK with nothing but the driver's word, which is what
-    // made the windowed-KV-on-a-tensor-split checkpoint save (TODO #124) a naked `ROCm error: invalid
-    // argument`: the arguments are what the caller got wrong, so print them.
-    const cudaError_t err = cudaMemcpy2DAsync(
-        data, stride_data, (const char *) tensor->data + offset, stride_tensor, size, n_copies, cudaMemcpyDeviceToHost, cuda_ctx->stream());
-    if (err != cudaSuccess) {
-        (void) cudaGetLastError();
-        GGML_LOG_ERROR("%s: device %d: 2-D read of '%s' failed (%s): %zu bytes x %zu copies, tensor pitch %zu, "
-                       "host pitch %zu, offset %zu (%s buffer)\n", __func__, cuda_ctx->device, tensor->name,
-                       cudaGetErrorString(err), size, n_copies, stride_tensor, stride_data, offset,
-                       ggml_backend_buft_name(buf->buft));
-        GGML_ABORT("%s: 2-D read failed", __func__);
-    }
+    // NOT a 2-D copy: a split tensor's row block lands in ONE device's pinned host allocation (llama.cpp's
+    // output buffer / state stage), and the peer grant a `hipMemcpy2DAsync` D2H needs for the destination is
+    // refused on this box -- that abort ("2-D read of 'result_output' failed (invalid argument)", 331092 bytes
+    // x 5 copies, host pitch 3 x tensor pitch) is what this path is fixed for.  See ggml_cuda_rows_to_host.
+    // The copies stay QUEUED on the context's stream (the caller batches them behind one backend synchronize,
+    // and this stream orders them after the graph that produced the rows).
+    ggml_cuda_rows_to_host(cuda_ctx->device, (const char *) tensor->data + offset, data, size, n_copies,
+            stride_tensor, stride_data, cuda_ctx->stream(), /*sync =*/ false);
 }
 
 // Staged cross-device copy (pinned host bounce).
