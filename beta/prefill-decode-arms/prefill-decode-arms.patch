+                        __func__, arms_reserve.n_aux, COMMON_ARMS_RESERVE_MIB_PER_AUX,
+                        (double) arms_bytes / 1048576.0);
+            } else {
+                const char * why = common_arms_pair_possible(params);
+                LOG_INF("%s: the two-arm server is requested but cannot be built (%s), so it reserves NOTHING\n",
+                        __func__, why);
+            }
+        }
+
         const common_draft_reserve draft_reserve = common_draft_reserve_derive(params);
         size_t aux_bytes = 0;
-        if (has_aux) {
+        if (has_aux || arms_bytes > 0) {
             // wip/slab-transient-absorption (step 1/2): the reserve derived above (the same value `--fit`
