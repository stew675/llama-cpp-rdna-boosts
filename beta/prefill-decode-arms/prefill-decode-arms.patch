     common_draft_reserve draft_reserve;
     if (!params.speculative.has_aux()) {
@@ -1551,13 +1608,37 @@ common_init_result::common_init_result(common_params & params, bool model_only,
         const bool has_host_experts = llama_model_moe_host_expert_dev_count(model) > 0;
         const bool has_aux = has_host_experts &&
                 (params.speculative.has_dft() || params.speculative.has_mtp());
+
+        // the two-arm server's AUXILIARY CONTEXTS, charged on the same preflight: one pinned compute region per
+        // context, counted (see COMMON_ARMS_RESERVE_MIB_PER_AUX)
+        size_t arms_bytes = 0;
