             const char * e = getenv("MOE_EXPERT_CACHE_AUX_RESERVE_MIB");
-            if (draft_reserve.ok) {
+            if (!has_aux) {
+                aux_bytes = 0;
+            } else if (draft_reserve.ok) {
                 // wip/slab-transient-absorption (step 4): the draft MODEL is now loaded BEFORE the target
                 // context (below), so its weights are already resident when the slab is created and are
                 // measured there from the free VRAM.  They must NOT be charged to the slab's reserve a
@@ -1595,6 +1676,12 @@ common_init_result::common_init_result(common_params & params, bool model_only,
                         draft_reserve.note.empty() ? "not derivable" : draft_reserve.note.c_str());
             }
         }
+        if (arms_bytes > 0) {
+            aux_bytes += arms_bytes;
+            LOG_INF("%s: MoE arena reserve = %.0f MiB in total (draft %.0f + two-arm auxiliary contexts %.0f)\n",
+                    __func__, (double) aux_bytes / 1048576.0, (double) (aux_bytes - arms_bytes) / 1048576.0,
+                    (double) arms_bytes / 1048576.0);
+        }
         llama_model_moe_cache_preflight(model, aux_bytes);
     }
 
@@ -2226,6 +2313,84 @@ struct llama_model * common_model_load(const std::vector<std::string> & paths, c
     return llama_model_load_from_splits(c_paths.data(), c_paths.size(), mparams);
 }
 
+// Is the TWO-ARM pair possible for this configuration?  ONE function, called by the reserve derivation and by
+// the server, so a charge and a creation cannot disagree (DESIGN.md V2).  Pure: no I/O, no allocation.
+const char * common_arms_pair_possible(const common_params & params) {
+    if (params.n_parallel < 2) {
+        return "it needs at least 2 slots (--parallel >= 2): the feature is a reply that keeps generating "
+               "while ANOTHER slot's prompt is processed";
+    }
+    // note: `mmproj_use_gpu` is a POLICY flag (default on) and says nothing about whether a projector
+    // is loaded -- only the path does
+    if (!params.mmproj.path.empty()) {
+        return "multimodal input (an mmproj) drives its own encoder pipeline, which is bound to one context";
+    }
+    if (params.embedding) {
+        return "embeddings/rerank/decision requests produce no decoded tokens to hand to a second arm";
+    }
+    if (!params.lora_adapters.empty()) {
+        return "LoRA adapters are applied per context (common_set_adapter_lora), and the two arms would "
+               "never agree on which are active";
+    }
+    if (params.sampling.backend_sampling) {
+        return "backend sampling keeps its sampler chain inside one context";
+    }
+    if (params.sleep_idle_seconds > 0) {
+        return "--sleep-idle unloads the model, which would tear the pair's SHARED memory down under the "
+               "other arm";
+    }
+    if (params.ctx_shift) {
+        return "--context-shift mutates the shared KV of a slot the decode arm owns; run --no-context-shift "
+               "(the pair does not shift a generating slot from the other arm)";
+    }
+    // The speculator (STEP 10): the decode arm DRIVES the draft/verify/accept round for the slots it owns, so a
+    // drafter is admitted only when its target side can follow the arm that ran the batch (`common_batch::ctx`)
+    // and it keeps its own KV.
+    //   * ADMITTED: draft-simple, draft-mtp, draft-mtp-adaptive, and the model-free n-gram family (which has
+    //     no draft context at all, so it never reaches this test).
+    //   * REFUSED: the layer-input families (eagle3/dflash/dspark/dflash2/lilicorr), which read the target's
+    //     layer inputs and bind `ctx_other` at init; and a draft that shares the TARGET's KV.
+    // The shared-KV refusal needs the GGUF: a gemma4 assistant is an ordinary `draft-simple` /
+    // `draft-mtp` GGUF whose ARCH (`gemma4-assistant`) operates on the TARGET's own KV cache.  It has to be
+    // refused HERE rather than after the load, or the pair would be charged its arena reserve and then not
+    // exist (V2) -- so this predicate does exactly ONE small read (`general.architecture` of the draft path,
+    // the same file the reserve estimate in `common_draft_reserve_derive()` opens).  The server asks the loaded
+    // model the same question as a belt-and-braces check for a path this could not read.
+    if (params.speculative.has_aux()) {
+        if (common_speculative_path_shares_target_kv(params.speculative.draft.mparams.path)) {
+            return "the draft model shares the TARGET's KV cache (a gemma4 assistant): it re-uses the target's "
+                   "position for every draft token and skips its catch-up decode, which assumes it is the only "
+                   "other reader of those cells -- with one shared memory that is unreachable. Run --spec-type "
+                   "none, or another drafter";
+        }
+
+        for (const auto type : params.speculative.types) {
+            switch (type) {
+                case COMMON_SPECULATIVE_TYPE_NONE:
+                case COMMON_SPECULATIVE_TYPE_DRAFT_SIMPLE:
+                case COMMON_SPECULATIVE_TYPE_DRAFT_MTP:
+                case COMMON_SPECULATIVE_TYPE_DRAFT_MTP_ADAPTIVE:
+                case COMMON_SPECULATIVE_TYPE_NGRAM_SIMPLE:
+                case COMMON_SPECULATIVE_TYPE_NGRAM_MAP_K:
+                case COMMON_SPECULATIVE_TYPE_NGRAM_MAP_K4V:
+                case COMMON_SPECULATIVE_TYPE_NGRAM_MOD:
+                case COMMON_SPECULATIVE_TYPE_NGRAM_CACHE:
+                    break;
+                case COMMON_SPECULATIVE_TYPE_DRAFT_EAGLE3:
+                case COMMON_SPECULATIVE_TYPE_DRAFT_DFLASH:
+                case COMMON_SPECULATIVE_TYPE_DRAFT_DSPARK:
+                case COMMON_SPECULATIVE_TYPE_DRAFT_DFLASH2:
+                case COMMON_SPECULATIVE_TYPE_DRAFT_LILICORR:
+                default:
+                    return "this speculator family keeps its TARGET side in one context (it reads the target's "
+                           "layer inputs / h_nextn rows through ctx_tgt), so the decode arm cannot drive it: run "
+                           "--spec-type none, or draft-simple / draft-mtp / draft-mtp-adaptive / an n-gram type";
+            }
+        }
+    }
+    return nullptr;
+}
